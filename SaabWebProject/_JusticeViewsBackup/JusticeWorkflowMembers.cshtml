    /* =========================================================
       JALALI
       ========================================================= */

    function div(a,b) {
        return ~~(a/b);
    }


    function mod(a,b) {
        return a - ~~(a/b)*b;
    }


    function jalCal(jy) {

        var breaks = [
            -61,9,38,199,426,
            686,756,818,1111,
            1181,1210,1635,
            2060,2097,2192,
            2262,2324,2394,
            2456,3178
        ];


        var bl = breaks.length;
        var gy = jy + 621;
        var leapJ = -14;
        var jp = breaks[0];
        var jm;
        var jump = 0;
        var leap;
        var leapG;
        var march;
        var n;
        var i;


        for (
            i = 1;
            i < bl;
            i++
        )
        {
            jm =
                breaks[i];

            jump =
                jm - jp;


            if (jy < jm)
            {
                break;
            }


            leapJ +=
                div(jump,33)*8
                +
                div(
                    mod(jump,33),
                    4
                );


            jp =
                jm;
        }


        n =
            jy - jp;


        leapJ +=
            div(n,33)*8
            +
            div(
                mod(n,33)+3,
                4
            );


        if (
            mod(jump,33) === 4
            &&
            jump - n === 4
        )
        {
            leapJ++;
        }


        leapG =
            div(gy,4)
            -
            div(
                (
                    div(gy,100)+1
                )*3,
                4
            )
            -
            150;


        march =
            20
            +
            leapJ
            -
            leapG;


        if (jump-n < 6)
        {
            n =
                n
                -
                jump
                +
                div(
                    jump+4,
                    33
                )*33;
        }


        leap =
            mod(
                mod(n+1,33)-1,
                4
            );


        if (leap === -1)
        {
            leap =
                4;
        }


        return {
            leap: leap,
            gy: gy,
            march: march
        };
    }



    function g2d(gy,gm,gd) {

        var d =
            div(
                (
                    gy
                    +
                    div(gm-8,6)
                    +
                    100100
                )*1461,
                4
            )
            +
            div(
                153*mod(gm+9,12)+2,
                5
            )
            +
            gd
            -
            34840408;


        d =
            d
            -
            div(
                div(
                    gy
                    +
                    100100
                    +
                    div(gm-8,6),
                    100
                )*3,
                4
            )
            +
            752;


        return d;
    }



    function d2g(jdn) {

        var j =
            4*jdn
            +
            139361631;


        j =
            j
            +
            div(
                div(
                    4*jdn
                    +
                    183187720,
                    146097
                )*3,
                4
            )*4
            -
            3908;


        var i =
            div(
                mod(j,1461),
                4
            )*5
            +
            308;


        var gd =
            div(
                mod(i,153),
                5
            )
            +
            1;


        var gm =
            mod(
                div(i,153),
                12
            )
            +
            1;


        var gy =
            div(j,1461)
            -
            100100
            +
            div(8-gm,6);


        return {
            gy:gy,
            gm:gm,
            gd:gd
        };
    }



    function j2d(jy,jm,jd) {

        var r =
            jalCal(jy);


        return g2d(
            r.gy,
            3,
            r.march
        )
        +
        (jm-1)*31
        -
        div(jm,7)*(jm-7)
        +
        jd
        -
        1;
    }



    function d2j(jdn) {

        var g =
            d2g(jdn);


        var jy =
            g.gy - 621;


        var r =
            jalCal(jy);


        var jdn1f =
            g2d(
                g.gy,
                3,
                r.march
            );


        var k =
            jdn - jdn1f;


        var jd;
        var jm;


        if (k >= 0)
        {
            if (k <= 185)
            {
                jm =
                    1
                    +
                    div(k,31);


                jd =
                    mod(k,31)
                    +
                    1;


                return {
                    jy:jy,
                    jm:jm,
                    jd:jd
                };
            }


            k -=
                186;
        }
        else
        {
            jy--;

            k +=
                179;


            if (r.leap === 1)
            {
                k++;
            }
        }


        jm =
            7
            +
            div(k,30);


        jd =
            mod(k,30)
            +
            1;


        return {
            jy:jy,
            jm:jm,
            jd:jd
        };
    }



    function gregorianToJalali(
        y,m,d
    )
    {
        return d2j(
            g2d(y,m,d)
        );
    }



    function jalaliToGregorian(
        y,m,d
    )
    {
        return d2g(
            j2d(y,m,d)
        );
    }



    var months = [
        "فروردین",
        "اردیبهشت",
        "خرداد",
        "تیر",
        "مرداد",
        "شهریور",
        "مهر",
        "آبان",
        "آذر",
        "دی",
        "بهمن",
        "اسفند"
    ];


    var dateInput =
        document.getElementById(
            "meetingDatePersian"
        );


    var picker =
        document.getElementById(
            "jalaliPicker"
        );


    var now =
        new Date();


    var today =
        gregorianToJalali(
            now.getFullYear(),
            now.getMonth()+1,
            now.getDate()
        );


    var py =
        today.jy;


    var pm =
        today.jm;


    function pad(v) {

        return v < 10
            ?
            "0" + v
            :
            v;
    }



    function monthLength(y,m) {

        if (m <= 6)
        {
            return 31;
        }


        if (m <= 11)
        {
            return 30;
        }


        return jalCal(y).leap === 0
            ?
            30
            :
            29;
    }



    function renderCalendar() {

        document.getElementById(
            "calendarTitle"
        ).innerText =
            months[pm-1]
            +
            " "
            +
            py;


        var area =
            document.getElementById(
                "calendarDays"
            );


        area.innerHTML =
            "";


        var g =
            jalaliToGregorian(
                py,
                pm,
                1
            );


        var first =
            new Date(
                g.gy,
                g.gm-1,
                g.gd
            );


        var offset =
            (
                first.getDay()+1
            ) % 7;


        for (
            var i=0;
            i<offset;
            i++
        )
        {
            var empty =
                document.createElement(
                    "span"
                );


            area.appendChild(
                empty
            );
        }


        for (
            let day=1;
            day<=monthLength(py,pm);
            day++
        )
        {
            var btn =
                document.createElement(
                    "button"
                );


            btn.type =
                "button";


            btn.className =
                "cal-day";


            btn.innerText =
                day;


            if (
                py === today.jy
                &&
                pm === today.jm
                &&
                day === today.jd
            )
            {
                btn.classList.add(
                    "today"
                );
            }


            btn.onclick =
                function () {

                    dateInput.value =
                        py
                        +
                        "/"
                        +
                        pad(pm)
                        +
                        "/"
                        +
                        pad(day);


                    picker.classList.remove(
                        "open"
                    );
                };


            area.appendChild(
                btn
            );
        }

    }



    dateInput.onclick =
        function () {

            renderCalendar();


            picker.classList.toggle(
                "open"
            );
        };



    document.getElementById(
        "prevMonth"
    ).onclick =
        function () {

            pm--;


            if (pm < 1)
            {
                pm =
                    12;

                py--;
            }


            renderCalendar();
        };



    document.getElementById(
        "nextMonth"
    ).onclick =
        function () {

            pm++;


            if (pm > 12)
            {
                pm =
                    1;

                py++;
            }


            renderCalendar();
        };



    document.getElementById(
        "todayButton"
    ).onclick =
        function () {

            py =
                today.jy;


            pm =
                today.jm;


            dateInput.value =
                today.jy
                +
                "/"
                +
                pad(today.jm)
                +
                "/"
                +
                pad(today.jd);


            picker.classList.remove(
                "open"
            );
        };



    document.getElementById(
        "clearDate"
    ).onclick =
        function () {

            dateInput.value =
                "";


            picker.classList.remove(
                "open"
            );
        };



    /* =========================================================
       SAVE MEETING
       ========================================================= */

    document.getElementById(
        "meetingForm"
    ).addEventListener(
        "submit",
        function (e) {

            e.preventDefault();


            if (!currentStageId)
            {
                alert(
                    "مرحله انتخاب نشده است."
                );

                return;
            }


            var caseId =
                document.getElementById(
                    "meetingCaseId"
                ).value;


            if (!caseId)
            {
                alert(
                    "درخواست مرتبط با جلسه را انتخاب کنید."
                );

                return;
            }


            if (!dateInput.value)
            {
                alert(
                    "تاریخ جلسه را انتخاب کنید."
                );

                return;
            }


            var participants =
                document.querySelectorAll(
                    '#meetingForm input[name="participantUserIds"]:checked'
                );


            if (participants.length === 0)
            {
                alert(
                    "حداقل یک شرکت‌کننده انتخاب کنید."
                );

                return;
            }


            var fd =
                new FormData(
                    this
                );


            fetch(
                '@Url.Action(
                    "SaveJusticeMeeting",
                    "Orders",
                    new { area = "Setting" }
                )',
                {
                    method:
                        "POST",

                    body:
                        fd
                }
            )
            .then(
                async function (response) {

                    var raw =
                        await response.text();


                    var result;


                    try
                    {
                        result =
                            JSON.parse(raw);
                    }
                    catch (ex)
                    {
                        throw new Error(
                            "پاسخ نامعتبر از سرور: "
                            +
                            raw.substring(
                                0,
                                500
                            )
                        );
                    }


                    return result;
                }
            )
            .then(
                function (result) {

                    if (!result.success)
                    {
                        alert(
                            result.message
                            ||
                            "ثبت جلسه انجام نشد."
                        );

                        return;
                    }


                    alert(
                        result.message
                        ||
                        "جلسه با موفقیت ثبت شد."
                    );


                    /*
                     * همان Stage مجدداً باز شود
                     */
                    window.location.href =
                        '@Url.Action(
                            "JusticeWorkflowMembers",
                            "Orders",
                            new { area = "Setting" }
                        )'
                        +
                        "?workflowId="
                        +
                        encodeURIComponent(
                            currentWorkflowId
                        )
                        +
                        "&stageId="
                        +
                        encodeURIComponent(
                            currentStageId
                        );

                }
            )
            .catch(
                function (error) {

                    console.error(
                        error
                    );


                    alert(
                        error.message
                        ||
                        "خطا در ارتباط با سرور."
                    );

                }
            );

        }
    );

</script>
@using SaabWebProject.Models.DomainModels
@using System.Globalization
@using System.Linq
@using System.Collections.Generic

@model List<JBP_CaseMeetings>

@{
    ViewBag.Title = "جلسات من";
    Layout = "~/Views/Shared/_Layout.cshtml";


    var cases =
        ViewBag.Cases as
        List<JBP_Cases>
        ??
        new List<JBP_Cases>();


    var participations =
        ViewBag.MyParticipations as
        List<JBP_CaseMeetingParticipants>
        ??
        new List<JBP_CaseMeetingParticipants>();


    var stages =
        ViewBag.Stages as
        List<JBP_WorkflowStages>
        ??
        new List<JBP_WorkflowStages>();


    DateTime now =
        ViewBag.CurrentDateTime != null
            ?
            (DateTime)ViewBag.CurrentDateTime
            :
            DateTime.Now;


    var pc =
        new PersianCalendar();


    int totalMeetings =
        Model != null
            ?
            Model.Count
            :
            0;


    int futureMeetings =
        Model != null
            ?
            Model.Count(x =>
                x.MeetingDateTime >= now
                &&
                x.StatusCode == 1
            )
            :
            0;


    int onlineMeetings =
        Model != null
            ?
            Model.Count(x =>
                x.MeetingType == 2
                &&
                x.MeetingDateTime >= now
                &&
                x.StatusCode == 1
            )
            :
            0;
}


<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .jm-page {
        direction: rtl;
        min-height: calc(100vh - 65px);
        padding: 14px;
        color: #fff;
        background: radial-gradient( circle at 8% 8%, rgba(0,220,255,.14), transparent 27% ), radial-gradient( circle at 90% 12%, rgba(124,72,255,.16), transparent 30% ), linear-gradient( 135deg, #06101d, #0a1930 50%, #07111f );
    }


    .jm-container {
        max-width: 1550px;
        margin: auto;
    }


    /* =========================================================
       GLASS
       ========================================================= */

    .jm-glass {
        background: linear-gradient( 135deg, rgba(255,255,255,.09), rgba(255,255,255,.035) );
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 18px 45px rgba(0,0,0,.25);
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .jm-header {
        min-height: 65px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }


    .jm-header-main {
        display: flex;
        align-items: center;
        gap: 11px;
    }


    .jm-header-icon {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        background: linear-gradient( 135deg, #00c1dd, #087cff );
        box-shadow: 0 0 24px rgba(0,200,255,.23);
    }


    .jm-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
    }


    .jm-header p {
        margin: 4px 0 0;
        font-size: 10px;
        color: rgba(255,255,255,.50);
    }


    /* =========================================================
       BUTTON
       ========================================================= */

    .jm-btn {
        min-height: 38px;
        padding: 0 14px;
        border-radius: 11px;
        border: 1px solid rgba(255,255,255,.10);
        background: rgba(255,255,255,.06);
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        transition: .2s;
    }


        .jm-btn:hover {
            color: white;
            transform: translateY(-1px);
            border-color: rgba(0,215,255,.30);
        }


    /* =========================================================
       SUMMARY
       ========================================================= */

    .jm-summary {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 8px;
        margin-bottom: 10px;
    }


    .jm-stat {
        padding: 12px 14px;
        position: relative;
        overflow: hidden;
    }


        .jm-stat::before {
            content: "";
            position: absolute;
            width: 85px;
            height: 85px;
            left: -25px;
            top: -25px;
            border-radius: 50%;
            background: rgba(0,210,255,.07);
        }


    .jm-stat-title {
        color: rgba(255,255,255,.48);
        font-size: 9px;
    }


    .jm-stat-number {
        margin-top: 4px;
        color: #82eaff;
        font-size: 21px;
        font-weight: 900;
    }


    /* =========================================================
       SEARCH BAR
       ========================================================= */

    .jm-tools {
        padding: 9px;
        margin-bottom: 8px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 7px;
    }


    .jm-control {
        width: 100%;
        height: 38px;
        box-sizing: border-box;
        padding: 7px 10px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(255,255,255,.05);
        color: white;
        outline: none;
        font-size: 9px;
        transition: .2s;
    }


        .jm-control::placeholder {
            color: rgba(255,255,255,.28);
        }


        .jm-control:focus {
            border-color: rgba(0,215,255,.65);
            box-shadow: 0 0 0 3px rgba(0,210,255,.06);
        }


    .jm-clear {
        min-width: 95px;
        border: 0;
        border-radius: 10px;
        color: white;
        cursor: pointer;
        background: linear-gradient( 135deg, #7757ff, #a94cff );
        font-size: 9px;
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .jm-table-card {
        padding: 10px;
    }


    .jm-table-wrap {
        overflow-x: auto;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,.055);
    }


    .jm-table {
        width: 100%;
        min-width: 1250px;
        border-collapse: collapse;
    }


        .jm-table thead {
            background: rgba(0,210,255,.035);
        }


        .jm-table th {
            padding: 8px 7px;
            text-align: right;
            color: #83eaff;
            border-bottom: 1px solid rgba(255,255,255,.07);
            font-size: 8px;
            white-space: nowrap;
        }


        .jm-table td {
            padding: 9px 7px;
            border-bottom: 1px solid rgba(255,255,255,.045);
            vertical-align: middle;
            font-size: 8px;
        }


        .jm-table tbody tr {
            transition: .18s;
        }


            .jm-table tbody tr:hover {
                background: rgba(0,210,255,.025);
            }


    /* =========================================================
       COLUMN SEARCH
       ========================================================= */

    .jm-filter-row th {
        padding: 5px 4px 7px;
    }


    .jm-column-filter {
        width: 100%;
        min-width: 75px;
        height: 29px;
        box-sizing: border-box;
        padding: 3px 6px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(2,14,27,.40);
        color: #fff;
        outline: none;
        font-size: 7px;
    }


        .jm-column-filter::placeholder {
            color: rgba(255,255,255,.25);
        }


        .jm-column-filter:focus {
            border-color: rgba(0,210,255,.42);
        }


    select.jm-column-filter option {
        background: #102039;
        color: white;
    }


    /* =========================================================
       CASE
       ========================================================= */

    .jm-case-number {
        color: #7feaff;
        font-weight: 900;
        font-size: 8px;
    }


    .jm-case-title {
        max-width: 230px;
        margin-top: 3px;
        color: rgba(255,255,255,.46);
        font-size: 7px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* =========================================================
       MEETING TITLE
       ========================================================= */

    .jm-meeting-title {
        max-width: 220px;
        font-weight: 900;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* =========================================================
       DATE
       ========================================================= */

    .jm-date {
        color: #7feaff;
        direction: ltr;
        text-align: right;
        white-space: nowrap;
    }


    .jm-time {
        font-weight: 900;
        color: #fff;
        direction: ltr;
        white-space: nowrap;
    }


    /* =========================================================
       BADGES
       ========================================================= */

    .jm-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 7px;
        border-radius: 12px;
        font-size: 7px;
        white-space: nowrap;
    }


    .jm-badge-online {
        color: #d5b1ff;
        background: rgba(161,86,255,.10);
        border: 1px solid rgba(161,86,255,.15);
    }


    .jm-badge-local {
        color: #7feaff;
        background: rgba(0,210,255,.08);
        border: 1px solid rgba(0,210,255,.15);
    }


    .jm-status-plan {
        color: #79eaff;
        background: rgba(0,210,255,.08);
    }


    .jm-status-done {
        color: #5fecb5;
        background: rgba(0,210,150,.08);
    }


    .jm-status-cancel {
        color: #ff8396;
        background: rgba(255,80,100,.08);
    }


    .jm-status-past {
        color: rgba(255,255,255,.45);
        background: rgba(255,255,255,.05);
    }


    /* =========================================================
       LINK
       ========================================================= */

    .jm-online-link {
        display: inline-flex;
        min-height: 27px;
        align-items: center;
        justify-content: center;
        padding: 0 8px;
        border-radius: 8px;
        color: #b798ff;
        background: rgba(160,90,255,.07);
        border: 1px solid rgba(160,90,255,.14);
        text-decoration: none;
        font-size: 7px;
        white-space: nowrap;
    }


        .jm-online-link:hover {
            color: white;
            background: rgba(160,90,255,.15);
        }


    /* =========================================================
       LOCATION
       ========================================================= */

    .jm-location {
        max-width: 180px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        color: rgba(255,255,255,.67);
    }


    /* =========================================================
       NO RESULT
       ========================================================= */

    .jm-empty {
        padding: 30px !important;
        text-align: center;
        color: rgba(255,255,255,.40);
    }


    .jm-no-search-result {
        display: none;
        padding: 18px;
        text-align: center;
        color: rgba(255,255,255,.42);
        font-size: 9px;
    }


    /* =========================================================
       UPCOMING
       ========================================================= */

    .jm-upcoming-row {
        box-shadow: inset -3px 0 0 rgba(0,210,255,.35);
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media(max-width:800px) {

        .jm-summary {
            grid-template-columns: 1fr;
        }


        .jm-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .jm-tools {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="jm-page">

    <div class="jm-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="jm-glass jm-header">

            <div class="jm-header-main">

                <div class="jm-header-icon">
                    📅
                </div>


                <div>

                    <h2>
                        جلسات من
                    </h2>

                    <p>
                        فهرست جلساتی که شما به عنوان شرکت‌کننده در آنها حضور دارید
                    </p>

                </div>

            </div>


            <a href="@Url.Action(
                     "JusticeDashboard",
                     "Orders",
                     new { area = "Setting" }
                 )"
               class="jm-btn">

                ← بازگشت به داشبورد

            </a>

        </div>



        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="jm-summary">


            <div class="jm-glass jm-stat">

                <div class="jm-stat-title">
                    کل جلسات من
                </div>

                <div class="jm-stat-number">
                    @totalMeetings
                </div>

            </div>


            <div class="jm-glass jm-stat">

                <div class="jm-stat-title">
                    جلسات پیش‌رو
                </div>

                <div class="jm-stat-number">
                    @futureMeetings
                </div>

            </div>


            <div class="jm-glass jm-stat">

                <div class="jm-stat-title">
                    جلسات آنلاین پیش‌رو
                </div>

                <div class="jm-stat-number">
                    @onlineMeetings
                </div>

            </div>


        </div>



        <!-- =====================================================
             GLOBAL SEARCH
             ===================================================== -->

        <div class="jm-glass jm-tools">

            <input type="text"
                   id="globalMeetingSearch"
                   class="jm-control"
                   placeholder="جستجو در تمام اطلاعات جلسات..." />


            <button type="button"
                    id="clearMeetingSearch"
                    class="jm-clear">

                پاک کردن فیلترها

            </button>

        </div>



        <!-- =====================================================
             TABLE
             ===================================================== -->

        <div class="jm-glass jm-table-card">

            <div class="jm-table-wrap">

                <table class="jm-table"
                       id="meetingsTable">

                    <thead>

                        <!-- COLUMN TITLES -->

                        <tr>

                            <th>
                                ردیف
                            </th>

                            <th>
                                درخواست
                            </th>

                            <th>
                                عنوان جلسه
                            </th>

                            <th>
                                تاریخ
                            </th>

                            <th>
                                ساعت
                            </th>

                            <th>
                                نوع
                            </th>

                            <th>
                                مرحله ثبت
                            </th>

                            <th>
                                محل / لینک
                            </th>

                            <th>
                                وضعیت
                            </th>

                            <th>
                                وضعیت حضور
                            </th>

                        </tr>


                        <!-- COLUMN FILTERS -->

                        <tr class="jm-filter-row">

                            <th>
                            </th>


                            <th>

                                <input type="text"
                                       class="jm-column-filter"
                                       data-column="1"
                                       placeholder="جستجوی درخواست..." />

                            </th>


                            <th>

                                <input type="text"
                                       class="jm-column-filter"
                                       data-column="2"
                                       placeholder="عنوان جلسه..." />

                            </th>


                            <th>

                                <input type="text"
                                       class="jm-column-filter"
                                       data-column="3"
                                       placeholder="تاریخ..." />

                            </th>


                            <th>

                                <input type="text"
                                       class="jm-column-filter"
                                       data-column="4"
                                       placeholder="ساعت..." />

                            </th>


                            <th>

                                <select class="jm-column-filter"
                                        data-column="5">

                                    <option value="">
                                        همه
                                    </option>

                                    <option value="حضوری">
                                        حضوری
                                    </option>

                                    <option value="آنلاین">
                                        آنلاین
                                    </option>

                                </select>

                            </th>


                            <th>

                                <input type="text"
                                       class="jm-column-filter"
                                       data-column="6"
                                       placeholder="مرحله..." />

                            </th>


                            <th>

                                <input type="text"
                                       class="jm-column-filter"
                                       data-column="7"
                                       placeholder="محل / لینک..." />

                            </th>


                            <th>

                                <select class="jm-column-filter"
                                        data-column="8">

                                    <option value="">
                                        همه وضعیت‌ها
                                    </option>

                                    <option value="برنامه‌ریزی شده">
                                        برنامه‌ریزی شده
                                    </option>

                                    <option value="برگزار شده">
                                        برگزار شده
                                    </option>

                                    <option value="لغو شده">
                                        لغو شده
                                    </option>

                                </select>

                            </th>


                            <th>

                                <select class="jm-column-filter"
                                        data-column="9">

                                    <option value="">
                                        همه
                                    </option>

                                    <option value="نامشخص">
                                        نامشخص
                                    </option>

                                    <option value="حاضر">
                                        حاضر
                                    </option>

                                    <option value="غایب">
                                        غایب
                                    </option>

                                </select>

                            </th>

                        </tr>

                    </thead>


                    <tbody id="meetingsTableBody">

                        @if (
                            Model != null
                            &&
                            Model.Any()
                        )
                        {
                            int row =
                                0;


                            foreach (
                                var meeting
                                in Model
                            )
                            {
                                row++;


                                /* =========================================
                                   CASE
                                   ========================================= */

                                var caseItem =
                                    meeting.FK_Case.HasValue
                                        ?
                                        cases.FirstOrDefault(x =>
                                            x.CaseID ==
                                            meeting.FK_Case.Value
                                        )
                                        :
                                        null;


                                /* =========================================
                                   PARTICIPATION
                                   ========================================= */

                                var participation =
                                    participations
                                    .FirstOrDefault(x =>
                                        x.FK_Meeting ==
                                        meeting.MeetingID
                                    );


                                /* =========================================
                                   STAGE
                                   ========================================= */

                                var stage =
                                    meeting.FK_Stage.HasValue
                                        ?
                                        stages.FirstOrDefault(x =>
                                            x.StageID ==
                                            meeting.FK_Stage.Value
                                        )
                                        :
                                        null;


                                /* =========================================
                                   PERSIAN DATE
                                   ========================================= */

                                string persianDate =
                                    pc.GetYear(
                                        meeting.MeetingDateTime
                                    ).ToString("0000")
                                    +
                                    "/"
                                    +
                                    pc.GetMonth(
                                        meeting.MeetingDateTime
                                    ).ToString("00")
                                    +
                                    "/"
                                    +
                                    pc.GetDayOfMonth(
                                        meeting.MeetingDateTime
                                    ).ToString("00");


                                string meetingTime =
                                    meeting.MeetingDateTime
                                    .ToString("HH:mm");


                                /* =========================================
                                   MEETING STATUS
                                   ========================================= */

                                string statusText =
                                    "نامشخص";


                                string statusClass =
                                    "jm-status-past";


                                if (
                                    meeting.StatusCode == 1
                                )
                                {
                                    statusText =
                                        "برنامه‌ریزی شده";

                                    statusClass =
                                        "jm-status-plan";
                                }
                                else if (
                                    meeting.StatusCode == 2
                                )
                                {
                                    statusText =
                                        "برگزار شده";

                                    statusClass =
                                        "jm-status-done";
                                }
                                else if (
                                    meeting.StatusCode == 3
                                )
                                {
                                    statusText =
                                        "لغو شده";

                                    statusClass =
                                        "jm-status-cancel";
                                }


                                /* =========================================
                                   ATTENDANCE
                                   ========================================= */

                                string attendanceText =
                                    "نامشخص";


                                if (participation != null)
                                {
                                    if (
                                        participation.AttendanceStatus == 1
                                    )
                                    {
                                        attendanceText =
                                            "حاضر";
                                    }
                                    else if (
                                        participation.AttendanceStatus == 2
                                    )
                                    {
                                        attendanceText =
                                            "غایب";
                                    }
                                }


                                bool upcoming =
                                    meeting.MeetingDateTime >= now
                                    &&
                                    meeting.StatusCode == 1;


                                <tr class="meeting-row @(upcoming ? "jm-upcoming-row" : "")">


                                    <!-- ROW -->

                                    <td>
                                        @row
                                    </td>


                                    <!-- CASE -->

                                    <td>

                                        @if (caseItem != null)
                                        {
                                            <div class="jm-case-number">
                                                @caseItem.CaseNumber
                                            </div>

                                            <div class="jm-case-title"
                                                 title="@caseItem.Title">

                                                @caseItem.Title

                                            </div>
                                        }
                                        else
                                        {
                                            <span style="
                                        color:rgba(255,255,255,.30);
                                    ">
                                                بدون درخواست
                                            </span>
                                        }

                                    </td>


                                    <!-- TITLE -->

                                    <td>

                                        <div class="jm-meeting-title"
                                             title="@meeting.Title">

                                            @meeting.Title

                                        </div>

                                    </td>


                                    <!-- DATE -->

                                    <td class="jm-date">
                                        @persianDate
                                    </td>


                                    <!-- TIME -->

                                    <td class="jm-time">
                                        @meetingTime
                                    </td>


                                    <!-- TYPE -->

                                    <td>

                                        @if (
                                            meeting.MeetingType == 2
                                        )
                                        {
                                            <span class="
                                        jm-badge
                                        jm-badge-online
                                    ">
                                                آنلاین
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="
                                        jm-badge
                                        jm-badge-local
                                    ">
                                                حضوری
                                            </span>
                                        }

                                    </td>


                                    <!-- STAGE -->

                                    <td>

                                        @if (stage != null)
                                        {
                                            <span>
                                                @stage.StageOrder
                                                -
                                                @stage.Title
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="
                                        color:rgba(255,255,255,.30);
                                    ">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- LOCATION / ONLINE -->

                                    <td>

                                        @if (
                                            meeting.MeetingType == 2
                                        )
                                        {
                                            if (
                                                !string.IsNullOrWhiteSpace(
                                                    meeting.OnlineLink
                                                )
                                            )
                                            {
                                                <a href="@meeting.OnlineLink"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="jm-online-link">

                                                    ورود به جلسه آنلاین

                                                </a>
                                            }
                                            else
                                            {
                                                <span style="
                                            color:rgba(255,255,255,.30);
                                        ">
                                                    لینک ثبت نشده
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <div class="jm-location"
                                                 title="@meeting.Location">

                                                @meeting.Location

                                            </div>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span class="
                                    jm-badge
                                    @statusClass
                                ">
                                            @statusText
                                        </span>

                                    </td>


                                    <!-- ATTENDANCE -->

                                    <td>
                                        @attendanceText
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="10"
                                    class="jm-empty">

                                    شما در حال حاضر جلسه‌ای ندارید.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>


                <div id="noMeetingSearchResult"
                     class="jm-no-search-result">

                    جلسه‌ای با فیلترهای انتخاب‌شده پیدا نشد.

                </div>

            </div>

        </div>


    </div>

</div>



<script>

    /* =========================================================
       NORMALIZE
       ========================================================= */

    function normalizeMeetingText(value) {

        return (value || "")

            .toString()

            .replace(
                /[۰-۹]/g,
                function (c) {

                    return "۰۱۲۳۴۵۶۷۸۹"
                        .indexOf(c);

                }
            )

            .replace(
                /[٠-٩]/g,
                function (c) {

                    return "٠١٢٣٤٥٦٧٨٩"
                        .indexOf(c);

                }
            )

            .replace(
                /\s+/g,
                " "
            )

            .trim()

            .toLowerCase();
    }



    var table =
        document.getElementById(
            "meetingsTable"
        );


    var body =
        document.getElementById(
            "meetingsTableBody"
        );


    var globalSearch =
        document.getElementById(
            "globalMeetingSearch"
        );


    var columnFilters =
        document.querySelectorAll(
            ".jm-column-filter"
        );


    var noResult =
        document.getElementById(
            "noMeetingSearchResult"
        );



    /* =========================================================
       APPLY FILTERS
       ========================================================= */

    function applyMeetingFilters() {

        var rows =
            body.querySelectorAll(
                ".meeting-row"
            );


        var globalValue =
            normalizeMeetingText(
                globalSearch.value
            );


        var visibleCount =
            0;


        rows.forEach(
            function (row) {

                var cells =
                    row.querySelectorAll(
                        "td"
                    );


                var rowText =
                    normalizeMeetingText(
                        row.innerText
                    );


                var visible =
                    true;


                /* =============================================
                   GLOBAL SEARCH
                   ============================================= */

                if (
                    globalValue
                    &&
                    rowText.indexOf(
                        globalValue
                    ) === -1
                )
                {
                    visible =
                        false;
                }


                /* =============================================
                   COLUMN SEARCH
                   ============================================= */

                if (visible)
                {
                    columnFilters.forEach(
                        function (filter) {

                            if (!visible)
                                return;


                            var value =
                                normalizeMeetingText(
                                    filter.value
                                );


                            if (!value)
                                return;


                            var columnIndex =
                                parseInt(
                                    filter.getAttribute(
                                        "data-column"
                                    )
                                );


                            if (
                                isNaN(
                                    columnIndex
                                )
                            )
                            {
                                return;
                            }


                            var cell =
                                cells[
                                    columnIndex
                                ];


                            if (!cell)
                                return;


                            var cellText =
                                normalizeMeetingText(
                                    cell.innerText
                                );


                            if (
                                cellText.indexOf(
                                    value
                                ) === -1
                            )
                            {
                                visible =
                                    false;
                            }

                        }
                    );
                }


                row.style.display =
                    visible
                        ?
                        ""
                        :
                        "none";


                if (visible)
                {
                    visibleCount++;
                }

            }
        );


        if (
            rows.length > 0
            &&
            visibleCount === 0
        )
        {
            noResult.style.display =
                "block";
        }
        else
        {
            noResult.style.display =
                "none";
        }

    }



    /* =========================================================
       GLOBAL SEARCH EVENT
       ========================================================= */

    globalSearch.addEventListener(
        "input",
        applyMeetingFilters
    );



    /* =========================================================
       COLUMN EVENTS
       ========================================================= */

    columnFilters.forEach(
        function (filter) {

            filter.addEventListener(
                "input",
                applyMeetingFilters
            );


            filter.addEventListener(
                "change",
                applyMeetingFilters
            );

        }
    );



    /* =========================================================
       CLEAR FILTERS
       ========================================================= */

    document.getElementById(
        "clearMeetingSearch"
    ).addEventListener(
        "click",
        function () {

            globalSearch.value =
                "";


            columnFilters.forEach(
                function (filter) {

                    filter.value =
                        "";

                }
            );


            applyMeetingFilters();

        }
    );

</script>
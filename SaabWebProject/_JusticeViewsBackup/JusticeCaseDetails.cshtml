@using SaabWebProject.Models.DomainModels
@using System.Linq
@using System.Collections.Generic

@model JBP_Cases

@{
    ViewBag.Title = "جزئیات درخواست";
    Layout = "~/Views/Shared/_Layout.cshtml";


    string category =
        ViewBag.Category as string;


    string statusTitle =
        ViewBag.StatusTitle as string;


    var currentStage =
        ViewBag.CurrentStage as
        JBP_WorkflowStages;


    var stages =
        ViewBag.Stages as
        List<JBP_WorkflowStages>
        ??
        new List<JBP_WorkflowStages>();


    var attachments =
        ViewBag.Attachments as
        List<JBP_CaseAttachments>
        ??
        new List<JBP_CaseAttachments>();


    var responses =
        ViewBag.Responses as
        List<JBP_CaseResponses>
        ??
        new List<JBP_CaseResponses>();


    var responseAttachments =
        ViewBag.ResponseAttachments as
        List<JBP_CaseAttachments>
        ??
        new List<JBP_CaseAttachments>();


    var appeals =
        ViewBag.Appeals as
        List<JBP_CaseAppeals>
        ??
        new List<JBP_CaseAppeals>();


    var appealAttachments =
        ViewBag.AppealAttachments as
        List<JBP_CaseAttachments>
        ??
        new List<JBP_CaseAttachments>();


    var users =
        ViewBag.RelatedUsers as
        List<tbUsers>
        ??
        new List<tbUsers>();


    bool canDecide =
        ViewBag.CanDecideResponse != null
        &&
        Convert.ToBoolean(
            ViewBag.CanDecideResponse
        );
}


<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .cd-page {
        direction: rtl;
        min-height: calc(100vh - 70px);
        padding: 15px;
        color: white;
        background: radial-gradient( circle at 10% 5%, rgba(0,220,255,.13), transparent 28% ), radial-gradient( circle at 90% 12%, rgba(125,70,255,.15), transparent 30% ), linear-gradient( 135deg, #06101d, #0a1930, #07111f );
    }


    .cd-container {
        max-width: 1450px;
        margin: auto;
    }


    /* =========================================================
       GLASS
       ========================================================= */

    .glass {
        background: linear-gradient( 135deg, rgba(255,255,255,.09), rgba(255,255,255,.035) );
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 18px 45px rgba(0,0,0,.25);
    }


    .cd-card {
        padding: 12px;
        margin-bottom: 9px;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .cd-head {
        min-height: 62px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        position: relative;
        overflow: hidden;
    }


        .cd-head::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -80px;
            top: -110px;
            border-radius: 50%;
            background: rgba(0,218,255,.10);
            filter: blur(25px);
            pointer-events: none;
        }


        .cd-head::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            left: -70px;
            bottom: -100px;
            border-radius: 50%;
            background: rgba(128,80,255,.10);
            filter: blur(25px);
            pointer-events: none;
        }


    .cd-head-main {
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
        z-index: 2;
        min-width: 0;
    }


    .cd-case-icon {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 20px;
        background: linear-gradient( 135deg, #00c7df, #087cff );
        box-shadow: 0 0 25px rgba(0,210,255,.25);
    }


    .cd-head-title {
        min-width: 0;
    }


        .cd-head-title h2 {
            margin: 0;
            color: #fff;
            font-size: 17px;
            font-weight: 900;
        }


    .cd-head-subtitle {
        max-width: 500px;
        margin-top: 4px;
        color: rgba(255,255,255,.48);
        font-size: 9px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .cd-head-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        position: relative;
        z-index: 2;
    }


    .cd-status-top {
        padding: 7px 10px;
        border-radius: 10px;
        color: #88ecff;
        font-size: 8px;
        white-space: nowrap;
        background: rgba(0,210,255,.065);
        border: 1px solid rgba(0,210,255,.14);
    }


        .cd-status-top strong {
            color: white;
        }


    .cd-back {
        padding: 7px 11px;
        border-radius: 10px;
        color: white;
        text-decoration: none;
        white-space: nowrap;
        background: rgba(255,255,255,.055);
        border: 1px solid rgba(255,255,255,.10);
        transition: .2s;
    }


        .cd-back:hover {
            color: white;
            transform: translateY(-1px);
            border-color: rgba(0,220,255,.25);
            background: rgba(0,210,255,.07);
        }



    /* =========================================================
       WORKFLOW STEPPER
       ========================================================= */

    .justice-stepper {
        margin-bottom: 9px;
        padding: 15px 16px;
        position: relative;
        overflow: hidden;
    }


        .justice-stepper::before {
            content: "";
            position: absolute;
            width: 200px;
            height: 200px;
            right: -100px;
            top: -120px;
            border-radius: 50%;
            background: rgba(0,215,255,.08);
            filter: blur(30px);
            pointer-events: none;
        }


        .justice-stepper::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            left: -100px;
            bottom: -130px;
            border-radius: 50%;
            background: rgba(129,78,255,.08);
            filter: blur(30px);
            pointer-events: none;
        }


    .justice-stepper-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 17px;
        position: relative;
        z-index: 3;
    }


    .justice-stepper-title {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #8ceeff;
        font-size: 11px;
        font-weight: 900;
    }


    .justice-current-caption {
        padding: 5px 10px;
        border-radius: 14px;
        color: #9cf1ff;
        font-size: 8px;
        background: rgba(0,210,255,.07);
        border: 1px solid rgba(0,210,255,.14);
    }


        .justice-current-caption strong {
            color: white;
        }


    .justice-stepper-scroll {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 14px 2px 6px;
        position: relative;
        z-index: 3;
    }


        .justice-stepper-scroll::-webkit-scrollbar {
            height: 5px;
        }


        .justice-stepper-scroll::-webkit-scrollbar-track {
            background: rgba(255,255,255,.025);
            border-radius: 20px;
        }


        .justice-stepper-scroll::-webkit-scrollbar-thumb {
            background: linear-gradient( 90deg, rgba(0,210,255,.30), rgba(125,75,255,.30) );
            border-radius: 20px;
        }


    .justice-stepper-inner {
        display: flex;
        align-items: flex-start;
        min-width: max-content;
        position: relative;
        direction: rtl;
    }


    /* =========================================================
       STEP
       ========================================================= */

    .justice-step {
        width: 145px;
        min-width: 145px;
        position: relative;
        text-align: center;
        z-index: 2;
    }


        /*
       خط بین مراحل
    */

        .justice-step:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 18px;
            left: -50%;
            width: 100%;
            height: 3px;
            border-radius: 20px;
            background: rgba(255,255,255,.085);
            z-index: -1;
        }


    /* =========================================================
       STEP CIRCLE
       ========================================================= */

    .justice-step-circle {
        width: 38px;
        height: 38px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 3;
        border-radius: 50%;
        color: rgba(255,255,255,.38);
        font-size: 10px;
        font-weight: 900;
        background: rgba(255,255,255,.045);
        border: 2px solid rgba(255,255,255,.10);
        box-shadow: 0 0 0 5px rgba(255,255,255,.015);
        transition: .25s;
    }


    .justice-step-title {
        max-width: 125px;
        margin: 8px auto 0;
        color: rgba(255,255,255,.35);
        font-size: 8px;
        line-height: 1.7;
        font-weight: 700;
        transition: .2s;
    }



    /* =========================================================
       COMPLETED STAGE
       ========================================================= */

    .justice-step.completed
    .justice-step-circle {
        color: #d9fff1;
        border-color: rgba(0,225,155,.55);
        background: linear-gradient( 135deg, rgba(0,190,130,.30), rgba(0,220,160,.15) );
        box-shadow: 0 0 15px rgba(0,220,155,.15), 0 0 0 5px rgba(0,210,145,.025);
    }


    .justice-step.completed
    .justice-step-title {
        color: rgba(180,255,225,.75);
    }


    .justice-step.completed:not(:last-child)::after {
        background: linear-gradient( 90deg, rgba(0,220,160,.65), rgba(0,210,255,.38) );
        box-shadow: 0 0 8px rgba(0,210,180,.08);
    }



    /* =========================================================
       CURRENT STAGE
       ========================================================= */

    .justice-step.current
    .justice-step-circle {
        color: #fff;
        border-color: #45eaff;
        background: linear-gradient( 135deg, #00c8df, #087cff );
        box-shadow: 0 0 9px rgba(0,225,255,.75), 0 0 25px rgba(0,190,255,.38), 0 0 0 6px rgba(0,210,255,.07);
        animation: justiceCurrentPulse 1.8s infinite;
    }


    .justice-step.current
    .justice-step-title {
        color: #8ceeff;
        font-size: 9px;
        font-weight: 900;
        text-shadow: 0 0 8px rgba(0,220,255,.25);
    }


    .justice-step.current::before {
        content: "مرحله جاری";
        position: absolute;
        top: -18px;
        right: 50%;
        transform: translateX(50%);
        padding: 2px 7px;
        border-radius: 8px;
        color: #8fefff;
        background: rgba(0,210,255,.08);
        border: 1px solid rgba(0,210,255,.14);
        font-size: 6px;
        white-space: nowrap;
    }


    @@keyframes justiceCurrentPulse {

        0% {
            box-shadow: 0 0 7px rgba(0,225,255,.55), 0 0 18px rgba(0,190,255,.22), 0 0 0 5px rgba(0,210,255,.05);
        }


        50% {
            box-shadow: 0 0 13px rgba(0,225,255,.90), 0 0 32px rgba(0,190,255,.42), 0 0 0 8px rgba(0,210,255,.08);
        }


        100% {
            box-shadow: 0 0 7px rgba(0,225,255,.55), 0 0 18px rgba(0,190,255,.22), 0 0 0 5px rgba(0,210,255,.05);
        }
    }



    /* =========================================================
       FUTURE STAGE
       ========================================================= */

    .justice-step.future
    .justice-step-circle {
        opacity: .52;
    }


    .justice-step.future
    .justice-step-title {
        opacity: .58;
    }


    .justice-step.completed:hover
    .justice-step-circle,
    .justice-step.current:hover
    .justice-step-circle {
        transform: translateY(-2px) scale(1.06);
    }



    /* =========================================================
       INFORMATION
       ========================================================= */

    .cd-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 7px;
    }


    .info {
        padding: 9px;
        border-radius: 11px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.035);
        transition: .2s;
    }


        .info:hover {
            background: rgba(0,210,255,.035);
            border-color: rgba(0,210,255,.10);
        }


    .label {
        color: #82eaff;
        font-size: 8px;
    }


    .value {
        margin-top: 4px;
        font-size: 10px;
        font-weight: 800;
    }


    .full {
        grid-column: 1 / -1;
    }



    /* =========================================================
       SECTION TITLE
       ========================================================= */

    .section-title {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 9px;
        color: #82eaff;
        font-size: 11px;
        font-weight: 900;
    }



    /* =========================================================
       FILES
       ========================================================= */

    .files {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 7px;
    }


    .file {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 8px;
        border-radius: 8px;
        color: #8aeaff;
        text-decoration: none;
        font-size: 8px;
        background: rgba(0,210,255,.06);
        border: 1px solid rgba(0,210,255,.12);
        transition: .2s;
    }


        .file:hover {
            color: white;
            transform: translateY(-1px);
            background: rgba(0,210,255,.12);
            border-color: rgba(0,210,255,.27);
        }


    .empty-text {
        padding: 9px;
        color: rgba(255,255,255,.38);
        font-size: 9px;
        border-radius: 10px;
        background: rgba(255,255,255,.02);
    }



    /* =========================================================
       RESPONSE
       ========================================================= */

    .response {
        padding: 10px;
        margin-bottom: 7px;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, rgba(255,255,255,.035), rgba(255,255,255,.018) );
        border: 1px solid rgba(255,255,255,.055);
    }


        .response::before {
            content: "";
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient( #00d4ff, #785cff );
        }


    .response-meta {
        margin-bottom: 6px;
        color: rgba(255,255,255,.42);
        font-size: 8px;
    }


    .response-text {
        color: rgba(255,255,255,.90);
        line-height: 2;
        white-space: pre-wrap;
        font-size: 10px;
    }



    /* =========================================================
       DECISION
       ========================================================= */

    .decision {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
    }


    .decision-box {
        padding: 13px;
        border-radius: 14px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.06);
    }


        .decision-box h4 {
            margin: 0 0 7px;
            font-size: 11px;
        }


    .accept-box {
        border-color: rgba(0,215,150,.12);
        background: linear-gradient( 135deg, rgba(0,210,140,.035), rgba(255,255,255,.02) );
    }


    .reject-box {
        border-color: rgba(255,80,125,.12);
        background: linear-gradient( 135deg, rgba(220,60,100,.035), rgba(130,60,255,.025) );
    }


    .decision-note {
        color: rgba(255,255,255,.50);
        font-size: 9px;
        line-height: 1.9;
    }



    /* =========================================================
       TEXTAREA
       ========================================================= */

    textarea {
        width: 100%;
        min-height: 110px;
        box-sizing: border-box;
        padding: 9px 10px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(255,255,255,.05);
        color: white;
        outline: none;
        resize: vertical;
        line-height: 1.9;
    }


        textarea::placeholder {
            color: rgba(255,255,255,.30);
        }


        textarea:focus {
            border-color: rgba(0,215,255,.55);
            box-shadow: 0 0 0 3px rgba(0,210,255,.06);
        }



    /* =========================================================
       UPLOAD
       ========================================================= */

    .upload-area {
        margin-top: 8px;
        padding: 9px;
        border-radius: 10px;
        background: rgba(0,210,255,.025);
        border: 1px dashed rgba(0,210,255,.18);
    }


    .upload-title {
        margin-bottom: 5px;
        color: rgba(255,255,255,.75);
        font-size: 9px;
    }


    input[type="file"] {
        width: 100%;
        color: rgba(255,255,255,.62);
        font-size: 8px;
    }



    /* =========================================================
       BUTTONS
       ========================================================= */

    .btn {
        min-height: 38px;
        margin-top: 8px;
        padding: 0 15px;
        border: 0;
        border-radius: 10px;
        color: white;
        cursor: pointer;
        font-family: inherit;
        transition: .2s;
    }


        .btn:hover {
            transform: translateY(-1px);
        }


    .accept {
        background: linear-gradient( 135deg, #00aa74, #00d59b );
        box-shadow: 0 0 20px rgba(0,210,150,.12);
    }


    .reject {
        background: linear-gradient( 135deg, #dd4662, #a92dff );
        box-shadow: 0 0 20px rgba(220,70,110,.12);
    }



    /* =========================================================
       CASE MESSAGE
       ========================================================= */

    .case-message {
        padding: 11px;
        color: rgba(255,255,255,.65);
        font-size: 9px;
        line-height: 1.9;
        border-radius: 11px;
        background: rgba(0,210,255,.035);
        border: 1px solid rgba(0,210,255,.08);
    }



    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media(max-width:1000px) {

        .cd-head {
            flex-direction: column;
            align-items: stretch;
        }


        .cd-head-actions {
            justify-content: space-between;
        }


        .cd-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }


    @@media(max-width:750px) {

        .cd-page {
            padding: 9px;
        }


        .cd-grid,
        .decision {
            grid-template-columns: 1fr;
        }


        .full {
            grid-column: auto;
        }


        .justice-stepper {
            padding: 13px 8px;
        }


        .justice-step {
            width: 115px;
            min-width: 115px;
        }


        .justice-step-title {
            max-width: 100px;
        }


        .justice-stepper-head {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>



<div class="cd-page">

    <div class="cd-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="glass cd-card cd-head">


            <div class="cd-head-main">


                <div class="cd-case-icon">

                    📄

                </div>


                <div class="cd-head-title">

                    <h2>

                        @Model.CaseNumber

                    </h2>


                    <div class="cd-head-subtitle"
                         title="@Model.Title">

                        @Model.Title

                    </div>

                </div>


            </div>



            <div class="cd-head-actions">


                <div class="cd-status-top">

                    وضعیت:

                    <strong>

                        @(string.IsNullOrWhiteSpace(
                        statusTitle
                    )
                        ?
                        "نامشخص"
                        :
                        statusTitle)

                    </strong>

                </div>


                <a href="@Url.Action(
                         "MyJusticeCases",
                         "Orders",
                         new
                         {
                             area = "Setting"
                         }
                     )"
                   class="cd-back">

                    ← بازگشت

                </a>


            </div>


        </div>



        <!-- =====================================================
             WORKFLOW STEPPER
             ===================================================== -->

        <div class="glass justice-stepper">


            <div class="justice-stepper-head">


                <div class="justice-stepper-title">

                    ⚡ مسیر رسیدگی پرونده

                </div>


                @if (currentStage != null)
                {

                    <div class="justice-current-caption">

                        اکنون در:

                        <strong>

                            @currentStage.Title

                        </strong>

                    </div>

                }


            </div>



            <div class="justice-stepper-scroll">


                <div class="justice-stepper-inner">


                    @if (
                        stages != null
                        &&
                        stages.Any()
                    )
                    {

                        foreach (
                            var stageItem
                            in stages
                            .OrderBy(x =>
                                x.StageOrder
                            )
                        )
                        {

                            bool isCompleted =
                                currentStage != null
                                &&
                                stageItem.StageOrder
                                <
                                currentStage.StageOrder;


                            bool isCurrent =
                                currentStage != null
                                &&
                                stageItem.StageOrder
                                ==
                                currentStage.StageOrder;


                            bool isFuture =
                                currentStage == null
                                ||
                                stageItem.StageOrder
                                >
                                currentStage.StageOrder;


                            string stepClass =
                                isCurrent
                                    ?
                                    "current"
                                    :
                                    (
                                        isCompleted
                                            ?
                                            "completed"
                                            :
                                            "future"
                                    );


                            <div class="
                            justice-step
                            @stepClass
                        ">


                                <div class="justice-step-circle">


                                    @if (isCompleted)
                                    {

                                        <span>
                                            ✓
                                        </span>

                                    }
                                    else
                                    {

                                        @stageItem.StageOrder

                                    }


                                </div>



                                <div class="justice-step-title">

                                    @stageItem.Title

                                </div>


                            </div>

                        }

                    }
                    else
                    {

                        <div style="
                        width:100%;
                        padding:15px;
                        color:rgba(255,255,255,.38);
                        text-align:center;
                        font-size:9px;
                    ">

                            مراحل گردش کار برای این پرونده یافت نشد.

                        </div>

                    }


                </div>


            </div>


        </div>



        <!-- =====================================================
             CASE INFORMATION
             ===================================================== -->

        <div class="glass cd-card">


            <div class="section-title">

                📋 اطلاعات درخواست

            </div>


            <div class="cd-grid">


                <div class="info">

                    <div class="label">

                        موضوع

                    </div>


                    <div class="value">

                        @(string.IsNullOrWhiteSpace(
                        category
                    )
                        ?
                        "-"
                        :
                        category)

                    </div>

                </div>



                <div class="info">

                    <div class="label">

                        وضعیت

                    </div>


                    <div class="value">

                        @(string.IsNullOrWhiteSpace(
                        statusTitle
                    )
                        ?
                        "-"
                        :
                        statusTitle)

                    </div>

                </div>



                <div class="info">

                    <div class="label">

                        مرحله جاری

                    </div>


                    <div class="value">


                        @if (currentStage != null)
                        {

                            <span style="
                            color:#85edff;
                        ">

                                @currentStage.StageOrder

                                -

                                @currentStage.Title

                            </span>

                        }
                        else
                        {

                            <span>
                                -
                            </span>

                        }


                    </div>

                </div>



                <div class="info">

                    <div class="label">

                        مبلغ مورد اختلاف

                    </div>


                    <div class="value">

                        @(Model.DisputedAmount.HasValue
                        ?
                        Model.DisputedAmount.Value
                            .ToString("N0")
                        :
                        "-")

                    </div>

                </div>



                <div class="info full">

                    <div class="label">

                        عنوان درخواست

                    </div>


                    <div class="value">

                        @Model.Title

                    </div>

                </div>



                <div class="info full">

                    <div class="label">

                        شرح درخواست

                    </div>


                    <div class="value"
                         style="
                        line-height:2;
                        white-space:pre-wrap;
                     ">

                        @Model.Description

                    </div>

                </div>


            </div>


        </div>



        <!-- =====================================================
             ORIGINAL FILES
             ===================================================== -->

        <div class="glass cd-card">


            <div class="section-title">

                📎 مستندات اولیه درخواست

            </div>


            @if (attachments.Any())
            {

                <div class="files">


                    @foreach (
                        var file
                        in attachments
                    )
                    {

                        <a class="file"
                           href="@Url.Action(
                           "DownloadJusticeAttachment",
                           "Orders",
                           new
                           {
                               area = "Setting",
                               id = file.AttachmentID
                           }
                       )">

                            📄

                            @file.RealFileName

                        </a>

                    }


                </div>

            }
            else
            {

                <div class="empty-text">

                    مستندی برای درخواست اولیه ثبت نشده است.

                </div>

            }


        </div>



        <!-- =====================================================
             RESPONSES
             ===================================================== -->

        <div class="glass cd-card">


            <div class="section-title">

                💬 پاسخ‌های ثبت‌شده

            </div>


            @if (responses.Any())
            {

                foreach (
                    var response
                    in responses
                )
                {

                    var responseUser =
                        users.FirstOrDefault(x =>
                            x.usr_ID ==
                            response.FK_User
                        );


                    string fullName =
                        responseUser == null
                            ?
                            "کارشناس"
                            :
                            (
                                (responseUser.usr_Name ?? "")
                                +
                                " "
                                +
                                (responseUser.usr_Family ?? "")
                            ).Trim();


                    var files =
                        response.AttachmentGroupID.HasValue
                            ?
                            responseAttachments
                            .Where(x =>
                                x.AttachmentGroupID ==
                                response.AttachmentGroupID
                            )
                            .ToList()
                            :
                            new List<JBP_CaseAttachments>();


                    <div class="response">


                        <div class="response-meta">

                            👤
                            @fullName

                            &nbsp; | &nbsp;

                            🕒
                            @response.CreatedAt
                            .ToString(
                            "yyyy/MM/dd HH:mm"
                            )

                        </div>



                        <div class="response-text">

                            @response.ResponseText

                        </div>



                        @if (files.Any())
                        {

                            <div class="files">


                                @foreach (
                                    var file
                                    in files
                                )
                                {

                                    <a class="file"
                                       href="@Url.Action(
                                       "DownloadJusticeAttachment",
                                       "Orders",
                                       new
                                       {
                                           area = "Setting",
                                           id = file.AttachmentID
                                       }
                                   )">

                                        📎
                                        @file.RealFileName

                                    </a>

                                }


                            </div>

                        }


                    </div>

                }

            }
            else
            {

                <div class="empty-text">

                    هنوز پاسخی برای این درخواست ثبت نشده است.

                </div>

            }


        </div>



        <!-- =====================================================
             APPEAL HISTORY
             ===================================================== -->

        @if (appeals.Any())
        {

            <div class="glass cd-card">


                <div class="section-title">

                    🔄 سوابق عدم پذیرش پاسخ و بازنگری

                </div>


                @foreach (
                    var appeal
                    in appeals
                )
                {

                    var appealUser =
                        users.FirstOrDefault(x =>
                            x.usr_ID ==
                            appeal.FK_User
                        );


                    string appealUserName =
                        appealUser == null
                            ?
                            "کاربر"
                            :
                            (
                                (appealUser.usr_Name ?? "")
                                +
                                " "
                                +
                                (appealUser.usr_Family ?? "")
                            ).Trim();


                    var files =
                        appeal.AttachmentGroupID.HasValue
                            ?
                            appealAttachments
                            .Where(x =>
                                x.AttachmentGroupID ==
                                appeal.AttachmentGroupID
                            )
                            .ToList()
                            :
                            new List<JBP_CaseAttachments>();


                    <div class="response">


                        <div class="response-meta">

                            👤
                            @appealUserName

                            &nbsp; | &nbsp;

                            🕒
                            @appeal.CreatedAt
                            .ToString(
                            "yyyy/MM/dd HH:mm"
                            )

                        </div>



                        <div class="response-text">

                            @appeal.Reason

                        </div>



                        @if (files.Any())
                        {

                            <div class="files">


                                @foreach (
                                    var file
                                    in files
                                )
                                {

                                    <a class="file"
                                       href="@Url.Action(
                                       "DownloadJusticeAttachment",
                                       "Orders",
                                       new
                                       {
                                           area = "Setting",
                                           id = file.AttachmentID
                                       }
                                   )">

                                        📎
                                        @file.RealFileName

                                    </a>

                                }


                            </div>

                        }


                    </div>

                }


            </div>

        }



        <!-- =====================================================
             DECISION
             ===================================================== -->

        @if (canDecide)
        {

            <div class="glass cd-card">


                <div class="section-title">

                    ⚖ تصمیم شما درباره پاسخ

                </div>


                <div class="decision">


                    <!-- ACCEPT -->

                    <div class="
                    decision-box
                    accept-box
                ">


                        <h4>

                            ✅ پاسخ مورد تأیید است

                        </h4>


                        <p class="decision-note">

                            در صورتی که پاسخ ارائه‌شده را می‌پذیرید،
                            پرونده پس از تأیید شما مختومه خواهد شد.

                        </p>


                        <form id="acceptForm">


                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="caseId"
                                   value="@Model.CaseID" />


                            <button type="submit"
                                    class="
                                    btn
                                    accept
                                ">

                                ✓ پذیرش پاسخ و خاتمه پرونده

                            </button>


                        </form>


                    </div>



                    <!-- REJECT -->

                    <div class="
                    decision-box
                    reject-box
                ">


                        <h4>

                            ❌ پاسخ را نمی‌پذیرم

                        </h4>


                        <p class="decision-note">

                            دلیل عدم پذیرش پاسخ را توضیح دهید.
                            در صورت نیاز می‌توانید مستندات تکمیلی
                            نیز بارگذاری نمایید.

                        </p>


                        <form id="appealForm"
                              enctype="multipart/form-data">


                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="caseId"
                                   value="@Model.CaseID" />


                            <textarea name="reason"
                                      id="appealReason"
                                      placeholder="دلیل عدم پذیرش پاسخ را به‌صورت کامل وارد کنید..."
                                      required></textarea>



                            <div class="upload-area">


                                <div class="upload-title">

                                    📎 مستندات تکمیلی

                                </div>


                                <input type="file"
                                       name="files"
                                       id="appealFiles"
                                       multiple />


                                <div style="
                                margin-top:5px;
                                color:rgba(255,255,255,.35);
                                font-size:7px;
                            ">

                                    حداکثر 10 فایل و هر فایل حداکثر 20 مگابایت

                                </div>


                            </div>



                            <button type="submit"
                                    class="
                                    btn
                                    reject
                                ">

                                ↻ عدم پذیرش و درخواست بازنگری

                            </button>


                        </form>


                    </div>


                </div>


            </div>

        }
        else
        {

            if (
                Model.StatusCode == 90
            )
            {

                <div class="glass cd-card">


                    <div class="case-message">

                        ✅ این پرونده مختومه شده است.

                    </div>


                </div>

            }

        }


    </div>

</div>



<script>

    /* =========================================================
       ACCEPT RESPONSE
       ========================================================= */

    var acceptForm =
        document.getElementById(
            "acceptForm"
        );


    if (acceptForm) {

        acceptForm.addEventListener(
            "submit",
            function (e) {

                e.preventDefault();


                if (
                    !confirm(
                        "آیا پاسخ را می‌پذیرید و پرونده بسته شود؟"
                    )
                ) {

                    return;

                }


                var submitButton =
                    this.querySelector(
                        "button[type='submit']"
                    );


                if (submitButton) {

                    submitButton.disabled =
                        true;

                    submitButton.innerText =
                        "در حال ثبت...";

                }


                fetch(
                    '@Url.Action(
                        "AcceptJusticeResponse",
                        "Orders",
                        new
                        {
                            area = "Setting"
                        }
                    )',
                    {
                        method: "POST",

                        body:
                            new FormData(
                                this
                            )
                    }
                )
                .then(
                    function (response) {

                        return response.json();

                    }
                )
                .then(
                    function (result) {

                        alert(
                            result.message
                            ||
                            (
                                result.success
                                    ?
                                    "عملیات با موفقیت انجام شد."
                                    :
                                    "عملیات انجام نشد."
                            )
                        );


                        if (
                            result.success
                        ) {

                            location.reload();

                            return;

                        }


                        if (submitButton) {

                            submitButton.disabled =
                                false;

                            submitButton.innerText =
                                "✓ پذیرش پاسخ و خاتمه پرونده";

                        }

                    }
                )
                .catch(
                    function () {

                        alert(
                            "خطا در ارتباط با سرور."
                        );


                        if (submitButton) {

                            submitButton.disabled =
                                false;

                            submitButton.innerText =
                                "✓ پذیرش پاسخ و خاتمه پرونده";

                        }

                    }
                );

            }
        );

    }



    /* =========================================================
       REJECT / APPEAL
       ========================================================= */

    var appealForm =
        document.getElementById(
            "appealForm"
        );


    if (appealForm) {

        appealForm.addEventListener(
            "submit",
            function (e) {

                e.preventDefault();


                var reason =
                    document.getElementById(
                        "appealReason"
                    );


                if (
                    !reason
                    ||
                    reason.value
                        .trim()
                        .length < 10
                ) {

                    alert(
                        "لطفاً دلیل عدم پذیرش پاسخ را حداقل در 10 کاراکتر توضیح دهید."
                    );


                    if (reason) {

                        reason.focus();

                    }


                    return;

                }


                var files =
                    document.getElementById(
                        "appealFiles"
                    ).files;


                /* =============================================
                   MAX FILE COUNT
                   ============================================= */

                if (
                    files.length > 10
                ) {

                    alert(
                        "حداکثر 10 فایل قابل ارسال است."
                    );

                    return;

                }


                /* =============================================
                   MAX FILE SIZE
                   20 MB
                   ============================================= */

                var maxFileSize =
                    20 *
                    1024 *
                    1024;


                for (
                    var i = 0;
                    i < files.length;
                    i++
                ) {

                    if (
                        files[i].size >
                        maxFileSize
                    ) {

                        alert(
                            "حجم فایل «"
                            +
                            files[i].name
                            +
                            "» بیشتر از 20 مگابایت است."
                        );

                        return;

                    }

                }


                if (
                    !confirm(
                        "آیا از عدم پذیرش پاسخ و ثبت درخواست بازنگری مطمئن هستید؟"
                    )
                ) {

                    return;

                }


                var submitButton =
                    this.querySelector(
                        "button[type='submit']"
                    );


                if (submitButton) {

                    submitButton.disabled =
                        true;

                    submitButton.innerText =
                        "در حال ارسال...";

                }


                fetch(
                    '@Url.Action(
                        "SubmitJusticeAppeal",
                        "Orders",
                        new
                        {
                            area = "Setting"
                        }
                    )',
                    {
                        method: "POST",

                        body:
                            new FormData(
                                this
                            )
                    }
                )
                .then(
                    function (response) {

                        return response.json();

                    }
                )
                .then(
                    function (result) {

                        alert(
                            result.message
                            ||
                            (
                                result.success
                                    ?
                                    "درخواست بازنگری ثبت شد."
                                    :
                                    "عملیات انجام نشد."
                            )
                        );


                        if (
                            result.success
                        ) {

                            location.reload();

                            return;

                        }


                        if (submitButton) {

                            submitButton.disabled =
                                false;

                            submitButton.innerText =
                                "↻ عدم پذیرش و درخواست بازنگری";

                        }

                    }
                )
                .catch(
                    function () {

                        alert(
                            "خطا در ارتباط با سرور."
                        );


                        if (submitButton) {

                            submitButton.disabled =
                                false;

                            submitButton.innerText =
                                "↻ عدم پذیرش و درخواست بازنگری";

                        }

                    }
                );

            }
        );

    }

</script>
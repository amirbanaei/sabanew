<script>
    function openPageGuide() {
        var activeTabButton = document.querySelector(".main-tab-button.active");
        var activeTab = activeTabButton ? activeTabButton.getAttribute("data-tab") : "tabOne";

        var guideMap = {
            tabOne: "pageGuideDialogTab1", tabTwo: "pageGuideDialogTab2", tabThree: "pageGuideDialogTab3",
            tabFour: "pageGuideDialogTab4", tabFive: "pageGuideDialogTab5", tabSix: "pageGuideDialogTab6",
            tabSeven: "pageGuideDialogTab7", tabEight: "pageGuideDialogTab7"
        };

        var dialog = document.getElementById(guideMap[activeTab] || guideMap.tabOne);

        if (!dialog) { return; }

        if (typeof dialog.showModal === "function") {
            if (!dialog.open) { dialog.showModal(); }
        }
        else {
            dialog.setAttribute("open", "open");
        }
    }

    // بستن راهنما با کلیک روی فضای تیره پشت آن
    document.addEventListener("click", function (e) {
        var target = e.target;

        if (target && target.classList
            && target.classList.contains("oa-native-guide")
            && typeof target.close === "function") {
            target.close();
        }
    });
</script>


<div class="order-page">

    <div id="orderNotification"></div>

    <div id="pageLoadingOverlay">
        <div class="loading-card">
            <div id="loadingTitle">در حال پردازش...</div>
            <div id="loadingText" style="margin-top:5px;color:#94a3b8;font-size:9px">لطفاً چند لحظه صبر کنید</div>
        </div>
    </div>

    <!-- DETAILS MODAL TAB 2 -->
    <div id="scopeDetailsModal" class="scope-modal">
        <div class="scope-modal-card">
            <h3 style="margin-top:0">جزئیات مامور</h3>
            <div id="scopeDetailsContent"></div>
            <div class="form-actions">
                <button type="button" id="closeScopeDetails" class="order-btn btn-secondary">بستن</button>
            </div>
        </div>
    </div>

    <!-- GUIDE BUTTON -->
    <div class="guide-header">
        <button type="button" class="guide-main-btn" onclick="openPageGuide();">
            <span class="guide-main-icon">?</span>
            راهنمای صفحه
        </button>
        <div class="guide-header-description">
            راهنمای هر تب جداگانه است؛ ابتدا تب موردنظر را انتخاب و سپس روی «راهنمای صفحه» کلیک کنید.
        </div>
    </div>

    <!-- TABS -->
    <div class="order-tabs">
        <button type="button" class="order-tab active main-tab-button" data-tab="tabOne">1- تعیین نقش وصول</button>
        <button type="button" class="order-tab main-tab-button" data-tab="tabTwo">2- تنظیمات ارجاع</button>
        <button type="button" class="order-tab main-tab-button" data-tab="tabThree">3- لیست بالابری</button>
        <button type="button" class="order-tab main-tab-button" data-tab="tabFour">4- اجرای تخصیص</button>
        <button type="button" class="order-tab main-tab-button" data-tab="tabFive">5- گزارش نیروها</button>
        <button type="button" class="order-tab main-tab-button" data-tab="tabSix">6- تخصیص تکی</button>
        <button type="button" class="order-tab main-tab-button" data-tab="tabSeven">7- خروجی کل روز</button>
        <button type="button" class="order-tab main-tab-button" data-tab="tabEight">8- Unallocated Records</button>
        @if (isJonobi)
        {
            <a class="order-tab" href="@Url.Action("SouthAgentMappings", "setting_order")" target="_blank" rel="noopener">فهرست مأموران جنوبی / officer_id</a>
        }
    </div>

    <!-- STATS -->
    <div class="order-stats">
        <div class="stat-card">
            <div class="stat-title">تعیین نقش ثبت‌شده</div>
            <div class="stat-value">@(ViewBag.AssignmentCount ?? assignments.Count)</div>
        </div>
        <div class="stat-card">
            <div class="stat-title">نیروهای قابل انتخاب</div>
            <div class="stat-value">@(ViewBag.UserCount ?? users.Count)</div>
        </div>
        <div class="stat-card">
            <div class="stat-title">نیروهای تنظیمات ارجاع</div>
            <div class="stat-value">@tab2Users.Count</div>
        </div>
        <div class="stat-card">
            <div class="stat-title">مناطق (همه شهرستان‌ها)</div>
            <div class="stat-value">@allRegions.Count</div>
        </div>
    </div>


    <!-- =====================================================
         TAB 1
         ===================================================== -->

    <div id="tabOne" class="main-tab-panel">

        <div class="glass-card" id="assignmentFormCard">

            <div class="section-header">
                <div>
                    <h2 id="assignmentFormTitle">تعیین نقش نیروها</h2>
                    <p>نقش هر نیرو را انتخاب کنید.</p>
                </div>
            </div>

            <form id="assignmentForm">

                @Html.AntiForgeryToken()

                <div class="tab-one-toolbar">
                    <div>
                        <div class="tab-one-info-title">تعیین نقش ماموران</div>
                        <div class="tab-one-info-subtitle">
                            هر نیرو می‌تواند یک یا چند فعالیت داشته باشد.
                            برای جستجوی نیرو از کادر زیر نام نیرو استفاده کنید.
                        </div>
                    </div>
                </div>

                <div class="matrix-area">

                    <div class="matrix-toolbar">
                        <div class="matrix-toolbar-title">ماتریس نقش‌ها</div>
                        <div class="matrix-toolbar-info">
                            انتخاب همه، کل ستون را انتخاب می‌کند. نقش @(isJonobi ? "وصول مذاکره‌ای" : "تلفنی") با سایر نقش‌ها هم‌زمان قابل انتخاب نیست.
                            انتخاب «بالابری» بدون «عادی» یا «دیماند» مجاز نیست.
                        </div>
                    </div>

                    <div class="matrix-wrapper matrix-scroll-20">

                        <table class="activity-matrix" id="assignmentMatrix">

                            <thead>
                                <tr>
                                    <th class="user-column-header-cell">
                                        <div class="user-column-title">نام نیرو</div>
                                        <div class="user-column-search">
                                            <span class="user-column-search-icon">⌕</span>
                                            <input type="text" id="matrixUserSearch" class="user-column-search-input"
                                                   autocomplete="off" placeholder="جستجوی نام یا کد ملی..." />
                                        </div>
                                    </th>

                                    @foreach (var activity in activityTypes)
                                    {
                                        <th>@activity.Title</th>
                                    }
                                </tr>
                            </thead>

                            <tbody>

                                <tr class="select-all-row">
                                    <td class="person-cell"><strong style="color:#7dd3fc">انتخاب همه</strong></td>

                                    @foreach (var activity in activityTypes)
                                    {
                                        <td>
                                            <label class="neon-check">
                                                <input type="checkbox" class="column-select-all" data-activity="@activity.ID" />
                                                <span></span>
                                            </label>
                                        </td>
                                    }
                                </tr>

                                @foreach (var user in users)
                                {
                                    var fullName = ((user.usr_Name ?? "") + " " + (user.usr_Family ?? "")).Trim();

                                    <tr class="user-activity-row"
                                        data-search="@((fullName + " " + (user.usr_NationalCode ?? "")).ToLower())">

                                        <td class="person-cell">
                                            <div class="person-info">
                                                <span class="person-avatar">
                                                    @(string.IsNullOrWhiteSpace(fullName) ? "؟" : fullName.Substring(0, 1))
                                                </span>
                                                <div>
                                                    <span class="person-name">@fullName</span>
                                                    <span class="person-national">@(user.usr_NationalCode ?? "")</span>
                                                </div>
                                            </div>
                                        </td>

                                        @foreach (var activity in activityTypes)
                                        {
                                            var pairKey = user.usr_ID.ToString() + "_" + activity.ID.ToString();
                                            var isSaved = savedActivityPairKeys.Contains(pairKey);

                                            <td>
                                                <label class="neon-check">
                                                    <input type="checkbox"
                                                           class="user-activity-check"
                                                           data-user="@user.usr_ID"
                                                           data-activity="@activity.ID"
                                                           @(isSaved ? "checked" : null) />
                                                    <span></span>
                                                </label>
                                            </td>
                                        }
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit" class="order-btn btn-main">
                        <span id="saveButtonText">ذخیره اطلاعات</span>
                    </button>
                    <button type="button" id="clearAssignment" class="order-btn btn-secondary">پاک کردن</button>
                </div>

            </form>

        </div>


        <!-- TAB 1 SAVED TABLE -->

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>آخرین تعیین نقش ثبت‌شده</h2>
                    <p>در هر ستون می‌توانید نام یا کد ملی نیرو را جستجو کنید.</p>
                </div>
            </div>

            <div class="matrix-wrapper">

                <table class="activity-matrix">

                    <thead>
                        <tr>
                            <th style="width:65px">ردیف</th>

                            @foreach (var activity in activityTypes)
                            {
                                <th>@activity.Title</th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @{ int row = 0; }

                        @foreach (var assignment in assignments)
                        {
                            row++;

                            <tr>
                                <td>@row</td>

                                @foreach (var activity in activityTypes)
                                {
                                    var ids = assignmentActivities
                                        .Where(x => x.AssignmentID == assignment.ID && x.ActivityTypeID == activity.ID)
                                        .Select(x => x.UserID)
                                        .Distinct()
                                        .ToList();

                                    var activityUsers = users
                                        .Where(x => ids.Contains(x.usr_ID))
                                        .OrderBy(x => x.usr_Family)
                                        .ThenBy(x => x.usr_Name)
                                        .ToList();

                                    <td>
                                        <div class="summary-cell-box">

                                            @if (activityUsers.Any())
                                            {
                                                <div class="summary-count-row">
                                                    <span class="summary-person-count" data-total="@activityUsers.Count">
                                                        @activityUsers.Count نفر
                                                    </span>
                                                    <span class="summary-search-result-count">همه</span>
                                                </div>

                                                <div class="summary-search-box">
                                                    <span class="summary-search-icon">⌕</span>
                                                    <input type="text" class="summary-cell-search"
                                                           autocomplete="off" placeholder="نام یا کد ملی..." />
                                                </div>

                                                <div class="summary-person-scroll">
                                                    <div class="summary-person-list">

                                                        @foreach (var person in activityUsers)
                                                        {
                                                            var name = ((person.usr_Name ?? "") + " " + (person.usr_Family ?? "")).Trim();

                                                            <div class="summary-person-item"
                                                                 data-search="@((name + " " + (person.usr_NationalCode ?? "")).ToLower())">
                                                                @name
                                                            </div>
                                                        }

                                                        <div class="summary-no-result">موردی پیدا نشد</div>

                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span style="color:#475569">-</span>
                                            }

                                        </div>
                                    </td>
                                }
                            </tr>
                        }

                        @if (row == 0)
                        {
                            <tr>
                                <td colspan="@(activityTypes.Count + 1)" style="padding:30px;color:#64748b">
                                    هنوز اطلاعاتی ثبت نشده است.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TAB 2  (هر منطقه ← چند گروه؛ هر گروه روزکار ، تعرفه و محدوده‌ی مخصوص خودش)
         پیش‌فرض: همه ماموران، مناطق، روزکارها، محدوده‌ها و تعرفه‌ها تیک‌خورده
         ===================================================== -->

    <div id="tabTwo" class="main-tab-panel" style="display:none">

        <div class="glass-card" id="scopeFormCard">

            <div class="section-header">
                <div>
                    <h2 id="scopeFormTitle">تنظیمات ارجاع ماموران</h2>
                    <p>مامور را انتخاب کنید و برای هر منطقه (و در صورت نیاز چند گروه داخل هر منطقه)، روزکار ، محدوده و تعرفه‌ی مخصوص را تعیین کنید. در حالت پیش‌فرض همه موارد تیک‌خورده است (بدون محدودیت).</p>
                </div>
            </div>

            <form id="agentScopeForm">

                @Html.AntiForgeryToken()

                <div class="scope-grid">

                    <!-- 1 USER -->
                    <div class="scope-card">
                        <div class="scope-card-title">نام مامور</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeUserSearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی نام یا کد ملی..." />
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllUsers" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            @foreach (var user in tab2Users)
                            {
                                var name = ((user.usr_Name ?? "") + " " + (user.usr_Family ?? "")).Trim();
                                var userAlreadySaved = savedScopeUserIds.Contains(user.usr_ID);

                                <label class="scope-item scope-user-option @(userAlreadySaved ? "scope-user-hidden scope-user-saved" : "")"
                                       data-search="@((name + " " + (user.usr_NationalCode ?? "")).ToLower())">
                                    <input type="checkbox" class="scope-user-check" value="@user.usr_ID" @(userAlreadySaved ? null : "checked") />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">@name</span>
                                </label>
                            }

                            <div id="scopeNoNewUsers" class="scope-empty-note">
                                همه ماموران قبلاً ثبت شده‌اند. برای تغییر، از دکمه «ویرایش» جدول پایین استفاده کنید.
                            </div>

                        </div>
                    </div>

                    <!-- 2 REGION (همه مناطق) -->
                    <div class="scope-card">
                        <div class="scope-card-title">کد @scopeRegionTitle (همه شهرستان‌ها)</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeRegionSearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی کد، نام @scopeRegionTitle یا شهرستان..." />
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllRegions" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            @foreach (var region in allRegions)
                            {
                                <label class="scope-item scope-region-option"
                                       data-search="@(region.Code + " " + region.Name + " " + region.County)">
                                    <input type="checkbox" class="scope-region-check" value="@region.Code" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">
                                        @scopeRegionTitle @region.Code
                                        @if (!string.IsNullOrWhiteSpace(region.Name))
                                        {
                                            <small>@(region.Name + (string.IsNullOrWhiteSpace(region.County) ? "" : " - " + region.County))</small>
                                        }
                                    </span>
                                </label>
                            }

                        </div>
                    </div>

                    <!-- 3 WORK DAY -->
                    <div class="scope-card">
                        <div class="scope-card-title">روزکار</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeWorkDaySearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی روزکار..." />
                        </div>

                        <div class="scope-selector-search workday-range-row">
                            <input type="number" id="workDayFrom" min="1" max="99"
                                   class="scope-selector-search-input" placeholder="از" />
                            <input type="number" id="workDayTo" min="1" max="99"
                                   class="scope-selector-search-input" placeholder="تا" />
                            <button type="button" id="applyWorkDayRange" class="scope-action">انتخاب بازه</button>
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllWorkDays" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            <div class="workday-grid">

                                @for (int day = 1; day <= 99; day++)
                                {
                                    <label class="scope-item scope-workday-option" data-search="@day">
                                        <input type="checkbox" class="scope-workday-check" value="@day" checked />
                                        <span class="scope-check"></span>
                                        <span class="scope-text">@day</span>
                                    </label>
                                }

                            </div>

                        </div>
                    </div>

                    <!-- 4 + 5 : MAHDOODEH / TARIFF -->
                    <div class="scope-side-cards">

                        <div class="scope-card">
                            <div class="scope-card-title">@scopeAreaTitle (کد ناحیه)</div>

                            <div class="scope-card-body">

                                <label class="scope-item">
                                    <input type="checkbox" id="scopeAllAreas" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">انتخاب همه</span>
                                </label>

                                <div class="area-grid">

                                    @for (int area = AreaMin; area <= AreaMax; area++)
                                    {
                                        <label class="scope-item scope-area-option">
                                            <input type="checkbox" class="scope-area-check" value="@area" checked />
                                            <span class="scope-check"></span>
                                            <span class="scope-text">@area</span>
                                        </label>
                                    }

                                </div>

                            </div>
                        </div>

                        <div class="scope-card">
                            <div class="scope-card-title">نوع تعرفه</div>

                            <div class="scope-card-body">

                                <label class="scope-item">
                                    <input type="checkbox" id="scopeAllTariffs" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">انتخاب همه</span>
                                </label>

                                @foreach (var tariff in tariffTypes)
                                {
                                    <label class="scope-item scope-tariff-option">
                                        <input type="checkbox" class="scope-tariff-check" value="@tariff.ID" checked />
                                        <span class="scope-check"></span>
                                        <span class="scope-text">@tariff.Title</span>
                                    </label>
                                }

                            </div>
                        </div>

                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit" id="saveAgentScope" class="order-btn btn-main">ذخیره اطلاعات</button>
                    <button type="button" id="clearAgentScope" class="order-btn btn-secondary">پاک کردن</button>
                </div>

            </form>

        </div>


        <!-- TAB 2 SAVED -->

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>آخرین تنظیمات ذخیره‌شده ماموران</h2>
                    <p>ارجاعات بر اساس آخرین تنظیمات ذخیره‌شده انجام خواهد شد.</p>
                </div>

                <div style="width:250px">
                    <input type="text" id="scopeSearch" class="order-input"
                           autocomplete="off" placeholder="جستجوی مامور..." />
                </div>
            </div>

            <div class="matrix-wrapper">

                <table class="activity-matrix">

                    <thead>
                        <tr>
                            <th>مامور</th>
                            <th>@scopeRegionsTitle ، گروه‌ها ، روزکار ، تعرفه و @scopeAreaTitle</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var scope in agentScopes)
                        {
                            var person = tab2Users.FirstOrDefault(x => x.usr_ID == scope.UserID);

                            if (person == null) { continue; }

                            var name = ((person.usr_Name ?? "") + " " + (person.usr_Family ?? "")).Trim();

                            var scopeRegionList = agentScopeRegions
                                .Where(x => x.ScopeID == scope.ID)
                                .Select(x => x.RegionCode)
                                .Distinct()
                                .OrderBy(x => x)
                                .ToList();

                            var scopeDayRows = agentScopeWorkDays.Where(x => x.ScopeID == scope.ID).ToList();

                            var generalDays = scopeDayRows
                                .Where(x => !x.RegionCode.HasValue)
                                .Select(x => x.WorkDay)
                                .ToList();

                            var scopeTariffRows = agentScopeTariffs.Where(x => x.ScopeID == scope.ID).ToList();

                            var scopeAreaRows = agentScopeAreas.Where(x => x.ScopeID == scope.ID).ToList();

                            var generalAreas = scopeAreaRows
                                .Where(x => !x.RegionCode.HasValue)
                                .Select(x => x.AreaCode)
                                .Distinct()
                                .ToList();

                            var generalAreasRestricted = generalAreas.Count > 0 && generalAreas.Count < AreaTotal;

                            var generalTariffIds = scopeTariffRows
                                .Where(x => !x.RegionCode.HasValue)
                                .Select(x => x.TariffTypeID)
                                .Distinct()
                                .ToList();

                            var generalTariffTitles = tariffTypes
                                .Where(x => generalTariffIds.Contains(x.ID))
                                .Select(x => x.Title)
                                .ToList();

                            <tr class="scope-data-row"
                                data-name="@((name + " " + (person.usr_NationalCode ?? "")).ToLower())">

                                <td>
                                    <div class="person-info">
                                        <span class="person-avatar">
                                            @(string.IsNullOrWhiteSpace(name) ? "؟" : name.Substring(0, 1))
                                        </span>
                                        <div>
                                            <span class="person-name">@name</span>
                                            <span class="person-national">@(person.usr_NationalCode ?? "")</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="scope-rule-lines">

                                        @foreach (var r in scopeRegionList)
                                        {
                                            // هر منطقه چند «گروه» دارد؛ هر گروه روزکار + محدوده + تعرفه‌ی مستقل
                                            var regionGroupNos = scopeDayRows.Where(x => x.RegionCode == r).Select(x => x.GroupNo)
                                                .Concat(scopeTariffRows.Where(x => x.RegionCode == r).Select(x => x.GroupNo))
                                                .Concat(scopeAreaRows.Where(x => x.RegionCode == r).Select(x => x.GroupNo))
                                                .Distinct()
                                                .OrderBy(x => x)
                                                .ToList();

                                            if (regionGroupNos.Count == 0) { regionGroupNos.Add(1); }

                                            foreach (var g in regionGroupNos)
                                            {
                                                var rd = scopeDayRows
                                                    .Where(x => x.RegionCode == r && x.GroupNo == g)
                                                    .Select(x => x.WorkDay)
                                                    .Distinct()
                                                    .ToList();

                                                if (rd.Count == 0) { rd = generalDays; }

                                                var rt = scopeTariffRows
                                                    .Where(x => x.RegionCode == r && x.GroupNo == g)
                                                    .Select(x => x.TariffTypeID)
                                                    .Distinct()
                                                    .ToList();

                                                if (rt.Count == 0) { rt = generalTariffIds; }

                                                var rtTitles = tariffTypes
                                                    .Where(x => rt.Contains(x.ID))
                                                    .Select(x => x.Title)
                                                    .ToList();

                                                var ra = scopeAreaRows
                                                    .Where(x => x.RegionCode == r && x.GroupNo == g)
                                                    .Select(x => x.AreaCode)
                                                    .Distinct()
                                                    .ToList();

                                                if (ra.Count == 0) { ra = generalAreas; }

                                                var raRestricted = ra.Count > 0 && ra.Count < AreaTotal;

                                                var isLastGroup = g == regionGroupNos.Last();

                                                <div class="scope-rule-line">
                                                    <span class="scope-chip">@scopeRegionTitle @r</span>
                                                    @if (regionGroupNos.Count > 1)
                                                    {
                                                        <span class="scope-chip">گروه @g</span>
                                                    }
                                                    <span class="scope-rule-days">
                                                        @("روزکار: " + (rd.Count > 0 ? compressDays(rd) : allDaysText))
                                                        &nbsp;|&nbsp;
                                                        @("تعرفه: " + (rtTitles.Count > 0 ? string.Join("، ", rtTitles) : allTariffsText))
                                                        &nbsp;|&nbsp;
                                                        @(scopeAreaTitle + ": " + (raRestricted ? compressDays(ra) : allAreasText))
                                                    </span>
                                                    <button type="button" class="scope-action edit-scope-region"
                                                            data-user="@scope.UserID"
                                                            data-region="@r"
                                                            data-group="@g"
                                                            data-tariffs="@string.Join(",", rt)"
                                                            data-areas="@(raRestricted ? string.Join(",", ra.OrderBy(a => a)) : "")"
                                                            data-days="@string.Join(",", rd.OrderBy(d => d))">
                                                        ویرایش
                                                    </button>
                                                    @if (isLastGroup)
                                                    {
                                                        <button type="button" class="scope-action add-scope-group"
                                                                data-user="@scope.UserID"
                                                                data-region="@r"
                                                                title="افزودن گروه جدید (روزکار و @scopeAreaTitle دیگر) برای @scopeRegionTitle @r">
                                                            + گروه
                                                        </button>
                                                    }
                                                    <button type="button" class="scope-action delete-scope-region"
                                                            data-id="@scope.ID"
                                                            data-region="@r"
                                                            data-group="@g">
                                                        حذف
                                                    </button>
                                                </div>
                                            }
                                        }

                                        @* مامور «همه مناطق» (بدون ردیف منطقه): یک خط با ویرایش ، «+ گروه» و حذف *@
                                        @if (scopeRegionList.Count == 0)
                                        {
                                            var legacyRestricted = generalDays.Count > 0 || generalTariffIds.Count > 0 || generalAreasRestricted;

                                            <div class="scope-rule-line">
                                                <span class="scope-chip">@(legacyRestricted ? "همه " + scopeRegionsTitle : "همه " + scopeRegionsTitle + " (بدون محدودیت)")</span>
                                                <span class="scope-rule-days">
                                                    @("روزکار: " + (generalDays.Count > 0 ? compressDays(generalDays) : allDaysText))
                                                    &nbsp;|&nbsp;
                                                    @("تعرفه: " + (generalTariffTitles.Count > 0 ? string.Join("، ", generalTariffTitles) : allTariffsText))
                                                    &nbsp;|&nbsp;
                                                    @(scopeAreaTitle + ": " + (generalAreasRestricted ? compressDays(generalAreas) : allAreasText))
                                                </span>
                                                <button type="button" class="scope-action edit-scope-region"
                                                        data-user="@scope.UserID"
                                                        data-region="0"
                                                        data-group="0"
                                                        data-tariffs="@string.Join(",", generalTariffIds)"
                                                        data-areas="@(generalAreasRestricted ? string.Join(",", generalAreas.OrderBy(a => a)) : "")"
                                                        data-days="@string.Join(",", generalDays.OrderBy(d => d))">
                                                    ویرایش
                                                </button>
                                                <button type="button" class="scope-action add-scope-group"
                                                        data-virtual="1"
                                                        data-user="@scope.UserID"
                                                        data-tariffs="@string.Join(",", generalTariffIds)"
                                                        data-areas="@(generalAreasRestricted ? string.Join(",", generalAreas.OrderBy(a => a)) : "")"
                                                        data-days="@string.Join(",", generalDays.OrderBy(d => d))"
                                                        title="افزودن گروه برای منطقه(های) دلخواه">
                                                    + گروه
                                                </button>
                                                <button type="button" class="scope-action delete-scope-region"
                                                        data-id="@scope.ID"
                                                        data-region="0"
                                                        data-group="0">
                                                    حذف
                                                </button>
                                            </div>
                                        }

                                    </div>
                                </td>

                                <td>
                                    <div class="scope-actions">
                                        <button type="button" class="scope-action add-scope-region" data-user="@scope.UserID">+ افزودن @scopeRegionTitle دیگر</button>
                                        <button type="button" class="scope-action details-agent-scope" data-id="@scope.ID">جزئیات</button>
                                        <button type="button" class="scope-action delete-agent-scope" data-id="@scope.ID">حذف کل مامور</button>
                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TAB 3 - EXCEL COMPONENT IMPORT
         ===================================================== -->

    <div id="tabThree" class="main-tab-panel" style="display:none">

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>ورود مؤلفه‌ها از Excel - لیست بالابری</h2>
                    <p>ابتدا نمونه فایل مؤلفه را دریافت کنید، مقادیر را در ستون اول قرار دهید و سپس همان فایل را بارگذاری نمایید.</p>
                </div>
            </div>

            <div class="excel-component-grid">

                @foreach (var component in excelComponents)
                {
                    if (developingExcelComponents.Contains(component.Key))
                    {
                        <div class="excel-component-card excel-card-disabled">

                            <div class="excel-component-head">
                                <h3 class="excel-component-title">@component.Value</h3>
                                <span class="excel-component-number">@component.Key</span>
                            </div>

                            <div class="excel-disabled-box">
                                <div class="scope-disabled-badge">در حال توسعه</div>
                                <div class="excel-disabled-text">بارگذاری فایل «@component.Value» به‌زودی فعال خواهد شد.</div>
                            </div>

                        </div>

                        continue;
                    }

                    var activeBatch = excelImportBatches
                        .Where(x => x.ComponentType == component.Key && x.IsActive == true)
                        .OrderByDescending(x => x.ID)
                        .FirstOrDefault();

                    <form class="excel-component-card component-upload-form"
                          enctype="multipart/form-data"
                          data-component-type="@component.Key"
                          data-component-title="@component.Value">

                        @Html.AntiForgeryToken()

                        <div class="excel-component-head">
                            <h3 class="excel-component-title">@component.Value</h3>
                            <span class="excel-component-number">@component.Key</span>
                        </div>

                        <div class="excel-component-description">
                            فایل باید فقط یک ستون با عنوان دقیق «@component.Value» داشته باشد. ردیف‌های خالی و مقادیر تکراری نادیده گرفته می‌شوند.
                        </div>

                        <div class="excel-file-picker">
                            <input type="file" id="componentExcel_@component.Key" name="excelFile"
                                   class="component-excel-file" accept=".xlsx,.xls" />
                            <label class="excel-file-label" for="componentExcel_@component.Key">انتخاب فایل</label>
                            <span class="excel-selected-file">فایلی انتخاب نشده است</span>
                        </div>

                        <div class="excel-component-actions">

                            <a class="excel-action-link"
                               href="@Url.Action("DownloadOrderComponentTemplate", new { componentType = component.Key })">
                                دریافت نمونه Excel
                            </a>

                            <button type="submit" class="excel-upload-button">بارگذاری و ذخیره</button>

                            @if (activeBatch != null)
                            {
                                <button type="button" class="excel-disable-button disable-component-import"
                                        data-id="@activeBatch.ID">
                                    غیرفعال‌سازی فایل فعلی
                                </button>
                            }

                        </div>

                        @if (activeBatch != null)
                        {
                            <div class="excel-active-batch">
                                <strong>فایل فعال:</strong>
                                @(activeBatch.OriginalFileName ?? "-")
                                <br />
                                <strong>تعداد مقادیر:</strong>
                                @activeBatch.RowCount
                            </div>
                        }

                        <div class="excel-result"></div>

                    </form>
                }

            </div>

        </div>

    </div>


    <!-- =====================================================
         TAB 4 - SMART ALLOCATION
         ===================================================== -->

    <div id="tabFour" class="main-tab-panel" style="display:none">

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>تخصیص هوشمند و چندمرحله‌ای مأموران وصول</h2>
                    <p>بر اساس نقش‌ها (تب ۱)، محدودیت‌ها (تب ۲) و لیست بالابری (تب ۳) — ترتیب فازها: بالابری ← میدانی ← @(isJonobi ? "وصول مذاکره‌ای" : "تلفنی") ← سایر</p>
                </div>
            </div>

            <div class="alloc-steps">
                <div class="alloc-step">
                    <div class="alloc-step-num">1</div>
                    <div class="alloc-step-title">فیلتر مجوزها</div>
                    <div class="alloc-step-text">حذف پرونده‌های فاقد مأمور مجاز (نقش / منطقه / روزکار / تعرفه / محدوده)</div>
                </div>
                <div class="alloc-step">
                    <div class="alloc-step-num">2</div>
                    <div class="alloc-step-title">اولویت مالی</div>
                    <div class="alloc-step-text">مرتب‌سازی نزولی بر اساس مبلغ بدهی</div>
                </div>
                <div class="alloc-step">
                    <div class="alloc-step-num">3</div>
                    <div class="alloc-step-title">برش سهمیه‌ای</div>
                    <div class="alloc-step-text">جدا کردن پرونده‌های برتر به اندازه مجموع ظرفیت</div>
                </div>
                <div class="alloc-step">
                    <div class="alloc-step-num">4</div>
                    <div class="alloc-step-title">خوشه‌بندی مسیر</div>
                    <div class="alloc-step-text">مرتب‌سازی مجدد بر اساس شماره اشتراک</div>
                </div>
                <div class="alloc-step">
                    <div class="alloc-step-num">5</div>
                    <div class="alloc-step-title">کمترین درجه آزادی</div>
                    <div class="alloc-step-text">اول مأمور با کمترین منطقه/روزکار/محدوده؛ در تساوی مأمور تک‌نوع</div>
                </div>
                <div class="alloc-step">
                    <div class="alloc-step-num">6</div>
                    <div class="alloc-step-title">حلقه تکمیلی</div>
                    <div class="alloc-step-text">تکرار ۱ تا ۵ برای مأموران دارای کسری</div>
                </div>
            </div>

            <form id="smartAllocationForm">

                @Html.AntiForgeryToken()

                <div class="alloc-form-grid">

                    <div class="alloc-field">
                        <label for="allocSourceCity">شهرستان</label>
                        <select id="allocSourceCity" name="sourceCity" class="order-input">
                            @if (!String.IsNullOrWhiteSpace(lockedAllocationCity))
                            {
                                <option value="@lockedAllocationCity" selected="selected">@lockedAllocationCity</option>
                            }
                            else
                            {
                                <option value="">-- انتخاب شهرستان --</option>

                                foreach (var c in allocationCities)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                        <small>@(String.IsNullOrWhiteSpace(lockedAllocationCity) ? "پرونده‌ها از ValuunicPriorityResult همین شهرستان خوانده می‌شوند" : "شهرستان از محل خدمت حساب کاربری شما تعیین شده است")</small>
                    </div>

                    <div class="alloc-field">
                        <label for="allocTargetCity">شهر مقصد (ذخیره خروجی)</label>
                        @if (!String.IsNullOrWhiteSpace(lockedAllocationCity))
                        {
                            <input type="text" id="allocTargetCity" name="targetCity" class="order-input" value="@lockedAllocationCity" readonly="readonly" />
                            <small>خروجی فقط با نام شهرستان محل خدمت شما ذخیره می‌شود</small>
                        }
                        else
                        {
                            <input type="text" id="allocTargetCity" name="targetCity" class="order-input"
                                   autocomplete="off" placeholder="خالی = همان شهر مبدأ" />
                            <small>در ValuunicPriorityResult3 با این نام ذخیره می‌شود</small>
                        }
                    </div>

                    @if (isJonobi)
                    {
                        <div class="alloc-field">
                            <label for="allocAllocationDays">تعداد روز لیست</label>
                            <input type="text" id="allocAllocationDays" name="allocationDays"
                                   class="order-input" inputmode="numeric" autocomplete="off"
                                   required placeholder="مثلاً 7" />
                            <small>ظرفیت مبلغ = استاندارد روزانه × روز؛ سقف تعداد هر مأمور = روز × ۶۰. با تکمیل هرکدام، تخصیص متوقف می‌شود.</small>
                            <small id="allocCountLimit"></small>
                        </div>
                        <div class="alloc-field">
                            <label for="allocManualDailyStandard">استاندارد روزانه هر مأمور عادی (ریال)</label>
                            <input type="text" id="allocManualDailyStandard" name="manualDailyStandard"
                                   class="order-input" inputmode="numeric" autocomplete="off"
                                   placeholder="خالی = استاندارد فعلی سرور" />
                            <small>ظرفیت مبلغ = استاندارد روزانه × تعداد روز لیست؛ ضرایب نقش‌ها مثل قبل است.</small>
                        </div>
                    }

                    <div class="alloc-field">
                        <label for="allocSpecialThreshold">سقف مبلغ پرونده ویژه (ریال)</label>
                        <input type="text" id="allocSpecialThreshold" name="specialThreshold" class="order-input"
                               inputmode="numeric" autocomplete="off"
                               placeholder="مثلاً 500,000,000  (خالی = بدون سقف)" />
                        <small>بدهی بیشتر از این مبلغ و دیماند عمومی ← شیت «ویژه»</small>
                    </div>

                    <div class="alloc-field">
                        <label>تاریخ ثبت تخصیص (لیست جدید - شمسی)</label>
                        <div class="jdate-picker" data-target="allocSourceDate"></div>
                        <input type="hidden" id="allocSourceDate" />
                        <small>اگر برای این روز و شهر تخصیصی ثبت شده باشد پاک و جایگزین می‌شود، وگرنه ساخته می‌شود</small>
                    </div>

                    <div class="alloc-field">
                        <label>تاریخ لیست قبلی (شمسی)</label>
                        <div class="jdate-picker" data-target="allocExcludeDate" data-offset="-1"></div>
                        <input type="hidden" id="allocExcludeDate" />
                        <label class="alloc-exclude-check">
                            <input type="checkbox" id="allocUseExclude" class="use-exclude-check" data-picker="allocExcludeDate" checked />
                            حذف پرونده‌های لیست قبلی از لیست جدید
                        </label>
                        <small>شناسه قبض‌های ذخیره‌شده در این تاریخ در لیست جدید نمی‌آیند</small>
                    </div>

                </div>

                <div class="alloc-filter-grid">

                    <div class="alloc-filter-card">

                        <div class="alloc-filter-head">
                            <div class="alloc-filter-title">مناطق شهرستان</div>
                            <div class="alloc-filter-summary" id="allocRegionSummary">-</div>
                        </div>

                        <div class="alloc-filter-tools">
                            <label class="scope-item" style="min-height:28px;padding:0">
                                <input type="checkbox" id="allocAllRegions" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>
                        </div>

                        <div class="alloc-filter-body" id="allocRegionList">
                            <div class="alloc-empty">ابتدا شهرستان را انتخاب کنید.</div>
                        </div>

                    </div>

                    <div class="alloc-filter-card">

                        <div class="alloc-filter-head">
                            <div class="alloc-filter-title">روزکارهای مناطق انتخاب‌شده</div>
                            <div class="alloc-filter-summary" id="allocWorkDaySummary">-</div>
                        </div>

                        <div class="alloc-filter-tools">
                            <label class="scope-item" style="min-height:28px;padding:0">
                                <input type="checkbox" id="allocAllWorkDays" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>
                            <input type="text" id="allocWorkDaySearch" class="scope-selector-search-input"
                                   style="max-width:180px" autocomplete="off" placeholder="جستجوی روزکار..." />
                        </div>

                        <div class="alloc-filter-body">
                            <div class="alloc-day-grid" id="allocWorkDayList">
                                <div class="alloc-empty">ابتدا شهرستان را انتخاب کنید.</div>
                            </div>
                            <div class="alloc-note" id="allocWorkDayNote" style="display:none"></div>
                        </div>

                    </div>

                </div>

                <div class="form-actions">
                    <button type="button" id="previewAllocation" class="order-btn btn-main">پیش‌نمایش (بدون ذخیره)</button>
                    <button type="button" id="runAllocation" class="order-btn btn-run">اجرا، ذخیره و دریافت Excel کامل</button>
                    @if (isJonobi)
                    {
                        <button type="button" id="runAllocationSheet1" class="order-btn btn-run">اکسل تک‌شیتی</button>
                    }
                </div>

            </form>

        </div>


        <div id="allocResult">

            <div class="alloc-stats" id="allocStats"></div>

            <div class="glass-card">

                <div class="section-header">
                    <div>
                        <h2>کارتابل مأموران</h2>
                        <p>مرتب بر اساس درجه آزادی (کمترین دامنه در ابتدا)</p>
                    </div>
                    <div style="width:250px">
                        <input type="text" id="allocAgentSearch" class="order-input"
                               autocomplete="off" placeholder="جستجوی مامور..." />
                    </div>
                </div>

                <div class="matrix-wrapper alloc-table-scroll">
                    <table class="activity-matrix">
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>مامور</th>
                                <th>نقش‌ها</th>
                                <th>مناطق</th>
                                <th>روزکار / تعرفه / @scopeAreaTitle</th>
                                <th>درجه آزادی</th>
                                <th>ظرفیت</th>
                                <th>بار تخصیص</th>
                                <th>تکمیل</th>
                                <th>پرونده</th>
                                <th>دور آخر</th>
                            </tr>
                        </thead>
                        <tbody id="allocAgentsBody"></tbody>
                    </table>
                </div>

            </div>

            <div class="glass-card">

                <div class="section-header">
                    <div>
                        <h2>گزارش فازها و دورهای حلقه تکمیلی</h2>
                        <p>هر ردیف یک دور از مراحل ۱ تا ۶ است</p>
                    </div>
                </div>

                <div class="matrix-wrapper">
                    <table class="activity-matrix">
                        <thead>
                            <tr>
                                <th>فاز</th>
                                <th>دور</th>
                                <th>مأموران هدف</th>
                                <th>پرونده‌های مجاز</th>
                                <th>ظرفیت خالی</th>
                                <th>برش‌خورده</th>
                                <th>تخصیص‌یافته</th>
                                <th>مبلغ (وزن) تخصیص</th>
                                <th>مأموران دارای کسری</th>
                            </tr>
                        </thead>
                        <tbody id="allocLogsBody"></tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TAB 5 - گزارش نیروهای ثبت‌شده / ثبت‌نشده (با تنظیمات ارجاع و محدوده)
         ===================================================== -->

    <div id="tabFive" class="main-tab-panel" style="display:none">

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>گزارش نیروها در تعیین نقش (تب ۱) و تنظیمات ارجاع (تب ۲)</h2>
                    <p>
                        ثبت‌نشده: <strong style="color:#fda4af">@unregisteredCount</strong> نفر
                        &nbsp;|&nbsp;
                        ثبت‌شده: <strong style="color:#6ee7b7">@registeredCount</strong> نفر
                    </p>
                </div>

                <div style="display:flex;gap:8px;align-items:center">
                    <div style="width:250px">
                        <input type="text" id="unregSearch" class="order-input"
                               autocomplete="off" placeholder="جستجوی نام، کد ملی، شغل، شهرستان یا تنظیمات..." />
                    </div>

                    <a class="order-btn btn-run"
                       style="text-decoration:none;display:inline-block"
                       href="@Url.Action("ExportUnregisteredUsers")">
                        دریافت خروجی Excel
                    </a>
                </div>
            </div>

            <div class="report-filters">
                <button type="button" class="report-filter active" data-status="all">همه (@reportUsers.Count)</button>
                <button type="button" class="report-filter" data-status="unregistered">ثبت‌نشده‌ها (@unregisteredCount)</button>
                <button type="button" class="report-filter" data-status="registered">ثبت‌شده‌ها (@registeredCount)</button>
            </div>

            <div class="matrix-wrapper alloc-table-scroll">
                <table class="activity-matrix">
                    <thead>
                        <tr>
                            <th style="width:65px">ردیف</th>
                            <th>نام</th>
                            <th>نام خانوادگی</th>
                            <th>کد ملی</th>
                            <th>کد پرسنلی</th>
                            <th>شغل</th>
                            <th>شهرستان</th>
                            <th>وضعیت</th>
                            <th>نقش‌ها (تب ۱)</th>
                            <th>@scopeRegionTitle ، روزکار ، تعرفه و @scopeAreaTitle (تب ۲)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int unregRow = 0; }

                        @foreach (var u in reportUsers)
                        {
                            unregRow++;

                            <tr class="unreg-row"
                                data-status="@(u.IsRegistered ? "registered" : "unregistered")"
                                data-search="@((u.Name + " " + u.Family + " " + u.NationalCode + " " + u.PersonalId + " " + u.JobTitle + " " + u.CityName + " " + u.Roles + " " + u.Scope).ToLower())">
                                <td>@unregRow</td>
                                <td>@u.Name</td>
                                <td>@u.Family</td>
                                <td>@u.NationalCode</td>
                                <td>@u.PersonalId</td>
                                <td>@u.JobTitle</td>
                                <td>@u.CityName</td>
                                <td>
                                    @if (u.IsRegistered)
                                    {
                                        <span class="status-pill yes">ثبت‌شده</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill no">ثبت‌نشده</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsRegistered)
                                    {
                                        foreach (var roleTitle in (u.Roles ?? "").Split(new[] { '،' }, StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="role-chip">@roleTitle.Trim()</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:#475569">-</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsRegistered)
                                    {
                                        <div class="report-scope">@u.Scope</div>
                                    }
                                    else
                                    {
                                        <span style="color:#475569">-</span>
                                    }
                                </td>
                            </tr>
                        }

                        @if (unregRow == 0)
                        {
                            <tr>
                                <td colspan="10" style="padding:30px;color:#64748b">موردی وجود ندارد.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>



       TAB 4 / 6 : RENDER  (p = "alloc" یا "single")
       ===================================================== */

    function renderAllocation(d, p) {

        p = p || "alloc";

        var stats = [
            ["مأموران", faNumber(d.agentCount) + " نفر"],
            ["کارتابل تکمیل", faNumber(d.completeAgents) + " از " + faNumber(d.agentCount)],
            ["درصد تکمیل کل", faNumber(d.totalFill) + "٪"],
            ["پرونده تخصیص‌یافته", faNumber(d.allocatedCount)],
            ["مبلغ تخصیص‌یافته", faNumber(d.allocatedAmount)],
            ["ویژه / تخصیص‌نیافته / بدون مجوز",
                faNumber(d.specialCount) + " / " + faNumber(d.unallocatedCount) + " / " + faNumber(d.noPermissionCount)],
            ["حذف‌شده: سخت وصول / لیست قبلی",
                faNumber(d.hardCount) + " / " + faNumber(d.previousCount)]
        ];

        if (isJonobi && d.standard && d.standard.RecordLimit != null) {
            stats.push(["سقف تعداد هر مأمور", faNumber(d.standard.RecordLimit) + " پرونده"]);
        }

        var statsHtml = "";

        $.each(stats, function (i, s) {
            statsHtml +=
                "<div class='stat-card'>" +
                    "<div class='stat-title'>" + htmlEncode(s[0]) + "</div>" +
                    "<div class='stat-value'>" + htmlEncode(s[1]) + "</div>" +
                "</div>";
        });

        $("#" + p + "Stats").html(statsHtml);

        var agentsHtml = "";

        $.each(d.agents || [], function (i, a) {

            var fill = Number(a.FillPercent || 0);
            var fillClass = fill >= 97 ? "ok" : (fill >= 70 ? "mid" : "low");

            var roles = "";

            $.each(a.Roles || [], function (j, r) {
                roles += "<span class='role-chip'>" + htmlEncode(r) + "</span>";
            });

            agentsHtml +=
                "<tr class='alloc-agent-row' data-search='" +
                    htmlEncode(((a.FullName || "") + " " + (a.NationalCode || "")).toLowerCase()) + "'>" +
                    "<td>" + faNumber(i + 1) + "</td>" +
                    "<td style='text-align:right'>" +
                        "<span class='person-name'>" + htmlEncode(a.FullName) + "</span>" +
                        "<span class='person-national'>" + htmlEncode(a.NationalCode) + "</span>" +
                    "</td>" +
                    "<td>" + roles + "</td>" +
                    "<td><div class='alloc-scope-text' title='" + htmlEncode(a.Regions) + "'>" + htmlEncode(a.Regions) + "</div></td>" +
                    "<td><div class='alloc-scope-text' title='" + htmlEncode(a.WorkDays) + "'>" + htmlEncode(a.WorkDays) + "</div></td>" +
                    "<td>" + faNumber(a.Freedom) + "</td>" +
                    "<td>" + faNumber(a.Capacity) + "</td>" +
                    "<td>" + faNumber(a.Load) + "</td>" +
                    "<td>" +
                        "<div class='fill-bar'>" +
                            "<div class='fill-bar-inner " + fillClass + "' style='width:" + Math.min(100, fill) + "%'></div>" +
                            "<div class='fill-bar-text'>" + faNumber(fill) + "٪</div>" +
                        "</div>" +
                    "</td>" +
                    "<td>" + faNumber(a.RecordCount) +
                        (isJonobi && a.RecordLimit != null ? " / " + faNumber(a.RecordLimit) : "") +
                        (isJonobi && a.CountLimitReached ? " <span>سقف تعداد تکمیل</span>" : "") +
                        (a.DemandCount ? " <span style='color:#64748b'>(دیماند " + faNumber(a.DemandCount) + ")</span>" : "") +
                    "</td>" +
                    "<td>" + (a.MaxRound ? faNumber(a.MaxRound) : "-") + "</td>" +
                "</tr>";
        });

        if (!agentsHtml) {
            agentsHtml = "<tr><td colspan='11' style='padding:25px;color:#64748b'>مأموری وجود ندارد.</td></tr>";
        }

        $("#" + p + "AgentsBody").html(agentsHtml);

        var logsHtml = "";

        $.each(d.logs || [], function (i, l) {
            logsHtml +=
                "<tr>" +
                    "<td>" + htmlEncode(l.PhaseTitle) + "</td>" +
                    "<td>" + faNumber(l.Round) + "</td>" +
                    "<td>" + faNumber(l.TargetAgents) + "</td>" +
                    "<td>" + faNumber(l.Candidates) + "</td>" +
                    "<td>" + faNumber(l.Gap) + "</td>" +
                    "<td>" + faNumber(l.CutCount) + "</td>" +
                    "<td>" + faNumber(l.AssignedCount) + "</td>" +
                    "<td>" + faNumber(l.AssignedWeight) + "</td>" +
                    "<td>" + faNumber(l.DeficitAgentsAfter) + "</td>" +
                "</tr>";
        });

        if (!logsHtml) {
            logsHtml = "<tr><td colspan='9' style='padding:25px;color:#64748b'>هیچ فازی اجرا نشد.</td></tr>";
        }

        $("#" + p + "LogsBody").html(logsHtml);

        $("#allocAgentSearch").val("");
        $("#" + p + "Result").show();
    }


    /* =====================================================
       TAB 4 : PREVIEW / RUN
       ===================================================== */

    $("#previewAllocation").on("click", function () {

        var $btn = $(this);

        if (!$("#allocSourceCity").val()) {
            message("شهرستان را انتخاب کنید.", "error");
            return;
        }

        if (!validateAllocationSelection()) { return; }

        $btn.prop("disabled", true);
        loading(true);

        $.ajax({
            url: urls.allocationPreview,
            type: "POST",
            traditional: true,
            data: allocationFormData(),
            success: function (r) {
                if (r && r.success) {
                    renderAllocation(r.data, "alloc");
                    message("پیش‌نمایش تخصیص آماده شد (ذخیره نشده است).", "success");
                }
                else {
                    message(r && r.message ? r.message : "پیش‌نمایش انجام نشد.", "error");
                }
            },
            error: function (xhr) {
                serverError(xhr, "خطا در اجرای پیش‌نمایش.");
            },
            complete: function () {
                $btn.prop("disabled", false);
                loading(false);
            }
        });
    });

    $("#runAllocation, #runAllocationSheet1").on("click", function () {

        var $btn = $(this);

        if (!$("#allocSourceCity").val()) {
            message("شهرستان را انتخاب کنید.", "error");
            return;
        }

        if (!validateAllocationSelection()) { return; }

        if (!confirm("تخصیص قبلی همین روز و همین شهر حذف و تخصیص جدید ذخیره می‌شود. ادامه می‌دهید؟")) { return; }

        $btn.prop("disabled", true);
        loading(true);

        var singleSheetOnly = $btn.attr("id") === "runAllocationSheet1";
        var requestData = allocationFormData();
        requestData.singleSheetOnly = singleSheetOnly;
        downloadExcel(urls.allocationRun, requestData, "Allocation.xlsx", "تخصیص انجام نشد.")
            .then(function () {
                message(singleSheetOnly ? "تخصیص ذخیره و اکسل تک‌شیتی sheet1 دریافت شد." : "تخصیص ذخیره و فایل Excel دریافت شد. خلاصه مأموران در شیت «خلاصه مامورین» است.", "success");
            })
            .catch(function (err) {
                message(err && err.message ? err.message : "خطا در اجرای تخصیص.", "error");
            })
            .then(function () {
                $btn.prop("disabled", false);
                loading(false);
            });
    });


@using System
@using System.Linq
@using System.Collections.Generic
@using SaabWebProject.Models.DomainModels

@{
    ViewBag.Title = "مدیریت تخصیص نیرو";
    var isEmbedded = ViewBag.IsEmbedded != null && (bool)ViewBag.IsEmbedded;
    Layout = isEmbedded ? null : "~/Views/Shared/_Layout.cshtml";

    /* ========================= TAB 1 ========================= */

    var users = ViewBag.Users as List<tbUsers> ?? new List<tbUsers>();
    var activityTypes = ViewBag.ActivityTypes as List<tbOrderActivityType> ?? new List<tbOrderActivityType>();
    var assignments = ViewBag.Assignments as List<tbOrderAssignment> ?? new List<tbOrderAssignment>();
    var assignmentActivities = ViewBag.AssignmentActivities as List<tbOrderAssignmentActivity> ?? new List<tbOrderAssignmentActivity>();

    var isJonobi = ViewBag.IsJonobi != null && (bool)ViewBag.IsJonobi;
    var specialCollectionTitle = isJonobi ? "وصول مذاکره‌ای" : "وصول تلفنی";

    // عنوان‌ها و بازه‌ها در جنوبی با سیستان متفاوت‌اند.
    var scopeRegionTitle = isJonobi ? "بخش" : "منطقه";
    var scopeRegionsTitle = isJonobi ? "بخش‌ها" : "مناطق";
    var scopeAreaTitle = isJonobi ? "منطقه" : "محدوده";

    var savedActivityPairKeys = new HashSet<string>(
        assignmentActivities.Select(x => x.UserID.ToString() + "_" + x.ActivityTypeID.ToString()));

    var telephoneActivity = activityTypes.FirstOrDefault(x =>
    {
        var title = (x.Title ?? "").Replace(" ", "").Replace("‌", "");

        return isJonobi
            ? title.IndexOf("مذاکره", StringComparison.OrdinalIgnoreCase) >= 0
            : title.IndexOf("تلفنی", StringComparison.OrdinalIgnoreCase) >= 0;
    });

    var telephoneActivityId = telephoneActivity == null ? 0 : telephoneActivity.ID;

    // قانون: انتخاب «بالابری» بدون «عادی» یا «دیماند» مجاز نیست
    var liftActivity = activityTypes.FirstOrDefault(x =>
        !string.IsNullOrWhiteSpace(x.Title)
        && x.Title.IndexOf("بالابری", StringComparison.OrdinalIgnoreCase) >= 0);

    var liftActivityId = liftActivity == null ? 0 : liftActivity.ID;

    var liftCompanionIds = activityTypes
        .Where(x => !string.IsNullOrWhiteSpace(x.Title)
                    && (x.Title.IndexOf("عادی", StringComparison.OrdinalIgnoreCase) >= 0
                        || x.Title.IndexOf("دیماند", StringComparison.OrdinalIgnoreCase) >= 0))
        .Select(x => x.ID)
        .ToList();

    /* ========================= TAB 2 ========================= */

    var tab2Users = ViewBag.Tab2Users as List<tbUsers> ?? new List<tbUsers>();
    var allRegions = ViewBag.AllowedRegions as List<SaabWebProject.Areas.setting_orderController.RegionItem>
                     ?? new List<SaabWebProject.Areas.setting_orderController.RegionItem>();
    var agentScopes = ViewBag.AgentScopes as List<tbOrderAgentScope> ?? new List<tbOrderAgentScope>();
    var agentScopeRegions = ViewBag.AgentScopeRegions as List<tbOrderAgentScopeRegion> ?? new List<tbOrderAgentScopeRegion>();
    var agentScopeWorkDays = ViewBag.AgentScopeWorkDays as List<tbOrderAgentScopeWorkDay> ?? new List<tbOrderAgentScopeWorkDay>();
    var tariffTypes = ViewBag.TariffTypes as List<tbOrderTariffType> ?? new List<tbOrderTariffType>();
    var agentScopeTariffs = ViewBag.AgentScopeTariffs as List<tbOrderAgentScopeTariff> ?? new List<tbOrderAgentScopeTariff>();
    var agentScopeAreas = ViewBag.AgentScopeAreas as List<tbOrderAgentScopeArea> ?? new List<tbOrderAgentScopeArea>();

    // جنوبی: منطقه 0 تا 60 ـ سیستان: محدوده 0 تا 45
    const int AreaMin = 0;
    var AreaMax = isJonobi ? 60 : 45;
    var AreaTotal = AreaMax - AreaMin + 1;

    // ماموران ثبت‌شده در جدول پایین؛ در لیست بالا دیگر نمایش داده نمی‌شوند (فقط با «ویرایش»)
    var savedScopeUserIds = new HashSet<int>(agentScopes.Select(x => x.UserID));

    // نمایش فشرده: 22, 23, 24, 25 → "22 تا 25"
    Func<IEnumerable<int>, string> compressDays = list =>
    {
        var s = list.Distinct().OrderBy(x => x).ToList();
        var parts = new List<string>();
        int i = 0;
        while (i < s.Count)
        {
            int j = i;
            while (j + 1 < s.Count && s[j + 1] == s[j] + 1) j++;
            parts.Add(j > i ? s[i] + " تا " + s[j] : s[i].ToString());
            i = j + 1;
        }
        return string.Join("، ", parts);
    };

    var allDaysText = "1 تا 99";
    var allAreasText = AreaMin + " تا " + AreaMax;
    var allTariffsText = tariffTypes.Count > 0 ? string.Join("، ", tariffTypes.Select(x => x.Title)) : "همه";
    var allRegionsText = allRegions.Count > 0 ? compressDays(allRegions.Select(x => x.Code)) : "همه";

    /* ========================= TAB 3 ========================= */

    var excelImportBatches = ViewBag.ExcelImportBatches as List<tbOrderExcelImportBatch> ?? new List<tbOrderExcelImportBatch>();

    var excelComponents = new Dictionary<int, string>
{
        { 1, "شناسه قبض" },
        { 2, "پرونده" },
        { 3, "روزکار" },
        { 4, "محدوده" }
    };

    // مؤلفه‌هایی که فعلاً «در حال توسعه» هستند (بارگذاری غیرفعال)
    var developingExcelComponents = new HashSet<int> { 3, 4 };

    /* ========================= TAB 4 / 6 ========================= */

    var allocationCities = ViewBag.AllocationCities as List<string> ?? new List<string>();
    var lockedAllocationCity = ViewBag.LockedAllocationCity as string;

    /* ========================= TAB 5 ========================= */

    var reportUsers =
        ViewBag.ReportUsers as List<SaabWebProject.Areas.setting_orderController.UnregisteredUserRow>
        ?? new List<SaabWebProject.Areas.setting_orderController.UnregisteredUserRow>();

    var unregisteredCount = reportUsers.Count(x => !x.IsRegistered);
    var registeredCount = reportUsers.Count(x => x.IsRegistered);
}


<style>
    @if (isEmbedded)
    {
        <text>
        html, body { margin: 0 !important; min-height: 100%; background: #050914 !important; }
        .order-page { min-height: 100vh; padding: 14px; }
        .guide-header, .order-tabs, .order-stats { display: none !important; }
        .main-tab-panel:not(#tabFour) { display: none !important; }
        #tabFour { display: block !important; }
        </text>
    }

    /* ROOT */
    .order-page {
        --cyan: #22d3ee;
        --blue: #2563eb;
        --purple: #8b5cf6;
        --green: #34d399;
        --red: #fb7185;
        --yellow: #fbbf24;
        direction: rtl;
        text-align: right;
        min-height: 100vh;
        padding: 22px;
        color: #e2e8f0;
        background: radial-gradient(circle at 5% 5%, rgba(14,165,233,.16), transparent 28%), radial-gradient(circle at 95% 10%, rgba(139,92,246,.14), transparent 28%), radial-gradient(circle at 50% 100%, rgba(16,185,129,.05), transparent 30%), #050914;
    }

        .order-page * {
            box-sizing: border-box;
        }

    /* GUIDE HEADER */
    .guide-header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        margin-bottom: 16px;
        padding: 16px 18px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.88), rgba(2,6,23,.70));
        border: 1px solid rgba(34,211,238,.14);
        border-radius: 18px;
        box-shadow: 0 22px 60px rgba(0,0,0,.30), inset 0 1px 0 rgba(255,255,255,.04);
    }

        .guide-header:before {
            content: "";
            position: absolute;
            top: 0;
            right: 30px;
            left: 30px;
            height: 1px;
            background: linear-gradient(90deg, transparent, #22d3ee, #8b5cf6, transparent);
        }

    .guide-main-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        padding: 10px 20px;
        color: #e0f2fe;
        cursor: pointer;
        background: linear-gradient(135deg, rgba(8,145,178,.22), rgba(79,70,229,.20));
        border: 1px solid rgba(34,211,238,.30);
        border-radius: 10px;
        font-size: 12px;
        font-weight: 900;
        transition: .18s;
        box-shadow: 0 0 20px rgba(34,211,238,.06);
    }

        .guide-main-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(34,211,238,.60);
            box-shadow: 0 0 22px rgba(34,211,238,.13);
        }

    .guide-main-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        color: #67e8f9;
        background: rgba(34,211,238,.08);
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 50%;
        font-size: 14px;
        font-weight: 900;
    }

    .guide-header-description {
        color: #64748b;
        font-size: 10px;
    }

    /* NATIVE GUIDE DIALOG */
    .oa-native-guide {
        width: min(850px, calc(100% - 30px));
        max-width: 850px;
        max-height: 90vh;
        margin: auto;
        padding: 0;
        direction: rtl;
        text-align: right;
        color: #e2e8f0;
        background: transparent;
        border: 0;
        outline: 0;
        border-radius: 18px;
        overflow: visible;
    }

        .oa-native-guide[open] {
            display: block;
        }

        .oa-native-guide::backdrop {
            background: rgba(2,6,23,.90);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

    .oa-native-guide-card {
        position: relative;
        width: 100%;
        max-height: 88vh;
        overflow-y: auto;
        padding: 24px;
        color: #e2e8f0;
        background: linear-gradient(145deg, #111c30, #050b18);
        border: 1px solid rgba(34,211,238,.32);
        border-radius: 18px;
        box-shadow: 0 30px 100px rgba(0,0,0,.75);
    }

        .oa-native-guide-card:before {
            content: "";
            position: absolute;
            top: 0;
            right: 35px;
            left: 35px;
            height: 1px;
            background: linear-gradient(90deg, transparent, #22d3ee, #8b5cf6, transparent);
        }

    .oa-native-guide-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        padding-bottom: 14px;
        margin-bottom: 17px;
        border-bottom: 1px solid rgba(148,163,184,.13);
    }

    .oa-native-guide-title {
        color: #f8fafc;
        font-size: 17px;
        font-weight: 900;
        line-height: 1.9;
    }

    .oa-native-guide-subtitle {
        margin-top: 4px;
        color: #67e8f9;
        font-size: 10px;
        line-height: 1.9;
    }

    .oa-native-guide-tab-badge {
        display: inline-block;
        margin-bottom: 6px;
        padding: 3px 10px;
        color: #67e8f9;
        background: rgba(6,182,212,.10);
        border: 1px solid rgba(34,211,238,.22);
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

    .oa-native-guide-close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        padding: 0;
        color: #e2e8f0;
        cursor: pointer;
        background: rgba(30,41,59,.85);
        border: 1px solid rgba(148,163,184,.22);
        border-radius: 9px;
        font-size: 21px;
        font-weight: bold;
        transition: .15s;
    }

        .oa-native-guide-close:hover {
            color: #fecaca;
            background: rgba(127,29,29,.20);
            border-color: rgba(244,63,94,.35);
        }

    .oa-native-guide-intro {
        margin-bottom: 14px;
        padding: 12px 14px;
        color: #e0f2fe;
        background: rgba(14,165,233,.08);
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 10px;
        font-size: 12px;
        font-weight: 900;
    }

    .oa-native-guide-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        width: 100%;
        margin-bottom: 10px;
        padding: 14px 15px;
        color: #e2e8f0;
        background: rgba(15,23,42,.72);
        border: 1px solid rgba(148,163,184,.12);
        border-radius: 11px;
    }

    .oa-native-guide-number {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        color: #67e8f9;
        background: rgba(6,182,212,.12);
        border: 1px solid rgba(34,211,238,.23);
        border-radius: 8px;
        font-size: 12px;
        font-weight: 900;
    }

    .oa-native-guide-text {
        flex: 1;
        color: #e2e8f0;
        font-size: 11px;
        font-weight: 500;
        line-height: 2.2;
    }

    .oa-native-guide-highlight {
        color: #fbbf24;
        font-weight: 900;
    }

    .oa-native-guide-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 18px;
        padding-top: 15px;
        border-top: 1px solid rgba(148,163,184,.10);
    }

    .oa-native-guide-ok {
        min-width: 125px;
        padding: 9px 18px;
        color: #fff;
        cursor: pointer;
        background: linear-gradient(135deg, #0891b2, #4f46e5);
        border: 1px solid rgba(34,211,238,.25);
        border-radius: 8px;
        font-size: 10px;
        font-weight: 800;
    }

    /* IMPORTANT NOTICE (اجباری - تا تایید بسته نمی‌شود) */
    .oa-notice-dialog {
        width: min(720px, calc(100% - 30px));
        max-height: 90vh;
        margin: auto;
        padding: 0;
        direction: rtl;
        text-align: right;
        color: #e2e8f0;
        background: transparent;
        border: 0;
        outline: 0;
        overflow: visible;
    }

        .oa-notice-dialog::backdrop {
            background: rgba(2,6,23,.93);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

    .oa-notice-card {
        position: relative;
        padding: 24px;
        background: linear-gradient(145deg, #1c1410, #0b0805);
        border: 1px solid rgba(251,191,36,.45);
        border-radius: 18px;
        box-shadow: 0 30px 100px rgba(0,0,0,.80), 0 0 40px rgba(251,191,36,.08);
    }

        .oa-notice-card:before {
            content: "";
            position: absolute;
            top: 0;
            right: 35px;
            left: 35px;
            height: 2px;
            background: linear-gradient(90deg, transparent, #fbbf24, #f97316, transparent);
        }

    .oa-notice-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        color: #fde68a;
        font-size: 17px;
        font-weight: 900;
    }

    .oa-notice-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        color: #1c1410;
        background: #fbbf24;
        border-radius: 50%;
        font-size: 17px;
        font-weight: 900;
    }

    .oa-notice-text {
        padding: 14px 16px;
        color: #f1f5f9;
        background: rgba(251,191,36,.07);
        border: 1px solid rgba(251,191,36,.20);
        border-radius: 12px;
        font-size: 13px;
        line-height: 2.3;
    }

    .oa-notice-confirm {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 16px;
        color: #fde68a;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        user-select: none;
    }

        .oa-notice-confirm input {
            width: 18px;
            height: 18px;
            accent-color: #fbbf24;
            cursor: pointer;
        }

    .oa-notice-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 16px;
    }

    .oa-notice-ok {
        min-width: 130px;
        padding: 10px 22px;
        color: #1c1410;
        cursor: pointer;
        background: linear-gradient(135deg, #fbbf24, #f97316);
        border: 0;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 900;
    }

        .oa-notice-ok:disabled {
            cursor: not-allowed;
            opacity: .35;
            filter: grayscale(.7);
        }

    /* TABS */
    .order-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 17px;
        padding: 6px;
        background: rgba(15,23,42,.62);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 13px;
    }

    .order-tab {
        min-width: 150px;
        padding: 10px 14px;
        color: #94a3b8;
        cursor: pointer;
        background: transparent;
        border: 0;
        border-radius: 9px;
        transition: .18s;
    }

        .order-tab:hover {
            color: #e0f2fe;
            background: rgba(14,165,233,.05);
        }

        .order-tab.active {
            color: #e0f2fe;
            background: linear-gradient(135deg, rgba(14,165,233,.20), rgba(99,102,241,.17));
            box-shadow: inset 0 0 0 1px rgba(34,211,238,.25);
        }

    /* GLASS CARD / STATS / SECTION */
    .glass-card {
        position: relative;
        margin-bottom: 17px;
        padding: 19px;
        background: linear-gradient(145deg, rgba(15,23,42,.77), rgba(2,6,23,.59));
        border: 1px solid rgba(255,255,255,.075);
        border-radius: 17px;
        box-shadow: 0 22px 60px rgba(0,0,0,.28);
    }

    .order-stats {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 11px;
        margin-bottom: 17px;
    }

    .stat-card {
        position: relative;
        padding: 14px 15px;
        background: rgba(15,23,42,.74);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 14px;
    }

        .stat-card:after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(#22d3ee, #6366f1);
        }

    .stat-title {
        color: #94a3b8;
        font-size: 10px;
    }

    .stat-value {
        margin-top: 4px;
        color: #f8fafc;
        font-size: 24px;
        font-weight: 900;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 15px;
    }

        .section-header h2 {
            margin: 0;
            color: #f8fafc;
            font-size: 16px;
            font-weight: 800;
        }

        .section-header p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 10px;
        }

    /* INPUT */
    .order-input {
        width: 100%;
        padding: 9px 11px;
        color: #e2e8f0;
        outline: none;
        background: rgba(2,6,23,.60);
        border: 1px solid rgba(148,163,184,.16);
        border-radius: 8px;
    }

        .order-input:focus {
            border-color: rgba(34,211,238,.65);
            box-shadow: 0 0 0 3px rgba(34,211,238,.04);
        }

    /* TAB 1 TOOLBAR / MATRIX */
    .tab-one-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        margin-bottom: 14px;
        padding: 11px 12px;
        background: rgba(2,6,23,.35);
        border: 1px solid rgba(148,163,184,.09);
        border-radius: 12px;
    }

    .tab-one-info-title {
        color: #e2e8f0;
        font-size: 11px;
        font-weight: 800;
    }

    .tab-one-info-subtitle {
        margin-top: 2px;
        color: #64748b;
        font-size: 8px;
    }

    .matrix-area {
        overflow: hidden;
        background: rgba(2,6,23,.38);
        border: 1px solid rgba(148,163,184,.09);
        border-radius: 14px;
    }

    .matrix-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 11px 13px;
        border-bottom: 1px solid rgba(148,163,184,.08);
    }

    .matrix-toolbar-title {
        color: #e0f2fe;
        font-size: 11px;
        font-weight: 800;
    }

    .matrix-toolbar-info {
        color: #64748b;
        font-size: 9px;
    }

    .matrix-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .activity-matrix {
        width: 100%;
        min-width: 850px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .activity-matrix th {
            padding: 10px 8px;
            text-align: center;
            color: #94a3b8;
            background: rgba(15,23,42,.99);
            border-bottom: 1px solid rgba(34,211,238,.12);
            font-size: 10px;
        }

        .activity-matrix td {
            padding: 9px 8px;
            text-align: center;
            color: #cbd5e1;
            border-bottom: 1px solid rgba(148,163,184,.065);
            font-size: 10px;
        }

    .matrix-scroll-20 {
        position: relative;
        max-height: 966px;
        overflow-x: auto;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(34,211,238,.55) rgba(2,6,23,.35);
    }

        .matrix-scroll-20::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .matrix-scroll-20::-webkit-scrollbar-thumb {
            background: linear-gradient(#22d3ee, #6366f1);
            border-radius: 20px;
        }

        .matrix-scroll-20 .activity-matrix thead th {
            position: sticky;
            top: 0;
            z-index: 20;
            background: rgba(15,23,42,.995);
        }

        .matrix-scroll-20 .select-all-row td {
            position: sticky;
            top: 76px;
            z-index: 18;
            background: rgba(8,47,73,.98);
        }

    /* SEARCH UNDER USER NAME */
    .user-column-header-cell {
        min-width: 240px !important;
        width: 240px;
        padding: 8px 10px !important;
        text-align: right !important;
        vertical-align: top;
    }

    .user-column-title {
        margin-bottom: 7px;
        color: #e2e8f0;
        text-align: right;
        font-size: 10px;
        font-weight: 900;
    }

    .user-column-search {
        position: relative;
        width: 100%;
    }

    .user-column-search-icon {
        position: absolute;
        top: 50%;
        right: 9px;
        transform: translateY(-50%);
        z-index: 2;
        color: #22d3ee;
        pointer-events: none;
        font-size: 13px;
    }

    .user-column-search-input {
        width: 100%;
        height: 31px;
        padding: 5px 29px 5px 8px;
        color: #e0f2fe;
        outline: none;
        background: rgba(2,6,23,.82);
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 7px;
        font-size: 8px;
    }

        .user-column-search-input::placeholder {
            color: #64748b;
        }

        .user-column-search-input:focus {
            border-color: rgba(34,211,238,.70);
            box-shadow: 0 0 10px rgba(34,211,238,.08);
        }

    /* TAB 1 - خطای قانون بالابری */
    .user-activity-row.row-error td {
        background: rgba(244,63,94,.14) !important;
    }

    .user-activity-row.row-error .person-name {
        color: #fda4af;
    }

    /* PERSON */
    .person-cell {
        min-width: 240px;
        text-align: right !important;
    }

    .person-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .person-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        color: #7dd3fc;
        background: rgba(14,165,233,.15);
        border: 1px solid rgba(34,211,238,.15);
        border-radius: 8px;
    }

    .person-name {
        display: block;
        color: #e2e8f0;
        font-size: 10px;
        font-weight: 700;
    }

    .person-national {
        display: block;
        margin-top: 2px;
        color: #64748b;
        font-size: 8px;
    }

    /* CHECKBOX */
    .neon-check {
        position: relative;
        display: inline-flex;
        width: 22px;
        height: 22px;
        cursor: pointer;
    }

        .neon-check input {
            position: absolute;
            opacity: 0;
        }

        .neon-check span {
            position: absolute;
            inset: 0;
            background: rgba(2,6,23,.78);
            border: 1px solid rgba(148,163,184,.34);
            border-radius: 6px;
        }

        .neon-check input:checked + span {
            background: linear-gradient(135deg, #06b6d4, #4f46e5);
            border-color: #22d3ee;
            box-shadow: 0 0 10px rgba(34,211,238,.30);
        }

            .neon-check input:checked + span:after {
                content: "✓";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%,-53%);
                color: white;
                font-size: 13px;
                font-weight: 900;
            }

        .neon-check input:indeterminate + span {
            background: rgba(34,211,238,.25);
            border-color: #22d3ee;
        }

        .neon-check input:disabled + span {
            cursor: not-allowed;
            opacity: .28;
            filter: grayscale(1);
        }

    /* BUTTONS */
    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 14px;
    }

    .order-btn {
        padding: 8px 15px;
        color: #fff;
        cursor: pointer;
        border: 1px solid transparent;
        border-radius: 8px;
    }

        .order-btn:disabled {
            cursor: not-allowed;
            opacity: .55;
        }

    .btn-main {
        background: linear-gradient(135deg, #0891b2, #4f46e5);
    }

    .btn-secondary {
        background: rgba(71,85,105,.40);
        border-color: rgba(148,163,184,.14);
    }

    .btn-cancel {
        color: #fde68a;
        background: rgba(245,158,11,.09);
        border-color: rgba(245,158,11,.18);
    }

    .btn-run {
        color: #052e16;
        font-weight: 900;
        background: linear-gradient(135deg, #34d399, #22d3ee);
    }

    /* TAB 1 SUMMARY */
    .summary-cell-box {
        min-width: 155px;
        padding: 6px;
        background: rgba(2,6,23,.20);
        border: 1px solid rgba(148,163,184,.05);
        border-radius: 9px;
    }

    .summary-count-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
        margin-bottom: 5px;
    }

    .summary-person-count {
        padding: 3px 7px;
        color: #67e8f9;
        background: rgba(6,182,212,.08);
        border: 1px solid rgba(34,211,238,.14);
        border-radius: 20px;
        font-size: 8px;
    }

    .summary-search-result-count {
        color: #64748b;
        font-size: 7px;
    }

    .summary-search-box {
        position: relative;
        margin-bottom: 6px;
    }

    .summary-search-icon {
        position: absolute;
        top: 50%;
        right: 8px;
        transform: translateY(-50%);
        color: #22d3ee;
        pointer-events: none;
    }

    .summary-cell-search {
        width: 100%;
        height: 29px;
        padding: 5px 26px 5px 7px;
        color: #dbeafe;
        outline: none;
        background: rgba(2,6,23,.72);
        border: 1px solid rgba(34,211,238,.13);
        border-radius: 6px;
        font-size: 8px;
    }

        .summary-cell-search:focus {
            border-color: rgba(34,211,238,.55);
        }

    .summary-person-scroll {
        max-height: 92px;
        min-height: 30px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: rgba(34,211,238,.50) rgba(2,6,23,.20);
    }

    .summary-person-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .summary-person-item {
        padding: 5px 7px;
        text-align: right;
        color: #bae6fd;
        background: rgba(14,165,233,.07);
        border: 1px solid rgba(34,211,238,.08);
        border-radius: 6px;
        font-size: 8px;
    }

    .summary-no-result {
        display: none;
        padding: 14px 6px;
        text-align: center;
        color: #64748b;
        font-size: 8px;
    }

    /* TAB 2 GRID */
    .scope-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr)) 150px 170px;
        gap: 10px;
        align-items: stretch;
    }

    .scope-side-cards {
        display: contents;
    }

        .scope-side-cards .scope-card {
            align-self: start;
            min-width: 0;
            min-height: 0;
        }

        .scope-side-cards .scope-card-title {
            padding: 8px 10px;
            font-size: 10px;
        }

    .scope-card {
        min-height: 340px;
        overflow: hidden;
        background: rgba(2,6,23,.66);
        border: 1px solid rgba(34,211,238,.17);
        border-radius: 12px;
    }

    .scope-card-title {
        padding: 11px 13px;
        color: #e0f2fe;
        border-bottom: 1px solid rgba(148,163,184,.08);
        font-size: 11px;
        font-weight: 800;
    }

    .scope-selector-search {
        padding: 8px 9px 0;
    }

    .scope-selector-search-input {
        width: 100%;
        height: 31px;
        padding: 6px 9px;
        color: #dbeafe;
        outline: none;
        background: rgba(2,6,23,.72);
        border: 1px solid rgba(34,211,238,.13);
        border-radius: 7px;
        font-size: 9px;
    }

        .scope-selector-search-input:focus {
            border-color: rgba(34,211,238,.55);
        }

    .scope-card-body {
        max-height: 270px;
        padding: 9px;
        overflow-y: auto;
    }

    .scope-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 34px;
        padding: 5px 8px;
        cursor: pointer;
    }

        .scope-item input {
            position: absolute;
            opacity: 0;
        }

    .scope-check {
        position: relative;
        width: 17px;
        height: 17px;
        flex-shrink: 0;
        background: rgba(2,6,23,.90);
        border: 1px solid rgba(148,163,184,.35);
        border-radius: 4px;
    }

    .scope-item input:checked + .scope-check {
        background: linear-gradient(135deg, #06b6d4, #2563eb);
        border-color: #22d3ee;
    }

        .scope-item input:checked + .scope-check:after {
            content: "✓";
            position: absolute;
            right: 3px;
            top: -1px;
            color: white;
        }

    .scope-item input:indeterminate + .scope-check {
        background: rgba(34,211,238,.25);
        border-color: #22d3ee;
    }

        .scope-item input:indeterminate + .scope-check:after {
            content: "–";
            position: absolute;
            right: 4px;
            top: -2px;
            color: white;
        }

    .scope-item input:disabled + .scope-check {
        opacity: .35;
    }

    .scope-text {
        color: #cbd5e1;
        font-size: 10px;
    }

        .scope-text small {
            color: #64748b;
            font-size: 8px;
            margin-right: 4px;
        }

    .workday-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 2px;
    }

    .area-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 2px;
    }

    .scope-user-hidden {
        display: none !important;
    }

    .scope-empty-note {
        display: none;
        padding: 10px 8px;
        color: #64748b;
        font-size: 9px;
        line-height: 1.9;
    }

    .scope-disabled-badge {
        display: inline-block;
        padding: 6px 12px;
        color: #fbbf24;
        background: rgba(245,158,11,.08);
        border: 1px solid rgba(245,158,11,.16);
        border-radius: 20px;
        font-size: 9px;
    }

    /* TAB 2 - RULES */
    .workday-range-row {
        display: flex;
        gap: 6px;
        align-items: center;
    }

        .workday-range-row .scope-selector-search-input {
            width: 60px;
            flex: 1;
        }

    .rule-row, .scope-rule-line {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 10px;
        background: rgba(14,165,233,.06);
        border: 1px solid rgba(34,211,238,.12);
        border-radius: 8px;
    }

    .rule-days, .scope-rule-days {
        flex: 1;
        color: #cbd5e1;
        font-size: 11px;
        text-align: right;
    }

    .scope-rule-lines {
        display: flex;
        flex-direction: column;
        gap: 5px;
        max-height: 130px;
        overflow-y: auto;
    }

    .scope-chip {
        padding: 4px 7px;
        color: #bae6fd;
        background: rgba(14,165,233,.08);
        border-radius: 15px;
        font-size: 8px;
        white-space: nowrap;
    }

    .scope-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 4px;
    }

    .scope-action {
        padding: 6px 8px;
        color: #bae6fd;
        cursor: pointer;
        background: rgba(2,6,23,.40);
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 6px;
        font-size: 8px;
    }

    .add-scope-region {
        color: #6ee7b7;
        border-color: rgba(52,211,153,.30);
    }

    .add-scope-group {
        color: #6ee7b7;
        border-color: rgba(52,211,153,.30);
    }

    .delete-agent-scope, .delete-rule, .delete-scope-region {
        color: #fda4af;
        border-color: rgba(244,63,94,.20);
    }

    /* MODAL / MESSAGE / LOADING */
    .scope-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999998;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(2,6,23,.80);
        backdrop-filter: blur(8px);
    }

        .scope-modal.show {
            display: flex;
        }

    .scope-modal-card {
        width: 600px;
        max-width: 95%;
        padding: 20px;
        color: #e2e8f0;
        background: #0f172a;
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 16px;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 110px 1fr;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid rgba(148,163,184,.07);
    }

    #orderNotification {
        display: none;
        position: fixed;
        top: 18px;
        left: 50%;
        z-index: 999999999;
        transform: translateX(-50%);
        min-width: 330px;
        max-width: 90%;
        padding: 13px 20px;
        color: white;
        text-align: center;
        border-radius: 11px;
        box-shadow: 0 18px 50px rgba(0,0,0,.45);
    }

        #orderNotification.success {
            background: #047857;
        }

        #orderNotification.error {
            background: #b91c1c;
        }

    #pageLoadingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999999998;
        align-items: center;
        justify-content: center;
        background: rgba(2,6,23,.76);
    }

        #pageLoadingOverlay.show {
            display: flex;
        }

    .loading-card {
        min-width: 260px;
        padding: 25px;
        color: white;
        text-align: center;
        background: #0f172a;
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 15px;
    }

    /* TAB 3 - EXCEL IMPORT */
    .excel-component-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .excel-component-card {
        position: relative;
        padding: 20px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.94), rgba(2,6,23,.84));
        border: 1px solid rgba(34,211,238,.16);
        border-radius: 20px;
        box-shadow: 0 18px 46px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.04);
    }

        .excel-component-card::before {
            content: "";
            position: absolute;
            inset: 0 auto auto 0;
            width: 120px;
            height: 120px;
            pointer-events: none;
            background: radial-gradient(circle, rgba(34,211,238,.13), transparent 68%);
        }

    .excel-component-head {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
    }

    .excel-component-title {
        margin: 0;
        color: #f8fafc;
        font-size: 17px;
        font-weight: 900;
    }

    .excel-component-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        color: #67e8f9;
        font-weight: 900;
        background: rgba(8,145,178,.13);
        border: 1px solid rgba(34,211,238,.24);
        border-radius: 11px;
    }

    .excel-component-description {
        min-height: 42px;
        margin-bottom: 14px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.9;
    }

    .excel-file-picker {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 48px;
        padding: 8px 10px;
        margin-bottom: 12px;
        background: rgba(15,23,42,.72);
        border: 1px dashed rgba(148,163,184,.26);
        border-radius: 14px;
    }

        .excel-file-picker input[type="file"] {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

    .excel-file-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 6px 12px;
        cursor: pointer;
        color: #e0f2fe;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
        background: rgba(14,165,233,.15);
        border: 1px solid rgba(56,189,248,.24);
        border-radius: 10px;
    }

    .excel-selected-file {
        min-width: 0;
        overflow: hidden;
        color: #94a3b8;
        font-size: 12px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .excel-component-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .excel-action-link, .excel-upload-button, .excel-disable-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 8px 13px;
        cursor: pointer;
        text-decoration: none;
        font-family: inherit;
        font-size: 12px;
        font-weight: 900;
        border-radius: 11px;
        transition: .18s ease;
    }

    .excel-action-link {
        color: #bfdbfe;
        background: rgba(37,99,235,.14);
        border: 1px solid rgba(96,165,250,.24);
    }

    .excel-upload-button {
        color: #052e16;
        background: linear-gradient(135deg, #34d399, #22d3ee);
        border: 0;
    }

    .excel-disable-button {
        color: #fecdd3;
        background: rgba(225,29,72,.12);
        border: 1px solid rgba(251,113,133,.24);
    }

        .excel-upload-button:disabled, .excel-disable-button:disabled {
            cursor: not-allowed;
            opacity: .55;
        }

    .excel-active-batch {
        margin-top: 14px;
        padding: 12px;
        color: #cbd5e1;
        font-size: 12px;
        line-height: 1.9;
        background: rgba(16,185,129,.07);
        border: 1px solid rgba(52,211,153,.16);
        border-radius: 13px;
    }

        .excel-active-batch strong {
            color: #6ee7b7;
        }

    .excel-result {
        display: none;
        margin-top: 12px;
        padding: 10px 12px;
        font-size: 12px;
        line-height: 1.9;
        border-radius: 12px;
    }

        .excel-result.success {
            display: block;
            color: #a7f3d0;
            background: rgba(16,185,129,.09);
            border: 1px solid rgba(52,211,153,.18);
        }

        .excel-result.error {
            display: block;
            color: #fecdd3;
            background: rgba(225,29,72,.09);
            border: 1px solid rgba(251,113,133,.18);
        }

    .excel-component-card.excel-card-disabled {
        opacity: .70;
        border-style: dashed;
        border-color: rgba(148,163,184,.22);
    }

        .excel-component-card.excel-card-disabled::before {
            background: radial-gradient(circle, rgba(245,158,11,.10), transparent 68%);
        }

        .excel-component-card.excel-card-disabled .excel-component-number {
            color: #fbbf24;
            background: rgba(245,158,11,.08);
            border-color: rgba(245,158,11,.20);
        }

    .excel-disabled-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 150px;
        padding: 18px 12px;
        text-align: center;
        background: rgba(2,6,23,.35);
        border: 1px dashed rgba(148,163,184,.15);
        border-radius: 14px;
    }

    .excel-disabled-text {
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.9;
    }

    /* TAB 4 - SMART ALLOCATION */
    .alloc-steps {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 16px;
    }

    .alloc-step {
        position: relative;
        padding: 11px 10px;
        background: rgba(2,6,23,.45);
        border: 1px solid rgba(34,211,238,.13);
        border-radius: 12px;
    }

    .alloc-step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        margin-bottom: 6px;
        color: #67e8f9;
        background: rgba(6,182,212,.12);
        border: 1px solid rgba(34,211,238,.23);
        border-radius: 7px;
        font-size: 10px;
        font-weight: 900;
    }

    .alloc-step-title {
        color: #e2e8f0;
        font-size: 10px;
        font-weight: 900;
    }

    .alloc-step-text {
        margin-top: 3px;
        color: #64748b;
        font-size: 8px;
        line-height: 1.8;
    }

    .alloc-form-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .alloc-field label {
        display: block;
        margin-bottom: 6px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 800;
    }

    .alloc-field small {
        display: block;
        margin-top: 5px;
        color: #64748b;
        font-size: 8px;
    }

    .alloc-field select.order-input option {
        color: #0f172a;
    }

    .alloc-exclude-check {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        color: #fde68a;
        font-size: 9px;
        cursor: pointer;
    }

        .alloc-exclude-check input {
            accent-color: #fbbf24;
            cursor: pointer;
        }

    #allocResult {
        display: none;
    }

    .alloc-stats {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 9px;
        margin-bottom: 15px;
    }

        .alloc-stats .stat-value {
            font-size: 17px;
        }

    .fill-bar {
        position: relative;
        width: 130px;
        height: 16px;
        margin: 0 auto;
        overflow: hidden;
        background: rgba(2,6,23,.70);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 20px;
    }

    .fill-bar-inner {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        border-radius: 20px;
    }

        .fill-bar-inner.ok {
            background: linear-gradient(90deg, #22d3ee, #34d399);
        }

        .fill-bar-inner.mid {
            background: linear-gradient(90deg, #f59e0b, #fbbf24);
        }

        .fill-bar-inner.low {
            background: linear-gradient(90deg, #e11d48, #fb7185);
        }

    .fill-bar-text {
        position: relative;
        z-index: 1;
        color: #f8fafc;
        font-size: 8px;
        font-weight: 900;
        line-height: 15px;
        text-align: center;
    }

    .role-chip {
        display: inline-block;
        margin: 1px;
        padding: 3px 7px;
        color: #c4b5fd;
        background: rgba(139,92,246,.10);
        border: 1px solid rgba(139,92,246,.22);
        border-radius: 15px;
        font-size: 8px;
    }

    .alloc-table-scroll {
        max-height: 560px;
        overflow: auto;
    }

        .alloc-table-scroll .activity-matrix thead th {
            position: sticky;
            top: 0;
            z-index: 5;
        }

    .alloc-scope-text {
        max-width: 190px;

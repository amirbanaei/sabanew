    </div>


    <!-- =====================================================
         TAB 7 - خروجی کل روز (همه شهرستان‌ها در یک Excel)
         ===================================================== -->

    <div id="tabSeven" class="main-tab-panel" style="display:none">

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>خروجی یکجای یک روز (همه شهرستان‌ها)</h2>
                    <p>همه‌ی تخصیص‌های ذخیره‌شده‌ی آن روز، از هر شهرستان، سرهم در یک فایل Excel</p>
                </div>
            </div>

            <form id="dayExportForm">

                @Html.AntiForgeryToken()

                <div class="alloc-form-grid">

                    <div class="alloc-field">
                        <label>تاریخ (شمسی)</label>
                        <div class="jdate-picker" data-target="exportDate"></div>
                        <input type="hidden" id="exportDate" />
                        <small>شیت‌ها: خلاصه مامورین، عادی، دیماند و ویژه — با ستون شهر</small>
                    </div>

                </div>

                <div class="form-actions">
                    <button type="button" id="exportDay" class="order-btn btn-run">دریافت Excel کل روز</button>
                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         TAB 8 - UNALLOCATED RECORDS (paged, no Excel)
         ===================================================== -->

    <div id="tabEight" class="main-tab-panel" style="display:none">

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>Unallocated Records</h2>
                    <p>View unallocated records here without adding them to the Excel download.</p>
                </div>
            </div>

            <form id="unallocatedForm">
                @Html.AntiForgeryToken()

                <div class="alloc-form-grid">
                    <div class="alloc-field">
                        <label>Allocation date (Jalali)</label>
                        <div class="jdate-picker" data-target="unallocatedDate"></div>
                        <input type="hidden" id="unallocatedDate" />
                    </div>

                    <div class="alloc-field">
                        <label>City</label>
                        <select id="unallocatedCity" class="order-input">
                            @if (!String.IsNullOrWhiteSpace(lockedAllocationCity))
                            {
                                <option value="@lockedAllocationCity" selected="selected">@lockedAllocationCity</option>
                            }
                            else
                            {
                                <option value="">-- Select a city --</option>
                                foreach (var c in allocationCities)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="alloc-field">
                        <label>Previous-list date (optional)</label>
                        <div class="jdate-picker disabled" data-target="unallocatedExcludeDate" data-offset="-1"></div>
                        <input type="hidden" id="unallocatedExcludeDate" />
                        <label class="alloc-exclude-check">
                            <input type="checkbox" id="unallocatedUseExclude" class="use-exclude-check" data-picker="unallocatedExcludeDate" />
                            Exclude records from the previous list
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" id="loadUnallocated" class="order-btn btn-run">Load records</button>
                </div>
            </form>

            <div id="unallocatedError"
                 style="display:none;margin:14px 0;padding:12px;border-radius:9px;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.38);color:#fecaca;white-space:pre-wrap"></div>

            <div id="unallocatedSummary" style="margin:12px 0;color:#cbd5e1"></div>

            <div class="matrix-wrapper alloc-table-scroll">
                <table class="activity-matrix">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>City</th>
                            <th>Region</th>
                            <th>Work day</th>
                            <th>Area</th>
                            <th>Tariff</th>
                            <th>Debt amount</th>
                            <th>Bill ID</th>
                            <th>Subscription</th>
                            <th>Customer type</th>
                        </tr>
                    </thead>
                    <tbody id="unallocatedBody">
                        <tr><td colspan="10">Select a date and click Load records.</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="form-actions" id="unallocatedPager" style="display:none">
                <button type="button" id="unallocatedPrev" class="order-btn">Previous</button>
                <span id="unallocatedPageText" style="padding:10px;color:#cbd5e1"></span>
                <button type="button" id="unallocatedNext" class="order-btn">Next</button>
            </div>

        </div>

    </div>

</div>


<!-- اگر در _Layout.cshtml از قبل jQuery لود شده است، این خط را حذف کنید. -->
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>


<script>

$(document).ready(function () {

    var DEFAULT_ASSIGNMENT_TITLE = "تعیین نقش";
    var DEFAULT_ASSIGNMENT_DESCRIPTION = "";


    /* =====================================================
       URLS  (بدون نام کنترلر → همان کنترلر/Area که صفحه را نمایش داده)
       ===================================================== */

    var urls = {

        // TAB 1
        assignmentSave: '@Url.Action("CreateOrderAssignment")',

        // TAB 2
        scopeSave: '@Url.Action("SaveAgentScope")',
        scopeGet: '@Url.Action("GetAgentScope")',
        scopeDetails: '@Url.Action("GetAgentScopeDetails")',
        scopeRemove: '@Url.Action("DeleteAgentScope")',
        scopeRemoveRegion: '@Url.Action("DeleteAgentScopeRegion")',

        // TAB 3
        componentUpload: '@Url.Action("UploadOrderComponentExcel")',
        componentDisable: '@Url.Action("DisableOrderComponentImport")',

        // TAB 4
        allocationFilters: '@Url.Action("GetAllocationFilterData")',
        allocationPreview: '@Url.Action("PreviewSmartAllocation")',
        allocationRun: '@Url.Action("RunSmartAllocation")',

        // TAB 6
        singleAgents: '@Url.Action("GetSingleAgentList")',
        singlePreview: '@Url.Action("PreviewSingleAllocation")',
        singleRun: '@Url.Action("RunSingleAllocation")',

        // TAB 7
        dayExport: '@Url.Action("ExportDayAllocation")',

        // TAB 8
        unallocatedList: '@Url.Action("GetUnallocatedAllocations")'
    };


    /* =====================================================
       COMMON
       ===================================================== */

    function token(formSelector) {
        return $(formSelector + ' input[name="__RequestVerificationToken"]').val();
    }

    function message(text, type) {
        var box = $("#orderNotification");

        box.stop(true, true)
            .removeClass("success error")
            .addClass(type || "success")
            .text(text || "")
            .fadeIn(150);

        clearTimeout(window.orderMessageTimer);

        window.orderMessageTimer = setTimeout(function () {
            box.fadeOut(200);
        }, 5000);
    }

    /* پیام خطای سرور همراه با کد HTTP (404 = Action پیدا نشد ، 500 = خطای کنترلر) */
    function serverError(xhr, fallback) {
        var status = xhr && xhr.status ? xhr.status : 0;
        var text = fallback || "خطا در ارتباط با سرور.";

        if (status === 404) { text += " (کد 404: Action در کنترلر پیدا نشد)"; }
        else if (status === 500) { text += " (کد 500: خطای داخلی کنترلر)"; }
        else if (status) { text += " (کد " + status + ")"; }

        if (window.console && console.error) {
            console.error(fallback, status, xhr && xhr.responseText);
        }

        message(text, "error");
    }

    /* Extract a readable server error from JSON, plain text, or an HTTP failure. */
    function ajaxErrorText(xhr, fallback) {
        var text = fallback || "A server error occurred.";

        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
            return xhr.responseJSON.message;
        }

        if (xhr && xhr.responseText) {
            try {
                var parsed = JSON.parse(xhr.responseText);
                if (parsed && parsed.message) { return parsed.message; }
            }
            catch (ignore) {
                var plain = $("<div>").html(xhr.responseText).text().replace(/\s+/g, " ").trim();
                if (plain) { text = plain.substring(0, 1200); }
            }
        }

        if (xhr && xhr.status) {
            text += " (HTTP " + xhr.status + ")";
        }

        return text;
    }

    function loading(show) {
        $("#pageLoadingOverlay").toggleClass("show", !!show);
    }

    function htmlEncode(value) {
        return $("<div>").text(value == null ? "" : value).html();
    }

    function reloadOnTab(tabId, delay) {
        sessionStorage.setItem("OrderAssignmentActiveTab", tabId);

        setTimeout(function () {
            window.location.reload();
        }, delay || 0);
    }

    function faNumber(value) {
        return Number(value || 0).toLocaleString("fa-IR");
    }

    function bindListSearch(inputSelector, itemSelector, attrName, lower) {
        $(inputSelector).on("input", function () {
            var q = $.trim($(this).val());
            if (lower) { q = q.toLowerCase(); }

            $(itemSelector).each(function () {
                var text = ($(this).attr(attrName) || "").toString();
                if (lower) { text = text.toLowerCase(); }

                $(this).toggle(!q || text.indexOf(q) >= 0);
            });
        });
    }


    /* =====================================================
       TABS
       ===================================================== */

    $(".main-tab-button").on("click", function () {

        var target = $(this).data("tab");

        $(".main-tab-button").removeClass("active");
        $(this).addClass("active");

        $(".main-tab-panel").hide();
        $("#" + target).show();

        sessionStorage.setItem("OrderAssignmentActiveTab", target);

        // پیغام مهم فقط برای سربرگ اول و دوم
        if ((target === "tabOne" || target === "tabTwo") && window.showImportantNotice) {
            window.showImportantNotice();
        }
    });

    @if (isEmbedded)
    {
        <text>
        $('.main-tab-button[data-tab="tabFour"]').trigger("click");
        </text>
    }
    else
    {
        <text>
        var savedTab = sessionStorage.getItem("OrderAssignmentActiveTab");

        if (savedTab
            && $("#" + savedTab).length
            && $('.main-tab-button[data-tab="' + savedTab + '"]').length) {
            $('.main-tab-button[data-tab="' + savedTab + '"]').trigger("click");
        }
        else if (window.showImportantNotice) {
            window.showImportantNotice();
        }
        </text>
    }


    /* =====================================================
       TAB 1 : TELEPHONE EXCLUSIVE RULE + LIFT RULE
       ===================================================== */

    var isJonobi = @(isJonobi ? "true" : "false");
    var specialCollectionTitle = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(specialCollectionTitle))';
    var telephoneActivityId = @telephoneActivityId;
    var liftActivityId = @liftActivityId;
    var liftCompanionIds = [@string.Join(",", liftCompanionIds)];

    function applyTelephoneRule(userId) {

        if (!telephoneActivityId) { return; }

        var $userChecks = $('.user-activity-check[data-user="' + userId + '"]');
        var $telephone = $userChecks.filter('[data-activity="' + telephoneActivityId + '"]');

        if ($telephone.length === 0) { return; }

        var $otherActivities = $userChecks.not($telephone);

        if ($telephone.is(":checked")) {
            $otherActivities.prop("checked", false).prop("disabled", true);
            $telephone.prop("disabled", false);
        }
        else {
            $otherActivities.prop("disabled", false);
            $telephone.prop("disabled", $otherActivities.filter(":checked").length > 0);
        }
    }

    function applyTelephoneRulesForAll() {
        var userMap = {};

        $(".user-activity-check").each(function () {
            userMap[$(this).data("user")] = true;
        });

        $.each(userMap, function (userId) {
            applyTelephoneRule(userId);
        });
    }

    function isLiftRelatedActivity(activityId) {
        return !!liftActivityId
            && liftCompanionIds.length > 0
            && (activityId === liftActivityId || liftCompanionIds.indexOf(activityId) >= 0);
    }

    // آیا این ردیف «بالابری» دارد ولی «عادی» و «دیماند» ندارد؟
    function liftRowViolates($row) {

        if (!liftActivityId || !liftCompanionIds.length) { return false; }

        var hasLift = $row
            .find('.user-activity-check[data-activity="' + liftActivityId + '"]')
            .is(":checked");

        if (!hasLift) { return false; }

        var hasCompanion = false;

        $.each(liftCompanionIds, function (_, id) {
            if ($row.find('.user-activity-check[data-activity="' + id + '"]').is(":checked")) {
                hasCompanion = true;
                return false;
            }
        });

        return !hasCompanion;
    }

    function findLiftRuleViolations() {
        var bad = [];

        $("#assignmentMatrix .user-activity-row").each(function () {
            if (liftRowViolates($(this))) { bad.push($(this)); }
        });

        return bad;
    }

    function refreshLiftRowErrors() {
        var count = 0;

        $("#assignmentMatrix .user-activity-row").each(function () {
            var violates = liftRowViolates($(this));

            $(this).toggleClass("row-error", violates);

            if (violates) { count++; }
        });

        return count;
    }


    /* =====================================================
       TAB 1 : MASTER CHECKBOX
       ===================================================== */

    function updateAssignmentMasters() {

        $(".column-select-all").each(function () {

            var master = $(this);
            var activityId = master.data("activity");

            var items = $('.user-activity-check[data-activity="' + activityId + '"]:not(:disabled)');
            var checked = items.filter(":checked").length;

            master.prop("disabled", items.length === 0);

            if (items.length > 0 && checked === items.length) {
                master.prop("checked", true).prop("indeterminate", false);
            }
            else if (checked > 0) {
                master.prop("checked", false).prop("indeterminate", true);
            }
            else {
                master.prop("checked", false).prop("indeterminate", false);
            }
        });
    }

    $(".column-select-all").on("change", function () {

        var activity = $(this).data("activity");
        var checked = $(this).is(":checked");

        $('.user-activity-check[data-activity="' + activity + '"]:not(:disabled)').prop("checked", checked);

        applyTelephoneRulesForAll();
        updateAssignmentMasters();

        if (isLiftRelatedActivity(parseInt(activity, 10))) {

            var violations = refreshLiftRowErrors();

            if (violations > 0) {
                message(
                    "برای " + violations + " نفر، در صورت انتخاب «بالابری»، " +
                    "باید «عادی» یا «دیماند» (یا هر دو) را هم انتخاب کنید.",
                    "error"
                );
            }
        }
    });

    $(document).on("change", ".user-activity-check", function () {

        applyTelephoneRule($(this).data("user"));
        updateAssignmentMasters();

        var $row = $(this).closest(".user-activity-row");
        var activityId = parseInt($(this).data("activity"), 10);

        if (isLiftRelatedActivity(activityId)) {

            var violates = liftRowViolates($row);

            $row.toggleClass("row-error", violates);

            if (violates) {
                message(
                    "برای «" + $.trim($row.find(".person-name").text()) + "» " +
                    "در صورت انتخاب «بالابری»، باید «عادی» یا «دیماند» (یا هر دو) را هم انتخاب کنید.",
                    "error"
                );
            }
        }
    });


    /* =====================================================
       TAB 1 : SEARCH
       ===================================================== */

    bindListSearch("#matrixUserSearch", "#assignmentMatrix .user-activity-row", "data-search", true);

    $(document).on("input", ".summary-cell-search", function () {

        var cell = $(this).closest(".summary-cell-box");
        var query = $.trim($(this).val()).toLowerCase();
        var visibleCount = 0;

        cell.find(".summary-person-item").each(function () {

            var text = ($(this).attr("data-search") || "").toLowerCase();
            var visible = !query || text.indexOf(query) >= 0;

            $(this).toggle(visible);

            if (visible) { visibleCount++; }
        });

        var total = parseInt(cell.find(".summary-person-count").attr("data-total") || "0");

        cell.find(".summary-search-result-count").text(query ? visibleCount + " از " + total : "همه");
        cell.find(".summary-no-result").toggle(!!query && visibleCount === 0);
        cell.find(".summary-person-scroll").scrollTop(0);
    });


    /* =====================================================
       TAB 1 : SAVE
       ===================================================== */

    function selectedPairs() {
        var result = [];

        $(".user-activity-check:checked").each(function () {
            result.push($(this).data("user") + "_" + $(this).data("activity"));
        });

        return result;
    }

    // همه کاربران ارسال می‌شوند؛ حتی کاربری که هیچ تیکی ندارد
    function allMatrixUsers() {
        var map = {};

        $(".user-activity-check").each(function () {
            map[$(this).data("user")] = true;
        });

        return Object.keys(map);
    }

    var assignmentSaving = false;

    $("#assignmentForm").on("submit", function (e) {

        e.preventDefault();

        if (assignmentSaving) { return; }

        var allUserIds = allMatrixUsers();
        var pairs = selectedPairs();

        if (allUserIds.length === 0) {
            message("هیچ نیرویی برای ثبت وجود ندارد.", "error");
            return;
        }

        // قانون بالابری: همراه با «عادی» یا «دیماند»
        $("#assignmentMatrix .user-activity-row").removeClass("row-error");

        var liftViolations = findLiftRuleViolations();

        if (liftViolations.length) {

            var names = $.map(liftViolations.slice(0, 3), function ($row) {
                $row.addClass("row-error");
                return $.trim($row.find(".person-name").text());
            });

            $.each(liftViolations.slice(3), function (_, $row) { $row.addClass("row-error"); });

            message(
                "در صورت انتخاب «بالابری»، انتخاب «عادی» یا «دیماند» نیز الزامی است. " +
                "نیروهای دارای مشکل: " + names.join("، ") +
                (liftViolations.length > 3 ? " و " + (liftViolations.length - 3) + " نفر دیگر" : ""),
                "error"
            );

            var $first = liftViolations[0];
            var $scroller = $first.closest(".matrix-scroll-20");

            if ($scroller.length) {
                $scroller.animate({
                    scrollTop: $scroller.scrollTop() + $first.position().top - 120
                }, 250);
            }

            return;
        }

        assignmentSaving = true;

        var $submitButton = $(this).find(":submit");

        $submitButton.prop("disabled", true);
        loading(true);

        $.ajax({
            url: urls.assignmentSave,
            type: "POST",
            traditional: true,
            data: {
                __RequestVerificationToken: token("#assignmentForm"),
                Title: DEFAULT_ASSIGNMENT_TITLE,
                Description: DEFAULT_ASSIGNMENT_DESCRIPTION,
                UserIds: allUserIds,
                UserActivityPairs: pairs
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    reloadOnTab("tabOne", 0);
                }
                else {
                    message(r && r.message ? r.message : "عملیات انجام نشد.", "error");
                }
            },
            error: function (xhr) {
                serverError(xhr, "خطا در ذخیره تعیین نقش.");
            },
            complete: function () {
                assignmentSaving = false;
                $submitButton.prop("disabled", false);
                loading(false);
            }
        });
    });

    $("#clearAssignment").on("click", function () {

        $(".user-activity-check").prop("checked", false).prop("disabled", false);

        $("#assignmentMatrix .user-activity-row").removeClass("row-error");

        $(".column-select-all").prop("checked", false).prop("indeterminate", false);
    });


    /* =====================================================
       TAB 2 : SEARCH
       ===================================================== */

    bindListSearch("#scopeUserSearch", ".scope-user-option", "data-search", true);
    bindListSearch("#scopeRegionSearch", ".scope-region-option", "data-search", true);
    bindListSearch("#scopeWorkDaySearch", ".scope-workday-option", "data-search", false);
    bindListSearch("#scopeSearch", ".scope-data-row", "data-name", true);


    /* =====================================================
       TAB 2 : SELECT ALL (+ حالت بینابین «انتخاب همه»)
       ===================================================== */

    function syncMaster(masterSel, itemSel) {
        var $items = $(itemSel);
        var checked = $items.filter(":checked").length;

        $(masterSel)
            .prop("checked", $items.length > 0 && checked === $items.length)
            .prop("indeterminate", checked > 0 && checked < $items.length);
    }

    function syncScopeMasters() {
        syncMaster("#scopeAllUsers", ".scope-user-option:not(.scope-user-hidden) .scope-user-check");
        syncMaster("#scopeAllRegions", ".scope-region-check");
        syncMaster("#scopeAllWorkDays", ".scope-workday-check");
        syncMaster("#scopeAllAreas", ".scope-area-check");
        syncMaster("#scopeAllTariffs", ".scope-tariff-check");

        $("#scopeNoNewUsers").toggle($(".scope-user-option:not(.scope-user-hidden)").length === 0);
    }

    // ماموران ثبت‌شده دوباره پنهان و بدون تیک می‌شوند؛ بقیه تیک‌خورده
    function restoreScopeUsers() {

        $(".scope-user-editing")
            .removeClass("scope-user-editing")
            .addClass("scope-user-hidden")
            .find(".scope-user-check").prop("checked", false);

        $(".scope-user-option:not(.scope-user-hidden)")
            .find(".scope-user-check").prop("disabled", false).prop("checked", true);
    }

    $("#scopeAllUsers").on("change", function () {
        $(".scope-user-option:visible").find(".scope-user-check:not(:disabled)").prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllRegions").on("change", function () {
        $(".scope-region-option:visible").find(".scope-region-check").prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllWorkDays").on("change", function () {
        $(".scope-workday-option:visible").find(".scope-workday-check").prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllAreas").on("change", function () {
        $(".scope-area-check").prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllTariffs").on("change", function () {
        $(".scope-tariff-check").prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $(document).on("change",
        ".scope-user-check, .scope-region-check, .scope-workday-check, .scope-area-check, .scope-tariff-check",
        syncScopeMasters);


    /* =====================================================
       TAB 2 : HELPERS
       ===================================================== */

    function scopeValues(selector) {
        var result = [];

        $(selector + ":checked").each(function () {
            result.push(parseInt($(this).val(), 10));
        });

        return result;
    }

    // اگر همه موارد تیک‌خورده باشند یعنی «بدون محدودیت» → آرایه خالی
    function selectedOrAll(selector) {
        var total = $(selector).length;
        var values = scopeValues(selector);

        return values.length === total ? [] : values;
    }

    // [22,23,24,25,27,28,29] → "22 تا 25، 27 تا 29"
    function compressDays(list) {

        var s = $.map(list, function (x) { return parseInt(x, 10); })
                 .sort(function (a, b) { return a - b; });

        var parts = [], i = 0;

        while (i < s.length) {
            var j = i;
            while (j + 1 < s.length && s[j + 1] === s[j] + 1) { j++; }
            parts.push(j > i ? s[i] + " تا " + s[j] : "" + s[i]);
            i = j + 1;
        }

        return parts.join("، ");
    }

    function tariffTitle(id) {
        return $.trim($('.scope-tariff-check[value="' + id + '"]').closest("label").find(".scope-text").text());
    }


    /* =====================================================
       TAB 2 RULES  { regionCode : {GroupNo, Days, Tariffs, Areas} }
       ===================================================== */

    var scopeRules = {};

    // حالت ویرایش: { region, group } برای ویرایش همان گروه؛ null = گروه جدید
    var scopeEdit = null;

    // حالت «+ گروه»: گروه جدید باید حداقل یک محدودیت داشته باشد
    var scopeAddGroup = false;

    // مامور «همه مناطق»: وقتی برای چند منطقه گروه می‌سازید، بقیه‌ی مناطق با تنظیم قبلی‌شان صریح ثبت می‌شوند
    // { days: [...], tariffs: [...], areas: [...] }
    var scopeFill = null;

    function allRegionCodes() {
        return $.map($(".scope-region-check"), function (el) { return parseInt($(el).val(), 10); });
    }

    function renderScopeRules() {
        // لیست قوانین فعلاً در صفحه نمایش داده نمی‌شود (در صورت نیاز #scopeRuleList اضافه کنید)
    }

    // حالت پیش‌فرض: همه مناطق، روزکارها، محدوده‌ها و تعرفه‌ها تیک‌خورده
    function resetScopeSelection() {
        $(".scope-region-check, .scope-workday-check, .scope-area-check, .scope-tariff-check").prop("checked", true);
        $("#workDayFrom, #workDayTo").val("");
        syncScopeMasters();
    }

    function numAsc(a, b) { return a - b; }

    // انتخاب فعلی فرم → برای هر منطقه‌ی تیک‌خورده یک قانون (گروه)
    // روزکار/تعرفه/محدوده‌ی خالی یعنی همه (بدون محدودیت)
    function currentSelectionRules() {

        var days = selectedOrAll(".scope-workday-check").sort(numAsc);
        var tariffs = selectedOrAll(".scope-tariff-check").sort(numAsc);
        var areas = selectedOrAll(".scope-area-check").sort(numAsc);

        var result = {};

        $.each(scopeValues(".scope-region-check"), function (_, r) {
            result[r] = {
                GroupNo: (scopeEdit && scopeEdit.region === r) ? scopeEdit.group : 0,
                Days: days.slice(),
                Tariffs: tariffs.slice(),
                Areas: areas.slice()
            };
        });

        return result;
    }

    function addSelectionAsRule(showError) {

        var selection = currentSelectionRules();

        if (!Object.keys(selection).length) {
            if (showError) { message("حداقل یک @scopeRegionTitle انتخاب کنید.", "error"); }
            return false;
        }

        $.extend(scopeRules, selection);

        resetScopeSelection();
        renderScopeRules();

        return true;
    }

    $("#applyWorkDayRange").on("click", function () {

        var from = parseInt($("#workDayFrom").val(), 10);
        var to = parseInt($("#workDayTo").val(), 10);

        if (isNaN(from) || isNaN(to) || from < 1 || to > 99 || from > to) {
            message("بازه روزکار معتبر نیست (بین 1 تا 99).", "error");
            return;
        }

        $(".scope-workday-check").each(function () {
            var v = parseInt($(this).val(), 10);
            $(this).prop("checked", v >= from && v <= to);
        });

        syncScopeMasters();
    });


    /* =====================================================
       TAB 2 : SAVE
       ===================================================== */

    $("#agentScopeForm").on("submit", function (e) {

        e.preventDefault();

        var selectedUserIds = scopeValues(".scope-user-check");

        if (selectedUserIds.length === 0) {
            message("حداقل یک مامور انتخاب کنید.", "error");
            return;
        }

        // هر چهار بخش باید حداقل یک مورد تیک‌خورده داشته باشند
        var missing = [];

        if (scopeValues(".scope-region-check").length === 0) { missing.push("@scopeRegionTitle"); }
        if (scopeValues(".scope-workday-check").length === 0) { missing.push("روزکار"); }
        if (scopeValues(".scope-area-check").length === 0) { missing.push("@scopeAreaTitle"); }
        if (scopeValues(".scope-tariff-check").length === 0) { missing.push("نوع تعرفه"); }

        if (missing.length) {
            message("برای ثبت باید حداقل یک مورد از این بخش‌ها انتخاب شود: " + missing.join("، "), "error");
            return;
        }

        // گروه جدید بدون هیچ محدودیتی، کل منطقه را بدون محدودیت می‌کند
        if (scopeAddGroup
            && selectedOrAll(".scope-workday-check").length === 0
            && selectedOrAll(".scope-area-check").length === 0
            && selectedOrAll(".scope-tariff-check").length === 0) {
            message("برای گروه جدید، حداقل یکی از روزکار، محدوده یا نوع تعرفه باید محدود شود (همه تیک‌خورده نباشد).", "error");
            return;
        }

        // هر منطقه‌ی تیک‌خورده یک قانون (گروه) می‌سازد؛ فرم بعد از خطا دست‌نخورده می‌ماند
        var allRules = $.extend({}, scopeRules, currentSelectionRules());

        // مامور «همه مناطق»: بقیه‌ی مناطق با تنظیم قبلی‌شان صریح ثبت می‌شوند
        if (scopeFill) {
            $.each(allRegionCodes(), function (_, r) {
                if (!allRules.hasOwnProperty(r)) {
                    allRules[r] = {
                        GroupNo: 0,
                        Days: scopeFill.days.slice(),
                        Tariffs: scopeFill.tariffs.slice(),
                        Areas: scopeFill.areas.slice()
                    };
                }
            });
        }

        var rulesArray = $.map(Object.keys(allRules), function (k) {
            return {
                Region: parseInt(k, 10),
                GroupNo: allRules[k].GroupNo || 0,
                Days: allRules[k].Days,
                Tariffs: allRules[k].Tariffs,
                Areas: allRules[k].Areas
            };
        });

        loading(true);

        $.ajax({
            url: urls.scopeSave,
            type: "POST",
            traditional: true,
            data: {
                __RequestVerificationToken: token("#agentScopeForm"),
                UserIds: selectedUserIds,
                RulesJson: JSON.stringify(rulesArray)
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    reloadOnTab("tabTwo", 450);
                }
                else {
                    message(r && r.message ? r.message : "ثبت انجام نشد.", "error");
                }
            },
            error: function (xhr) {
                serverError(xhr, "خطا در ذخیره تنظیمات ارجاع.");
            },
            complete: function () {
                loading(false);
            }
        });
    });


    /* =====================================================
       TAB 2 : EDIT ONE REGION / GROUP
       ===================================================== */

    $(document).on("click", ".edit-scope-region", function () {

        var userId = $(this).data("user");
        var region = parseInt($(this).data("region"), 10);

        function parseList(el, attr) {
            return ("" + ($(el).attr(attr) || ""))
                .split(",")
                .filter(function (x) { return x !== ""; })
                .map(function (x) { return parseInt(x, 10); });
        }

        var days = parseList(this, "data-days");
        var tariffIds = parseList(this, "data-tariffs");
        var areaIds = parseList(this, "data-areas");

        scopeRules = {};
        scopeAddGroup = false;
        scopeFill = null;
        scopeEdit = region > 0
            ? { region: region, group: parseInt($(this).attr("data-group"), 10) || 0 }
            : null;
        renderScopeRules();

        // فقط همین مامور (ثبت‌شده‌ها پنهان‌اند؛ مامور در حال ویرایش موقتاً نمایش داده می‌شود)
        restoreScopeUsers();
        $(".scope-user-check").prop("checked", false);

        $('.scope-user-check[value="' + userId + '"]')
            .prop("checked", true)
            .closest(".scope-user-option")
            .removeClass("scope-user-hidden")
            .addClass("scope-user-editing");

        // منطقه: region = 0 یعنی همه مناطق
        $(".scope-region-check").prop("checked", region <= 0);
        if (region > 0) {
            $('.scope-region-check[value="' + region + '"]').prop("checked", true);
        }

        // روزکار: لیست خالی یعنی همه روزها
        $(".scope-workday-check").prop("checked", days.length === 0);
        $.each(days, function (_, d) {
            $('.scope-workday-check[value="' + d + '"]').prop("checked", true);
        });

        // جنوبی: منطقه 0 تا 60 ـ سیستان: محدوده 0 تا 45؛ لیست خالی یعنی همه
        $(".scope-area-check").prop("checked", areaIds.length === 0);
        $.each(areaIds, function (_, a) {
            $('.scope-area-check[value="' + a + '"]').prop("checked", true);
        });

        // تعرفه: لیست خالی یعنی همه تعرفه‌ها
        $(".scope-tariff-check").prop("checked", tariffIds.length === 0);
        $.each(tariffIds, function (_, t) {
            $('.scope-tariff-check[value="' + t + '"]').prop("checked", true);
        });

        $("#workDayFrom, #workDayTo").val("");

        // جستجوهای فعال پاک شود تا همه موارد دیده شوند
        $("#scopeUserSearch, #scopeRegionSearch, #scopeWorkDaySearch").val("").trigger("input");

        syncScopeMasters();

        $(".main-tab-button").removeClass("active");
        $('.main-tab-button[data-tab="tabTwo"]').addClass("active");
        $(".main-tab-panel").hide();
        $("#tabTwo").show();

        sessionStorage.setItem("OrderAssignmentActiveTab", "tabTwo");

        $("html,body").animate({ scrollTop: $("#scopeFormCard").offset().top - 30 }, 250);

        message("روزکار، محدوده و تعرفه را تغییر دهید و «ذخیره اطلاعات» را بزنید (فقط همین گروه ویرایش می‌شود).", "success");
    });


    /* =====================================================
       TAB 2 : ADD ANOTHER REGION FOR A SAVED AGENT
       ===================================================== */

    $(document).on("click", ".add-scope-region", function () {

        var userId = $(this).data("user");

        scopeRules = {};
        scopeEdit = null;
        scopeAddGroup = false;
        scopeFill = null;
        renderScopeRules();

        restoreScopeUsers();
        $(".scope-user-check").prop("checked", false);

        $('.scope-user-check[value="' + userId + '"]')
            .prop("checked", true)
            .closest(".scope-user-option")
            .removeClass("scope-user-hidden")
            .addClass("scope-user-editing");

        // مناطق را خودِ کاربر انتخاب می‌کند؛ روزکار، محدوده و تعرفه پیش‌فرض (همه)
        $(".scope-region-check").prop("checked", false);
        $(".scope-workday-check, .scope-area-check, .scope-tariff-check").prop("checked", true);

        $("#workDayFrom, #workDayTo").val("");
        $("#scopeUserSearch, #scopeRegionSearch, #scopeWorkDaySearch").val("").trigger("input");

        syncScopeMasters();

        $(".main-tab-button").removeClass("active");
        $('.main-tab-button[data-tab="tabTwo"]').addClass("active");
        $(".main-tab-panel").hide();
        $("#tabTwo").show();

        sessionStorage.setItem("OrderAssignmentActiveTab", "tabTwo");

        $("html,body").animate({ scrollTop: $("#scopeFormCard").offset().top - 30 }, 250);

        message("منطقه(های) جدید را تیک بزنید، روزکار/محدوده/تعرفه‌شان را تعیین کنید و «ذخیره اطلاعات» را بزنید. مناطق قبلی مامور تغییر نمی‌کند.", "success");
    });


    /* =====================================================
       TAB 2 : ADD ANOTHER GROUP FOR A REGION
       - مامور «همه مناطق» (data-virtual=1): منطقه(های) گروه را کاربر تیک می‌زند
       - مامور با مناطق ثبت‌شده: فقط همان منطقه انتخاب می‌شود
       ===================================================== */

    $(document).on("click", ".add-scope-group", function () {

        var userId = $(this).data("user");
        var isVirtual = $(this).attr("data-virtual") === "1";
        var region = parseInt($(this).attr("data-region"), 10);

        function list(el, attr) {
            return ("" + ($(el).attr(attr) || ""))
                .split(",")
                .filter(function (x) { return x !== ""; })
                .map(function (x) { return parseInt(x, 10); });
        }

        scopeRules = {};
        renderScopeRules();

        scopeEdit = null;
        scopeAddGroup = true;

        scopeFill = isVirtual
            ? { days: list(this, "data-days"), tariffs: list(this, "data-tariffs"), areas: list(this, "data-areas") }
            : null;

        restoreScopeUsers();
        $(".scope-user-check").prop("checked", false);

        $('.scope-user-check[value="' + userId + '"]')
            .prop("checked", true)
            .closest(".scope-user-option")
            .removeClass("scope-user-hidden")
            .addClass("scope-user-editing");

        $(".scope-region-check").prop("checked", false);

        if (!isVirtual) {
            $('.scope-region-check[value="' + region + '"]').prop("checked", true);
        }

        $(".scope-workday-check, .scope-area-check, .scope-tariff-check").prop("checked", true);
        $("#workDayFrom, #workDayTo").val("");
        $("#scopeUserSearch, #scopeRegionSearch, #scopeWorkDaySearch").val("").trigger("input");

        syncScopeMasters();

        $(".main-tab-button").removeClass("active");
        $('.main-tab-button[data-tab="tabTwo"]').addClass("active");
        $(".main-tab-panel").hide();
        $("#tabTwo").show();

        sessionStorage.setItem("OrderAssignmentActiveTab", "tabTwo");

        $("html,body").animate({ scrollTop: $("#scopeFormCard").offset().top - 30 }, 250);

        message(isVirtual
            ? "منطقه(های) این گروه را تیک بزنید، روزکار/محدوده/تعرفه‌ی گروه را تعیین کنید و «ذخیره اطلاعات» را بزنید. مناطق دیگر مامور با تنظیم قبلی‌شان ثبت می‌شوند."
            : "گروه جدید برای منطقه " + region + ": روزکار، محدوده و تعرفه‌ی این گروه را تیک بزنید و «ذخیره اطلاعات» را بزنید.",
            "success");
    });


    /* TAB 2 CLEAR (برگشت به حالت پیش‌فرض: همه چیز تیک‌خورده) */

    $("#clearAgentScope").on("click", function () {

        scopeRules = {};
        scopeEdit = null;
        scopeAddGroup = false;
        scopeFill = null;
        renderScopeRules();

        resetScopeSelection();
        restoreScopeUsers();
        syncScopeMasters();
    });


    /* TAB 2 DELETE ONE REGION / GROUP */

    $(document).on("click", ".delete-scope-region", function () {

        var id = $(this).data("id");
        var region = $(this).data("region");
        var group = $(this).data("group") || 0;

        if (!confirm(group > 0
            ? "این گروه (روزکار، محدوده و تعرفه‌اش) از تنظیمات مامور حذف شود؟"
            : "این منطقه (و روزکار، تعرفه و محدوده‌اش) از تنظیمات مامور حذف شود؟")) { return; }

        loading(true);

        $.ajax({
            url: urls.scopeRemoveRegion,
            type: "POST",
            data: {
                __RequestVerificationToken: token("#agentScopeForm"),
                id: id,
                region: region,
                group: group
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    reloadOnTab("tabTwo", 400);
                }
                else {
                    message(r && r.message ? r.message : "حذف انجام نشد.", "error");
                }
            },
            error: function (xhr) {
                serverError(xhr, "خطا در حذف اطلاعات.");
            },
            complete: function () {
                loading(false);
            }
        });
    });


    /* TAB 2 DELETE (کل مامور) */

    $(document).on("click", ".delete-agent-scope", function () {

        var id = $(this).data("id");

        if (!confirm("آیا اطلاعات این مامور حذف شود؟")) { return; }

        loading(true);

        $.ajax({
            url: urls.scopeRemove,
            type: "POST",
            data: {
                __RequestVerificationToken: token("#agentScopeForm"),
                id: id
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    reloadOnTab("tabTwo", 400);
                }
                else {
                    message(r && r.message ? r.message : "حذف انجام نشد.", "error");
                }
            },
            error: function (xhr) {
                serverError(xhr, "خطا در حذف اطلاعات.");
            },
            complete: function () {
                loading(false);
            }
        });
    });


    /* TAB 2 DETAILS */

    $(document).on("click", ".details-agent-scope", function () {

        var id = $(this).data("id");

        loading(true);

        $.ajax({
            url: urls.scopeDetails,
            type: "GET",
            data: { id: id },
            success: function (r) {

                if (!r || !r.success) {
                    message(r && r.message ? r.message : "اطلاعات دریافت نشد.", "error");
                    return;
                }

                var d = r.data;
                var rulesHtml = "";
                var tariffMap = {};

                $.each(d.TariffTypes || [], function (_, t) {
                    tariffMap[t.ID] = t.Title;
                });

                // «همه» به‌صورت مقدارهای واقعی نمایش داده می‌شود
                var allTariffsText = $.map($(".scope-tariff-check"), function (el) {
                    return tariffTitle($(el).val());
                }).join("، ") || "همه";

                var allRegionsText = compressDays($.map($(".scope-region-check"), function (el) {
                    return parseInt($(el).val(), 10);
                })) || "همه";

                function ruleLine(regionText, x) {

                    var tariffText = (x.Tariffs && x.Tariffs.length)
                        ? $.map(x.Tariffs, function (tid) { return tariffMap[tid] || tid; }).join("، ")
                        : allTariffsText;

                    return "<div>" + regionText + ": " +
                        "روزکار " + ((x.Days && x.Days.length) ? compressDays(x.Days) : "1 تا 99") +
                        " | تعرفه " + htmlEncode(tariffText) +
                        " | @scopeAreaTitle " + ((x.Areas && x.Areas.length && x.Areas.length < @AreaTotal) ? compressDays(x.Areas) : "@allAreasText") +
                        "</div>";
                }

                var groupCount = {};

                $.each(d.Rules || [], function (_, x) {
                    groupCount[x.Region] = (groupCount[x.Region] || 0) + 1;
                });

                $.each(d.Rules || [], function (_, x) {
                    var label = x.Region ? "@scopeRegionTitle " + x.Region : "همه @scopeRegionsTitle";

                    if (groupCount[x.Region] > 1) { label += " - گروه " + x.GroupNo; }

                    rulesHtml += ruleLine(label, x);
                });

                // مامور بدون قاعده: همه مناطق، روزکارها، تعرفه‌ها و محدوده‌ها
                if (!rulesHtml) {
                    rulesHtml = ruleLine("@scopeRegionTitle " + allRegionsText, {});
                }

                var html = "";

                html += "<div class='detail-row'><div>نام مامور</div><div>" + htmlEncode(d.FullName) + "</div></div>";
                html += "<div class='detail-row'><div>کد ملی</div><div>" + htmlEncode(d.NationalCode) + "</div></div>";
                html += "<div class='detail-row'><div>@scopeRegionsTitle، روزکار، تعرفه و @scopeAreaTitle</div><div>" + rulesHtml + "</div></div>";

                $("#scopeDetailsContent").html(html);
                $("#scopeDetailsModal").addClass("show");
            },
            error: function (xhr) {
                serverError(xhr, "خطا در دریافت جزئیات.");
            },
            complete: function () {
                loading(false);
            }
        });
    });

    $("#closeScopeDetails").on("click", function () {
        $("#scopeDetailsModal").removeClass("show");
    });

    $("#scopeDetailsModal").on("click", function (e) {
        if (e.target === this) { $(this).removeClass("show"); }
    });


    /* =====================================================
       TAB 3 : FILE NAME / UPLOAD / DISABLE
       ===================================================== */

    $(document).on("change", ".component-excel-file", function () {

        var fileName = this.files && this.files.length
            ? this.files[0].name
            : "فایلی انتخاب نشده است";

        $(this).closest(".excel-file-picker").find(".excel-selected-file").text(fileName);
    });

    $(document).on("submit", ".component-upload-form", function (e) {

        e.preventDefault();

        var form = this;
        var $form = $(form);
        var fileInput = $form.find(".component-excel-file")[0];
        var $result = $form.find(".excel-result");

        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
            $result.removeClass("success").addClass("error").text("ابتدا فایل Excel را انتخاب کنید.");
            return;
        }

        var formData = new FormData(form);

        formData.append("componentType", $form.data("component-type"));

        var $button = $form.find(".excel-upload-button");

        $button.prop("disabled", true);
        loading(true);

        $.ajax({
            url: urls.componentUpload,
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (r) {

                if (r && r.success) {
                    $result.removeClass("error").addClass("success").text(r.message);
                    message(r.message, "success");
                    reloadOnTab("tabThree", 0);
                }
                else {
                    var errorText = r && r.message ? r.message : "بارگذاری فایل انجام نشد.";

                    if (r && r.errors && r.errors.length) {
                        errorText += " | " + r.errors.join(" | ");
                    }

                    $result.removeClass("success").addClass("error").text(errorText);
                    message(errorText, "error");
                }
            },
            error: function (xhr) {
                var errorText = "خطا در ارتباط با سرور هنگام بارگذاری فایل.";

                $result.removeClass("success").addClass("error").text(errorText);
                serverError(xhr, errorText);
            },
            complete: function () {
                $button.prop("disabled", false);
                loading(false);
            }
        });
    });

    $(document).on("click", ".disable-component-import", function () {

        var $button = $(this);

        if (!confirm("آیا فایل فعال این مؤلفه غیرفعال شود؟")) { return; }

        $button.prop("disabled", true);
        loading(true);

        $.ajax({
            url: urls.componentDisable,
            type: "POST",
            data: {
                __RequestVerificationToken: $button
                    .closest(".component-upload-form")
                    .find('input[name="__RequestVerificationToken"]')
                    .val(),
                id: $button.data("id")
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    reloadOnTab("tabThree", 0);
                }
                else {
                    message(r && r.message ? r.message : "غیرفعال‌سازی انجام نشد.", "error");
                    $button.prop("disabled", false);
                }
            },
            error: function (xhr) {
                serverError(xhr, "خطا در غیرفعال‌سازی فایل.");
                $button.prop("disabled", false);
            },
            complete: function () {
                loading(false);
            }
        });
    });


    /* =====================================================
       TAB 4 : HELPERS
       ===================================================== */

    function checkedValues(selector) {
        var result = [];

        $(selector + ":checked").each(function () {
            result.push(parseInt($(this).val(), 10));
        });

        return result;
    }

    // تاریخ لیست قبلی: فقط وقتی تیک «حذف پرونده‌های لیست قبلی» روشن است ارسال می‌شود
    function excludeDateValue(checkSelector, hiddenSelector) {
        return $(checkSelector).is(":checked") ? $.trim($(hiddenSelector).val()) : "";
    }

    function allocationDaysValue(selector) {
        return $.trim($(selector).val() || "")
            .replace(/[۰-۹]/g, function (d) { return "۰۱۲۳۴۵۶۷۸۹".indexOf(d); })
            .replace(/[٠-٩]/g, function (d) { return "٠١٢٣٤٥٦٧٨٩".indexOf(d); });
    }

    function validateAllocationDays(selector) {
        if (!isJonobi) { return true; }
        var value = allocationDaysValue(selector);
        if (!/^[0-9]+$/.test(value) || Number(value) < 1 || Number(value) > 2147483647) {
            message("تعداد روز لیست را به‌صورت عدد صحیح مثبت وارد کنید (مثلاً 7).", "error");
            $(selector).focus();
            return false;
        }
        return true;
    }

    function updateCountLimitHint(prefix) {
        var days = allocationDaysValue("#" + prefix + "AllocationDays");
        var valid = /^[0-9]+$/.test(days) && Number(days) >= 1 && Number(days) <= 2147483647;
        $("#" + prefix + "CountLimit").text(valid
            ? "حداکثر " + faNumber(Number(days) * 60) + " پرونده برای هر مأمور" : "");
    }
    $("#allocAllocationDays, #singleAllocationDays").on("input", function () {
        updateCountLimitHint(this.id === "allocAllocationDays" ? "alloc" : "single");
    });

    $("#allocAllocationDays").on("input", function () { $("#allocResult").hide(); });
    $("#allocManualDailyStandard").on("input", function () { $("#allocResult").hide(); });
    $("#singleAllocationDays").on("input", function () { $("#singleResult").hide(); });
    $("#singleManualDailyStandard").on("input", function () { $("#singleResult").hide(); });

    function allocationFormData() {
        return {
            __RequestVerificationToken: token("#smartAllocationForm"),
            sourceCity: $("#allocSourceCity").val(),
            targetCity: $.trim($("#allocTargetCity").val()),
            specialThreshold: $.trim($("#allocSpecialThreshold").val()),
            allocationDays: isJonobi ? allocationDaysValue("#allocAllocationDays") : "",
            manualDailyStandard: isJonobi ? $.trim($("#allocManualDailyStandard").val() || "") : "",
            sourceDate: $.trim($("#allocSourceDate").val()),
            excludeDate: excludeDateValue("#allocUseExclude", "#allocExcludeDate"),
            RegionIds: checkedValues(".alloc-region-check"),
            WorkDays: checkedValues(".alloc-workday-check")
        };
    }

    function validDateText(text) {
        return /^\d{4}[\/\-.]\d{1,2}[\/\-.]\d{1,2}$/.test(
            (text || "")
                .replace(/[۰-۹]/g, function (d) { return "۰۱۲۳۴۵۶۷۸۹".indexOf(d); })
                .replace(/[٠-٩]/g, function (d) { return "٠١٢٣٤٥٦٧٨٩".indexOf(d); }));
    }

    function validateAllocationSelection() {
        if (!validateAllocationDays("#allocAllocationDays")) { return false; }

        if (!validDateText($("#allocSourceDate").val())) {
            message("تاریخ ثبت تخصیص را به‌صورت شمسی وارد کنید (مثال: 1405/07/12).", "error");
            return false;
        }

        if ($("#allocUseExclude").is(":checked")) {

            if (!validDateText($("#allocExcludeDate").val())) {
                message("تاریخ لیست قبلی را به‌صورت شمسی وارد کنید.", "error");
                return false;
            }

            if ($.trim($("#allocExcludeDate").val()) === $.trim($("#allocSourceDate").val())) {
                message("تاریخ لیست قبلی نباید با تاریخ ثبت تخصیص یکی باشد.", "error");
                return false;
            }
        }

        if (checkedValues(".alloc-region-check").length === 0) {
            message("حداقل یک @scopeRegionTitle انتخاب کنید.", "error");
            return false;
        }

        if (checkedValues(".alloc-workday-check").length === 0) {
            message("حداقل یک روزکار انتخاب کنید.", "error");
            return false;
        }

        return true;
    }


    /* دریافت فایل (Excel) با fetch تا خطاهای JSON هم نمایش داده شوند */
    function downloadExcel(url, formDataObject, defaultName, errorFallback) {

        var body = new FormData();

        $.each(formDataObject, function (k, v) {
            if ($.isArray(v)) {
                $.each(v, function (i, item) { body.append(k, item); });
            }
            else {
                body.append(k, v == null ? "" : v);
            }
        });

        return fetch(url, { method: "POST", body: body, credentials: "same-origin" })
            .then(function (res) {

                if (!res.ok) {
                    var hint = res.status === 404
                        ? " (Action در کنترلر پیدا نشد)"
                        : (res.status === 500 ? " (خطای داخلی کنترلر)" : "");

                    return res.text().then(function (raw) {
                        var detail = "";

                        try {
                            var parsed = JSON.parse(raw);
                            detail = parsed && parsed.message ? parsed.message : "";
                        }
                        catch (ignore) {
                            detail = $("<div>").html(raw || "").text().replace(/\s+/g, " ").trim().substring(0, 1200);
                        }

                        throw new Error(detail || ("خطای سرور (" + res.status + ")" + hint));
                    });
                }

                var type = res.headers.get("Content-Type") || "";

                if (type.indexOf("application/json") >= 0) {
                    return res.json().then(function (j) {
                        throw new Error(j && j.message ? j.message : errorFallback);
                    });
                }

                if (type.indexOf("text/html") >= 0 || type.indexOf("text/plain") >= 0) {
                    return res.text().then(function (raw) {
                        var detail = $("<div>").html(raw || "").text().replace(/\s+/g, " ").trim().substring(0, 1200);
                        throw new Error(detail || errorFallback);
                    });
                }

                var fileName = defaultName;
                var disposition = res.headers.get("Content-Disposition") || "";
                var utf8 = /filename\*=UTF-8''([^;]+)/i.exec(disposition);
                var plain = /filename="?([^";]+)"?/i.exec(disposition);

                if (utf8) { fileName = decodeURIComponent(utf8[1]); }
                else if (plain) { fileName = plain[1]; }

                return res.blob().then(function (blob) {
                    var blobUrl = URL.createObjectURL(blob);
                    var a = document.createElement("a");

                    a.href = blobUrl;
                    a.download = fileName;

                    document.body.appendChild(a);
                    a.click();
                    a.remove();

                    setTimeout(function () { URL.revokeObjectURL(blobUrl); }, 1500);
                });
            })
            .catch(function (err) {
                // وقتی هیچ پاسخ HTTP دریافت نشده، fetch فقط یک TypeError عمومی می‌دهد.
                // اطلاعات قابل‌تشخیص مرورگر و URL را نشان می‌دهیم تا علت قابل پیگیری باشد.
                if (err && (err.name === "TypeError" || /failed to fetch/i.test(err.message || ""))) {
                    var requestUrl = "";
                    try { requestUrl = new URL(url, window.location.href).href; }
                    catch (ignore) { requestUrl = url || "(نامشخص)"; }

                    var reason = !navigator.onLine
                        ? "اتصال اینترنت/شبکه مرورگر قطع است."
                        : "پاسخی از سرور دریافت نشد؛ درخواست ممکن است به‌علت قطع اتصال، Timeout سرور/Proxy یا خطای TLS متوقف شده باشد.";

                    throw new Error("دانلود اکسل ناموفق بود. " + reason + " نشانی درخواست: " + requestUrl + ". جزئیات بیشتر را در F12 > Network بررسی کنید.");
                }

                throw err;
            });
    }


    /* =====================================================
       TAB 4 : REGIONS + WORKDAYS
       ===================================================== */

    var allocFilterRequest = null;
    var allocFilterTimer = null;

    function updateAllocationSummaries() {

        var regionChecks = $(".alloc-region-check");
        var dayChecks = $(".alloc-workday-check");

        var regionChecked = regionChecks.filter(":checked").length;
        var dayChecked = dayChecks.filter(":checked").length;

        $("#allocRegionSummary").text(faNumber(regionChecked) + " از " + faNumber(regionChecks.length));

        var dayCount = 0;
        var dayAmount = 0;

        dayChecks.filter(":checked").each(function () {
            dayCount += Number($(this).data("count") || 0);
            dayAmount += Number($(this).data("amount") || 0);
        });

        $("#allocWorkDaySummary").text(
            faNumber(dayChecked) + " از " + faNumber(dayChecks.length)
            + " روزکار | " + faNumber(dayCount) + " پرونده | " + faNumber(dayAmount) + " ریال");

        $("#allocAllRegions").prop("checked", regionChecks.length > 0 && regionChecked === regionChecks.length);
        $("#allocAllWorkDays").prop("checked", dayChecks.length > 0 && dayChecked === dayChecks.length);
    }

    function renderAllocationRegions(regions, selected) {

        var selectedMap = {};

        $.each(selected || [], function (i, r) { selectedMap[r] = true; });

        var html = "";

        $.each(regions || [], function (i, r) {

            html +=
                "<label class='alloc-region-item'>" +
                    "<input type='checkbox' class='alloc-region-check' value='" + r.Code + "'" +
                        (selectedMap[r.Code] ? " checked" : "") + " />" +
                    "<span class='scope-check'></span>" +
                    "<div class='alloc-item-main'>" +
                        "<div class='alloc-item-title'>" + htmlEncode(r.Code) +
                            (r.Name ? " - " + htmlEncode(r.Name) : "") + "</div>" +
                        "<div class='alloc-item-sub'>" +
                            faNumber(r.Count) + " پرونده | " + faNumber(r.Amount) + " ریال" +
                        "</div>" +
                    "</div>" +
                    "<span class='alloc-badge" + (r.Agents ? "" : " none") + "'>" +
                        (r.Agents ? faNumber(r.Agents) + " مأمور" : "بدون مأمور") +
                    "</span>" +
                "</label>";
        });

        $("#allocRegionList").html(html || "<div class='alloc-empty'>برای این شهرستان @scopeRegionTitle تعریف نشده است.</div>");
    }

    function renderAllocationWorkDays(d, previousChecked, keepPrevious) {

        var html = "";

        $.each(d.workDays || [], function (i, w) {

            var checked = !keepPrevious || !previousChecked.hasOwnProperty(w.Day) || previousChecked[w.Day];

            html +=
                "<label class='alloc-day-item" + (w.Agents ? "" : " no-agent") + "'" +
                    " data-search='" + w.Day + "'" +
                    " title='مناطق: " + htmlEncode((w.Regions || []).join("، ")) + "'>" +
                    "<input type='checkbox' class='alloc-workday-check' value='" + w.Day + "'" +
                        " data-count='" + w.Count + "' data-amount='" + w.Amount + "'" +
                        (checked ? " checked" : "") + " />" +
                    "<span class='scope-check'></span>" +
                    "<div class='alloc-item-main'>" +
                        "<div class='alloc-item-title'>روزکار " + faNumber(w.Day) + "</div>" +
                        "<div class='alloc-item-sub'>" + faNumber(w.Count) + " پرونده</div>" +
                    "</div>" +
                    "<span class='alloc-badge" + (w.Agents ? "" : " none") + "'>" +
                        (w.Agents ? faNumber(w.Agents) + " مأمور" : "بدون مأمور") +
                    "</span>" +
                "</label>";
        });

        $("#allocWorkDayList").html(html || "<div class='alloc-empty'>در مناطق انتخاب‌شده پرونده‌ای وجود ندارد.</div>");

        var notes = [];

        if (d.noWorkDayCount) {
            notes.push(faNumber(d.noWorkDayCount) + " پرونده روزکار معتبر ندارند (رقم ۴ و ۵ اشتراک) و تخصیص داده نمی‌شوند.");
        }

        if (d.agentMessage) {
            notes.push(d.agentMessage);
        }
        else if (!d.agentCount) {
            notes.push("هیچ مأموری با نقش معتبر در این شهرستان وجود ندارد.");
        }

        if (!d.cityValue) {
            notes.push("ارزش پایه این شهر تعریف نشده است؛ تخصیص انجام نخواهد شد.");
        }

        $("#allocWorkDayNote").text(notes.join(" ")).toggle(notes.length > 0);

        $("#allocWorkDaySearch").val("");
    }

    function loadAllocationFilters(resetRegions) {

        var city = $("#allocSourceCity").val();

        if (!city) {
            $("#allocRegionList").html("<div class='alloc-empty'>ابتدا شهرستان را انتخاب کنید.</div>");
            $("#allocWorkDayList").html("<div class='alloc-empty'>ابتدا شهرستان را انتخاب کنید.</div>");
            $("#allocWorkDayNote").hide();
            updateAllocationSummaries();
            return;
        }

        var previousChecked = {};

        $(".alloc-workday-check").each(function () {
            previousChecked[$(this).val()] = $(this).is(":checked");
        });

        if (allocFilterRequest) { allocFilterRequest.abort(); }

        if (resetRegions) {
            $("#allocRegionList").html("<div class='alloc-empty'>در حال دریافت مناطق...</div>");
        }

        $("#allocWorkDayList").html("<div class='alloc-empty'>در حال دریافت روزکارها...</div>");

        allocFilterRequest = $.ajax({
            url: urls.allocationFilters,
            type: "POST",
            traditional: true,
            data: {
                __RequestVerificationToken: token("#smartAllocationForm"),
                sourceCity: city,
                RegionIds: resetRegions ? [] : checkedValues(".alloc-region-check")
            },
            success: function (r) {

                if (!r || !r.success) {
                    message(r && r.message ? r.message : "دریافت مناطق انجام نشد.", "error");
                    $("#allocWorkDayList").html("<div class='alloc-empty'>-</div>");

                    if (resetRegions) { $("#allocRegionList").html("<div class='alloc-empty'>-</div>"); }

                    return;
                }

                if (resetRegions) {
                    renderAllocationRegions(r.data.regions, r.data.selectedRegions);
                }

                renderAllocationWorkDays(r.data, previousChecked, !resetRegions);
                updateAllocationSummaries();
            },
            error: function (xhr, status) {

                if (status !== "abort") {

                    $("#allocWorkDayList").html("<div class='alloc-empty'>-</div>");

                    if (resetRegions) { $("#allocRegionList").html("<div class='alloc-empty'>-</div>"); }

                    serverError(xhr, "خطا در دریافت مناطق و روزکارها.");
                }
            },
            complete: function () {
                allocFilterRequest = null;
            }
        });
    }

    $("#allocSourceCity").on("change", function () {
        $("#allocResult").hide();
        loadAllocationFilters(true);
    });

    function scheduleWorkDayReload() {
        clearTimeout(allocFilterTimer);

        allocFilterTimer = setTimeout(function () {
            loadAllocationFilters(false);
        }, 350);
    }

    $(document).on("change", ".alloc-region-check", function () {
        updateAllocationSummaries();
        scheduleWorkDayReload();
    });

    $("#allocAllRegions").on("change", function () {
        $(".alloc-region-check").prop("checked", $(this).is(":checked"));
        updateAllocationSummaries();
        scheduleWorkDayReload();
    });

    $(document).on("change", ".alloc-workday-check", function () {
        updateAllocationSummaries();
    });

    $("#allocAllWorkDays").on("change", function () {
        $(".alloc-day-item:visible .alloc-workday-check").prop("checked", $(this).is(":checked"));
        updateAllocationSummaries();
    });


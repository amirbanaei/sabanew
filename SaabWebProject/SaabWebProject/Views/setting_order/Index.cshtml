    /* =====================================================
       TAB 5 : REPORT (فیلتر وضعیت + جستجو)
       ===================================================== */

    var reportStatus = "all";

    function applyReportFilter() {

        var q = $.trim($("#unregSearch").val()).toLowerCase();

        $(".unreg-row").each(function () {

            var statusOk = reportStatus === "all" || $(this).attr("data-status") === reportStatus;
            var text = ($(this).attr("data-search") || "").toLowerCase();

            $(this).toggle(statusOk && (!q || text.indexOf(q) >= 0));
        });
    }

    $("#unregSearch").on("input", applyReportFilter);

    $(document).on("click", ".report-filter", function () {

        reportStatus = $(this).attr("data-status");

        $(".report-filter").removeClass("active");
        $(this).addClass("active");

        applyReportFilter();
    });


    /* =====================================================
       TAB 6 : SINGLE AGENT ALLOCATION
       ===================================================== */

    function singleFormData() {
        return {
            __RequestVerificationToken: token("#singleAllocationForm"),
            sourceCity: $("#singleSourceCity").val(),
            targetCity: $.trim($("#singleTargetCity").val()),
            specialThreshold: $.trim($("#singleSpecialThreshold").val()),
            allocationDays: isJonobi ? allocationDaysValue("#singleAllocationDays") : "",
            manualDailyStandard: isJonobi ? $.trim($("#singleManualDailyStandard").val() || "") : "",
            sourceDate: $.trim($("#singleSourceDate").val()),
            excludeDate: excludeDateValue("#singleUseExclude", "#singleExcludeDate"),
            userId: $("#singleAgent").val()
        };
    }

    function validateSingle() {
        if (!validateAllocationDays("#singleAllocationDays")) { return false; }

        if (!$("#singleSourceCity").val()) {
            message("شهرستان را انتخاب کنید.", "error");
            return false;
        }

        if (!$("#singleAgent").val()) {
            message("مأمور را انتخاب کنید.", "error");
            return false;
        }

        if (!validDateText($("#singleSourceDate").val())) {
            message("تاریخ ثبت تخصیص را به‌صورت شمسی وارد کنید (مثال: 1405/07/12).", "error");
            return false;
        }

        if ($("#singleUseExclude").is(":checked")) {

            if (!validDateText($("#singleExcludeDate").val())) {
                message("تاریخ لیست قبلی را به‌صورت شمسی وارد کنید.", "error");
                return false;
            }

            if ($.trim($("#singleExcludeDate").val()) === $.trim($("#singleSourceDate").val())) {
                message("تاریخ لیست قبلی نباید با تاریخ ثبت تخصیص یکی باشد.", "error");
                return false;
            }
        }

        return true;
    }

    $("#singleSourceCity").on("change", function () {

        var city = $(this).val();

        $("#singleResult").hide();
        $("#singleAgentInfo").text("");
        $("#singleAgent").html("<option value=''>-- در حال دریافت... --</option>");

        if (!city) {
            $("#singleAgent").html("<option value=''>-- ابتدا شهرستان را انتخاب کنید --</option>");
            return;
        }

        $.ajax({
            url: urls.singleAgents,
            type: "POST",
            data: {
                __RequestVerificationToken: token("#singleAllocationForm"),
                sourceCity: city
            },
            success: function (r) {

                if (!r || !r.success) {
                    $("#singleAgent").html("<option value=''>-</option>");
                    message(r && r.message ? r.message : "دریافت مأموران انجام نشد.", "error");
                    return;
                }

                var html = "<option value=''>-- انتخاب مأمور --</option>";

                $.each(r.data || [], function (i, a) {
                    html +=
                        "<option value='" + a.UserId + "'" +
                            " data-info='" + htmlEncode("نقش‌ها: " + a.Roles + " | مناطق: " + a.Regions) + "'>" +
                            htmlEncode(a.FullName + " - " + a.NationalCode) +
                        "</option>";
                });

                if (!(r.data || []).length) {
                    html = "<option value=''>مأمور واجد شرایطی وجود ندارد</option>";
                    $("#singleAgentInfo").text(r.hint || "");
                }

                $("#singleAgent").html(html);
            },
            error: function (xhr) {
                $("#singleAgent").html("<option value=''>-</option>");
                serverError(xhr, "خطا در دریافت مأموران.");
            }
        });
    });

    $("#singleAgent").on("change", function () {
        $("#singleResult").hide();
        $("#singleAgentInfo").text($(this).find("option:selected").attr("data-info") || "");
    });

    $("#previewSingle").on("click", function () {

        var $btn = $(this);

        if (!validateSingle()) { return; }

        $btn.prop("disabled", true);
        loading(true);

        $.ajax({
            url: urls.singlePreview,
            type: "POST",
            data: singleFormData(),
            success: function (r) {
                if (r && r.success) {
                    renderAllocation(r.data, "single");
                    message("پیش‌نمایش تخصیص تکی آماده شد (ذخیره نشده است).", "success");
                }
                else {
                    message(r && r.message ? r.message : "پیش‌نمایش انجام نشد.", "error");
                }
            },
            error: function (xhr) {
                serverError(xhr, "خطا در اجرای پیش‌نمایش تکی.");
            },
            complete: function () {
                $btn.prop("disabled", false);
                loading(false);
            }
        });
    });

    $("#runSingle, #runSingleSheet1").on("click", function () {

        var $btn = $(this);

        if (!validateSingle()) { return; }

        if (!confirm("از پرونده‌های باقیمانده برای این مأمور تخصیص ذخیره می‌شود. هیچ تخصیص قبلی پاک نخواهد شد. ادامه می‌دهید؟")) { return; }

        $btn.prop("disabled", true);
        loading(true);

        var singleSheetOnly = $btn.attr("id") === "runSingleSheet1";
        var requestData = singleFormData();
        requestData.singleSheetOnly = singleSheetOnly;
        downloadExcel(urls.singleRun, requestData, "SingleAllocation.xlsx", "تخصیص تکی انجام نشد.")
            .then(function () {
                message(singleSheetOnly ? "تخصیص تکی ذخیره و اکسل تک‌شیتی sheet1 دریافت شد." : "تخصیص تکی ذخیره و فایل Excel دریافت شد.", "success");
            })
            .catch(function (err) {
                message(err && err.message ? err.message : "خطا در اجرای تخصیص تکی.", "error");
            })
            .then(function () {
                $btn.prop("disabled", false);
                loading(false);
            });
    });


    /* =====================================================
       TAB 7 : DAY EXPORT
       ===================================================== */

    $("#exportDay").on("click", function () {

        var $btn = $(this);

        if (!validDateText($("#exportDate").val())) {
            message("تاریخ را انتخاب کنید.", "error");
            return;
        }

        $btn.prop("disabled", true);
        loading(true);

        downloadExcel(
            urls.dayExport,
            {
                __RequestVerificationToken: token("#dayExportForm"),
                sourceDate: $.trim($("#exportDate").val()),
                excludeDate: ""
            },
            "Allocation.xlsx",
            "خروجی ساخته نشد.")
            .then(function () {
                message("فایل Excel کل روز دریافت شد.", "success");
            })
            .catch(function (err) {
                message(err && err.message ? err.message : "خطا در دریافت خروجی.", "error");
            })
            .then(function () {
                $btn.prop("disabled", false);
                loading(false);
            });
    });


    /* =====================================================
       TAB 8 : UNALLOCATED RECORDS
       ===================================================== */

    var unallocatedState = {
        page: 1,
        totalPages: 0,
        request: null
    };

    function showUnallocatedError(text) {
        var $box = $("#unallocatedError");

        if (text) {
            $box.text(text).show();
            message(text, "error");
        }
        else {
            $box.text("").hide();
        }
    }

    function renderUnallocated(data, serverMessage) {
        data = data || {};

        var items = data.items || [];
        var $body = $("#unallocatedBody").empty();

        if (!items.length) {
            $body.html("<tr><td colspan='10'>" + htmlEncode(serverMessage || "No unallocated records were found.") + "</td></tr>");
        }
        else {
            $.each(items, function (_, item) {
                $body.append(
                    "<tr>" +
                    "<td>" + htmlEncode(item.rowNumber) + "</td>" +
                    "<td>" + htmlEncode(item.city) + "</td>" +
                    "<td>" + htmlEncode(item.region) + "</td>" +
                    "<td>" + htmlEncode(item.workDay) + "</td>" +
                    "<td>" + htmlEncode(item.area) + "</td>" +
                    "<td>" + htmlEncode(item.tariff) + "</td>" +
                    "<td>" + htmlEncode(faNumber(item.debtAmount)) + "</td>" +
                    "<td>" + htmlEncode(item.billId) + "</td>" +
                    "<td>" + htmlEncode(item.subscriptionNumber) + "</td>" +
                    "<td>" + htmlEncode(item.customerType) + "</td>" +
                    "</tr>");
            });
        }

        unallocatedState.page = Number(data.page || 1);
        unallocatedState.totalPages = Number(data.totalPages || 0);

        $("#unallocatedSummary").text(
            "Total records: " + faNumber(data.total || 0) +
            (unallocatedState.totalPages ? " | Page " + faNumber(unallocatedState.page) + " of " + faNumber(unallocatedState.totalPages) : ""));

        $("#unallocatedPageText").text(
            unallocatedState.totalPages
                ? "Page " + unallocatedState.page + " / " + unallocatedState.totalPages
                : "No pages");

        $("#unallocatedPrev").prop("disabled", unallocatedState.page <= 1);
        $("#unallocatedNext").prop("disabled", unallocatedState.totalPages === 0 || unallocatedState.page >= unallocatedState.totalPages);
        $("#unallocatedPager").toggle(unallocatedState.totalPages > 1);
    }

    function loadUnallocated(page) {
        var date = $.trim($("#unallocatedDate").val());

        showUnallocatedError("");

        if (!validDateText(date)) {
            showUnallocatedError("Please select a valid allocation date.");
            return;
        }

        if (!$("#unallocatedCity").val()) {
            showUnallocatedError("Please select a city.");
            return;
        }

        if ($("#unallocatedUseExclude").is(":checked") && !validDateText($("#unallocatedExcludeDate").val())) {
            showUnallocatedError("Please select a valid previous-list date.");
            return;
        }

        if (unallocatedState.request) {
            unallocatedState.request.abort();
        }

        var $button = $("#loadUnallocated").prop("disabled", true);

        loading(true);
        $("#unallocatedBody").html("<tr><td colspan='10'>Loading...</td></tr>");

        unallocatedState.request = $.ajax({
            url: urls.unallocatedList,
            type: "POST",
            data: {
                __RequestVerificationToken: token("#unallocatedForm"),
                sourceDate: date,
                excludeDate: excludeDateValue("#unallocatedUseExclude", "#unallocatedExcludeDate"),
                sourceCity: $("#unallocatedCity").val() || "",
                page: page || 1,
                pageSize: 100
            },
            success: function (response) {
                if (!response || !response.success) {
                    showUnallocatedError(response && response.message
                        ? response.message
                        : "The server returned an invalid response.");
                    renderUnallocated(null, "Unable to load records.");
                    return;
                }

                renderUnallocated(response.data, response.message);
            },
            error: function (xhr, statusText) {
                if (statusText === "abort") { return; }

                var errorText = ajaxErrorText(xhr, "Unable to load unallocated records.");
                showUnallocatedError(errorText);
                renderUnallocated(null, "Unable to load records.");
            },
            complete: function () {
                unallocatedState.request = null;
                $button.prop("disabled", false);
                loading(false);
            }
        });
    }

    $("#loadUnallocated").on("click", function () { loadUnallocated(1); });
    $("#unallocatedPrev").on("click", function () { loadUnallocated(unallocatedState.page - 1); });
    $("#unallocatedNext").on("click", function () { loadUnallocated(unallocatedState.page + 1); });
    $("#unallocatedCity").on("change", function () {
        if ($("#unallocatedSummary").text()) { loadUnallocated(1); }
    });


    /* =====================================================
       JALALI DATE PICKER
       سه لیست «سال / ماه / روز» که در فیلد مخفیِ همان تب به‌صورت yyyy/mm/dd نوشته می‌شود
       data-offset (اختیاری): تعداد روز نسبت به امروز (مثلاً -1 = دیروز)
       ===================================================== */

    var JALALI_MONTHS = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور",
                         "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"];

    // میلادی → شمسی
    function gregorianToJalali(gy, gm, gd) {

        var gdm = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
        var gy2 = gm > 2 ? gy + 1 : gy;

        var days = 355666 + (365 * gy) + Math.floor((gy2 + 3) / 4)
                 - Math.floor((gy2 + 99) / 100) + Math.floor((gy2 + 399) / 400)
                 + gd + gdm[gm - 1];

        var jy = -1595 + (33 * Math.floor(days / 12053));
        days %= 12053;

        jy += 4 * Math.floor(days / 1461);
        days %= 1461;

        if (days > 365) {
            jy += Math.floor((days - 1) / 365);
            days = (days - 1) % 365;
        }

        var jm = days < 186 ? 1 + Math.floor(days / 31) : 7 + Math.floor((days - 186) / 30);
        var jd = 1 + (days < 186 ? days % 31 : (days - 186) % 30);

        return { y: jy, m: jm, d: jd };
    }

    function jalaliMonthLength(y, m) {

        if (m <= 6) { return 31; }
        if (m <= 11) { return 30; }

        var leapYears = [1, 5, 9, 13, 17, 22, 26, 30];
        return leapYears.indexOf(y % 33) >= 0 ? 30 : 29;
    }

    function initJalaliPicker($box) {

        var $target = $("#" + $box.data("target"));
        var offset = parseInt($box.attr("data-offset") || "0", 10) || 0;

        var today = new Date();
        today.setDate(today.getDate() + offset);

        var now = gregorianToJalali(today.getFullYear(), today.getMonth() + 1, today.getDate());

        var $y = $("<select></select>");
        var $m = $("<select></select>");
        var $d = $("<select></select>");

        for (var y = now.y - 3; y <= now.y + 1; y++) {
            $y.append("<option value='" + y + "'>" + faNumber(y).replace(/٬/g, "") + "</option>");
        }

        for (var m = 1; m <= 12; m++) {
            $m.append("<option value='" + m + "'>" + JALALI_MONTHS[m - 1] + "</option>");
        }

        function fillDays(keep) {

            var len = jalaliMonthLength(parseInt($y.val(), 10), parseInt($m.val(), 10));
            var current = keep || parseInt($d.val(), 10) || 1;

            $d.empty();

            for (var d = 1; d <= len; d++) {
                $d.append("<option value='" + d + "'>" + faNumber(d) + "</option>");
            }

            $d.val(Math.min(current, len));
        }

        function pad(n) { return n < 10 ? "0" + n : "" + n; }

        function write(trigger) {

            var text = $y.val() + "/" + pad(parseInt($m.val(), 10)) + "/" + pad(parseInt($d.val(), 10));

            $target.val(text);

            if (trigger) { $target.trigger("change"); }
        }

        $y.val(now.y);
        $m.val(now.m);
        fillDays(now.d);

        $y.add($m).on("change", function () {
            fillDays();
            write(true);
        });

        $d.on("change", function () {
            write(true);
        });

        $box.append($y).append($m).append($d);

        write(false);
    }

    $(".jdate-picker").each(function () {
        initJalaliPicker($(this));
    });

    // تیک «حذف پرونده‌های لیست قبلی» ← فعال/غیرفعال شدن انتخاب‌گر تاریخ قبلی
    function syncExcludePicker($check) {
        $('.jdate-picker[data-target="' + $check.attr("data-picker") + '"]')
            .toggleClass("disabled", !$check.is(":checked"));
    }

    $(".use-exclude-check").on("change", function () { syncExcludePicker($(this)); });
    $(".use-exclude-check").each(function () { syncExcludePicker($(this)); });


    /* =====================================================
       INITIAL
       ===================================================== */

    applyTelephoneRulesForAll();
    updateAssignmentMasters();
    syncScopeMasters();
    refreshLiftRowErrors();

    if ($("#allocSourceCity").val()) {
        loadAllocationFilters(true);
    }

});

</script>

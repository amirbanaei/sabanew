<!-- ===================== IMPORTANT NOTICE (هنگام ورود به تب ۱ و ۲) ===================== -->

<dialog id="importantNoticeDialog" class="oa-notice-dialog">
    <div class="oa-notice-card">
        <div class="oa-notice-title">
            <span class="oa-notice-icon">!</span>
            توجه (مهم):
        </div>
        <div class="oa-notice-text">
            درصورتیکه ماموری در سربرگ اول توسط کاربر تعیین نقش وصول گردد ولی در سربرگ دوم (تنظیمات ارجاع)،
            محدودیتی برای این مامور اعمال و ذخیره نگردد، سیستم بصورت خودکار ارجاع وصول برای این مامور را
            بدون محدودیت (تمام مناطق و روزکارها و تعرفه ها و محدوده ها) و مانند روال قبلی (با اولویت مبلغ و پراکندگی)
            انجام خواهد داد.
        </div>
        <label class="oa-notice-confirm">
            <input type="checkbox" id="importantNoticeCheck" />
            مطالعه کردم
        </label>
        <div class="oa-notice-footer">
            <button type="button" id="importantNoticeOk" class="oa-notice-ok" disabled>تایید</button>
        </div>
    </div>
</dialog>

<script>
    // پیغام مهم: فقط برای سربرگ اول و دوم؛ تا «مطالعه کردم + تایید» بسته نمی‌شود.
    (function () {
        var dialog = document.getElementById("importantNoticeDialog");
        var check = document.getElementById("importantNoticeCheck");
        var ok = document.getElementById("importantNoticeOk");

        if (!dialog || !check || !ok) { return; }

        dialog.addEventListener("cancel", function (e) { e.preventDefault(); });
        check.addEventListener("change", function () { ok.disabled = !check.checked; });

        var acknowledged = false;

        ok.addEventListener("click", function () {
            if (!check.checked) { return; }
            acknowledged = true;
            if (typeof dialog.close === "function") { dialog.close(); }
            else { dialog.removeAttribute("open"); }
        });

        window.showImportantNotice = function () {
            if (acknowledged || dialog.open) { return; }
            check.checked = false;
            ok.disabled = true;
            if (typeof dialog.showModal === "function") { dialog.showModal(); }
            else { dialog.setAttribute("open", "open"); }
        };
    })();
</script>



                                li.classList.toggle("gs-ag-selected", on);
                                if (on && scroll) { self.lists[c[0]].scrollTop = li.offsetTop - self.lists[c[0]].clientHeight / 2 + li.offsetHeight / 2; }
                            });
                        });
                    },

                    open: function () {
                        if (this.input.disabled || this.input.readOnly) { return; }
                        if (current && current !== this) { current.close(); }
                        current = this;
                        this.panel.classList.add("gs-ag-panel-open");
                        this.position();
                        var self = this;
                        this.mark(true);
                        requestAnimationFrame(function () { self.panel.classList.add("gs-ag-panel-visible"); });
                    },

                    close: function () {
                        if (!this.isOpen()) { return; }
                        this.panel.classList.remove("gs-ag-panel-open", "gs-ag-panel-visible", "gs-ag-panel-up");
                        if (current === this) { current = null; }
                    },

                    position: function () {
                        if (!this.isOpen()) { return; }
                        var r = this.input.getBoundingClientRect(), h = this.panel.offsetHeight, w = this.panel.offsetWidth;
                        var below = window.innerHeight - r.bottom, up = below < h + 12 && r.top > below;
                        var left = Math.min(Math.max(8, r.left + (r.width - w) / 2), window.innerWidth - w - 8);
                        this.panel.style.left = left + "px";
                        if (up) { this.panel.style.top = Math.max(8, r.top - h - 6) + "px"; this.panel.classList.add("gs-ag-panel-up"); }
                        else { this.panel.style.top = (r.bottom + 6) + "px"; this.panel.classList.remove("gs-ag-panel-up"); }
                    }
                };

                document.addEventListener("mousedown", function (e) {
                    if (current && !current.panel.contains(e.target) && e.target !== current.input) { current.close(); }
                }, true);
                window.addEventListener("resize", function () { if (current) { current.close(); } });
                window.addEventListener("scroll", function (e) { if (current && !current.panel.contains(e.target)) { current.close(); } }, true);

                function init(root) {
                    Array.prototype.forEach.call((root || document).querySelectorAll(SELECTOR), function (i) {
                        if (!i.__glassTime) { new Picker(i); }
                    });
                }

                window.GlassTime = { init: init };

                function auto() {
                    init(document);
                    if (window.MutationObserver && !window.__glassTimeObserver) {
                        var pending = false;
                        window.__glassTimeObserver = new MutationObserver(function (ms) {
                            if (pending) { return; }
                            for (var i = 0; i < ms.length; i++) {
                                if (ms[i].addedNodes.length) { pending = true; requestAnimationFrame(function () { pending = false; init(document); }); return; }
                            }
                        });
                        window.__glassTimeObserver.observe(document.body, { childList: true, subtree: true });
                    }
                }

                if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", auto); } else { auto(); }

            })(window, document);
        </script>

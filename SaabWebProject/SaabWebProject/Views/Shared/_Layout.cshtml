                    }

                    50% {
                        opacity: 1;
                        transform: scale(1.03);
                    }
                }


                /* =========================================================
                AG — GLOBAL NEON GLASS ALERT SYSTEM
                (منتقل‌شده از DashbordJalasat برای استفاده در همه صفحات)
                ========================================================= */

                /* =========================================================
                GLOBAL NEON GLASS ALERT SYSTEM
                ========================================================= */

                .global-alert-container {
                    position: fixed;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    z-index: 999999;
                    direction: rtl;
                    pointer-events: none;
                    padding: 1rem;
                }


                /* =========================================================
                ALERT BOX
                ========================================================= */

                .global-alert {
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    width: min(32rem, calc(100vw - 2rem));
                    min-height: 6rem;
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    padding: 1rem 1.1rem;
                    color: rgba(255,255,255,.94) !important;
                    background: linear-gradient( 135deg, rgba(255,255,255,.09), rgba(255,255,255,.025) ) !important;
                    border: 1px solid rgba(255,255,255,.18) !important;
                    border-radius: 1rem !important;
                    backdrop-filter: blur(22px) saturate(170%);
                    -webkit-backdrop-filter: blur(22px) saturate(170%);
                    box-shadow: 0 1.5rem 4rem rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.25), inset 0 -1px 0 rgba(255,255,255,.04);
                    overflow: hidden;
                    opacity: 0;
                    visibility: hidden;
                    pointer-events: none;
                    transform: translate(-50%, -50%) translateY(-2rem) scale(.82);
                    transition: opacity .35s ease, visibility .35s ease, transform .5s cubic-bezier(.22,.61,.36,1);
                }


                    /* =========================================================
                SHOW
                ========================================================= */

                    .global-alert.show {
                        opacity: 1;
                        visibility: visible;
                        pointer-events: auto;
                        transform: translate(-50%, -50%) translateY(0) scale(1);
                    }


                    /* =========================================================
                NEON LIGHT
                ========================================================= */

                    .global-alert::before {
                        content: "";
                        position: absolute;
                        width: 11rem;
                        height: 11rem;
                        top: -7rem;
                        right: -5rem;
                        border-radius: 50%;
                        filter: blur(45px);
                        opacity: .18;
                        pointer-events: none;
                    }


                    .global-alert::after {
                        content: "";
                        position: absolute;
                        top: 0;
                        right: 0;
                        width: 100%;
                        height: 1px;
                        background: linear-gradient( 90deg, transparent, rgba(255,255,255,.35), transparent );
                        opacity: .7;
                    }


                /* =========================================================
                ALERT ICON
                ========================================================= */

                .global-alert-icon {
                    position: relative;
                    flex: 0 0 3.4rem;
                    width: 3.4rem;
                    height: 3.4rem;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: .85rem;
                    font-size: 1.45rem;
                    background: rgba(255,255,255,.045);
                    border: 1px solid rgba(255,255,255,.14);
                    backdrop-filter: blur(10px);
                    -webkit-backdrop-filter: blur(10px);
                    transition: transform .3s ease, box-shadow .3s ease;
                }


                .global-alert:hover .global-alert-icon {
                    transform: scale(1.06);
                }


                /* =========================================================
                CONTENT
                ========================================================= */

                .global-alert-content {
                    flex: 1;
                    min-width: 0;
                    text-align: right;
                }


                .global-alert-title {
                    margin-bottom: .25rem;
                    font-size: .95rem;
                    font-weight: 800;
                    letter-spacing: -.01em;
                }


                .global-alert-message {
                    font-size: .76rem;
                    line-height: 1.8;
                    color: rgba(255,255,255,.62);
                }


                /* =========================================================
                CLOSE BUTTON
                ========================================================= */

                .global-alert-confirm,
                .global-alert-close {
                    flex: 0 0 auto;
                    width: 2rem;
                    height: 2rem;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 0;
                    border: 1px solid rgba(255,255,255,.08);
                    border-radius: .55rem;
                    background: rgba(255,255,255,.025);
                    color: rgba(255,255,255,.4);
                    cursor: pointer;
                    transition: color .25s ease, background .25s ease, border-color .25s ease, transform .25s ease;
                }


                    .global-alert-close:hover {
                        color: var(--danger) !important;
                        background: rgba(255,77,109,.08) !important;
                        border-color: rgba(255,77,109,.35) !important;
                        box-shadow: 0 0 1.2rem rgba(255,77,109,.15);
                        transform: scale(1.08);
                    }


                /* =========================================================
                SUCCESS
                ========================================================= */

                .global-alert-success {
                    border-color: rgba(0,255,195,.3) !important;
                    box-shadow: 0 1.5rem 4rem rgba(0,0,0,.35), 0 0 2.5rem rgba(0,255,195,.09), inset 0 1px 0 rgba(255,255,255,.25);
                }


                    .global-alert-success::before {
                        background: #00ffc3;
                    }


                    .global-alert-success .global-alert-icon {
                        color: #00ffc3;
                        background: rgba(0,255,195,.07);
                        border-color: rgba(0,255,195,.3);
                        box-shadow: 0 0 1.5rem rgba(0,255,195,.18), inset 0 0 1rem rgba(0,255,195,.04);
                    }


                    .global-alert-success .global-alert-title {
                        color: #00ffc3 !important;
                        text-shadow: 0 0 .8rem rgba(0,255,195,.25);
                    }


                /* =========================================================
                WARNING
                ========================================================= */

                .global-alert-warning {
                    border-color: rgba(255,193,7,.3) !important;
                    box-shadow: 0 1.5rem 4rem rgba(0,0,0,.35), 0 0 2.5rem rgba(255,193,7,.08), inset 0 1px 0 rgba(255,255,255,.25);
                }


                    .global-alert-warning::before {
                        background: #ffc107;
                    }


                    .global-alert-warning .global-alert-icon {
                        color: #ffc107;
                        background: rgba(255,193,7,.07);
                        border-color: rgba(255,193,7,.3);
                        box-shadow: 0 0 1.5rem rgba(255,193,7,.16), inset 0 0 1rem rgba(255,193,7,.04);
                    }


                    .global-alert-warning .global-alert-title {
                        color: #ffc107 !important;
                        text-shadow: 0 0 .8rem rgba(255,193,7,.25);
                    }


                /* =========================================================
                ERROR
                ========================================================= */

                .global-alert-error {
                    border-color: rgba(255,75,95,.32) !important;
                    box-shadow: 0 1.5rem 4rem rgba(0,0,0,.35), 0 0 2.5rem rgba(255,75,95,.1), inset 0 1px 0 rgba(255,255,255,.25);
                }


                    .global-alert-error::before {
                        background: #ff5368;
                    }


                    .global-alert-error .global-alert-icon {
                        color: #ff5368;
                        background: rgba(255,75,95,.07);
                        border-color: rgba(255,75,95,.3);
                        box-shadow: 0 0 1.5rem rgba(255,75,95,.18), inset 0 0 1rem rgba(255,75,95,.04);
                    }


                    .global-alert-error .global-alert-title {
                        color: #ff5368 !important;
                        text-shadow: 0 0 .8rem rgba(255,75,95,.25);
                    }


                /* =========================================================
                HOVER
                ========================================================= */

                .global-alert:hover {
                    transform: translate(-50%, -50%) translateY(-.2rem) scale(1.015);
                    background: linear-gradient( 135deg, rgba(255,255,255,.105), rgba(255,255,255,.035) ) !important;
                }


                /* =========================================================
                MOBILE
                ========================================================= */

                @@media (max-width: 576px) {

                    .global-alert-container {
                        padding: .75rem;
                    }

                    .global-alert {
                        width: calc(100vw - 1.5rem);
                        min-height: 5.5rem;
                        padding: .85rem;
                        gap: .75rem;
                    }

                    .global-alert-icon {
                        flex: 0 0 3rem;
                        width: 3rem;
                        height: 3rem;
                        font-size: 1.25rem;
                    }

                    .global-alert-title {
                        font-size: .88rem;
                    }

                    .global-alert-message {
                        font-size: .7rem;
                    }
                }

                /* =========================================================
                   AG — GLASS SELECT (سلکتور شیشه‌ای + جستجو)
                   استفاده:
                     <select class="glass-select-search"> ... </select>
                     data-search="true"  → همیشه جستجو داشته باشد
                     data-search="false" → هیچ‌وقت جستجو نداشته باشد
                     (پیش‌فرض: اگر بیشتر از ۷ گزینه داشت، جستجو نمایش داده می‌شود)
                   ظاهر کامل با کلاس‌های gs-ag-* در همین بخش قابل تغییر است
                   ========================================================= */

                /* قبل از فعال شدن JS (یا اگر JS خطا داد) هم ظاهر شیشه‌ای داشته باشد */
                select.glass-select-search,
                select.glass-select-serch {
                    width: 100%;
                    font-size: 12px;
                    padding: .375rem .75rem;
                    color: rgba(255,255,255,.92);
                    border: 1px solid rgba(255,255,255,.14);
                    border-radius: .55rem;
                    background-color: rgba(255,255,255,.035);
                }

                    select.glass-select-search option,
                    select.glass-select-serch option {
                        color: #fff;
                        background: #0b1c26;
                    }

                .gs-ag {
                    position: relative;
                    width: 100%;
                    direction: rtl;
                }

                /* -------- TRIGGER (شبیه glass-select-ag) -------- */

                .gs-ag-trigger {
                    width: 100%;
                    min-height: 2.1rem;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: .5rem;
                    padding: .375rem .75rem;
                    font-size: 12px;
                    text-align: right;
                    color: rgba(255,255,255,.92);
                    border: 1px solid rgba(255,255,255,.14);
                    border-radius: .55rem;
                    background-color: rgba(255,255,255,.035);
                    backdrop-filter: blur(12px) saturate(150%);
                    -webkit-backdrop-filter: blur(12px) saturate(150%);
                    box-shadow: inset 0 1px 0 rgba(255,255,255,.10), inset 0 -1px 0 rgba(255,255,255,.02);
                    cursor: pointer;
                    transition: border-color .3s ease, background-color .3s ease, box-shadow .3s ease, transform .2s ease;
                }

                    .gs-ag-trigger:hover {
                        border-color: rgba(0,255,255,.40);
                        background-color: rgba(0,255,255,.055);
                        box-shadow: inset 0 0 .6rem rgba(0,255,255,.05), 0 0 .5rem rgba(0,255,255,.03);
                    }

                    .gs-ag-trigger:focus,
                    .gs-ag-open .gs-ag-trigger {
                        outline: none;
                        color: #fff;
                        background: linear-gradient(135deg, rgba(0,255,255,.09), rgba(255,255,255,.035));
                        border-color: rgba(0,255,255,.65);
                        box-shadow: inset 0 0 .7rem rgba(0,255,255,.06), 0 0 .8rem rgba(0,255,255,.08);
                    }

                .gs-ag-text {
                    flex: 1;
                    min-width: 0;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                    .gs-ag-text.gs-ag-placeholder {
                        color: rgba(255,255,255,.45);
                    }

                .gs-ag-arrow {
                    flex: 0 0 auto;
                    color: #00ffff;
                    font-size: .75rem;
                    transition: transform .25s ease;
                }

                .gs-ag-open .gs-ag-arrow {
                    transform: rotate(180deg);
                }

                .gs-ag-disabled .gs-ag-trigger {
                    opacity: .5;
                    cursor: not-allowed;
                    border-color: transparent;
                }

                /* -------- PANEL (لیست آبشاری) -------- */

                .gs-ag-panel {
                    position: fixed;
                    z-index: 1000050;
                    display: none;
                    flex-direction: column;
                    direction: rtl;
                    overflow: hidden;
                    color: rgba(255,255,255,.92);
                    border: 1px solid rgba(0,255,255,.30);
                    border-radius: .65rem;
                    background: linear-gradient(145deg, rgba(12,35,45,.92), rgba(5,17,25,.95));
                    backdrop-filter: blur(18px) saturate(150%);
                    -webkit-backdrop-filter: blur(18px) saturate(150%);
                    box-shadow: 0 1rem 2.5rem rgba(0,0,0,.45), 0 0 1.2rem rgba(0,255,255,.08), inset 0 1px 0 rgba(255,255,255,.08);
                    opacity: 0;
                    transform: translateY(-.35rem);
                    transition: opacity .16s ease, transform .16s ease;
                }

                    .gs-ag-panel.gs-ag-panel-open {
                        display: flex;
                    }

                    .gs-ag-panel.gs-ag-panel-visible {
                        opacity: 1;
                        transform: translateY(0);
                    }

                    .gs-ag-panel.gs-ag-panel-up {
                        transform: translateY(.35rem);
                    }

                        .gs-ag-panel.gs-ag-panel-up.gs-ag-panel-visible {
                            transform: translateY(0);
                        }

                    /* -------- SEARCH -------- */

                    .gs-ag-panel .gs-ag-search {
                        position: relative;
                        flex: 0 0 auto;
                        margin: 0;
                        padding: .45rem;
                        border-bottom: 1px solid rgba(255,255,255,.08);
                    }

                        .gs-ag-panel .gs-ag-search i {
                            position: absolute;
                            top: 50%;
                            right: 1rem;
                            left: auto;
                            margin: 0;
                            transform: translateY(-50%);
                            color: rgba(0,255,255,.75);
                            font-size: .72rem;
                            line-height: 1;
                            pointer-events: none;
                            z-index: 1;
                        }

                        /* با !important تا استایل‌های عمومی input پروژه روی آن اثر نگذارد */
                        .gs-ag-panel .gs-ag-search input {
                            display: block;
                            width: 100% !important;
                            height: 1.9rem !important;
                            min-height: 0 !important;
                            margin: 0 !important;
                            padding: 0 1.9rem 0 .6rem !important;
                            font-size: 11.5px !important;
                            line-height: 1.9rem !important;
                            color: #fff !important;
                            border: 1px solid rgba(255,255,255,.14) !important;
                            border-radius: .45rem !important;
                            background: rgba(255,255,255,.04) !important;
                            box-shadow: inset 0 1px 0 rgba(255,255,255,.08) !important;
                            outline: none !important;
                            transform: none !important;
                            transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
                        }

                            .gs-ag-panel .gs-ag-search input:hover {
                                border-color: rgba(0,255,255,.35) !important;
                            }

                            .gs-ag-panel .gs-ag-search input:focus {
                                border-color: rgba(0,255,255,.60) !important;
                                background: rgba(0,255,255,.05) !important;
                                box-shadow: inset 0 0 .6rem rgba(0,255,255,.06), 0 0 .6rem rgba(0,255,255,.08) !important;
                            }

                            .gs-ag-panel .gs-ag-search input::placeholder {
                                color: rgba(255,255,255,.38) !important;
                            }

                /* -------- LIST -------- */

                .gs-ag-list {
                    flex: 1 1 auto;
                    min-height: 0;
                    max-height: 15rem;
                    overflow-y: auto;
                    margin: 0;
                    padding: .3rem;
                    list-style: none;
                    scrollbar-width: thin;
                    scrollbar-color: rgba(0,255,255,.25) transparent;
                }

                .gs-ag-option {
                    display: flex;
                    align-items: center;
                    gap: .45rem;
                    padding: .42rem .6rem;
                    margin-bottom: 2px;
                    font-size: 11.5px;
                    border-radius: .45rem;
                    border: 1px solid transparent;
                    cursor: pointer;
                    transition: background .15s ease, border-color .15s ease, color .15s ease;
                }

                .gs-ag-option-text {
                    flex: 1;
                    min-width: 0;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .gs-ag-option-check {
                    flex: 0 0 auto;
                    font-size: .8rem;
                    color: #00ffff;
                    opacity: 0;
                }

                .gs-ag-option.gs-ag-active {
                    background: rgba(0,255,255,.07);
                    border-color: rgba(0,255,255,.18);
                }

                .gs-ag-option.gs-ag-selected {
                    color: #00ffff;
                    background: rgba(0,255,255,.10);
                    border-color: rgba(0,255,255,.28);
                }

                    .gs-ag-option.gs-ag-selected .gs-ag-option-check {
                        opacity: 1;
                    }

                .gs-ag-option.gs-ag-option-placeholder {
                    color: rgba(255,255,255,.5);
                }

                .gs-ag-option.gs-ag-option-disabled {
                    opacity: .4;
                    cursor: not-allowed;
                }

                .gs-ag-option mark {
                    padding: 0;
                    color: #ffc857;
                    background: transparent;
                }

                .gs-ag-group {
                    padding: .35rem .6rem .15rem;
                    font-size: .6rem;
                    color: rgba(255,255,255,.45);
                }

                .gs-ag-empty {
                    display: none;
                    padding: .9rem .6rem;
                    text-align: center;
                    font-size: 11px;
                    color: rgba(255,255,255,.45);
                }

                    .gs-ag-empty.gs-ag-empty-show {
                        display: block;
                    }
    </style>

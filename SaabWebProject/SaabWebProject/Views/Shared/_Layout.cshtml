        @* ===== MDR: بخش «MDR» در منوی کناری (افزوده‌شده؛ منطق دسترسی در Areas/Mdr/Infrastructure/MdrMenu.cs و آیتم‌ها در Areas/Mdr/Views/Shared/_MdrSidebarMenu.cshtml) ===== *@
        @{ var mdrMenuModel__ = SaabWebProject.Areas.Mdr.Infrastructure.MdrMenu.ForCurrentUser(); }
        @if (mdrMenuModel__.Any)
        {
            <div id="mdr-menu-holder" style="display:none">
                @Html.Partial("~/Areas/Mdr/Views/Shared/_MdrSidebarMenu.cshtml", mdrMenuModel__)
            </div>
            <script>
                (function () {
                    var holder = document.getElementById("mdr-menu-holder");
                    var menu = document.querySelector("#sidebar .app-sidebar-content .menu");
                    if (holder && menu && holder.firstElementChild) {
                        // Layout چند <br> فاصله‌گذار انتهای منو دارد؛ MDR باید قبل از آن‌ها بنشیند تا بین آیتم‌ها فاصله‌ی اضافه نیفتد
                        var tail = [];
                        while (menu.lastElementChild && menu.lastElementChild.tagName === "BR") { tail.unshift(menu.lastElementChild); menu.removeChild(menu.lastElementChild); }
                        menu.appendChild(holder.firstElementChild);
                        tail.forEach(function (br) { menu.appendChild(br); });
                    }
                    if (holder && holder.parentNode) { holder.parentNode.removeChild(holder); }
                })();
            </script>
        }



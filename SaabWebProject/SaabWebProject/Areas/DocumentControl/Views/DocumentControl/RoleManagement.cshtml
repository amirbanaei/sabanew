@model SaabWebProject.Areas.DocumentControl.Models.ModuleRoleManagementVm

@functions {
    // Persian texts are passed as Unicode escapes so this View remains
    // independent from the physical file encoding.
    private string Fa(string value)
    {
        return value;
    }
}

@{
    ViewBag.Title = "\u0645\u062f\u06cc\u0631\u06cc\u062a \u062f\u0633\u062a\u0631\u0633\u06cc \u06a9\u0646\u062a\u0631\u0644 \u0645\u062f\u0627\u0631\u06a9";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .rm-page {
        direction: rtl;
        box-sizing: border-box;
        min-height: calc(100vh - 70px);
        padding: 24px;
        color: #e8f7ff;
        font-family: Tahoma, Arial, sans-serif;
        background: radial-gradient(circle at top right, rgba(13, 148, 136, .12), transparent 32%), linear-gradient(145deg, #040b16, #07192d 55%, #06101f);
    }

        .rm-page *,
        .rm-page *::before,
        .rm-page *::after {
            box-sizing: border-box;
        }

    .rm-card {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px;
        overflow: hidden;
        border: 1px solid rgba(103, 232, 249, .25);
        border-radius: 20px;
        background: rgba(8, 24, 44, .94);
        box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
    }

    .rm-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 20px;
    }

    .rm-title {
        min-width: 0;
    }

        .rm-title h1 {
            margin: 0 0 8px;
            color: #f4fbff;
            font-size: 23px;
            font-weight: 700;
            line-height: 1.6;
        }

    .rm-note {
        color: #93b7ca;
        font-size: 13px;
        line-height: 2;
    }

    .rm-back {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 9px 16px;
        color: #67e8f9;
        text-decoration: none;
        border: 1px solid rgba(103, 232, 249, .35);
        border-radius: 11px;
        background: rgba(6, 20, 38, .65);
        transition: background .2s, border-color .2s, transform .2s;
    }

        .rm-back:hover,
        .rm-back:focus {
            color: #fff;
            text-decoration: none;
            border-color: #22d3ee;
            background: rgba(8, 145, 178, .22);
            transform: translateY(-1px);
        }

    .rm-search-box {
        position: relative;
        margin: 12px 0 18px;
    }

    .rm-search {
        width: 100%;
        height: 48px;
        padding: 11px 46px 11px 14px;
        color: #fff;
        font-family: inherit;
        font-size: 14px;
        border: 1px solid rgba(103, 232, 249, .28);
        border-radius: 12px;
        outline: none;
        background: #061426;
        transition: border-color .2s, box-shadow .2s;
    }

        .rm-search::placeholder {
            color: #789bad;
            opacity: 1;
        }

        .rm-search:focus {
            border-color: #22d3ee;
            box-shadow: 0 0 0 3px rgba(34, 211, 238, .12);
        }

    .rm-search-icon {
        position: absolute;
        top: 50%;
        right: 16px;
        color: #67e8f9;
        font-size: 19px;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .rm-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid rgba(147, 197, 220, .12);
        border-radius: 13px;
    }

    .rm-table {
        width: 100%;
        min-width: 680px;
        border-collapse: collapse;
        background: rgba(4, 16, 31, .28);
    }

        .rm-table th,
        .rm-table td {
            padding: 14px 12px;
            text-align: center;
            vertical-align: middle;
            border-bottom: 1px solid rgba(147, 197, 220, .12);
        }

        .rm-table th {
            position: sticky;
            top: 0;
            z-index: 2;
            color: #d7f6ff;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
            background: #0e3d5b;
        }

        .rm-table tbody tr {
            transition: background-color .15s;
        }

            .rm-table tbody tr:hover {
                background: rgba(14, 61, 91, .25);
            }

            .rm-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .rm-user {
        width: 44%;
        text-align: right !important;
    }

    .rm-user-name {
        color: #f8fdff;
        font-size: 14px;
        line-height: 1.8;
    }

    .rm-user small {
        display: block;
        margin-top: 3px;
        color: #68a8c8;
        direction: ltr;
        font-size: 12px;
        text-align: right;
    }

    .rm-self {
        display: inline-block;
        margin-right: 7px;
        padding: 2px 7px;
        color: #fcd34d;
        font-size: 10px;
        font-weight: normal;
        border: 1px solid rgba(252, 211, 77, .25);
        border-radius: 20px;
        background: rgba(252, 211, 77, .08);
    }

    .rm-switch {
        width: 21px;
        height: 21px;
        margin: 0;
        vertical-align: middle;
        cursor: pointer;
        accent-color: #22d3ee;
    }

        .rm-switch:disabled {
            cursor: not-allowed;
            opacity: .55;
        }

    .rm-empty {
        padding: 30px !important;
        color: #93b7ca;
        text-align: center !important;
    }

    .rm-message {
        position: fixed;
        left: 22px;
        bottom: 22px;
        z-index: 10000;
        display: none;
        max-width: min(420px, calc(100vw - 44px));
        padding: 13px 18px;
        color: #fff;
        direction: rtl;
        font-family: Tahoma, Arial, sans-serif;
        font-size: 13px;
        line-height: 1.8;
        border: 1px solid rgba(255, 255, 255, .15);
        border-radius: 12px;
        background: #047857;
        box-shadow: 0 15px 40px rgba(0, 0, 0, .3);
    }

        .rm-message.error {
            background: #9f1239;
        }

    .rm-loading {
        opacity: .55;
        pointer-events: none;
    }

    @@media (max-width: 700px) {
        .rm-page {
            padding: 10px;
        }

        .rm-card {
            padding: 15px;
            border-radius: 15px;
        }

        .rm-head {
            align-items: stretch;
            flex-direction: column;
        }

        .rm-title h1 {
            font-size: 19px;
        }

        .rm-back {
            width: 100%;
        }

        .rm-table th,
        .rm-table td {
            padding: 12px 8px;
        }

        .rm-message {
            right: 12px;
            bottom: 12px;
            left: 12px;
            max-width: none;
        }
    }
</style>

<div class="rm-page">
    @Html.AntiForgeryToken()

    <div class="rm-card">
        <div class="rm-head">
            <div class="rm-title">
                <h1>
                    @Fa("\u0645\u062f\u06cc\u0631\u06cc\u062a \u062f\u0633\u062a\u0631\u0633\u06cc\u200c\u0647\u0627")
                </h1>

                <div class="rm-note">
                    @Fa("Admin \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0648 \u06af\u0631\u062f\u0634\u200c\u0647\u0627 \u0631\u0627 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b Manager \u0628\u0647 \u0645\u06cc\u0632 \u0645\u062f\u06cc\u0631\u06cc\u062a\u06cc \u0647\u0645\u0647 \u0645\u062f\u0627\u0631\u06a9 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0631\u062f.")
                </div>
            </div>

            <a class="rm-back" href="@Url.Action("Index", "DocumentControl")">
                @Fa("\u0628\u0627\u0632\u06af\u0634\u062a")
            </a>
        </div>

        <div class="rm-search-box">
            <span class="rm-search-icon">&#9906;</span>

            <input id="roleSearch"
                   class="rm-search"
                   type="search"
                   placeholder="@Fa("\u062c\u0633\u062a\u062c\u0648 \u0628\u0631\u0627\u0633\u0627\u0633 \u0646\u0627\u0645 \u06cc\u0627 \u06a9\u062f \u0645\u0644\u06cc...")"
                   autocomplete="off" />
        </div>

        <div class="rm-wrap">
            <table class="rm-table">
                <thead>
                    <tr>
                        <th class="rm-user">
                            @Fa("\u06a9\u0627\u0631\u0628\u0631")
                        </th>

                        <th>
                            @Fa("\u0645\u062f\u06cc\u0631 \u0633\u06cc\u0633\u062a\u0645 (Admin)")
                        </th>

                        <th>
                            @Fa("\u0645\u062f\u06cc\u0631 \u0645\u0634\u0627\u0647\u062f\u0647 (Manager)")
                        </th>
                    </tr>
                </thead>

                <tbody id="roleRows">
                    @foreach (var user in Model.Users)
                    {
                        var isSelf = user.UserId == Model.CurrentUserId;
                        var searchValue = ((user.FullName ?? "") + " " + (user.NationalCode ?? "")).ToLowerInvariant();

                        <tr data-search="@searchValue">
                            <td class="rm-user">
                                <div class="rm-user-name">
                                    <strong>@user.FullName</strong>

                                    @if (isSelf)
                                    {
                                        <span class="rm-self">
                                            @Fa("\u06a9\u0627\u0631\u0628\u0631 \u0641\u0639\u0644\u06cc")
                                        </span>
                                    }
                                </div>

                                <small>@user.NationalCode</small>
                            </td>

                            <td>
                                @if (isSelf && user.IsAdmin)
                                {
                                    <input class="rm-switch role-toggle"
                                           type="checkbox"
                                           data-user="@user.UserId"
                                           data-role="Admin"
                                           data-locked="true"
                                           checked="checked"
                                           disabled="disabled"
                                           aria-label="Admin" />
                                }
                                else if (user.IsAdmin)
                                {
                                    <input class="rm-switch role-toggle"
                                           type="checkbox"
                                           data-user="@user.UserId"
                                           data-role="Admin"
                                           data-locked="false"
                                           checked="checked"
                                           aria-label="Admin" />
                                }
                                else
                                {
                                    <input class="rm-switch role-toggle"
                                           type="checkbox"
                                           data-user="@user.UserId"
                                           data-role="Admin"
                                           data-locked="false"
                                           aria-label="Admin" />
                                }
                            </td>

                            <td>
                                @if (user.IsManager)
                                {
                                    <input class="rm-switch role-toggle"
                                           type="checkbox"
                                           data-user="@user.UserId"
                                           data-role="Manager"
                                           data-locked="false"
                                           checked="checked"
                                           aria-label="Manager" />
                                }
                                else
                                {
                                    <input class="rm-switch role-toggle"
                                           type="checkbox"
                                           data-user="@user.UserId"
                                           data-role="Manager"
                                           data-locked="false"
                                           aria-label="Manager" />
                                }
                            </td>
                        </tr>
                    }

                    <tr id="noRoleResult" style="display:none">
                        <td class="rm-empty" colspan="3">
                            @Fa("\u06a9\u0627\u0631\u0628\u0631\u06cc \u067e\u06cc\u062f\u0627 \u0646\u0634\u062f.")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="roleMessage"
     class="rm-message"
     role="status"
     aria-live="polite">
</div>

@section Scripts {
    <script>
        $(function () {
            var saveUrl = '@Url.Action("SetModuleUserRole", "DocumentControl")';
            var token = $('input[name="__RequestVerificationToken"]').val();

            var saveError =
                '\u0630\u062e\u06cc\u0631\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u0627\u0646\u062c\u0627\u0645 \u0646\u0634\u062f.';

            var connectionError =
                '\u062e\u0637\u0627\u06cc \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627 \u0633\u0631\u0648\u0631.';

            var enabledMessage =
                '\u062f\u0633\u062a\u0631\u0633\u06cc \u0641\u0639\u0627\u0644 \u0634\u062f.';

            var disabledMessage =
                '\u062f\u0633\u062a\u0631\u0633\u06cc \u063a\u06cc\u0631\u0641\u0639\u0627\u0644 \u0634\u062f.';

            function usableMessage(message, fallback) {
                message = $.trim(String(message || ''));

                // These characters commonly indicate broken UTF-8 text.
                if (!message || /[\u00c2\u00d8\u00d9\u00db]/.test(message)) {
                    return fallback;
                }

                return message;
            }

            function showMessage(message, isError) {
                $('#roleMessage')
                    .stop(true, true)
                    .toggleClass('error', !!isError)
                    .text(message)
                    .fadeIn(140)
                    .delay(2600)
                    .fadeOut(180);
            }

            $('#roleSearch').on('input', function () {
                var value = $.trim(String($(this).val() || '')).toLowerCase();
                var visibleCount = 0;

                $('#roleRows tr[data-search]').each(function () {
                    var row = $(this);
                    var searchableText =
                        String(row.attr('data-search') || '').toLowerCase();

                    var isVisible =
                        !value || searchableText.indexOf(value) >= 0;

                    row.toggle(isVisible);

                    if (isVisible) {
                        visibleCount++;
                    }
                });

                $('#noRoleResult').toggle(visibleCount === 0);
            });

            $('.role-toggle').on('change', function () {
                var checkbox = $(this);
                var newValue = checkbox.is(':checked');
                var row = checkbox.closest('tr');

                checkbox.prop('disabled', true);
                row.addClass('rm-loading');

                $.ajax({
                    url: saveUrl,
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        __RequestVerificationToken: token,
                        targetUserId: checkbox.attr('data-user'),
                        roleCode: checkbox.attr('data-role'),
                        isActive: newValue
                    }
                })
                .done(function (result) {
                    if (!result || result.success !== true) {
                        checkbox.prop('checked', !newValue);

                        showMessage(
                            usableMessage(result && result.message, saveError),
                            true
                        );

                        return;
                    }

                    showMessage(
                        usableMessage(
                            result.message,
                            newValue ? enabledMessage : disabledMessage
                        ),
                        false
                    );
                })
                .fail(function (xhr) {
                    checkbox.prop('checked', !newValue);

                    var response = xhr && xhr.responseJSON
                        ? xhr.responseJSON
                        : null;

                    showMessage(
                        usableMessage(
                            response && response.message,
                            connectionError
                        ),
                        true
                    );
                })
                .always(function () {
                    row.removeClass('rm-loading');

                    if (checkbox.attr('data-locked') !== 'true') {
                        checkbox.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
@{
    ViewBag.Title = "تعریف شروط ارجاع متمرکز";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}
@Html.AntiForgeryToken()

<main class="pdx" dir="rtl">
    <div class="pdx-orb pdx-orb-one"></div><div class="pdx-orb pdx-orb-two"></div>
    <header class="pdx-hero pdx-glass">
        <div><span class="pdx-kicker"><i class="bi bi-bezier2"></i> موتور قواعد ستاد</span><h1>تعریف شروط ارجاع متمرکز</h1><p>ساخت شرط فقط بر پایه لیست، یونیک، فیلدها، شاخص‌ها و اولویت‌هایی که در مراحل قبل تعریف شده‌اند</p></div>
        <div class="pdx-hero-actions"><label>طراحی‌های ذخیره‌شده<select id="designPicker"></select></label><button id="newBtn" class="pdx-btn pdx-btn-ghost"><i class="bi bi-plus-lg"></i> طراحی جدید</button><button id="saveBtn" class="pdx-btn pdx-btn-cyan"><i class="bi bi-floppy"></i> ذخیره طراحی</button></div>
    </header>
    <details class="pdx-prerequisites pdx-glass">
        <summary><span><i class="bi bi-diagram-3"></i> تنظیمات مرجع این طراحی</span><small>شاخص، فیلد پایه، اولویت و عنوان لیست</small><i class="bi bi-chevron-down"></i></summary>
        <div class="pdx-workflow">
            <a target="_blank" rel="noopener" href="@Url.Action("Index", "HeadOfficeIndicators", new { area = "Setting" })"><b>۱</b><span>شاخص اصلی<small>عنوان و واحد</small></span></a>
            <a target="_blank" rel="noopener" href="@Url.Action("Index", "HeadOfficeReferral", new { area = "Setting", tab = "base" })"><b>۲</b><span>فیلدهای پایه<small>گزارش و فیلدهای مجاز</small></span></a>
            <a target="_blank" rel="noopener" href="@Url.Action("Index", "HeadOfficeReferral", new { area = "Setting", tab = "priority" })"><b>۳</b><span>محدودیت و اولویت<small>مبلغ، مدیریت و وزن</small></span></a>
            <a target="_blank" rel="noopener" href="@Url.Action("Index", "HeadOfficeReferral", new { area = "Setting", tab = "lists" })"><b>۴</b><span>عنوان لیست<small>یونیک و مسیریابی</small></span></a>
        </div>
    </details>
    <div id="msg"></div>
    <nav class="pdx-steps pdx-glass">
        <button data-tab="1" class="active"><b>۱</b><span>طراحی کامل شرط<small>انتخاب لیست، فیلدها و قواعد حذف</small></span></button>
        <button data-tab="2"><b>۲</b><span>ساخت و اجرای نهایی<small>پیش‌نمایش، انتشار و اجرای خودکار</small></span></button>
    </nav>

    <section data-page="1" class="pdx-page active">
        <div class="pdx-panel pdx-glass pdx-setup-panel">
            <div class="pdx-panel-head"><div><span class="pdx-index">01</span><h2>مشخصات طراحی و عنوان لیست</h2><p>لیست را انتخاب کنید؛ فیلدهای مجاز و تنظیمات مرتبط همان لحظه در همین صفحه نمایش داده می‌شوند.</p></div><span class="pdx-live"><i></i> طراحی یکپارچه</span></div>
            <div class="pdx-grid pdx-grid-4"><label class="pdx-field pdx-span-2">عنوان لیست تعریف‌شده<select id="listId"></select></label><label class="pdx-field">عنوان طراحی<input id="title" placeholder="مثلاً شروط حذف لیست وصول" /></label><label class="pdx-field">وضعیت<select id="active"><option value="1">فعال</option><option value="0">غیرفعال</option></select></label><label class="pdx-field">Schema پروسیجر<input id="procSchema" readonly value="Setting" dir="ltr" /></label><label class="pdx-field pdx-span-2">نام پروسیجر<input id="procName" readonly placeholder="usp_ReferralList_1" dir="ltr" /></label></div>
        </div>
        <div id="contextSummary"></div>
        <div class="pdx-designer-grid">
            <aside class="pdx-panel pdx-glass pdx-catalog">
                <div class="pdx-panel-head"><div><span class="pdx-index">02</span><h2>فیلدهای قابل استفاده</h2><p>فقط فیلدهای پایه همین لیست</p></div></div>
                <div id="baseFields" class="pdx-field-cards"></div>
            </aside>
            <div class="pdx-panel pdx-glass pdx-rules-panel">
                <div class="pdx-panel-head"><div><span class="pdx-index">03</span><h2>شرایط حذف یونیک</h2><p>بندهای یک گروه با «و» و گروه‌های متفاوت با «یا» ترکیب می‌شوند.</p></div><button id="originalRules" class="pdx-btn pdx-btn-ghost">افزودن شرط‌های نمونه ۱۲۱۸</button><button id="addRule" class="pdx-btn pdx-btn-violet"><i class="bi bi-node-plus"></i> شرط جدید</button></div>
                <div class="pdx-logic-help"><span><b>گروه ۱</b> شرط اول <i>و</i> شرط دوم</span><strong>یا</strong><span><b>گروه ۲</b> شرط سوم</span></div>
                <div id="rules"></div>
            </div>
        </div>
        <details class="pdx-insights pdx-panel pdx-glass">
            <summary><span><i class="bi bi-sliders2"></i> مشاهده شاخص‌ها، محدودیت مبلغ و وزن اولویت‌ها</span><i class="bi bi-chevron-down"></i></summary>
            <div class="pdx-insights-body"><div id="indicatorChips" class="pdx-chips"></div><div id="priorityTable" class="pdx-table-wrap"></div></div>
        </details>
    </section>
    <section data-page="2" class="pdx-page"><div class="pdx-panel pdx-glass pdx-execute-panel"><div class="pdx-panel-head"><div><span class="pdx-index">04</span><h2>ساخت و اجرای نهایی</h2><p>طراحی ذخیره می‌شود، پروسیجر ساخته می‌شود و آخرین Batch مربوط به همین گزارش اجرا خواهد شد.</p></div><span class="pdx-live pdx-live-pink"><i></i> اجرای خودکار</span></div><div class="pdx-run-banner"><i class="bi bi-stars"></i><div><strong>آماده ساخت خروجی نهایی</strong><small>پیش از اجرا، طراحی به‌صورت خودکار ذخیره می‌شود.</small></div><div class="pdx-actions"><button id="preview" class="pdx-btn pdx-btn-ghost"><i class="bi bi-code-square"></i> پیش‌نمایش SQL</button><button id="publishExecute" class="pdx-btn pdx-btn-pink"><i class="bi bi-rocket-takeoff"></i> ساخت و اجرای خودکار</button></div></div><textarea id="sqlPreview" rows="22" dir="ltr" spellcheck="false" placeholder="پیش‌نمایش SQL اینجا نمایش داده می‌شود..."></textarea><pre id="result"></pre></div></section>
</main>

<style>
    .pdx{--cyan:#39f6ff;--violet:#a978ff;--pink:#ff5fb7;--ink:#eafcff;--muted:#92adbe;position:relative;isolation:isolate;max-width:1540px;margin:20px auto;padding:12px 18px 50px;color:var(--ink);font-family:Tahoma,Arial;overflow:hidden}.pdx *{box-sizing:border-box}.pdx-orb{position:absolute;width:360px;height:360px;border-radius:50%;filter:blur(90px);opacity:.16;z-index:-1;pointer-events:none}.pdx-orb-one{background:var(--cyan);top:-130px;right:-100px}.pdx-orb-two{background:var(--violet);left:-130px;top:360px}.pdx-glass{background:linear-gradient(145deg,rgba(13,35,53,.82),rgba(6,17,31,.68));border:1px solid rgba(114,231,255,.2);box-shadow:0 24px 65px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.06);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
    .pdx-hero{border-radius:24px;padding:25px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px;position:relative;overflow:hidden}.pdx-hero:after{content:"";position:absolute;inset:auto -20% -90% 30%;height:190px;background:radial-gradient(ellipse,var(--cyan),transparent 65%);opacity:.12}.pdx-kicker{color:var(--cyan);font-size:12px}.pdx h1{font-size:27px;margin:8px 0;text-shadow:0 0 22px rgba(57,246,255,.28)}.pdx h2{font-size:18px;margin:2px 0 7px}.pdx p{margin:0;color:var(--muted);font-size:12px;line-height:2}.pdx-hero-actions{min-width:410px;display:grid;grid-template-columns:1fr auto;gap:9px}.pdx-hero-actions label{grid-column:1/-1}.pdx label{font-size:12px;color:#b7d0df}.pdx input,.pdx select,.pdx textarea{width:100%;margin-top:7px;border:1px solid rgba(89,221,255,.2);border-radius:11px;padding:11px 12px;background:rgba(3,14,26,.72);color:#effcff;font-family:inherit;outline:none;transition:.2s}.pdx option{background:#091b2b;color:#fff}.pdx input:focus,.pdx select:focus,.pdx textarea:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(57,246,255,.09),0 0 22px rgba(57,246,255,.11)}
    .pdx-btn{border:1px solid transparent;border-radius:11px;padding:10px 15px;color:white;font-family:inherit;cursor:pointer;transition:.22s;white-space:nowrap}.pdx-btn:hover{transform:translateY(-2px);filter:brightness(1.12)}.pdx-btn-cyan{background:linear-gradient(135deg,#087f8c,#14c9c9);box-shadow:0 0 22px rgba(57,246,255,.17)}.pdx-btn-violet{background:linear-gradient(135deg,#6643c8,#9d62e7);box-shadow:0 0 22px rgba(169,120,255,.18)}.pdx-btn-pink{background:linear-gradient(135deg,#a71f68,#ec4d9e);box-shadow:0 0 22px rgba(255,95,183,.18)}.pdx-btn-ghost{background:rgba(121,215,255,.07);border-color:rgba(121,215,255,.22)}
    .pdx-workflow{margin:14px 0;border-radius:18px;padding:9px;display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.pdx-workflow a{display:flex;align-items:center;gap:9px;padding:11px;border:1px solid transparent;border-radius:13px;color:#a4bac8;text-decoration:none;transition:.2s}.pdx-workflow a:hover,.pdx-workflow a.active{color:#fff;border-color:rgba(57,246,255,.28);background:linear-gradient(135deg,rgba(57,246,255,.13),rgba(169,120,255,.1));transform:translateY(-1px)}.pdx-workflow b{display:grid;place-items:center;flex:0 0 30px;height:30px;border-radius:50%;background:rgba(255,255,255,.06);color:var(--cyan)}.pdx-workflow a.active b{color:#06202a;background:var(--cyan);box-shadow:0 0 18px rgba(57,246,255,.5)}.pdx-workflow span{font-size:11px;font-weight:bold}.pdx-workflow small{display:block;margin-top:4px;color:#718fa2;font-size:9px;font-weight:normal}.pdx-steps{margin:14px 0;border-radius:18px;padding:8px;display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.pdx-steps button{border:0;border-radius:12px;padding:12px;color:#8da8ba;background:transparent;font-family:inherit;cursor:pointer}.pdx-steps b{display:inline-grid;place-items:center;width:27px;height:27px;margin-left:7px;border-radius:50%;background:rgba(255,255,255,.06)}.pdx-steps button.active{color:#fff;background:linear-gradient(135deg,rgba(57,246,255,.16),rgba(169,120,255,.12));box-shadow:inset 0 0 0 1px rgba(57,246,255,.22)}.pdx-steps button.active b{color:#06202a;background:var(--cyan);box-shadow:0 0 18px rgba(57,246,255,.55)}
    .pdx-page{display:none}.pdx-page.active{display:block;animation:pdxFade .26s ease}.pdx-panel{border-radius:20px;padding:21px;margin-bottom:13px}.pdx-panel-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:18px}.pdx-panel-head>div{position:relative;padding-right:58px}.pdx-index{position:absolute;right:0;top:0;display:grid;place-items:center;min-width:43px;height:43px;padding:0 7px;border:1px solid rgba(57,246,255,.28);border-radius:13px;color:var(--cyan);background:rgba(57,246,255,.07)}.pdx-grid{display:grid;gap:11px}.pdx-grid-4{grid-template-columns:repeat(4,1fr)}.pdx-span-2{grid-column:span 2}.pdx-field{display:flex;flex-direction:column}.pdx-summary{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:13px}.pdx-summary-card{padding:16px;border-radius:16px}.pdx-summary-card small{display:block;color:#7f9caf;margin-bottom:8px}.pdx-summary-card i{color:var(--cyan);margin-left:5px}.pdx-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.pdx-chip{padding:8px 12px;border:1px solid rgba(169,120,255,.28);border-radius:999px;background:rgba(169,120,255,.09);color:#d9c6ff}.pdx-chip b{color:var(--cyan)}
    .pdx-table-wrap{overflow:auto;border:1px solid rgba(126,203,233,.14);border-radius:14px}.pdx-table{width:100%;border-collapse:collapse;min-width:800px}.pdx-table th,.pdx-table td{padding:11px;border-bottom:1px solid rgba(126,203,233,.1);text-align:right;font-size:12px}.pdx-table th{color:var(--cyan);background:rgba(57,246,255,.05)}.pdx-empty{padding:22px;text-align:center;color:#7895a7}.pdx-field-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.pdx-field-card{padding:15px;border:1px solid rgba(57,246,255,.16);border-radius:15px;background:rgba(5,22,37,.62)}.pdx-field-card strong{display:block;margin-bottom:8px}.pdx-field-card span{font-size:11px;color:#91adbd}.pdx-field-card .pdx-subsets{color:#d7c2ff;margin-top:8px;line-height:1.8}
    .pdx-rule{border:1px solid rgba(169,120,255,.2);border-radius:18px;padding:16px;margin:12px 0;background:linear-gradient(135deg,rgba(15,34,52,.78),rgba(28,17,48,.45))}.pdx-rule-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.pdx-rule-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:10px}.pdx-clause{display:grid;grid-template-columns:85px 1.2fr 105px 1fr 1fr 135px 1fr 42px;gap:7px;align-items:end;margin:9px 0;padding:10px;border:1px dashed rgba(57,246,255,.15);border-radius:13px}.pdx-clause label{display:grid;grid-template-rows:18px 42px;align-content:end;align-self:end;min-width:0;font-size:10px;line-height:18px}.pdx-clause input,.pdx-clause select{display:block;height:42px;min-height:42px;margin:0;padding:0 10px;line-height:40px}.pdx-clause input[type=number]{appearance:textfield;-moz-appearance:textfield}.pdx-clause input[type=number]::-webkit-inner-spin-button,.pdx-clause input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}.pdx-icon-btn{align-self:end;height:42px;min-height:42px;border:1px solid rgba(255,95,183,.25);border-radius:10px;background:rgba(255,95,183,.08);color:#ff92cb;cursor:pointer}.pdx-actions{display:flex;gap:9px;align-items:end;flex-wrap:wrap}.pdx-batch{width:190px}.pdx #sqlPreview{margin-top:15px;background:#04101b;color:#9fffdc;line-height:1.7}.pdx #result{display:none;background:#04101b;color:#b8f7df;border:1px solid rgba(57,246,255,.15);padding:14px;border-radius:13px;white-space:pre-wrap;direction:ltr;text-align:left;max-height:350px;overflow:auto}.pdx-alert{margin:12px 0;padding:13px 16px;border-radius:13px;border:1px solid}.pdx-ok{color:#a9ffd4;background:rgba(25,196,123,.09);border-color:rgba(25,196,123,.24)}.pdx-bad{color:#ffc1dc;background:rgba(255,95,183,.08);border-color:rgba(255,95,183,.23)}
    .pdx-prerequisites{margin:14px 0;border-radius:17px;overflow:hidden}.pdx-prerequisites>summary,.pdx-insights>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 17px;cursor:pointer;color:#c9e9f4}.pdx-prerequisites>summary::-webkit-details-marker,.pdx-insights>summary::-webkit-details-marker{display:none}.pdx-prerequisites>summary span{font-weight:bold}.pdx-prerequisites>summary span i,.pdx-insights>summary span i{color:var(--cyan);margin-left:7px}.pdx-prerequisites>summary small{margin-right:auto;color:#7394a7}.pdx-prerequisites[open]>summary>i,.pdx-insights[open]>summary>i{transform:rotate(180deg)}.pdx-prerequisites>summary>i,.pdx-insights>summary>i{transition:.2s}.pdx-prerequisites .pdx-workflow{grid-template-columns:repeat(4,1fr);margin:0;padding:0 10px 10px;border-top:1px solid rgba(57,246,255,.08)}
    .pdx-steps{position:sticky;top:8px;z-index:8;grid-template-columns:repeat(2,1fr);box-shadow:0 18px 45px rgba(0,0,0,.3),0 0 28px rgba(57,246,255,.05)}.pdx-steps button{display:flex;align-items:center;justify-content:center}.pdx-steps button span{text-align:right;font-weight:bold}.pdx-steps button small{display:block;margin-top:4px;color:#6f8fa2;font-weight:normal;font-size:9px}.pdx-steps button.active small{color:#a5c7d6}.pdx-setup-panel{position:relative;overflow:hidden}.pdx-setup-panel:before,.pdx-execute-panel:before{content:"";position:absolute;width:260px;height:260px;border-radius:50%;background:var(--cyan);filter:blur(100px);opacity:.06;left:-80px;top:-120px;pointer-events:none}.pdx-live{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border:1px solid rgba(57,246,255,.2);border-radius:999px;color:#91faff;background:rgba(57,246,255,.06);font-size:10px}.pdx-live i{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan);animation:pdxPulse 1.7s infinite}.pdx-live-pink{border-color:rgba(255,95,183,.22);color:#ff9bd1;background:rgba(255,95,183,.07)}.pdx-live-pink i{background:var(--pink);box-shadow:0 0 12px var(--pink)}
    .pdx-designer-grid{display:grid;grid-template-columns:minmax(250px,310px) minmax(0,1fr);gap:13px;align-items:start}.pdx-catalog{position:sticky;top:92px;max-height:calc(100vh - 112px);overflow:auto}.pdx-catalog .pdx-panel-head>div{padding-right:52px}.pdx-catalog .pdx-field-cards{grid-template-columns:1fr}.pdx-catalog .pdx-field-card{position:relative;overflow:hidden;transition:.2s}.pdx-catalog .pdx-field-card:before{content:"";position:absolute;right:0;top:12px;bottom:12px;width:2px;background:linear-gradient(var(--cyan),var(--violet));box-shadow:0 0 10px var(--cyan)}.pdx-catalog .pdx-field-card:hover{transform:translateX(-3px);border-color:rgba(57,246,255,.35);background:rgba(8,31,49,.82)}.pdx-rules-panel{min-width:0}.pdx-logic-help{display:flex;align-items:center;justify-content:center;gap:9px;padding:10px;margin:-4px 0 14px;border:1px dashed rgba(57,246,255,.16);border-radius:13px;color:#7798aa;font-size:10px;background:rgba(2,14,25,.28)}.pdx-logic-help span{padding:5px 9px;border-radius:8px;background:rgba(255,255,255,.035)}.pdx-logic-help b{color:#c8b1ff}.pdx-logic-help i,.pdx-logic-help strong{color:var(--cyan);font-style:normal}.pdx-rule{box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}.pdx-rule:hover{border-color:rgba(169,120,255,.34)}.pdx-insights{padding:0;overflow:hidden}.pdx-insights>summary span{font-weight:bold}.pdx-insights-body{padding:0 20px 20px;border-top:1px solid rgba(57,246,255,.08)}.pdx-insights-body .pdx-chips{padding-top:17px}.pdx-run-banner{display:flex;align-items:center;gap:14px;padding:17px;border:1px solid rgba(57,246,255,.15);border-radius:16px;background:linear-gradient(135deg,rgba(57,246,255,.075),rgba(169,120,255,.06))}.pdx-run-banner>i{display:grid;place-items:center;flex:0 0 48px;height:48px;border-radius:15px;color:#071b25;background:linear-gradient(135deg,var(--cyan),#72b5ff);box-shadow:0 0 28px rgba(57,246,255,.3);font-size:21px}.pdx-run-banner div:nth-child(2){display:flex;flex-direction:column;gap:5px}.pdx-run-banner small{color:#7899aa}.pdx-run-banner .pdx-actions{margin-right:auto}.pdx-execute-panel{position:relative;overflow:hidden;min-height:430px}
    @@keyframes pdxPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.75)}}@@keyframes pdxFade{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}@@media(max-width:1150px){.pdx-prerequisites .pdx-workflow{grid-template-columns:repeat(2,1fr)}.pdx-grid-4{grid-template-columns:repeat(2,1fr)}.pdx-summary{grid-template-columns:repeat(3,1fr)}.pdx-designer-grid{grid-template-columns:1fr}.pdx-catalog{position:relative;top:auto;max-height:none}.pdx-catalog .pdx-field-cards{grid-template-columns:repeat(3,1fr)}.pdx-clause{grid-template-columns:repeat(4,1fr)}}@@media(max-width:720px){.pdx{padding:7px}.pdx-hero{align-items:stretch;flex-direction:column}.pdx-hero-actions{min-width:0}.pdx-prerequisites .pdx-workflow,.pdx-steps{grid-template-columns:1fr}.pdx-grid-4,.pdx-catalog .pdx-field-cards,.pdx-summary,.pdx-rule-grid,.pdx-clause{grid-template-columns:1fr}.pdx-span-2{grid-column:span 1}.pdx-panel-head,.pdx-run-banner{align-items:stretch;flex-direction:column}.pdx-run-banner .pdx-actions{margin-right:0}.pdx-prerequisites>summary small{display:none}}
</style>

<script>
(function(){
 const base='@Url.Content("~/Setting/ProcedureDesigner/")',csrf=document.querySelector('[name="__RequestVerificationToken"]').value,$=s=>document.querySelector(s),$$=s=>Array.from(document.querySelectorAll(s));
 let boot={lists:[],indicators:[],designs:[]},ctx={list:null,fields:[],subsets:[],priorities:[]},state=blank();
 function blank(){return{id:0,listId:0,title:'',procedureSchema:'Setting',procedureName:'',isActive:true,rules:[]}}
 const esc=x=>String(x==null?'':x).replace(/[&<>"']/g,a=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[a]));const key=p=>p+Date.now()+Math.random().toString(16).slice(2),selected=(a,b)=>String(a)==String(b)?' selected':'';
 function note(m,ok){$('#msg').innerHTML='<div class="pdx-alert '+(ok?'pdx-ok':'pdx-bad')+'">'+esc(m)+'</div>';window.scrollTo({top:0,behavior:'smooth'})}
 async function api(p,o){o=o||{};o.headers=Object.assign({RequestVerificationToken:csrf},o.headers||{});let r=await fetch(base+p,o),raw=await r.text(),j;try{j=JSON.parse(raw)}catch(_){let detail='';try{let doc=new DOMParser().parseFromString(raw,'text/html'),node=doc.querySelector('title,h1,h2,.exceptionMessage');detail=node?node.textContent.trim():''}catch(__){}throw Error('سرور به‌جای JSON یک صفحه HTML برگرداند'+(detail?'؛ '+detail:'')+' (HTTP '+r.status+'). IIS Express را Restart کنید و در صورت تکرار، خطای سرور را بررسی کنید.')}if(!r.ok||!j.success)throw Error(j.message||('خطای سرور با کد '+r.status));return j.data==null?j:j.data}
 function options(a,v,t,e){return '<option value="">'+(e||'انتخاب کنید')+'</option>'+a.map(x=>'<option value="'+esc(x[v])+'">'+esc(x[t])+'</option>').join('')}
 async function init(id){try{boot=await api('Bootstrap'+(id?'?id='+id:''));$('#designPicker').innerHTML=options(boot.designs,'ID','Title','طراحی جدید');$('#listId').innerHTML=options(boot.lists,'ID','Title','عنوان لیست را انتخاب کنید');if(boot.snapshot)hydrate(boot.snapshot);syncHead();if(state.listId)await loadContext(state.listId);render()}catch(e){note(e.message)}}
 function hydrate(s){let d=s.design||{},fm={};(s.fields||[]).forEach(f=>fm[f.ID]=f.ClientKey);state={id:d.ID||0,listId:Number(d.ListId||0),title:d.Title||'',procedureSchema:d.ProcedureSchema||'Setting',procedureName:d.ProcedureName||'',isActive:d.IsActive!==false,rules:(s.rules||[]).map(r=>({clientKey:key('r'),title:r.Title,rejectReason:r.RejectReason,sortOrder:r.SortOrder,clauses:(s.clauses||[]).filter(c=>c.RuleID==r.ID).map(c=>({matchMode:c.MatchMode||'LEGACY',groupNo:c.GroupNo,sortOrder:c.SortOrder,leftFieldClientKey:fm[c.LeftFieldID],arithmeticOperator:c.ArithmeticOperator,rightFieldClientKey:c.RightFieldID?fm[c.RightFieldID]:null,rightConstant:c.RightConstant||'',compareOperator:c.CompareOperator,compareValue:c.CompareValue||''}))}))};$('#designPicker').value=state.id}
 function syncHead(){if(!$('#title'))return;$('#title').value=state.title;$('#procSchema').value=state.procedureSchema;$('#procName').value=state.procedureName;$('#active').value=state.isActive?'1':'0';$('#listId').value=state.listId||''}
 async function loadContext(id){ctx=await api('Context?listId='+encodeURIComponent(id));renderContext();renderFields();renderRules()}
 function render(){syncHead();renderContext();renderFields();renderRules()}
 function renderContext(){let l=ctx.list;if(!l){$('#contextSummary').innerHTML='';$('#indicatorChips').innerHTML='<div class="pdx-empty">ابتدا عنوان لیست را انتخاب کنید.</div>';$('#priorityTable').innerHTML='';return}$('#contextSummary').innerHTML='<div class="pdx-summary">'+summary('bi-table','گزارش ورودی',l.ReportTitle)+summary('bi-fingerprint','فیلد یونیک',l.KeyFieldTitle)+summary('bi-calendar3','مقدار روزانه',l.DailyAmount)+summary('bi-hourglass-split','بازه زمانی',l.DurationDays+' روز')+summary('bi-geo-alt','دامنه',l.CityTitle||'همه مدیریت‌ها')+'</div>';$('#indicatorChips').innerHTML=boot.indicators.length?boot.indicators.map(i=>'<span class="pdx-chip">'+esc(i.Title)+' <b>'+esc(i.Unit)+'</b></span>').join(''):'<div class="pdx-empty">شاخص اصلی فعالی تعریف نشده است.</div>';renderPriorities()}
 function summary(icon,label,value){return '<div class="pdx-summary-card pdx-glass"><small><i class="bi '+icon+'"></i>'+esc(label)+'</small><strong>'+esc(value==null?'-':value)+'</strong></div>'}
 function renderPriorities(){if(!ctx.priorities.length){$('#priorityTable').innerHTML='<div class="pdx-empty">برای دامنه این لیست هنوز محدودیت و اولویت ثبت نشده است.</div>';return}let groups={};ctx.priorities.forEach(p=>{let k=p.FieldId+'_'+(p.SubsetId||0);if(!groups[k])groups[k]={p:p,w:[]};if(p.IndicatorTitle)groups[k].w.push(esc(p.IndicatorTitle)+': '+esc(p.Weight)+'٪')});$('#priorityTable').innerHTML='<table class="pdx-table"><thead><tr><th>فیلد</th><th>زیرمجموعه</th><th>کمترین مبلغ</th><th>بیشترین مبلغ</th><th>وزن شاخص‌ها</th></tr></thead><tbody>'+Object.values(groups).map(g=>'<tr><td>'+esc(g.p.FieldTitle)+'</td><td>'+esc(g.p.SubsetTitle||'همه')+'</td><td>'+esc(g.p.MinimumAmount==null?'-':g.p.MinimumAmount)+'</td><td>'+esc(g.p.MaximumAmount==null?'-':g.p.MaximumAmount)+'</td><td>'+g.w.join(' | ')+'</td></tr>').join('')+'</tbody></table>'}
 function renderFields(){if(!ctx.fields.length){$('#baseFields').innerHTML='<div class="pdx-empty">فیلد پایه‌ای برای لیست انتخاب‌شده وجود ندارد.</div>';return}$('#baseFields').innerHTML=ctx.fields.map(f=>{let subs=ctx.subsets.filter(s=>s.FieldId==f.ID).map(s=>s.Title);return '<div class="pdx-field-card"><strong>'+esc(f.Title)+'</strong><span>نوع: '+esc(typeTitle(f.ValueType))+' · شناسه: '+esc(f.ID)+'</span>'+(subs.length?'<div class="pdx-subsets">زیرمجموعه‌ها: '+subs.map(esc).join('، ')+'</div>':'')+'</div>'}).join('')}
 function typeTitle(t){return t==='NUMBER'?'عدد/مبلغ':t==='DATE'?'تاریخ':'متن'}function addRule(){state.rules.push({clientKey:key('r'),title:'',rejectReason:'',sortOrder:state.rules.length,clauses:[newClause()]});renderRules()}function newClause(){return{matchMode:'LEGACY',groupNo:1,sortOrder:0,leftFieldClientKey:ctx.fields.length?'field_'+ctx.fields[0].ID:null,arithmeticOperator:'NONE',rightFieldClientKey:null,rightConstant:'',compareOperator:'=',compareValue:''}}
 function fieldOptions(v,empty){return '<option value="">'+(empty||'انتخاب فیلد')+'</option>'+ctx.fields.map(f=>'<option value="field_'+f.ID+'"'+selected('field_'+f.ID,v)+'>'+esc(f.Title)+'</option>').join('')}
 function compareEditor(c,ri,ci){if(c.matchMode&&c.matchMode!=='LEGACY')return '<input data-ri="'+ri+'" data-ci="'+ci+'" data-ck="compareValue" value="'+esc(c.compareValue)+'" placeholder="اعداد: 60|85|86 · بازه: 77000|77600" />';let id=Number(String(c.leftFieldClientKey||'').replace('field_','')),subs=ctx.subsets.filter(s=>s.FieldId==id);if(!subs.length)return '<input data-ri="'+ri+'" data-ci="'+ci+'" data-ck="compareValue" value="'+esc(c.compareValue)+'" placeholder="مقدار مقایسه" />';return '<select data-ri="'+ri+'" data-ci="'+ci+'" data-ck="compareValue"><option value="">زیرمجموعه</option>'+subs.map(s=>'<option value="'+esc(s.Title)+'"'+selected(s.Title,c.compareValue)+'>'+esc(s.Title)+'</option>').join('')+'</select>'}
 function clause(c,ri,ci){return '<div class="pdx-clause"><label>گروه پرانتز<input type="number" min="1" value="'+c.groupNo+'" data-ri="'+ri+'" data-ci="'+ci+'" data-ck="groupNo" /></label><label>فیلد<select data-ri="'+ri+'" data-ci="'+ci+'" data-ck="leftFieldClientKey">'+fieldOptions(c.leftFieldClientKey)+'</select></label><label>بررسی رکوردها<select data-ri="'+ri+'" data-ci="'+ci+'" data-ck="matchMode">'+modeOptions(c.matchMode)+'</select></label><label>محاسبه<select data-ri="'+ri+'" data-ci="'+ci+'" data-ck="arithmeticOperator">'+arith(c.arithmeticOperator)+'</select></label><label>فیلد دوم<select data-ri="'+ri+'" data-ci="'+ci+'" data-ck="rightFieldClientKey">'+fieldOptions(c.rightFieldClientKey,'ثابت / ندارد')+'</select></label><label>ثابت محاسباتی<input data-ri="'+ri+'" data-ci="'+ci+'" data-ck="rightConstant" value="'+esc(c.rightConstant)+'" /></label><label>عملگر مقایسه<select data-ri="'+ri+'" data-ci="'+ci+'" data-ck="compareOperator">'+comp(c.compareOperator)+'</select></label><label>مقدار'+compareEditor(c,ri,ci)+'</label><button class="pdx-icon-btn" data-rmc="'+ri+':'+ci+'"><i class="bi bi-trash"></i></button></div>'}
 function addOriginalRules(){
 const required=[2,9,16,20,25,28],missing=required.filter(id=>!ctx.fields.some(f=>Number(f.ID)===id));
 if(missing.length){note('این فیلدها را ابتدا در فیلدهای پایه گزارش تعریف کنید: '+missing.join('، '));return}
 const c=(id,mode,value,group=1,op='=')=>({groupNo:group,sortOrder:0,leftFieldClientKey:'field_'+id,matchMode:mode,arithmeticOperator:'NONE',rightFieldClientKey:null,rightConstant:'',compareOperator:op,compareValue:value});
 const rules=[
 ['بدهکار تهاتری',[c(2,'ANY_EQ','بدهکارتهاتري')]],
 ['کدهای ممنوع فیلد ۹',[c(9,'ANY_IN','60|85|86')]],
 ['کدهای ممنوع فیلد ۱۶',[c(16,'ANY_IN','21000|76000'),c(16,'ANY_RANGE','77000|77600',2)]],
 ['شروع با ۲ بدون کد محافظت‌شده',[c(20,'ANY_STARTS','2'),c(16,'NONE_IN','8600|17999|69000|91670|91680|97500|99500|99700|99800|99999'),c(16,'NONE_RANGE','85000|85999')]],
 ['مهلت پرداخت آینده و مبلغ کم',[c(28,'ANY_AFTER_TODAY',''),c(25,'ANY_OPEN_RANGE','0|5000000')]]
 ];
 if(!confirm('پنج شرط نمونه به شرط‌های فعلی اضافه شود؟'))return;
 rules.forEach(([title,clauses])=>{clauses.forEach((c,i)=>c.sortOrder=i);state.rules.push({clientKey:key('r'),title,rejectReason:title,sortOrder:state.rules.length,clauses})});renderRules();note('شرط‌های نمونه اضافه شدند؛ بررسی و سپس ذخیره کنید.',true)
 }
 function modeOptions(v){return [['LEGACY','مقدار تجمیعی قبلی'],['ANY_EQ','وجود متن مساوی'],['ANY_IN','وجود عدد در فهرست'],['NONE_IN','نبود عدد در فهرست'],['ANY_RANGE','وجود عدد در بازه بسته'],['ANY_OPEN_RANGE','وجود عدد در بازه باز (بدون دو سر)'],['NONE_RANGE','نبود عدد در بازه بسته'],['ANY_STARTS','وجود متن با شروع مشخص'],['ANY_AFTER_TODAY','وجود تاریخ شمسی بعد از روز اجرا']].map(x=>'<option value="'+x[0]+'"'+selected(x[0],v||'LEGACY')+'>'+x[1]+'</option>').join('')}
 function arith(v){return [['NONE','بدون محاسبه'],['+','جمع'],['-','تفریق'],['*','ضرب'],['/','تقسیم']].map(x=>'<option value="'+x[0]+'"'+selected(x[0],v)+'>'+x[1]+'</option>').join('')}function comp(v){return [['=','مساوی'],['<>','نامساوی'],['>','بزرگ‌تر'],['>=','بزرگ‌تر یا مساوی'],['<','کوچک‌تر'],['<=','کوچک‌تر یا مساوی'],['CONTAINS','شامل'],['STARTS','شروع شود با'],['ISNULL','خالی باشد'],['NOTNULL','خالی نباشد']].map(x=>'<option value="'+x[0]+'"'+selected(x[0],v)+'>'+x[1]+'</option>').join('')}
 function renderRules(){if(!state.rules.length){$('#rules').innerHTML='<div class="pdx-empty">هنوز شرطی تعریف نشده است.</div>';return}$('#rules').innerHTML=state.rules.map((r,ri)=>'<article class="pdx-rule"><div class="pdx-rule-head"><strong>شرط '+(ri+1)+'</strong><button class="pdx-icon-btn" data-rmr="'+ri+'"><i class="bi bi-trash"></i></button></div><div class="pdx-rule-grid"><label class="pdx-field">عنوان شرط<input data-ri="'+ri+'" data-rk="title" value="'+esc(r.title)+'" /></label><label class="pdx-field">دلیل حذف قابل نمایش<input data-ri="'+ri+'" data-rk="rejectReason" value="'+esc(r.rejectReason)+'" /></label></div>'+r.clauses.map((c,ci)=>clause(c,ri,ci)).join('')+'<button class="pdx-btn pdx-btn-ghost" data-addc="'+ri+'"><i class="bi bi-plus"></i> افزودن بند</button></article>').join('')}
 function sync(){state.title=$('#title').value.trim();state.procedureSchema=$('#procSchema').value.trim();state.procedureName=$('#procName').value.trim();state.isActive=$('#active').value==='1';state.listId=Number($('#listId').value||0)}async function save(){try{sync();if(!state.listId)throw Error('عنوان لیست را انتخاب کنید.');let j=await api('Save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(state)});state.id=j.id;note(j.message,true);await init(state.id);return true}catch(e){note(e.message);return false}}
 document.addEventListener('click',async e=>{let t=e.target.closest('button');if(!t)return;if(t.dataset.tab){$$('.pdx-steps button').forEach(x=>x.classList.toggle('active',x===t));$$('.pdx-page').forEach(x=>x.classList.toggle('active',x.dataset.page===t.dataset.tab));return}if(t.id==='newBtn'){state=blank();ctx={list:null,fields:[],subsets:[],priorities:[]};$('#designPicker').value='';render()}if(t.id==='saveBtn')await save();if(t.id==='originalRules')addOriginalRules();if(t.id==='addRule')addRule();if(t.dataset.addc!=null){let r=state.rules[+t.dataset.addc],c=newClause();c.sortOrder=r.clauses.length;r.clauses.push(c);renderRules()}if(t.dataset.rmr!=null){state.rules.splice(+t.dataset.rmr,1);renderRules()}if(t.dataset.rmc){let a=t.dataset.rmc.split(':');state.rules[+a[0]].clauses.splice(+a[1],1);renderRules()}if(t.id==='preview')await action('Preview');if(t.id==='publishExecute'&&confirm('آخرین تغییرات ذخیره، پروسیجر ساخته و آخرین Batch همین گزارش اجرا شود؟'))await publishAndExecute()});
 document.addEventListener('input',e=>{let el=e.target,ri=el.dataset.ri;if(ri==null)return;if(el.dataset.rk)state.rules[+ri][el.dataset.rk]=el.value;else if(el.dataset.ci!=null){let c=state.rules[+ri].clauses[+el.dataset.ci];c[el.dataset.ck]=el.dataset.ck==='groupNo'?Number(el.value):el.value||null}});
 document.addEventListener('change',async e=>{let el=e.target;if(el.id==='listId'){let selected=Number(el.value||0);let existing=boot.designs.find(d=>Number(d.ListId)===selected);state=blank();ctx={list:null,fields:[],subsets:[],priorities:[]};if(existing){await init(existing.ID);return}state.listId=selected;if(state.listId){let l=boot.lists.find(x=>x.ID==state.listId);if(!state.title)state.title='شروط '+l.Title;if(!state.procedureName)state.procedureName='usp_ReferralList_'+state.listId;await loadContext(state.listId)}else{ctx={list:null,fields:[],subsets:[],priorities:[]};render()}syncHead()}if(el.id==='designPicker'){let id=Number(el.value||0);state=blank();ctx={list:null,fields:[],subsets:[],priorities:[]};await init(id||null)}if(el.dataset.ck==='leftFieldClientKey'||el.dataset.ck==='matchMode')renderRules()});
 async function action(name){try{if(!state.id)throw Error('ابتدا طراحی را ذخیره کنید.');let fd=new URLSearchParams({id:state.id}),j=await api(name,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:fd});if(name==='Preview')$('#sqlPreview').value=j;else note(j.message,true)}catch(e){note(e.message)}}async function publishAndExecute(){try{if(!await save())return;let fd=new URLSearchParams({id:state.id}),j=await api('PublishAndExecute',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:fd});note(j.message+' Batch: '+j.batchId,true);$('#result').style.display='none';note('اجرا انجام شد و نتایج در دیتابیس ذخیره شدند. Batch: '+j.batchId,true)}catch(e){note(e.message)}}
 init(@(ViewBag.DesignId ?? "null"));
})();
</script>

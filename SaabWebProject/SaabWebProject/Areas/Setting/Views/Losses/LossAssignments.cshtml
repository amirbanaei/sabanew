<script>

    function openPageGuide() {

        var activeTabButton = document.querySelector(".main-tab-button.active");

        var activeTab = activeTabButton ? activeTabButton.getAttribute("data-tab") : "tabOne";

        var guideMap = {
            tabOne: "pageGuideDialogTab1",
            tabTwo: "pageGuideDialogTab2",
            tabThree: "pageGuideDialogTab3"
        };

        var dialog = document.getElementById(guideMap[activeTab] || guideMap.tabOne);

        if (!dialog) { return; }

        if (typeof dialog.showModal === "function") {
            if (!dialog.open) { dialog.showModal(); }
        }
        else {
            dialog.setAttribute("open", "open");
        }
    }

    document.addEventListener("click", function (e) {
        var target = e.target;

        if (target && target.classList
            && target.classList.contains("oa-native-guide")
            && typeof target.close === "function") {
            target.close();
        }
    });

</script>



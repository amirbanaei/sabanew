@using System
@using System.Linq
@using System.Collections.Generic
@using SaabWebProject.Models.DomainModels

@{
    ViewBag.Title = "مدیریت تخصیص نیرو - تلفات";
    Layout = "~/Views/Shared/_Layout.cshtml";

    /* ========================= TAB 1 ========================= */

    var users = ViewBag.Users as List<tbUsers> ?? new List<tbUsers>();
    var activityTypes = ViewBag.ActivityTypes as List<tbLossActivityType> ?? new List<tbLossActivityType>();
    var assignments = ViewBag.Assignments as List<tbLossAssignment> ?? new List<tbLossAssignment>();
    var assignmentActivities = ViewBag.AssignmentActivities as List<tbLossAssignmentActivity> ?? new List<tbLossAssignmentActivity>();

    var savedActivityPairKeys = new HashSet<string>(
        assignmentActivities.Select(x => x.UserID.ToString() + "_" + x.ActivityTypeID.ToString()));

    /* ========================= TAB 2 ========================= */

    var tab2Users = ViewBag.Tab2Users as List<tbUsers> ?? new List<tbUsers>();
    var allowedRegions = ViewBag.AllowedRegions as List<int> ?? new List<int>();
    var agentScopes = ViewBag.AgentScopes as List<tbLossAgentScope> ?? new List<tbLossAgentScope>();
    var agentScopeRegions = ViewBag.AgentScopeRegions as List<tbLossAgentScopeRegion> ?? new List<tbLossAgentScopeRegion>();
    var agentScopeWorkDays = ViewBag.AgentScopeWorkDays as List<tbLossAgentScopeWorkDay> ?? new List<tbLossAgentScopeWorkDay>();
    var tariffTypes = ViewBag.TariffTypes as List<tbOrderTariffType> ?? new List<tbOrderTariffType>();
    var agentScopeTariffs = ViewBag.AgentScopeTariffs as List<tbLossAgentScopeTariff> ?? new List<tbLossAgentScopeTariff>();
    var agentScopeAreas = ViewBag.AgentScopeAreas as List<tbLossAgentScopeArea> ?? new List<tbLossAgentScopeArea>();
    var agentScopeZoneTypes = ViewBag.AgentScopeZoneTypes as List<tbLossAgentScopeZoneType> ?? new List<tbLossAgentScopeZoneType>();

    // محدوده (کد ناحیه): از 0 تا 45  → 46 مقدار
    const int AreaMin = 0;
    const int AreaMax = 45;
    const int AreaTotal = 46;

    // نوع محدوده: 1 = شهری ، 2 = روستایی
    const int ZoneTotal = 2;
    Func<int, string> zoneTitle = z => z == 1 ? "شهری" : "روستایی";

    /* ========================= TAB 3 : استثناها ========================= */

    var excelImportBatches = ViewBag.ExcelImportBatches as List<tbLossExcelImportBatch> ?? new List<tbLossExcelImportBatch>();

    var excelComponents = new Dictionary<int, string>
{
        { 1, "شناسه قبض" },
        { 2, "پرونده" },
        { 3, "روزکار" },
        { 4, "محدوده" },
        { 5, "شماره اشتراک" }
    };

    // مؤلفه‌هایی که فعلاً «در حال توسعه» هستند
    var developingExcelComponents = new HashSet<int> { 3, 4 };

    // نوع استثنا: ListType در دیتابیس
    var excelLists = new[]
    {
        new { Type = 1, Title = "بالابری" },
        new { Type = 2, Title = "آلودگی" },
        new { Type = 3, Title = "ممانعت" }
    };

    var electricalSettings = ViewBag.ElectricalSettings as List<SaabWebProject.Areas.Setting.Controllers.LossesController.LossElectricalSetting>
        ?? new List<SaabWebProject.Areas.Setting.Controllers.LossesController.LossElectricalSetting>();
    Func<long, int, SaabWebProject.Areas.Setting.Controllers.LossesController.LossElectricalSetting> electricalOf = (id, region) =>
        electricalSettings.FirstOrDefault(x => x.ScopeID == id && x.RegionCode == region)
        ?? electricalSettings.FirstOrDefault(x => x.ScopeID == id && x.RegionCode == 0)
        ?? new SaabWebProject.Areas.Setting.Controllers.LossesController.LossElectricalSetting { SupplyType = 1, PhaseMask = 3 };
    Func<int, string> phaseTitle = mask => mask == 1 ? "تک فاز" : mask == 2 ? "سه فاز" : "تک فاز، سه فاز";

    var savedScopeUserIds = new HashSet<int>(agentScopes.Select(x => x.UserID));

    // 22, 23, 24, 25 → "22 تا 25"
    Func<IEnumerable<int>, string> compressDays = list =>
    {
        var s = list.Distinct().OrderBy(x => x).ToList();
        var parts = new List<string>();
        int i = 0;
        while (i < s.Count)
        {
            int j = i;
            while (j + 1 < s.Count && s[j + 1] == s[j] + 1) j++;
            parts.Add(j > i ? s[i] + " تا " + s[j] : s[i].ToString());
            i = j + 1;
        }
        return string.Join("، ", parts);
    };

    var allDaysText = "1 تا 99";
    var allAreasText = "0 تا 45";
    var allZonesText = "شهری، روستایی";
    var allTariffsText = tariffTypes.Count > 0 ? string.Join("، ", tariffTypes.Select(x => x.Title)) : "همه";
    var allRegionsText = allowedRegions.Count > 0 ? compressDays(allowedRegions) : "همه";
}


<style>


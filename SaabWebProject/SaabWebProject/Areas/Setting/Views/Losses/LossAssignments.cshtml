                <div>
                    <h2>تعیین نقش نیروها (تلفات)</h2>
                    <p>نقش هر نیرو را انتخاب کنید.</p>
                </div>
            </div>

            <form id="assignmentForm">

                @Html.AntiForgeryToken()

                <div class="tab-one-toolbar">
                    <div>
                        <div class="tab-one-info-title">تعیین نقش ماموران</div>
                        <div class="tab-one-info-subtitle">
                            هر نیرو فقط می‌تواند یک نقش داشته باشد.
                            برای جستجوی نیرو از کادر زیر نام نیرو استفاده کنید.
                        </div>
                    </div>
                </div>

                <div class="matrix-area">

                    <div class="matrix-toolbar">
                        <div class="matrix-toolbar-title">ماتریس نقش‌ها</div>
                        <div class="matrix-toolbar-info">انتخاب همه، این نقش را برای همه نیروها تعیین می‌کند (نقش قبلی هر نیرو برداشته می‌شود).</div>
                    </div>

                    <div class="matrix-wrapper matrix-scroll-20">

                        <table class="activity-matrix" id="assignmentMatrix">

                            <thead>
                                <tr>
                                    <th class="user-column-header-cell">
                                        <div class="user-column-title">نام نیرو</div>
                                        <div class="user-column-search">
                                            <span class="user-column-search-icon">⌕</span>
                                            <input type="text" id="matrixUserSearch" class="user-column-search-input"
                                                   autocomplete="off" placeholder="جستجوی نام یا کد ملی..." />
                                        </div>
                                    </th>

                                    @foreach (var activity in activityTypes)
                                    {
                                        <th>@activity.Title</th>
                                    }
                                </tr>
                            </thead>

                            <tbody>

                                <tr class="select-all-row">
                                    <td class="person-cell"><strong style="color:#7dd3fc">انتخاب همه</strong></td>

                                    @foreach (var activity in activityTypes)
                                    {
                                        <td>
                                            <label class="neon-check">
                                                <input type="checkbox" class="column-select-all" data-activity="@activity.ID" />
                                                <span></span>
                                            </label>
                                        </td>
                                    }
                                </tr>

                                @foreach (var user in users)
                                {
                                    var fullName = ((user.usr_Name ?? "") + " " + (user.usr_Family ?? "")).Trim();

                                    <tr class="user-activity-row"
                                        data-search="@((fullName + " " + (user.usr_NationalCode ?? "")).ToLower())">

                                        <td class="person-cell">
                                            <div class="person-info">
                                                <span class="person-avatar">
                                                    @(string.IsNullOrWhiteSpace(fullName) ? "؟" : fullName.Substring(0, 1))
                                                </span>
                                                <div>
                                                    <span class="person-name">@fullName</span>
                                                    <span class="person-national">@(user.usr_NationalCode ?? "")</span>
                                                </div>
                                            </div>
                                        </td>

                                        @foreach (var activity in activityTypes)
                                        {
                                            var pairKey = user.usr_ID.ToString() + "_" + activity.ID.ToString();
                                            var isSaved = savedActivityPairKeys.Contains(pairKey);

                                            <td>
                                                <label class="neon-check">
                                                    <input type="checkbox"
                                                           class="user-activity-check"
                                                           data-user="@user.usr_ID"
                                                           data-activity="@activity.ID"
                                                           @(isSaved ? "checked" : null) />
                                                    <span></span>
                                                </label>
                                            </td>
                                        }
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit" class="order-btn btn-main">
                        <span id="saveButtonText">ذخیره اطلاعات</span>
                    </button>
                    <button type="button" id="clearAssignment" class="order-btn btn-secondary">پاک کردن</button>
                </div>

            </form>

        </div>


        <!-- TAB 1 SAVED TABLE -->

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>آخرین تعیین نقش ثبت‌شده</h2>
                    <p>در هر ستون می‌توانید نام یا کد ملی نیرو را جستجو کنید.</p>
                </div>
            </div>

            <div class="matrix-wrapper">

                <table class="activity-matrix">

                    <thead>
                        <tr>
                            <th style="width:65px">ردیف</th>

                            @foreach (var activity in activityTypes)
                            {
                                <th>@activity.Title</th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @{ int row = 0; }

                        @foreach (var assignment in assignments)
                        {
                            row++;

                            <tr>
                                <td>@row</td>

                                @foreach (var activity in activityTypes)
                                {
                                    var ids = assignmentActivities
                                        .Where(x => x.AssignmentID == assignment.ID && x.ActivityTypeID == activity.ID)
                                        .Select(x => x.UserID)
                                        .Distinct()
                                        .ToList();

                                    var activityUsers = users
                                        .Where(x => ids.Contains(x.usr_ID))
                                        .OrderBy(x => x.usr_Family)
                                        .ThenBy(x => x.usr_Name)
                                        .ToList();

                                    <td>
                                        <div class="summary-cell-box">

                                            @if (activityUsers.Any())
                                            {
                                                <div class="summary-count-row">
                                                    <span class="summary-person-count" data-total="@activityUsers.Count">
                                                        @activityUsers.Count نفر
                                                    </span>
                                                    <span class="summary-search-result-count">همه</span>
                                                </div>

                                                <div class="summary-search-box">
                                                    <span class="summary-search-icon">⌕</span>
                                                    <input type="text" class="summary-cell-search"
                                                           autocomplete="off" placeholder="نام یا کد ملی..." />
                                                </div>

                                                <div class="summary-person-scroll">
                                                    <div class="summary-person-list">

                                                        @foreach (var person in activityUsers)
                                                        {
                                                            var name = ((person.usr_Name ?? "") + " " + (person.usr_Family ?? "")).Trim();

                                                            <div class="summary-person-item"
                                                                 data-search="@((name + " " + (person.usr_NationalCode ?? "")).ToLower())">
                                                                @name
                                                            </div>
                                                        }

                                                        <div class="summary-no-result">موردی پیدا نشد</div>

                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span style="color:#475569">-</span>
                                            }

                                        </div>
                                    </td>
                                }
                            </tr>
                        }

                        @if (row == 0)
                        {
                            <tr>
                                <td colspan="@(activityTypes.Count + 1)" style="padding:30px;color:#64748b">
                                    هنوز اطلاعاتی ثبت نشده است.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TAB 2
         ===================================================== -->

    <div id="tabTwo" class="main-tab-panel" style="display:none">

        <div class="glass-card" id="scopeFormCard">

            <div class="section-header">
                <div>
                    <h2>تنظیمات ارجاع ماموران (تلفات)</h2>
                    <p>مامور و محدوده فعالیت را انتخاب کنید؛ سپس نوع اشتراک و فازها را مشخص کنید.</p>
                </div>
            </div>

            <form id="agentScopeForm">

                @Html.AntiForgeryToken()

                <div id="addRegionBanner"></div>

                <div class="scope-grid">

                    <!-- 1 USER -->
                    <div class="scope-card">
                        <div class="scope-card-title">نام مامور</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeUserSearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی نام یا کد ملی..." />
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllUsers" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            @foreach (var user in tab2Users)
                            {
                                var name = ((user.usr_Name ?? "") + " " + (user.usr_Family ?? "")).Trim();
                                var userAlreadySaved = savedScopeUserIds.Contains(user.usr_ID);

                                <label class="scope-item scope-user-option @(userAlreadySaved ? "scope-user-hidden scope-user-saved" : "")"
                                       data-search="@((name + " " + (user.usr_NationalCode ?? "")).ToLower())">
                                    <input type="checkbox" class="scope-user-check" value="@user.usr_ID" @(userAlreadySaved ? null : "checked") />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">@name</span>
                                </label>
                            }

                            <div id="scopeNoNewUsers" class="scope-empty-note">
                                همه ماموران قبلاً ثبت شده‌اند. برای تغییر، از دکمه «ویرایش» جدول پایین استفاده کنید.
                            </div>

                        </div>
                    </div>

                    <!-- 2 REGION -->
                    <div class="scope-card">
                        <div class="scope-card-title">کد منطقه</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeRegionSearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی منطقه..." />
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllRegions" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            @foreach (var region in allowedRegions)
                            {
                                <label class="scope-item scope-region-option" data-search="@region">
                                    <input type="checkbox" class="scope-region-check" value="@region" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">منطقه @region</span>
                                </label>
                            }

                        </div>
                    </div>

                    <!-- 3 WORK DAY -->
                    <div class="scope-card">
                        <div class="scope-card-title">روزکار</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeWorkDaySearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی روزکار..." />
                        </div>

                        <div class="scope-selector-search workday-range-row">
                            <input type="number" id="workDayFrom" min="1" max="99"
                                   class="scope-selector-search-input" placeholder="از" />
                            <input type="number" id="workDayTo" min="1" max="99"
                                   class="scope-selector-search-input" placeholder="تا" />
                            <button type="button" id="applyWorkDayRange" class="scope-action">انتخاب بازه</button>
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllWorkDays" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            <div class="workday-grid">

                                @for (int day = 1; day <= 99; day++)
                                {
                                    <label class="scope-item scope-workday-option" data-search="@day">
                                        <input type="checkbox" class="scope-workday-check" value="@day" checked />
                                        <span class="scope-check"></span>
                                        <span class="scope-text">@day</span>
                                    </label>
                                }

                            </div>

                        </div>
                    </div>

                    <!-- 4 + 5 + 6 : محدوده / تعرفه / شهری-روستایی -->
                    <div class="scope-side-cards">

                        <div class="scope-card">
                            <div class="scope-card-title">کد ناحیه</div>

                            <div class="scope-card-body">

                                <label class="scope-item">
                                    <input type="checkbox" id="scopeAllAreas" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">انتخاب همه</span>
                                </label>

                                <div class="area-grid">

                                    @for (int area = AreaMin; area <= AreaMax; area++)
                                    {
                                        <label class="scope-item scope-area-option">
                                            <input type="checkbox" class="scope-area-check" value="@area" checked />
                                            <span class="scope-check"></span>
                                            <span class="scope-text">@area</span>
                                        </label>
                                    }

                                </div>

                            </div>
                        </div>

                        <div class="scope-card">
                            <div class="scope-card-title">نوع تعرفه</div>

                            <div class="scope-card-body">

                                <label class="scope-item">
                                    <input type="checkbox" id="scopeAllTariffs" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">انتخاب همه</span>
                                </label>

                                @foreach (var tariff in tariffTypes)
                                {
                                    <label class="scope-item scope-tariff-option">
                                        <input type="checkbox" class="scope-tariff-check" value="@tariff.ID" checked />
                                        <span class="scope-check"></span>
                                        <span class="scope-text">@tariff.Title</span>
                                    </label>
                                }

                            </div>
                        </div>

                        <div class="scope-card">
                            <div class="scope-card-title">نوع اشتراک <span class="scope-caption">انتخاب هم‌زمان مجاز است</span></div>
                            <div class="scope-card-body">
                                <label class="electrical-option"><input type="checkbox" name="SupplyType" value="1" checked /> عادی</label>
                                <label class="electrical-option"><input type="checkbox" name="SupplyType" value="2" /> دیماند</label>
                            </div>
                        </div>
                        <div class="scope-card">
                            <div class="scope-card-title">فازها (جهت تلفات)</div>
                            <div class="scope-card-body">
                                <label class="electrical-option"><input type="checkbox" id="phaseSingle" checked /> تک فاز</label>
                                <label class="electrical-option"><input type="checkbox" id="phaseThree" checked /> سه فاز</label>
                            </div>
                        </div>
                        <!-- جدید: شهری / روستایی -->
                        <div class="scope-card">
                            <div class="scope-card-title">محدوده</div>

                            <div class="scope-card-body">

                                <label class="scope-item">
                                    <input type="checkbox" id="scopeAllZones" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">انتخاب همه</span>
                                </label>

                                <label class="scope-item scope-zone-option">
                                    <input type="checkbox" class="scope-zone-check" value="1" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">شهری</span>
                                </label>

                                <label class="scope-item scope-zone-option">
                                    <input type="checkbox" class="scope-zone-check" value="2" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">روستایی</span>
                                </label>

                            </div>
                        </div>

                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit" id="saveAgentScope" class="order-btn btn-main">ذخیره اطلاعات</button>
                    <button type="button" id="clearAgentScope" class="order-btn btn-secondary">پاک کردن</button>
                </div>

            </form>

        </div>


        <!-- TAB 2 SAVED -->

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>آخرین تنظیمات ذخیره‌شده ماموران</h2>
                    <p>ارجاعات بر اساس آخرین تنظیمات ذخیره‌شده انجام خواهد شد.</p>
                </div>

                <div style="width:250px">
                    <input type="text" id="scopeSearch" class="order-input"
                           autocomplete="off" placeholder="جستجوی مامور..." />
                </div>
            </div>

            <div class="matrix-wrapper">

                <table class="activity-matrix">

                    <thead>
                        <tr>
                            <th>مامور</th>
                            <th>مناطق، روزکار، تعرفه، کد ناحیه و محدوده</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var scope in agentScopes)
                        {
                            var person = tab2Users.FirstOrDefault(x => x.usr_ID == scope.UserID);

                            if (person == null) { continue; }

                            var name = ((person.usr_Name ?? "") + " " + (person.usr_Family ?? "")).Trim();

                            var scopeRegionList = agentScopeRegions
                                .Where(x => x.ScopeID == scope.ID)
                                .Select(x => x.RegionCode)
                                .Distinct()
                                .OrderBy(x => x)
                                .ToList();

                            var scopeDayRows = agentScopeWorkDays.Where(x => x.ScopeID == scope.ID).ToList();
                            var generalDays = scopeDayRows.Where(x => !x.RegionCode.HasValue).Select(x => x.WorkDay).ToList();

                            var scopeTariffRows = agentScopeTariffs.Where(x => x.ScopeID == scope.ID).ToList();

                            var scopeAreaRows = agentScopeAreas.Where(x => x.ScopeID == scope.ID).ToList();
                            var generalAreas = scopeAreaRows.Where(x => !x.RegionCode.HasValue).Select(x => x.AreaCode).Distinct().ToList();
                            var generalAreasRestricted = generalAreas.Count > 0 && generalAreas.Count < AreaTotal;

                            var generalElectrical = electricalOf(scope.ID, 0);
                            var scopeZoneRows = agentScopeZoneTypes.Where(x => x.ScopeID == scope.ID).ToList();
                            var generalZones = scopeZoneRows.Where(x => !x.RegionCode.HasValue).Select(x => (int)x.ZoneType).Distinct().ToList();
                            var generalZonesRestricted = generalZones.Count > 0 && generalZones.Count < ZoneTotal;

                            var generalTariffIds = scopeTariffRows
                                .Where(x => !x.RegionCode.HasValue)
                                .Select(x => x.TariffTypeID)
                                .Distinct()
                                .ToList();

                            var generalTariffTitles = tariffTypes
                                .Where(x => generalTariffIds.Contains(x.ID))
                                .Select(x => x.Title)
                                .ToList();

                            <tr class="scope-data-row"
                                data-name="@((name + " " + (person.usr_NationalCode ?? "")).ToLower())">

                                <td>
                                    <div class="person-info">
                                        <span class="person-avatar">
                                            @(string.IsNullOrWhiteSpace(name) ? "؟" : name.Substring(0, 1))
                                        </span>
                                        <div>
                                            <span class="person-name">@name</span>
                                            <span class="person-national">@(person.usr_NationalCode ?? "")</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="scope-rule-lines">

                                        @foreach (var r in scopeRegionList)
                                        {
                                            var electrical = electricalOf(scope.ID, r);
                                            var rd = scopeDayRows.Where(x => x.RegionCode == r).Select(x => x.WorkDay).ToList();
                                            if (rd.Count == 0) { rd = generalDays; }

                                            var rt = scopeTariffRows.Where(x => x.RegionCode == r).Select(x => x.TariffTypeID).Distinct().ToList();
                                            if (rt.Count == 0) { rt = generalTariffIds; }

                                            var rtTitles = tariffTypes.Where(x => rt.Contains(x.ID)).Select(x => x.Title).ToList();

                                            var ra = scopeAreaRows.Where(x => x.RegionCode == r).Select(x => x.AreaCode).Distinct().ToList();
                                            if (ra.Count == 0) { ra = generalAreas; }
                                            var raRestricted = ra.Count > 0 && ra.Count < AreaTotal;

                                            var rz = scopeZoneRows.Where(x => x.RegionCode == r).Select(x => (int)x.ZoneType).Distinct().ToList();
                                            if (rz.Count == 0) { rz = generalZones; }
                                            var rzRestricted = rz.Count > 0 && rz.Count < ZoneTotal;

                                            <div class="scope-rule-line">
                                                <span class="scope-chip">منطقه @r</span>
                                                <span class="scope-rule-days">
                                                    @("روزکار: " + (rd.Count > 0 ? compressDays(rd) : allDaysText))
                                                    &nbsp;|&nbsp;
                                                    @("تعرفه: " + (rtTitles.Count > 0 ? string.Join("، ", rtTitles) : allTariffsText))
                                                    &nbsp;|&nbsp;
                                                    @("کد ناحیه: " + (raRestricted ? compressDays(ra) : allAreasText))
                                                    &nbsp;|&nbsp;
                                                    @("محدوده: " + (rzRestricted ? string.Join("، ", rz.OrderBy(z => z).Select(zoneTitle)) : allZonesText))
                                                    | @(electrical.SupplyType == 3 ? "عادی و دیماند" : electrical.SupplyType == 2 ? "دیماند" : "عادی") | @phaseTitle(electrical.PhaseMask)
                                                </span>
                                                <button type="button" class="scope-action edit-scope-region"
                                                        data-user="@scope.UserID"
                                                        data-region="@r"
                                                        data-supply="@electrical.SupplyType" data-phase="@electrical.PhaseMask"
                                                        data-tariffs="@string.Join(",", rt)"
                                                        data-areas="@(raRestricted ? string.Join(",", ra.OrderBy(a => a)) : "")"
                                                        data-zones="@(rzRestricted ? string.Join(",", rz.OrderBy(z => z)) : "")"
                                                        data-days="@string.Join(",", rd.OrderBy(d => d))">
                                                    ویرایش
                                                </button>
                                                <button type="button" class="scope-action delete-scope-region"
                                                        data-id="@scope.ID"
                                                        data-region="@r">
                                                    حذف
                                                </button>
                                            </div>
                                        }

                                        @if (scopeRegionList.Count == 0 && (generalDays.Count > 0 || generalTariffIds.Count > 0 || generalAreasRestricted || generalZonesRestricted || electricalSettings.Any(x => x.ScopeID == scope.ID && x.RegionCode == 0)))
                                        {
                                            <div class="scope-rule-line">
                                                <span class="scope-chip">همه مناطق</span>
                                                <span class="scope-rule-days">
                                                    @("روزکار: " + (generalDays.Count > 0 ? compressDays(generalDays) : allDaysText))
                                                    &nbsp;|&nbsp;
                                                    @("تعرفه: " + (generalTariffTitles.Count > 0 ? string.Join("، ", generalTariffTitles) : allTariffsText))
                                                    &nbsp;|&nbsp;
                                                    @("کد ناحیه: " + (generalAreasRestricted ? compressDays(generalAreas) : allAreasText))
                                                    &nbsp;|&nbsp;
                                                    @("محدوده: " + (generalZonesRestricted ? string.Join("، ", generalZones.OrderBy(z => z).Select(zoneTitle)) : allZonesText))
                                                    | @(generalElectrical.SupplyType == 3 ? "عادی و دیماند" : generalElectrical.SupplyType == 2 ? "دیماند" : "عادی") | @phaseTitle(generalElectrical.PhaseMask)
                                                </span>
                                                <button type="button" class="scope-action edit-scope-region"
                                                        data-user="@scope.UserID"
                                                        data-region="0"
                                                        data-supply="@generalElectrical.SupplyType" data-phase="@generalElectrical.PhaseMask"
                                                        data-tariffs="@string.Join(",", generalTariffIds)"
                                                        data-areas="@(generalAreasRestricted ? string.Join(",", generalAreas.OrderBy(a => a)) : "")"
                                                        data-zones="@(generalZonesRestricted ? string.Join(",", generalZones.OrderBy(z => z)) : "")"
                                                        data-days="@string.Join(",", generalDays.OrderBy(d => d))">
                                                    ویرایش
                                                </button>
                                                <button type="button" class="scope-action delete-scope-region"
                                                        data-id="@scope.ID"
                                                        data-region="0">
                                                    حذف
                                                </button>
                                            </div>
                                        }

                                        @if (scopeRegionList.Count == 0 && generalDays.Count == 0 && generalTariffIds.Count == 0 && !generalAreasRestricted && !generalZonesRestricted && !electricalSettings.Any(x => x.ScopeID == scope.ID && x.RegionCode == 0))
                                        {
                                            <div class="scope-rule-line">
                                                <span class="scope-chip">منطقه: @allRegionsText</span>
                                                <span class="scope-rule-days">
                                                    @("روزکار: " + allDaysText)
                                                    &nbsp;|&nbsp;
                                                    @("تعرفه: " + allTariffsText)
                                                    &nbsp;|&nbsp;
                                                    @("کد ناحیه: " + allAreasText)
                                                    &nbsp;|&nbsp;
                                                    @("محدوده: " + allZonesText)
                                                </span>
                                            </div>
                                        }

                                    </div>
                                </td>

                                <td>
                                    @{
                                        // مناطق مجاز که هنوز برای این مامور ثبت نشده‌اند
                                        var remainingRegions = allowedRegions.Except(scopeRegionList).OrderBy(x => x).ToList();
                                    }
                                    <div class="scope-actions">
                                        @if (scopeRegionList.Count > 0 && remainingRegions.Count > 0)
                                        {
                                            <button type="button" class="scope-action add-scope-region"
                                                    data-user="@scope.UserID"
                                                    data-existing="@string.Join(",", scopeRegionList)"
                                                    title="مناطق ثبت‌نشده: @string.Join("، ", remainingRegions)">
                                                + افزودن منطقه دیگر
                                            </button>
                                        }
                                        <button type="button" class="scope-action details-agent-scope" data-id="@scope.ID">جزئیات</button>
                                        <button type="button" class="scope-action delete-agent-scope" data-id="@scope.ID">حذف کل مامور</button>
                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- =====================================================
         TAB 3 - استثناها (انتخاب نوع: بالابری / آلودگی ← بارگذاری Excel)
         ListType: 1 = بالابری ، 2 = آلودگی
         ===================================================== -->

    <div id="tabThree" class="main-tab-panel" style="display:none">

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>استثناها - ورود مؤلفه‌ها از Excel</h2>
                    <p>ابتدا نوع استثنا را انتخاب کنید، سپس نمونه فایل مؤلفه را دریافت، مقادیر را در ستون اول قرار دهید و فایل را بارگذاری نمایید.</p>
                </div>
            </div>

            <div class="exception-selector-row">
                <label for="exceptionTypeSelect">نوع استثنا:</label>
                <select id="exceptionTypeSelect">
                    <option value="">-- انتخاب کنید --</option>
                    @foreach (var list in excelLists)
                    {
                        <option value="@list.Type">@list.Title</option>
                    }
                </select>
            </div>

            <div id="exceptionEmptyNote" class="exception-empty-note">
                برای بارگذاری فایل، ابتدا یکی از گزینه‌های «بالابری»، «آلودگی» یا «ممانعت» را انتخاب کنید.
            </div>

            @foreach (var list in excelLists)
            {
                <div class="exception-panel" data-list-type="@list.Type">

                    <div class="section-header" style="margin-bottom:10px">
                        <div><h2 style="font-size:14px">استثنای @list.Title</h2></div>
                    </div>

                    <div class="excel-component-grid">

                        @foreach (var component in (list.Type == 3 ? new Dictionary<int, string> { { 5, "ممانعت" } } : excelComponents))
                        {
                            if (developingExcelComponents.Contains(component.Key))
                            {
                                <div class="excel-component-card excel-card-disabled">

                                    <div class="excel-component-head">
                                        <h3 class="excel-component-title">@component.Value</h3>
                                        <span class="excel-component-number">@component.Key</span>
                                    </div>

                                    <div class="excel-disabled-box">
                                        <div class="excel-disabled-badge">در حال توسعه</div>
                                        <div class="excel-disabled-text">
                                            بارگذاری فایل «@component.Value» به‌زودی فعال خواهد شد.
                                        </div>
                                    </div>

                                </div>

                                continue;
                            }

                            var activeBatch = excelImportBatches
                                .Where(x => x.ComponentType == component.Key
                                            && x.ListType == list.Type
                                            && x.IsActive == true)
                                .OrderByDescending(x => x.ID)
                                .FirstOrDefault();

                            <form class="excel-component-card component-upload-form"
                                  enctype="multipart/form-data"
                                  data-list-type="@list.Type"
                                  data-component-type="@component.Key"
                                  data-component-title="@component.Value">

                                @Html.AntiForgeryToken()

                                <div class="excel-component-head">
                                    <h3 class="excel-component-title">@component.Value</h3>
                                    <span class="excel-component-number">@component.Key</span>
                                </div>

                                <div class="excel-component-description">
                                    @if (list.Type == 3)
                                    {
                                        <div>فایل ممانعت باید دقیقاً این چهار ستون را به همین ترتیب داشته باشد:</div>
                                        <div style="overflow-x:auto;margin:10px 0">
                                            <table style="width:100%;border-collapse:collapse;text-align:right">
                                                <thead>
                                                    <tr>
                                                        <th style="padding:8px;border:1px solid #405875">اشتراک</th>
                                                        <th style="padding:8px;border:1px solid #405875">پرونده</th>
                                                        <th style="padding:8px;border:1px solid #405875">شماره سریال کنتور</th>
                                                        <th style="padding:8px;border:1px solid #405875">علت ممانعت</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>
                                        <div>تکمیل هر چهار ستون الزامی است. ردیف‌های کاملاً خالی یا کاملاً تکراری نادیده گرفته می‌شوند.</div>
                                    }
                                    else
                                    {
                                        <span>فایل باید فقط یک ستون با عنوان دقیق «@component.Value» داشته باشد. ردیف‌های خالی و مقادیر تکراری نادیده گرفته می‌شوند.</span>
                                    }
                                </div>

                                <div class="excel-file-picker">
                                    <input type="file" id="componentExcel_@(list.Type)_@component.Key" name="excelFile"
                                           class="component-excel-file" accept=".xlsx,.xls" />
                                    <label class="excel-file-label" for="componentExcel_@(list.Type)_@component.Key">انتخاب فایل</label>
                                    <span class="excel-selected-file">فایلی انتخاب نشده است</span>
                                </div>

                                <div class="excel-component-actions">

                                    <a class="excel-action-link"
                                       href="@Url.Action("DownloadLossComponentTemplate", "Losses", new { area = "Setting", componentType = component.Key, listType = list.Type })">
                                        دریافت نمونه Excel
                                    </a>

                                    <button type="submit" class="excel-upload-button">بارگذاری و ذخیره</button>

                                    @if (activeBatch != null)
                                    {
                                        <button type="button" class="excel-disable-button disable-component-import"
                                                data-id="@activeBatch.ID">
                                            غیرفعال‌سازی فایل فعلی
                                        </button>
                                    }

                                </div>

                                @if (activeBatch != null)
                                {
                                    <div class="excel-active-batch">
                                        <strong>فایل فعال:</strong>
                                        @(activeBatch.OriginalFileName ?? "-")
                                        <br />
                                        <strong>تعداد مقادیر:</strong>
                                        @activeBatch.RowCount
                                    </div>
                                }

                                <div class="excel-result"></div>

                            </form>
                        }

                    </div>

                </div>
            }

        </div>

    </div>

</div>


<!-- اگر در _Layout.cshtml از قبل jQuery لود شده است، این خط را حذف کنید. -->
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>


<script>

$(document).ready(function () {

    var DEFAULT_ASSIGNMENT_TITLE = "تعیین نقش";
    var DEFAULT_ASSIGNMENT_DESCRIPTION = "";
    var TAB_KEY = "LossAssignmentActiveTab";
    var ZONE_TOTAL = 2;


    /* =====================================================
       COMMON
       ===================================================== */

    function token(formSelector) {
        return $(formSelector + ' input[name="__RequestVerificationToken"]').val();
    }

    function message(text, type) {
        var box = $("#orderNotification");

        box.stop(true, true)
            .removeClass("success error")
            .addClass(type || "success")
            .text(text || "")
            .fadeIn(150);

        clearTimeout(window.orderMessageTimer);

        window.orderMessageTimer = setTimeout(function () {
            box.fadeOut(200);
        }, 3500);
    }

    function loading(show) {
        $("#pageLoadingOverlay").toggleClass("show", !!show);
    }

    function htmlEncode(value) {
        return $("<div>").text(value == null ? "" : value).html();
    }

    function zoneTitle(z) {
        return parseInt(z, 10) === 1 ? "شهری" : "روستایی";
    }


    /* =====================================================
       TABS
       ===================================================== */

    $(".main-tab-button").on("click", function () {

        var target = $(this).data("tab");

        $(".main-tab-button").removeClass("active");
        $(this).addClass("active");

        $(".main-tab-panel").hide();
        $("#" + target).show();

        sessionStorage.setItem(TAB_KEY, target);

        // پیغام مهم فقط برای سربرگ اول و دوم
        if ((target === "tabOne" || target === "tabTwo") && window.showImportantNotice) {
            window.showImportantNotice();
        }
    });

    var savedTab = sessionStorage.getItem(TAB_KEY);

    if (savedTab
        && $("#" + savedTab).length
        && $('.main-tab-button[data-tab="' + savedTab + '"]').length) {

        $('.main-tab-button[data-tab="' + savedTab + '"]').trigger("click");
    }
    else if (window.showImportantNotice) {
        window.showImportantNotice();
    }


    /* =====================================================
       TAB 1 MASTER CHECKBOX
       ===================================================== */

    function updateAssignmentMasters() {

        $(".column-select-all").each(function () {

            var master = $(this);
            var activityId = master.data("activity");

            var items = $('.user-activity-check[data-activity="' + activityId + '"]:not(:disabled)');
            var checked = items.filter(":checked").length;

            master.prop("disabled", items.length === 0);

            if (items.length > 0 && checked === items.length) {
                master.prop("checked", true).prop("indeterminate", false);
            }
            else if (checked > 0) {
                master.prop("checked", false).prop("indeterminate", true);
            }
            else {
                master.prop("checked", false).prop("indeterminate", false);
            }
        });
    }

    $(".column-select-all").on("change", function () {

        var activity = $(this).data("activity");
        var checked = $(this).is(":checked");

        var $column = $('.user-activity-check[data-activity="' + activity + '"]:not(:disabled)');

        // هر نیرو فقط یک نقش دارد: با انتخاب این ستون، نقش‌های دیگر آن نیرو برداشته می‌شود
        if (checked) {
            $column.each(function () {
                $('.user-activity-check[data-user="' + $(this).data("user") + '"]').not(this).prop("checked", false);
            });
        }

        $column.prop("checked", checked);

        updateAssignmentMasters();
    });

    // فقط یک نقش برای هر نیرو
    $(document).on("change", ".user-activity-check", function () {

        if ($(this).is(":checked")) {
            $('.user-activity-check[data-user="' + $(this).data("user") + '"]').not(this).prop("checked", false);
        }

        updateAssignmentMasters();
    });


    /* =====================================================
       TAB 1 USER SEARCH
       ===================================================== */

    $("#matrixUserSearch").on("input", function () {

        var q = $.trim($(this).val()).toLowerCase();

        $("#assignmentMatrix .user-activity-row").each(function () {

            var text = ($(this).attr("data-search") || "").toLowerCase();

            $(this).toggle(!q || text.indexOf(q) >= 0);
        });
    });


    /* =====================================================
       TAB 1 SUMMARY SEARCH
       ===================================================== */

    $(document).on("input", ".summary-cell-search", function () {

        var cell = $(this).closest(".summary-cell-box");
        var query = $.trim($(this).val()).toLowerCase();
        var visibleCount = 0;

        cell.find(".summary-person-item").each(function () {

            var item = $(this);
            var text = (item.attr("data-search") || "").toLowerCase();
            var visible = !query || text.indexOf(query) >= 0;

            item.toggle(visible);

            if (visible) { visibleCount++; }
        });

        var total = parseInt(cell.find(".summary-person-count").attr("data-total") || "0");

        cell.find(".summary-search-result-count")
            .text(query ? visibleCount + " از " + total : "همه");

        cell.find(".summary-no-result").toggle(!!query && visibleCount === 0);

        cell.find(".summary-person-scroll").scrollTop(0);
    });


    /* =====================================================
       TAB 1 SAVE
       ===================================================== */

    var assignmentUrls = {
        save: '@Url.Action("CreateLossAssignment", "Losses", new { area = "Setting" })'
    };

    function selectedPairs() {
        var result = [];

        $(".user-activity-check:checked").each(function () {
            result.push($(this).data("user") + "_" + $(this).data("activity"));
        });

        return result;
    }

    // همه کاربران ارسال می‌شوند؛ حتی کاربری که هیچ تیکی ندارد
    function allMatrixUsers() {
        var map = {};

        $(".user-activity-check").each(function () {
            map[$(this).data("user")] = true;
        });

        return Object.keys(map);
    }

    var assignmentSaving = false;

    $("#assignmentForm").on("submit", function (e) {

        e.preventDefault();

        if (assignmentSaving) { return; }

        var allUserIds = allMatrixUsers();
        var pairs = selectedPairs();

        if (allUserIds.length === 0) {
            message("هیچ نیرویی برای ثبت وجود ندارد.", "error");
            return;
        }

        // محافظ: هر نیرو حداکثر یک نقش
        var perUser = {}, multi = false;
        $.each(pairs, function (_, p) {
            var u = p.split("_")[0];
            perUser[u] = (perUser[u] || 0) + 1;
            if (perUser[u] > 1) { multi = true; }
        });

        if (multi) {
            message("هر نیرو فقط می‌تواند یک نقش داشته باشد.", "error");
            return;
        }

        assignmentSaving = true;

        var $submitButton = $(this).find(":submit");

        $submitButton.prop("disabled", true);
        loading(true);

        $.ajax({
            url: assignmentUrls.save,
            type: "POST",
            traditional: true,
            data: {
                __RequestVerificationToken: token("#assignmentForm"),
                Title: DEFAULT_ASSIGNMENT_TITLE,
                Description: DEFAULT_ASSIGNMENT_DESCRIPTION,
                UserIds: allUserIds,
                UserActivityPairs: pairs
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    sessionStorage.setItem(TAB_KEY, "tabOne");
                    window.location.reload();
                }
                else {
                    message(r && r.message ? r.message : "عملیات انجام نشد.", "error");
                }
            },
            error: function () {
                message("خطا در ارتباط با سرور.", "error");
            },
            complete: function () {
                assignmentSaving = false;
                $submitButton.prop("disabled", false);
                loading(false);
            }
        });
    });


    /* =====================================================
       TAB 1 CLEAR
       ===================================================== */

    $("#clearAssignment").on("click", function () {
        $(".user-activity-check").prop("checked", false).prop("disabled", false);
        $(".column-select-all").prop("checked", false).prop("indeterminate", false);
    });


    /* =====================================================
       TAB 2 SEARCH
       ===================================================== */

    function bindScopeSearch(inputSelector, itemSelector, lower) {
        $(inputSelector).on("input", function () {

            var q = $.trim($(this).val());
            if (lower) { q = q.toLowerCase(); }

            $(itemSelector).each(function () {

                var text = ($(this).attr("data-search") || "").toString();
                if (lower) { text = text.toLowerCase(); }

                $(this).toggle(!q || text.indexOf(q) >= 0);
            });
        });
    }

    bindScopeSearch("#scopeUserSearch", ".scope-user-option", true);
    bindScopeSearch("#scopeRegionSearch", ".scope-region-option", false);
    bindScopeSearch("#scopeWorkDaySearch", ".scope-workday-option", false);


    /* =====================================================
       TAB 2 SELECT ALL
       ===================================================== */

    function syncMaster(masterSel, itemSel) {

        var $items = $(itemSel);
        var checked = $items.filter(":checked").length;

        $(masterSel)
            .prop("checked", $items.length > 0 && checked === $items.length)
            .prop("indeterminate", checked > 0 && checked < $items.length);
    }

    function syncScopeMasters() {
        syncMaster("#scopeAllUsers",    ".scope-user-option:not(.scope-user-hidden) .scope-user-check");
        syncMaster("#scopeAllRegions",  ".scope-region-option:not(.scope-region-hidden) .scope-region-check");
        syncMaster("#scopeAllWorkDays", ".scope-workday-check");
        syncMaster("#scopeAllAreas",    ".scope-area-check");
        syncMaster("#scopeAllTariffs",  ".scope-tariff-check");
        syncMaster("#scopeAllZones",    ".scope-zone-check");

        $("#scopeNoNewUsers").toggle($(".scope-user-option:not(.scope-user-hidden)").length === 0);
    }

    function restoreScopeUsers() {

        $(".scope-user-editing")
            .removeClass("scope-user-editing")
            .addClass("scope-user-hidden")
            .find(".scope-user-check").prop("checked", false);

        $(".scope-user-option:not(.scope-user-hidden)")
            .find(".scope-user-check").prop("disabled", false).prop("checked", true);
    }

    $("#scopeAllUsers").on("change", function () {
        $(".scope-user-option:visible")
            .find(".scope-user-check:not(:disabled)")
            .prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllRegions").on("change", function () {
        $(".scope-region-option:visible")
            .find(".scope-region-check")
            .prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllWorkDays").on("change", function () {
        $(".scope-workday-option:visible")
            .find(".scope-workday-check")
            .prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllAreas").on("change", function () {
        $(".scope-area-check").prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllTariffs").on("change", function () {
        $(".scope-tariff-check").prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $("#scopeAllZones").on("change", function () {
        $(".scope-zone-check").prop("checked", $(this).is(":checked"));
        syncScopeMasters();
    });

    $(document).on("change",
        ".scope-user-check, .scope-region-check, .scope-workday-check, .scope-area-check, .scope-tariff-check, .scope-zone-check",
        syncScopeMasters);


    /* =====================================================
       TAB 2 URLS
       ===================================================== */

    var scopeUrls = {
        save:    '@Url.Action("SaveLossAgentScope", "Losses", new { area = "Setting" })',
        get:     '@Url.Action("GetLossAgentScope", "Losses", new { area = "Setting" })',
        details: '@Url.Action("GetLossAgentScopeDetails", "Losses", new { area = "Setting" })',
        remove:  '@Url.Action("DeleteLossAgentScope", "Losses", new { area = "Setting" })',
        removeRegion: '@Url.Action("DeleteLossAgentScopeRegion", "Losses", new { area = "Setting" })'
    };


    /* =====================================================
       TAB 2 HELPERS
       ===================================================== */

    function scopeValues(selector) {
        var result = [];

        $(selector + ":checked").each(function () {
            result.push(parseInt($(this).val(), 10));
        });

        return result;
    }

    // همه تیک‌خورده = بدون محدودیت → آرایه خالی
    function selectedOrAll(selector) {

        var total = $(selector).length;
        var values = scopeValues(selector);

        return values.length === total ? [] : values;
    }

    function compressDays(list) {

        var s = $.map(list, function (x) { return parseInt(x, 10); })
                 .sort(function (a, b) { return a - b; });

        var parts = [], i = 0;

        while (i < s.length) {
            var j = i;
            while (j + 1 < s.length && s[j + 1] === s[j] + 1) { j++; }
            parts.push(j > i ? s[i] + " تا " + s[j] : "" + s[i]);
            i = j + 1;
        }

        return parts.join("، ");
    }


    /* =====================================================
       TAB 2 RULES  { regionCode (0 = همه مناطق) : {...} }
       ===================================================== */

    function supplyType() {
        var mask = 0;
        $('input[name="SupplyType"]:checked').each(function () { mask |= parseInt(this.value, 10); });
        return mask;
    }
    function phaseMask() { return ($('#phaseSingle').prop('checked') ? 1 : 0) + ($('#phaseThree').prop('checked') ? 2 : 0); }
    function syncElectrical() {
        var demand = supplyType() === 2;
        $('#phaseSingle').prop('disabled', demand);
        $('#phaseSingle').closest('label').toggleClass('electrical-disabled', demand);
        if (demand) { $('#phaseSingle').prop('checked', false); $('#phaseThree').prop('checked', true); }
    }
    function setElectrical(type, mask) {
        $('input[name="SupplyType"]').each(function () {
            $(this).prop('checked', (type & parseInt(this.value, 10)) !== 0);
        });
        $('#phaseSingle').prop('checked', (mask & 1) !== 0);
        $('#phaseThree').prop('checked', (mask & 2) !== 0);
        syncElectrical();
    }
    function electricalText(rule) {
        return ' | نوع اشتراک: ' + (rule.SupplyType === 3 ? 'عادی و دیماند' : rule.SupplyType === 2 ? 'دیماند' : 'عادی') +
            ' | فازها: ' + (rule.PhaseMask === 1 ? 'تک فاز' : rule.PhaseMask === 2 ? 'سه فاز' : 'تک فاز، سه فاز');
    }
    $('input[name="SupplyType"], #phaseThree').on('change', syncElectrical);
    syncElectrical();
    var scopeRules = {};

    function tariffTitle(id) {
        return $.trim(
            $('.scope-tariff-check[value="' + id + '"]').closest("label").find(".scope-text").text());
    }

    function ruleText(rule) {

        var tariffText = (rule.Tariffs && rule.Tariffs.length)
            ? $.map(rule.Tariffs, tariffTitle).join("، ")
            : "همه";

        var zoneText = (rule.ZoneTypes && rule.ZoneTypes.length)
            ? $.map(rule.ZoneTypes, zoneTitle).join("، ")
            : "شهری، روستایی";

        return "روزکار: " + ((rule.Days && rule.Days.length) ? compressDays(rule.Days) : "همه") +
               " | تعرفه: " + tariffText +
               " | کد ناحیه: " + ((rule.Areas && rule.Areas.length) ? compressDays(rule.Areas) : "همه") +
               " | محدوده: " + zoneText + electricalText(rule);
    }

    function renderScopeRules() {

        var $box = $("#scopeRuleList").empty();

        if (!$box.length) { return; }

        var keys = Object.keys(scopeRules)
            .map(Number)
            .sort(function (a, b) { return a - b; });

        if (!keys.length) {
            $box.html("<div class='rule-empty'>هنوز موردی به لیست اضافه نشده است (بدون محدودیت).</div>");
            return;
        }

        $.each(keys, function (_, r) {

            $box.append(
                "<div class='rule-row'>" +
                    "<span class='scope-chip'>" + (r ? "منطقه " + r : "همه مناطق") + "</span>" +
                    "<span class='rule-days'>" + htmlEncode(ruleText(scopeRules[r])) + "</span>" +
                    "<button type='button' class='scope-action delete-rule' data-region='" + r + "'>حذف</button>" +
                "</div>"
            );
        });
    }

    /* حالت «افزودن منطقه دیگر» برای مامور ثبت‌شده */
    var addRegionMode = false;

    function leaveAddRegionMode() {
        addRegionMode = false;
        $(".scope-region-option").removeClass("scope-region-hidden");
        $("#addRegionBanner").hide().empty();
    }

    function resetScopeSelection() {
        setElectrical(1, 3);
        leaveAddRegionMode();
        $(".scope-region-check, .scope-workday-check, .scope-area-check, .scope-tariff-check, .scope-zone-check").prop("checked", true);
        $("#workDayFrom, #workDayTo").val("");
        syncScopeMasters();
    }

    function addSelectionAsRule(showError) {

        var regions = selectedOrAll(".scope-region-check");
        var days    = selectedOrAll(".scope-workday-check").sort(function (a, b) { return a - b; });
        var tariffs = selectedOrAll(".scope-tariff-check").sort(function (a, b) { return a - b; });
        var areas   = selectedOrAll(".scope-area-check").sort(function (a, b) { return a - b; });
        var zones   = selectedOrAll(".scope-zone-check").sort(function (a, b) { return a - b; });

        if (!supplyType()) {
            message("حداقل یک نوع اشتراک انتخاب کنید.", "error");
            return false;
        }
        if (!phaseMask()) {
            message("حداقل یک فاز انتخاب کنید.", "error");
            return false;
        }

        // برای منطقه تکراری، تنظیمات قبلی جایگزین می‌شود
        $.each(regions.length ? regions : [0], function (_, r) {
            scopeRules[r] = {
                Days: days.slice(),
                Tariffs: tariffs.slice(),
                Areas: areas.slice(),
                SupplyType: supplyType(), PhaseMask: phaseMask(),
                ZoneTypes: zones.slice()
            };
        });

        resetScopeSelection();
        renderScopeRules();

        return true;
    }

    $(document).on("click", ".delete-rule", function () {
        delete scopeRules[$(this).data("region")];
        renderScopeRules();
    });

    $("#applyWorkDayRange").on("click", function () {

        var from = parseInt($("#workDayFrom").val(), 10);
        var to = parseInt($("#workDayTo").val(), 10);

        if (isNaN(from) || isNaN(to) || from < 1 || to > 99 || from > to) {
            message("بازه روزکار معتبر نیست (بین 1 تا 99).", "error");
            return;
        }

        $(".scope-workday-check").each(function () {
            var v = parseInt($(this).val(), 10);
            $(this).prop("checked", v >= from && v <= to);
        });

        syncScopeMasters();
    });

    renderScopeRules();


    /* =====================================================
       TAB 2 SAVE
       ===================================================== */

    $("#agentScopeForm").on("submit", function (e) {

        e.preventDefault();

        var selectedUserIds = scopeValues(".scope-user-check");

        if (selectedUserIds.length === 0) {
            message("حداقل یک مامور انتخاب کنید.", "error");
            return;
        }

        // هر پنج بخش باید حداقل یک مورد تیک‌خورده داشته باشند
        var missing = [];
        if (!supplyType()) { missing.push("نوع اشتراک"); }
        if (!phaseMask()) { missing.push("فازها"); }

        if (scopeValues(".scope-region-check").length === 0)  { missing.push("منطقه"); }
        if (scopeValues(".scope-workday-check").length === 0) { missing.push("روزکار"); }
        if (scopeValues(".scope-area-check").length === 0)    { missing.push("کد ناحیه"); }
        if (scopeValues(".scope-tariff-check").length === 0)  { missing.push("نوع تعرفه"); }
        if (scopeValues(".scope-zone-check").length === 0)    { missing.push("محدوده (شهری/روستایی)"); }

        if (missing.length) {
            message("برای ثبت باید حداقل یک مورد از این بخش‌ها انتخاب شود: " + missing.join("، "), "error");
            return;
        }

        if (addRegionMode) {

            // مناطق جدید همیشه صریح ارسال می‌شوند (حتی اگر بقیه موارد «همه» باشند)
            var newRegions = scopeValues(".scope-region-option:not(.scope-region-hidden) .scope-region-check");

            if (!newRegions.length) {
                message("حداقل یک منطقه جدید انتخاب کنید.", "error");
                return;
            }

            var dd = selectedOrAll(".scope-workday-check").sort(function (a, b) { return a - b; });
            var tt = selectedOrAll(".scope-tariff-check").sort(function (a, b) { return a - b; });
            var aa = selectedOrAll(".scope-area-check").sort(function (a, b) { return a - b; });
            var zz = selectedOrAll(".scope-zone-check").sort(function (a, b) { return a - b; });

            scopeRules = {};

            $.each(newRegions, function (_, r) {
                scopeRules[r] = { Days: dd.slice(), Tariffs: tt.slice(), Areas: aa.slice(), ZoneTypes: zz.slice(), SupplyType: supplyType(), PhaseMask: phaseMask() };
            });
        }
        else {
            addSelectionAsRule(false);
        }

        var rulesArray = $.map(Object.keys(scopeRules), function (k) {
            return {
                Region: parseInt(k, 10),
                Days: scopeRules[k].Days,
                Tariffs: scopeRules[k].Tariffs,
                Areas: scopeRules[k].Areas,
                SupplyType: scopeRules[k].SupplyType, PhaseMask: scopeRules[k].PhaseMask,
                ZoneTypes: scopeRules[k].ZoneTypes
            };
        });

        loading(true);

        $.ajax({
            url: scopeUrls.save,
            type: "POST",
            traditional: true,
            data: {
                __RequestVerificationToken: token("#agentScopeForm"),
                UserIds: selectedUserIds,
                AddOnly: addRegionMode,
                RulesJson: JSON.stringify(rulesArray)
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    sessionStorage.setItem(TAB_KEY, "tabTwo");
                    setTimeout(function () { location.reload(); }, 450);
                }
                else {
                    message(r && r.message ? r.message : "ثبت انجام نشد.", "error");
                }
            },
            error: function () {
                message("خطا در ارتباط با سرور.", "error");
            },
            complete: function () {
                loading(false);
            }
        });
    });


    /* =====================================================
       TAB 2 ADD ANOTHER REGION FOR A SAVED AGENT
       مامور به لیست بالا برمی‌گردد؛ مناطق ثبت‌شده‌اش مخفی و بدون تیک می‌شوند
       ===================================================== */

    $(document).on("click", ".add-scope-region", function () {

        var userId = $(this).data("user");

        var existing = ("" + ($(this).attr("data-existing") || ""))
            .split(",")
            .filter(function (x) { return x !== ""; })
            .map(function (x) { return parseInt(x, 10); });

        scopeRules = {};
        renderScopeRules();
        leaveAddRegionMode();

        restoreScopeUsers();
        $(".scope-user-check").prop("checked", false);

        var $user = $('.scope-user-check[value="' + userId + '"]');

        $user.prop("checked", true)
            .closest(".scope-user-option")
            .removeClass("scope-user-hidden")
            .addClass("scope-user-editing");

        addRegionMode = true;
        setElectrical(1, 3);

        // مناطق قبلی مخفی؛ مناطق جدید تیک‌خورده
        $(".scope-region-check").each(function () {
            var r = parseInt($(this).val(), 10);
            var isExisting = existing.indexOf(r) >= 0;

            $(this).prop("checked", !isExisting)
                .closest(".scope-region-option")
                .toggleClass("scope-region-hidden", isExisting);
        });

        $(".scope-workday-check, .scope-area-check, .scope-tariff-check, .scope-zone-check").prop("checked", true);
        $("#workDayFrom, #workDayTo").val("");

        var name = $.trim($user.closest(".scope-user-option").find(".scope-text").text());

        $("#addRegionBanner")
            .html("افزودن منطقه جدید برای «" + htmlEncode(name) + "» — مناطق قبلی (" +
                  existing.join("، ") + ") تغییری نمی‌کنند. منطقه‌های جدید را تیک بزنید، بقیه تنظیمات را مشخص و «ذخیره اطلاعات» را بزنید.")
            .show();

        syncScopeMasters();

        $(".main-tab-button").removeClass("active");
        $('.main-tab-button[data-tab="tabTwo"]').addClass("active");
        $(".main-tab-panel").hide();
        $("#tabTwo").show();

        $("html,body").animate({ scrollTop: $("#scopeFormCard").offset().top - 30 }, 250);
    });


    /* =====================================================
       TAB 2 EDIT ONE REGION
       ===================================================== */

    $(document).on("click", ".edit-scope-region", function () {

        leaveAddRegionMode();

        var userId = $(this).data("user");
        var region = parseInt($(this).data("region"), 10);

        function parseList(el, attr) {
            return ("" + ($(el).attr(attr) || ""))
                .split(",")
                .filter(function (x) { return x !== ""; })
                .map(function (x) { return parseInt(x, 10); });
        }

        var days = parseList(this, "data-days");
        var tariffIds = parseList(this, "data-tariffs");
        var areaIds = parseList(this, "data-areas");
        var zoneIds = parseList(this, "data-zones");
        setElectrical(parseInt($(this).attr("data-supply"), 10) || 1, parseInt($(this).attr("data-phase"), 10) || 3);

        scopeRules = {};
        renderScopeRules();

        restoreScopeUsers();
        $(".scope-user-check").prop("checked", false);

        $('.scope-user-check[value="' + userId + '"]')
            .prop("checked", true)
            .closest(".scope-user-option")
            .removeClass("scope-user-hidden")
            .addClass("scope-user-editing");

        // منطقه: region = 0 یعنی همه مناطق
        $(".scope-region-check").prop("checked", region <= 0);
        if (region > 0) {
            $('.scope-region-check[value="' + region + '"]').prop("checked", true);
        }

        // لیست خالی یعنی همه
        $(".scope-workday-check").prop("checked", days.length === 0);
        $.each(days, function (_, d) {
            $('.scope-workday-check[value="' + d + '"]').prop("checked", true);
        });

        $(".scope-area-check").prop("checked", areaIds.length === 0);
        $.each(areaIds, function (_, a) {
            $('.scope-area-check[value="' + a + '"]').prop("checked", true);
        });

        $(".scope-tariff-check").prop("checked", tariffIds.length === 0);
        $.each(tariffIds, function (_, t) {
            $('.scope-tariff-check[value="' + t + '"]').prop("checked", true);
        });

        $(".scope-zone-check").prop("checked", zoneIds.length === 0);
        $.each(zoneIds, function (_, z) {
            $('.scope-zone-check[value="' + z + '"]').prop("checked", true);
        });

        $("#workDayFrom, #workDayTo").val("");

        syncScopeMasters();

        $(".main-tab-button").removeClass("active");
        $('.main-tab-button[data-tab="tabTwo"]').addClass("active");
        $(".main-tab-panel").hide();
        $("#tabTwo").show();

        $("html,body").animate({ scrollTop: $("#scopeFormCard").offset().top - 30 }, 250);

        message("تنظیمات را تغییر دهید و «ذخیره اطلاعات» را بزنید.", "success");
    });


    /* =====================================================
       TAB 2 CLEAR
       ===================================================== */

    $("#clearAgentScope").on("click", function () {

        scopeRules = {};
        renderScopeRules();

        resetScopeSelection();
        restoreScopeUsers();

        syncScopeMasters();
    });


    /* =====================================================
       TAB 2 DELETE ONE REGION
       ===================================================== */

    $(document).on("click", ".delete-scope-region", function () {

        var id = $(this).data("id");
        var region = $(this).data("region");

        if (!confirm("این منطقه (و تنظیماتش) از تنظیمات مامور حذف شود؟")) { return; }

        loading(true);

        $.ajax({
            url: scopeUrls.removeRegion,
            type: "POST",
            data: {
                __RequestVerificationToken: token("#agentScopeForm"),
                id: id,
                region: region
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    sessionStorage.setItem(TAB_KEY, "tabTwo");
                    setTimeout(function () { location.reload(); }, 400);
                }
                else {
                    message(r && r.message ? r.message : "حذف انجام نشد.", "error");
                }
            },
            error: function () {
                message("خطا در حذف اطلاعات.", "error");
            },
            complete: function () {
                loading(false);
            }
        });
    });


    /* =====================================================
       TAB 2 DELETE
       ===================================================== */

    $(document).on("click", ".delete-agent-scope", function () {

        var id = $(this).data("id");

        if (!confirm("آیا اطلاعات این مامور حذف شود؟")) { return; }

        loading(true);

        $.ajax({
            url: scopeUrls.remove,
            type: "POST",
            data: {
                __RequestVerificationToken: token("#agentScopeForm"),
                id: id
            },
            success: function (r) {
                if (r && r.success) {
                    message(r.message, "success");
                    sessionStorage.setItem(TAB_KEY, "tabTwo");
                    setTimeout(function () { location.reload(); }, 400);
                }
                else {
                    message(r && r.message ? r.message : "حذف انجام نشد.", "error");
                }
            },
            error: function () {
                message("خطا در حذف اطلاعات.", "error");
            },
            complete: function () {
                loading(false);
            }
        });
    });


    /* =====================================================
       TAB 2 DETAILS
       ===================================================== */

    $(document).on("click", ".details-agent-scope", function () {

        var id = $(this).data("id");

        loading(true);

        $.ajax({
            url: scopeUrls.details,
            type: "GET",
            data: { id: id },
            success: function (r) {

                if (!r || !r.success) {
                    message(r && r.message ? r.message : "اطلاعات دریافت نشد.", "error");
                    return;
                }

                var d = r.data;
                var rulesHtml = "";
                var tariffMap = {};

                $.each(d.TariffTypes || [], function (_, t) {
                    tariffMap[t.ID] = t.Title;
                });

                var allTariffsText = $.map($(".scope-tariff-check"), function (el) {
                    return tariffTitle($(el).val());
                }).join("، ") || "همه";

                var allRegionsText = compressDays($.map($(".scope-region-check"), function (el) {
                    return parseInt($(el).val(), 10);
                })) || "همه";

                function ruleLine(regionText, x) {

                    var tariffText = (x.Tariffs && x.Tariffs.length)
                        ? $.map(x.Tariffs, function (id) { return tariffMap[id] || id; }).join("، ")
                        : allTariffsText;

                    var zoneText = (x.ZoneTypes && x.ZoneTypes.length && x.ZoneTypes.length < ZONE_TOTAL)
                        ? $.map(x.ZoneTypes, zoneTitle).join("، ")
                        : "شهری، روستایی";

                    return "<div>" + regionText + ": " +
                        "روزکار " + ((x.Days && x.Days.length) ? compressDays(x.Days) : "1 تا 99") +
                        " | تعرفه " + htmlEncode(tariffText) +
                        " | کد ناحیه " + ((x.Areas && x.Areas.length && x.Areas.length < 46) ? compressDays(x.Areas) : "0 تا 45") +
                        " | محدوده " + zoneText + electricalText(x) +
                        "</div>";
                }

                $.each(d.Rules || [], function (_, x) {
                    rulesHtml += ruleLine(x.Region ? "منطقه " + x.Region : "همه مناطق", x);
                });

                if (!rulesHtml) {
                    rulesHtml = ruleLine("منطقه " + allRegionsText, {});
                }

                var html = "";

                html += "<div class='detail-row'><div>نام مامور</div><div>" + htmlEncode(d.FullName) + "</div></div>";
                html += "<div class='detail-row'><div>کد ملی</div><div>" + htmlEncode(d.NationalCode) + "</div></div>";
                html += "<div class='detail-row'><div>تنظیمات</div><div>" + rulesHtml + "</div></div>";

                $("#scopeDetailsContent").html(html);
                $("#scopeDetailsModal").addClass("show");
            },
            error: function () {
                message("خطا در دریافت جزئیات.", "error");
            },
            complete: function () {
                loading(false);
            }
        });
    });


    $("#closeScopeDetails").on("click", function () {
        $("#scopeDetailsModal").removeClass("show");
    });

    $("#scopeDetailsModal").on("click", function (e) {
        if (e.target === this) { $(this).removeClass("show"); }
    });


    /* =====================================================
       TAB 2 SAVED TABLE SEARCH
       ===================================================== */

    $("#scopeSearch").on("input", function () {

        var q = $.trim($(this).val()).toLowerCase();

        $(".scope-data-row").each(function () {

            var text = ($(this).attr("data-name") || "").toLowerCase();

            $(this).toggle(!q || text.indexOf(q) >= 0);
        });
    });


    /* =====================================================
       TAB 3 (استثناها) : SELECTOR
       ===================================================== */

    var EXC_KEY = "LossExceptionType";

    function showExceptionPanel(type) {

        $(".exception-panel").hide();

        var $panel = $('.exception-panel[data-list-type="' + type + '"]');

        $("#exceptionEmptyNote").toggle($panel.length === 0);

        if ($panel.length) { $panel.show(); }
    }

    $("#exceptionTypeSelect").on("change", function () {

        var type = $(this).val();

        sessionStorage.setItem(EXC_KEY, type || "");

        showExceptionPanel(type);
    });

    (function () {
        var saved = sessionStorage.getItem(EXC_KEY);

        if (saved && $('#exceptionTypeSelect option[value="' + saved + '"]').length) {
            $("#exceptionTypeSelect").val(saved);
            showExceptionPanel(saved);
        }
    })();


    /* =====================================================
       TAB 3 : URLS / FILE NAME / UPLOAD / DISABLE
       ===================================================== */

    var componentImportUrls = {
        upload:  '@Url.Action("UploadLossComponentExcel", "Losses", new { area = "Setting" })',
        disable: '@Url.Action("DisableLossComponentImport", "Losses", new { area = "Setting" })'
    };

    $(document).on("change", ".component-excel-file", function () {

        var fileName = this.files && this.files.length
            ? this.files[0].name
            : "فایلی انتخاب نشده است";

        $(this).closest(".excel-file-picker").find(".excel-selected-file").text(fileName);
    });

    $(document).on("submit", ".component-upload-form", function (e) {

        e.preventDefault();

        var form = this;
        var $form = $(form);
        var fileInput = $form.find(".component-excel-file")[0];
        var $result = $form.find(".excel-result");

        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
            $result.removeClass("success").addClass("error").text("ابتدا فایل Excel را انتخاب کنید.");
            return;
        }

        var formData = new FormData(form);

        formData.append("componentType", $form.data("component-type"));
        formData.append("listType", $form.data("list-type"));

        var $button = $form.find(".excel-upload-button");

        $button.prop("disabled", true);
        loading(true);

        $.ajax({
            url: componentImportUrls.upload,
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (r) {

                if (r && r.success) {

                    $result.removeClass("error").addClass("success").text(r.message);

                    message(r.message, "success");

                    sessionStorage.setItem(TAB_KEY, "tabThree");

                    window.location.reload();
                }
                else {

                    var errorText = r && r.message ? r.message : "بارگذاری فایل انجام نشد.";

                    if (r && r.errors && r.errors.length) {
                        errorText += " | " + r.errors.join(" | ");
                    }

                    $result.removeClass("success").addClass("error").text(errorText);

                    message(errorText, "error");
                }
            },
            error: function () {

                var errorText = "خطا در ارتباط با سرور هنگام بارگذاری فایل.";

                $result.removeClass("success").addClass("error").text(errorText);

                message(errorText, "error");
            },
            complete: function () {
                $button.prop("disabled", false);
                loading(false);
            }
        });
    });

    $(document).on("click", ".disable-component-import", function () {

        var $button = $(this);

        if (!confirm("آیا فایل فعال این مؤلفه غیرفعال شود؟")) { return; }

        $button.prop("disabled", true);
        loading(true);

        $.ajax({
            url: componentImportUrls.disable,
            type: "POST",
            data: {
                __RequestVerificationToken: $button
                    .closest(".component-upload-form")
                    .find('input[name="__RequestVerificationToken"]')
                    .val(),
                id: $button.data("id")
            },
            success: function (r) {

                if (r && r.success) {

                    message(r.message, "success");

                    sessionStorage.setItem(TAB_KEY, "tabThree");

                    window.location.reload();
                }
                else {

                    message(r && r.message ? r.message : "غیرفعال‌سازی انجام نشد.", "error");

                    $button.prop("disabled", false);
                }
            },
            error: function () {
                message("خطا در ارتباط با سرور.", "error");
                $button.prop("disabled", false);
            },
            complete: function () {
                loading(false);
            }
        });
    });


    /* =====================================================
       INITIAL
       ===================================================== */

    updateAssignmentMasters();
    syncScopeMasters();

});

</script>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "مدیریت و اولویت‌بندی";
}

<style>
    /* ============ پایه (همه‌چیز با tk- اسکوپ شده تا با CSS لایه‌ی اصلی تداخل نکند) ============ */
    .tk-scope {
        --tk-off: 120px; /* ← ارتفاع هدر لایه‌ی خودت؛ اگر صفحه اسکرول کل‌صفحه گرفت این عدد را بیشتر کن */
        --cyan: #22d3ee;
        --pink: #f43f9e;
        --violet: #8b5cf6;
        --lime: #a3e635;
        --amber: #fbbf24;
        --red: #fb7185;
        --text: #e9edff;
        --muted: #9aa7d1;
        --line: rgba(255,255,255,.16);
        direction: rtl;
        text-align: right;
        font-family: inherit;
        font-size: 13px;
        line-height: 1.6;
        color: var(--text)
    }

        .tk-scope *, .tk-scope *::before, .tk-scope *::after {
            box-sizing: border-box
        }

        .tk-scope h1, .tk-scope h2, .tk-scope h3 {
            margin: 0;
            font-family: inherit;
            line-height: 1.4;
            color: inherit
        }

        .tk-scope a {
            text-decoration: none
        }

        .tk-scope button {
            font-family: inherit
        }

    .tk-root {
        position: relative;
        overflow: hidden;
        overflow: clip;
        isolation: isolate;
        border-radius: 20px;
        padding: 12px;
        height: calc(100vh - var(--tk-off));
        height: calc(100dvh - var(--tk-off));
        min-height: 440px;
        display: flex;
        flex-direction: column;
        background: radial-gradient(800px 420px at 85% -10%,rgba(99,60,255,.5),transparent 60%), radial-gradient(700px 420px at -5% 105%,rgba(244,63,158,.36),transparent 60%), linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px) 0 0/32px 32px, linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px) 0 0/32px 32px, linear-gradient(160deg,#060818,#0c1030);
        border: 1px solid rgba(255,255,255,.12);
        box-shadow: 0 14px 44px rgba(0,0,0,.5),0 0 0 1px rgba(34,211,238,.12),0 0 56px rgba(139,92,246,.2)
    }

        .tk-root > * {
            position: relative;
            z-index: 1
        }

        .tk-root::before, .tk-root::after {
            content: "";
            position: absolute;
            z-index: 0;
            border-radius: 50%;
            filter: blur(80px);
            opacity: .45;
            pointer-events: none
        }

        .tk-root::before {
            width: 300px;
            height: 300px;
            background: var(--cyan);
            top: -120px;
            left: -90px;
            animation: tkFloat 14s ease-in-out infinite
        }

        .tk-root::after {
            width: 340px;
            height: 340px;
            background: var(--pink);
            bottom: -140px;
            right: -100px;
            animation: tkFloat 18s ease-in-out infinite reverse
        }

    @@keyframes tkFloat {
        50% {
            transform: translate(50px,30px) scale(1.12)
        }
    }

    .tk-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        margin-bottom: 10px;
        flex: 0 0 auto
    }

    .tk-title {
        margin-left: auto !important;
        font-size: 16px !important;
        font-weight: 800;
        background: linear-gradient(90deg,var(--cyan),var(--pink));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent !important;
        filter: drop-shadow(0 0 12px rgba(34,211,238,.45))
    }

    .tk-link {
        display: inline-block;
        color: var(--text);
        padding: 5px 12px;
        border-radius: 9px;
        font-size: 12px;
        cursor: pointer;
        background: rgba(255,255,255,.07);
        border: 1px solid var(--line);
        backdrop-filter: blur(14px);
        transition: .25s
    }

        .tk-link:hover, .tk-link.on {
            color: #fff;
            border-color: var(--cyan);
            box-shadow: 0 0 16px rgba(34,211,238,.5),inset 0 0 10px rgba(34,211,238,.18)
        }

    .tk-glass {
        padding: 12px;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        min-height: 0;
        background: linear-gradient(145deg,rgba(255,255,255,.11),rgba(255,255,255,.03));
        border: 1px solid var(--line);
        backdrop-filter: blur(16px) saturate(150%);
        -webkit-backdrop-filter: blur(16px) saturate(150%);
        box-shadow: 0 8px 30px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.2)
    }

    .tk-main {
        flex: 1 1 auto;
        min-height: 0
    }

    .tk-h2 {
        font-size: 14px !important;
        color: var(--cyan) !important;
        text-shadow: 0 0 14px rgba(34,211,238,.65)
    }

    .tk-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding-left: 2px;
        margin-top: 8px;
        scrollbar-width: thin;
        scrollbar-color: rgba(34,211,238,.5) transparent
    }

        .tk-scroll::-webkit-scrollbar {
            width: 5px
        }

        .tk-scroll::-webkit-scrollbar-thumb {
            background: rgba(34,211,238,.5);
            border-radius: 9px
        }

    .tk-hint {
        color: var(--muted);
        font-size: 11px
    }

    /* نوار فیلتر */
    .tk-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        flex: 0 0 auto
    }

        .tk-bar .tk-h2 {
            margin-left: auto
        }

    /* --- سوئیچ «انجام‌شده‌ها» --- */
    .tk-scope label.tk-switch {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        padding: 4px 10px 4px 6px;
        border-radius: 99px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 400;
        color: var(--text);
        max-width: none;
        background: rgba(255,255,255,.06);
        border: 1px solid var(--line);
        transition: .2s;
        user-select: none
    }

        .tk-scope label.tk-switch:hover {
            border-color: var(--lime)
        }

    .tk-switch input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0
    }

    .tk-sw-track {
        direction: ltr;
        position: relative;
        flex: 0 0 36px;
        width: 36px;
        height: 20px;
        border-radius: 99px;
        background: rgba(255,255,255,.14);
        transition: .25s
    }

    .tk-sw-knob {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #cfd6ff;
        transition: .25s
    }

    .tk-switch input:checked ~ .tk-sw-track {
        background: linear-gradient(90deg,#65a30d,var(--lime));
        box-shadow: 0 0 14px rgba(163,230,53,.7)
    }

        .tk-switch input:checked ~ .tk-sw-track .tk-sw-knob {
            left: 19px;
            background: #fff
        }

    .tk-switch input:focus-visible ~ .tk-sw-track {
        outline: 2px solid var(--cyan);
        outline-offset: 2px
    }

    .tk-switch:has(input:checked) {
        border-color: var(--lime);
        box-shadow: 0 0 14px rgba(163,230,53,.3)
    }

    .tk-sw-cnt {
        min-width: 20px;
        text-align: center;
        padding: 0 6px;
        border-radius: 99px;
        font-size: 10px;
        font-weight: 800;
        line-height: 1.7;
        background: rgba(163,230,53,.2);
        color: var(--lime)
    }

    /* --- لیست کشویی کاربر با جستجو --- */
    .tk-combo {
        position: relative;
        width: 240px;
        max-width: 100%
    }

    .tk-scope .tk-combo-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 4px 8px 4px 10px;
        border-radius: 12px;
        cursor: pointer;
        color: var(--text);
        font-size: 12px;
        text-align: right;
        background: linear-gradient(135deg,rgba(255,255,255,.11),rgba(255,255,255,.03));
        border: 1px solid var(--line);
        transition: .2s
    }

        .tk-scope .tk-combo-btn:hover, .tk-combo.open .tk-combo-btn {
            border-color: var(--cyan);
            box-shadow: 0 0 16px rgba(34,211,238,.45)
        }

    .tk-av {
        flex: 0 0 22px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg,var(--violet),var(--pink));
        box-shadow: 0 0 10px rgba(139,92,246,.6)
    }

    .tk-cb-label {
        flex: 1;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    .tk-cb-x {
        display: none;
        flex: 0 0 18px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        background: rgba(255,255,255,.14);
        transition: .2s
    }

    .tk-combo.has .tk-cb-x {
        display: inline-flex
    }

    .tk-cb-x:hover {
        background: var(--red);
        color: #fff
    }

    .tk-cb-chev {
        color: var(--cyan);
        transition: .2s
    }

    .tk-combo.open .tk-cb-chev {
        transform: rotate(180deg)
    }

    .tk-combo-panel {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        left: 0;
        z-index: 40;
        padding: 8px;
        border-radius: 14px;
        background: linear-gradient(145deg,rgba(26,30,76,.98),rgba(10,12,36,.99));
        border: 1px solid var(--cyan);
        box-shadow: 0 0 30px rgba(34,211,238,.35),0 16px 40px rgba(0,0,0,.6)
    }

    .tk-combo.open .tk-combo-panel {
        display: block
    }

    .tk-cb-search {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 10px;
        border-radius: 10px;
        background: rgba(4,6,22,.7);
        border: 1px solid var(--line);
        transition: .2s
    }

        .tk-cb-search:focus-within {
            border-color: var(--cyan);
            box-shadow: 0 0 14px rgba(34,211,238,.4)
        }

    .tk-scope input.tk-cb-in {
        flex: 1;
        min-width: 0;
        width: auto;
        height: auto;
        padding: 7px 2px;
        background: transparent;
        border: 0;
        outline: 0;
        box-shadow: none;
        color: var(--text);
        font: inherit;
        font-size: 13px
    }

        .tk-scope input.tk-cb-in::placeholder {
            color: #6d7aa8
        }

    .tk-cb-list {
        position: relative;
        max-height: 250px;
        overflow-y: auto;
        margin-top: 6px;
        scrollbar-width: thin;
        scrollbar-color: rgba(34,211,238,.5) transparent
    }

    .tk-cb-opt {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        margin-bottom: 2px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 13px;
        border: 1px solid transparent;
        transition: .12s
    }

        .tk-cb-opt:hover, .tk-cb-opt.act {
            background: rgba(34,211,238,.14);
            border-color: rgba(34,211,238,.45)
        }

        .tk-cb-opt.sel {
            background: rgba(244,63,158,.14);
            border-color: var(--pink)
        }

        .tk-cb-opt .nm {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap
        }

        .tk-cb-opt mark {
            background: rgba(251,191,36,.35);
            color: #fff;
            border-radius: 3px;
            padding: 0 1px
        }

    .tk-cb-empty {
        padding: 16px 8px;
        text-align: center;
        color: var(--muted);
        font-size: 12px
    }

    /* فرم‌ها */
    .tk-scope label.tk-lbl {
        display: block;
        font-size: 11px;
        font-weight: 400;
        color: var(--muted);
        margin: 8px 0 3px;
        max-width: none
    }

    .tk-scope .tk-in {
        display: block;
        width: 100%;
        height: auto;
        padding: 7px 10px;
        border-radius: 10px;
        color: var(--text);
        font: inherit;
        font-size: 13px;
        background: rgba(4,6,22,.6);
        border: 1px solid rgba(255,255,255,.15);
        box-shadow: none;
        outline: none;
        transition: .2s
    }

        .tk-scope .tk-in:focus {
            border-color: var(--cyan);
            box-shadow: 0 0 0 2px rgba(34,211,238,.2),0 0 14px rgba(34,211,238,.4)
        }

    .tk-scope textarea.tk-in {
        min-height: 70px;
        resize: none
    }

    .tk-scope select.tk-in option {
        background: #0b0f24;
        color: #fff
    }

    .tk-scope select.tk-in.auto {
        width: auto;
        min-width: 160px;
        padding: 5px 10px;
        font-size: 12px
    }

    .tk-scope .tk-in::placeholder {
        color: #6d7aa8
    }

    .tk-two {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px
    }

    /* دکمه‌ها */
    .tk-btn {
        display: inline-block;
        cursor: pointer;
        border: 0;
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 13px;
        color: #fff;
        transition: .25s;
        background: linear-gradient(90deg,var(--cyan),var(--violet));
        box-shadow: 0 0 16px rgba(34,211,238,.45)
    }

        .tk-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 26px rgba(139,92,246,.85);
            color: #fff
        }

        .tk-btn.pink {
            background: linear-gradient(90deg,var(--pink),var(--violet));
            box-shadow: 0 0 16px rgba(244,63,158,.45)
        }

        .tk-btn.ghost {
            background: rgba(255,255,255,.08);
            border: 1px solid var(--line);
            box-shadow: none
        }

        .tk-btn.sm {
            padding: 4px 10px;
            font-size: 11px;
            border-radius: 8px
        }

        .tk-btn.danger {
            background: linear-gradient(90deg,#f43f5e,#be123c);
            box-shadow: 0 0 14px rgba(244,63,94,.5)
        }

    .tk-flex {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center
    }

        .tk-flex.end {
            justify-content: flex-end
        }

    .tk-ib {
        width: 26px;
        height: 26px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        cursor: pointer;
        border: 1px solid var(--line);
        background: rgba(255,255,255,.08);
        color: #fff;
        font-size: 12px;
        line-height: 1;
        transition: .2s
    }

        .tk-ib:hover {
            border-color: var(--cyan);
            box-shadow: 0 0 12px rgba(34,211,238,.5)
        }

        .tk-ib.danger:hover {
            border-color: var(--red);
            box-shadow: 0 0 12px rgba(251,113,133,.6)
        }

    /* کارت مسئله */
    .tk-task {
        --acc: var(--cyan);
        margin-bottom: 8px;
        padding: 9px 12px;
        border-radius: 12px;
        position: relative;
        background: linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.02));
        border: 1px solid rgba(255,255,255,.14);
        border-right: 3px solid var(--acc);
        box-shadow: inset -8px 0 18px -12px var(--acc);
        transition: .25s
    }

        .tk-task:hover {
            box-shadow: 0 0 20px -4px var(--acc),inset -8px 0 18px -12px var(--acc)
        }

        .tk-task.s1 {
            --acc: var(--amber)
        }

        .tk-task.s2 {
            --acc: var(--lime);
            opacity: .7
        }

        .tk-task.s3 {
            --acc: var(--red)
        }

        .tk-task.dragging {
            opacity: .4;
            border-color: var(--pink);
            box-shadow: 0 0 30px var(--pink)
        }

    .tk-top {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        justify-content: space-between
    }

    .tk-line {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0
    }

    .tk-grip {
        cursor: grab;
        color: var(--muted);
        font-size: 16px;
        user-select: none;
        line-height: 1
    }

    .tk-rank {
        flex: 0 0 28px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 12px;
        color: #fff;
        background: linear-gradient(135deg,var(--pink),var(--violet));
        box-shadow: 0 0 12px rgba(244,63,158,.7)
    }

        .tk-rank.done {
            background: linear-gradient(135deg,#65a30d,var(--lime));
            color: #102000;
            box-shadow: 0 0 12px rgba(163,230,53,.6)
        }

    .tk-ttl {
        font-weight: 700;
        font-size: 13px;
        min-width: 0;
        overflow-wrap: anywhere
    }

    .tk-desc {
        color: var(--muted);
        font-size: 12px;
        margin: 4px 0 0;
        white-space: pre-wrap;
        line-height: 1.7;
        cursor: pointer;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden
    }

        .tk-desc.x {
            display: block;
            -webkit-line-clamp: unset
        }

    .tk-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 6px;
        align-items: center
    }

    .tk-chip {
        display: inline-block;
        font-size: 11px;
        line-height: 1.5;
        padding: 1px 9px;
        border-radius: 99px;
        border: 1px solid rgba(255,255,255,.2);
        background: rgba(255,255,255,.06);
        white-space: nowrap
    }

        .tk-chip.owner {
            color: #fff;
            border-color: var(--violet);
            background: rgba(139,92,246,.25);
            box-shadow: 0 0 10px rgba(139,92,246,.45)
        }

        .tk-chip.s0 {
            color: var(--cyan);
            border-color: var(--cyan);
            box-shadow: 0 0 10px rgba(34,211,238,.4)
        }

        .tk-chip.s1 {
            color: var(--amber);
            border-color: var(--amber);
            box-shadow: 0 0 10px rgba(251,191,36,.4)
        }

        .tk-chip.s2 {
            color: var(--lime);
            border-color: var(--lime);
            box-shadow: 0 0 10px rgba(163,230,53,.4)
        }

        .tk-chip.s3 {
            color: var(--red);
            border-color: var(--red);
            box-shadow: 0 0 10px rgba(251,113,133,.4)
        }

        .tk-chip.late {
            color: var(--red);
            border-color: var(--red);
            animation: tkPulse 1.4s infinite
        }

        .tk-chip.pink {
            color: var(--pink);
            border-color: var(--pink);
            box-shadow: 0 0 10px rgba(244,63,158,.35)
        }

    @@keyframes tkPulse {
        50% {
            box-shadow: 0 0 14px var(--red)
        }
    }

    .tk-chip a {
        color: var(--cyan)
    }

    .tk-note {
        margin-top: 5px;
        font-size: 12px;
        color: var(--muted)
    }

    .tk-empty {
        text-align: center;
        color: var(--muted);
        padding: 30px 0
    }

    .tk-user {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 7px 10px;
        margin-bottom: 6px;
        border-radius: 10px;
        font-size: 12px;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.1)
    }

    /* مودال‌ها و اعلان (به body منتقل می‌شوند) */
    .tk-modal-bg {
        position: fixed;
        inset: 0;
        z-index: 99998;
        background: rgba(2,3,12,.7);
        backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 12px
    }

        .tk-modal-bg.open {
            display: flex
        }

    .tk-modal {
        width: 100%;
        max-width: 420px;
        max-height: 92vh;
        overflow: auto;
        padding: 14px;
        background: linear-gradient(145deg,rgba(24,28,70,.94),rgba(12,14,40,.96));
        border: 1px solid var(--cyan);
        box-shadow: 0 0 36px rgba(34,211,238,.35),0 20px 60px rgba(0,0,0,.6)
    }

    .tk-toast {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%) translateY(90px);
        z-index: 99999;
        padding: 9px 20px;
        border-radius: 12px;
        font-size: 13px;
        max-width: 90vw;
        background: rgba(8,12,38,.94);
        border: 1px solid var(--cyan);
        box-shadow: 0 0 24px rgba(34,211,238,.6);
        color: #fff;
        transition: .35s;
        opacity: 0;
        pointer-events: none
    }

        .tk-toast.show {
            transform: translateX(-50%);
            opacity: 1
        }

        .tk-toast.err {
            border-color: var(--red);
            box-shadow: 0 0 24px rgba(251,113,133,.6)
        }

    /* ============ موبایل / تبلت ============ */
    @@media(max-width:900px) {
        .tk-root {
            height: auto;
            min-height: 0;
            padding: 10px;
            border-radius: 16px
        }

        .tk-scroll {
            overflow: visible;
            margin-top: 6px
        }

        .tk-title {
            font-size: 14px !important
        }

        .tk-hint {
            display: none
        }

        .tk-bar .tk-h2 {
            flex: 1 0 100%
        }

        .tk-combo {
            flex: 1 1 180px;
            width: auto
        }

        .tk-grip {
            display: none
        }
    }

    /* ============ انتخاب‌گر تاریخ شمسی ============ */
    .tk-dp {
        box-sizing: border-box;
        position: fixed;
        z-index: 100000;
        display: none;
        width: 292px;
        padding: 10px;
        border-radius: 16px;
        background: linear-gradient(145deg,rgba(26,30,76,.97),rgba(10,12,36,.98));
        border: 1px solid var(--cyan);
        box-shadow: 0 0 34px rgba(34,211,238,.4),0 18px 50px rgba(0,0,0,.65);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px)
    }

        .tk-dp.open {
            display: block
        }

    .tk-dp-head {
        display: flex;
        gap: 6px;
        align-items: center;
        margin-bottom: 8px
    }

    .tk-dp .tk-dp-nav {
        flex: 0 0 30px;
        width: 30px;
        height: 30px;
        padding: 0;
        border-radius: 9px;
        border: 1px solid var(--line);
        background: rgba(255,255,255,.08);
        color: #fff;
        cursor: pointer;
        font-size: 18px;
        line-height: 1;
        transition: .2s
    }

        .tk-dp .tk-dp-nav:hover {
            border-color: var(--cyan);
            box-shadow: 0 0 12px rgba(34,211,238,.55)
        }

    .tk-dp select {
        flex: 1 1 0;
        min-width: 0;
        width: auto;
        height: 30px;
        padding: 0 6px;
        border-radius: 9px;
        color: #fff;
        background: rgba(4,6,22,.75);
        border: 1px solid var(--line);
        font: inherit;
        font-size: 12px;
        outline: none;
        cursor: pointer
    }

        .tk-dp select:focus {
            border-color: var(--cyan)
        }

        .tk-dp select option {
            background: #0b0f24;
            color: #fff
        }

    .tk-dp-grid {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        gap: 3px;
        text-align: center
    }

    .tk-dp-wd {
        font-size: 11px;
        color: var(--muted);
        padding: 3px 0
    }

        .tk-dp-wd.fri {
            color: var(--red)
        }

    .tk-dp .tk-dp-d {
        height: 34px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        font: inherit;
        font-size: 13px;
        transition: .15s
    }

        .tk-dp .tk-dp-d:hover {
            background: rgba(34,211,238,.22);
            box-shadow: 0 0 12px rgba(34,211,238,.5)
        }

        .tk-dp .tk-dp-d.fri {
            color: var(--red)
        }

        .tk-dp .tk-dp-d.today {
            box-shadow: inset 0 0 0 1.5px var(--cyan)
        }

        .tk-dp .tk-dp-d.sel {
            color: #fff;
            background: linear-gradient(135deg,var(--pink),var(--violet));
            box-shadow: 0 0 16px rgba(244,63,158,.75)
        }

    .tk-dp-foot {
        display: flex;
        justify-content: space-between;
        gap: 6px;
        margin-top: 8px
    }

    .tk-dp .tk-dp-foot button {
        flex: 1;
        padding: 6px 8px;
        border-radius: 9px;
        border: 1px solid var(--line);
        background: rgba(255,255,255,.08);
        color: #fff;
        cursor: pointer;
        font-size: 12px;
        transition: .2s
    }

        .tk-dp .tk-dp-foot button:hover {
            border-color: var(--cyan);
            box-shadow: 0 0 12px rgba(34,211,238,.5)
        }

        .tk-dp .tk-dp-foot button.clr:hover {
            border-color: var(--red);
            box-shadow: 0 0 12px rgba(251,113,133,.6)
        }

    @@media(max-width:600px) {
        .tk-dp {
            left: 8px !important;
            right: 8px !important;
            top: auto !important;
            bottom: 8px;
            width: auto;
            max-width: 380px;
            margin: 0 auto
        }

            .tk-dp .tk-dp-d {
                height: 40px
            }
    }
</style>

<div class="tk-scope tk-root" id="tk-root">
    <div class="tk-nav">
        <h1 class="tk-title">✦ مدیریت و اولویت‌بندی</h1>
        <a class="tk-link" href="@Url.Action("Index")">ثبت مسئله</a>
        <a class="tk-link" href="@Url.Action("Board")">برد عمومی</a>
        <a class="tk-link on" href="@Url.Action("Manage")">مدیریت</a>
        <a class="tk-link" id="tk-btnAccess" role="button">🔑 دسترسی</a>
    </div>

    <div class="tk-glass tk-main">
        <div class="tk-bar">
            <h2 class="tk-h2" id="tk-count">همه‌ی کارها</h2>
            <div class="tk-combo" id="tk-combo">
                <button type="button" class="tk-combo-btn" id="tk-cbBtn" aria-haspopup="listbox">
                    <span class="tk-av" id="tk-cbAv">👥</span>
                    <span class="tk-cb-label" id="tk-cbLabel">همه‌ی کاربران</span>
                    <span class="tk-cb-x" id="tk-cbClear" title="نمایش همه‌ی کاربران">✕</span>
                    <span class="tk-cb-chev">▾</span>
                </button>
                <div class="tk-combo-panel">
                    <div class="tk-cb-search">
                        <span>🔍</span>
                        <input type="text" class="tk-cb-in" id="tk-cbSearch" placeholder="جستجوی کاربر..." autocomplete="off" />
                    </div>
                    <div class="tk-cb-list" id="tk-cbList" role="listbox"></div>
                </div>
            </div>
            <label class="tk-switch" title="نمایش کارهای انجام‌شده">
                <input type="checkbox" id="tk-fDone" />
                <span class="tk-sw-track"><span class="tk-sw-knob"></span></span>
                <span>انجام‌شده‌ها</span>
                <span class="tk-sw-cnt" id="tk-doneCnt">0</span>
            </label>
        </div>
        <div class="tk-hint" style="margin-top:4px">همه‌ی کارها به ترتیب اولویت زیر هم‌اند. بکشید و رها کنید یا از ▲ ▼ استفاده کنید؛ ترتیب فوری ذخیره می‌شود و در برد عمومی هم همین ترتیب دیده می‌شود.</div>
        <div id="tk-tasks" class="tk-scroll"></div>
    </div>
</div>

<!-- مودال ویرایش -->
<div class="tk-scope tk-modal-bg" id="tk-mEdit">
    <div class="tk-glass tk-modal">
        <h2 class="tk-h2" id="tk-mTitle">ویرایش</h2>
        <input type="hidden" id="tk-eId" />
        <div class="tk-two">
            <div>
                <label class="tk-lbl">وضعیت</label>
                <select class="tk-in" id="tk-eStatus">
                    <option value="0">جدید</option>
                    <option value="1">در حال انجام</option>
                    <option value="2">انجام شد</option>
                    <option value="3">متوقف</option>
                </select>
            </div>
            <div>
                <label class="tk-lbl">تخمین (ساعت)</label>
                <input type="number" class="tk-in" id="tk-eEst" min="0" step="0.5" placeholder="6" inputmode="decimal" />
            </div>
        </div>
        <label class="tk-lbl">مهلت جدید (شمسی) — اختیاری</label>
        <input type="text" class="tk-in" id="tk-eDeadline" placeholder="1405/07/20" maxlength="10" inputmode="numeric" />
        <label class="tk-lbl">یادداشت مدیر</label>
        <textarea class="tk-in" id="tk-eNote"></textarea>
        <div class="tk-flex end" style="margin-top:12px">
            <button type="button" class="tk-btn ghost" data-close>بستن</button>

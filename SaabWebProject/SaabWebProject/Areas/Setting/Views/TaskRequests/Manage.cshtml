<!-- مودال دسترسی‌ها -->
<div class="tk-scope tk-modal-bg" id="tk-mAccess">
    <div class="tk-glass tk-modal">
        <h2 class="tk-h2" style="margin-bottom:8px">دسترسی به بخش مدیریت</h2>
        <div id="tk-mgrs"></div>
        <label class="tk-lbl">افزودن با کد ملی</label>
        <div class="tk-flex" style="flex-wrap:nowrap">
            <input type="text" class="tk-in" id="tk-gNat" placeholder="کد ملی" inputmode="numeric" style="flex:1" />
            <button type="button" class="tk-btn pink" id="tk-gAdd">افزودن</button>
        </div>
        <div class="tk-flex end" style="margin-top:12px"><button type="button" class="tk-btn ghost" data-close>بستن</button></div>
    </div>
</div>

<div class="tk-scope tk-toast" id="tk-toast"></div>

<script>
(function () {
    'use strict';
    // ⚠️ همه‌چیز داخل IIFE است تا متغیرهای سراسری لایه (مثل $ و jQuery) خراب نشوند
    var URLS = {
        all:    '@Url.Action("ManageAll")',
        upd:    '@Url.Action("UpdateManage")',
        order:  '@Url.Action("Reorder")',
        del:    '@Url.Action("Delete")',
        dl:     '@Url.Action("DownloadFile")',
        mList:  '@Url.Action("ManagerList")',
        grant:  '@Url.Action("GrantAccess")',
        revoke: '@Url.Action("RevokeAccess")'
    };
    var q = function (s) { return document.querySelector(s); };
    var items = [];          // همه‌ی کارها به ترتیب اولویت سراسری
    var fUser = '', fDone = false;

    ['#tk-mEdit', '#tk-mAccess', '#tk-toast'].forEach(function (s) { document.body.appendChild(q(s)); });
    var toastEl = q('#tk-toast');

    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }
    function toast(msg, err) { toastEl.textContent = msg; toastEl.className = 'tk-scope tk-toast show' + (err ? ' err' : ''); setTimeout(function () { toastEl.className = 'tk-scope tk-toast'; }, 2600); }
    function fmtSize(b) { return b > 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB'; }
    async function get(url) { return (await fetch(url, { credentials: 'same-origin' })).json(); }
    async function post(url, obj) {
        var body = new URLSearchParams();
        for (var k in obj) { if (Array.isArray(obj[k])) obj[k].forEach(function (v) { body.append(k, v); }); else body.append(k, obj[k] == null ? '' : obj[k]); }
        return (await fetch(url, { method: 'POST', body: body, credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' } })).json();
    }
    function openM(id) { q(id).classList.add('open'); }
    document.querySelectorAll('.tk-modal-bg').forEach(function (m) {
        m.addEventListener('click', function (e) { if (e.target === m || e.target.hasAttribute('data-close')) m.classList.remove('open'); });
    });

    // ---------- فیلتر ----------
    function visible() {
        return items.filter(function (t) {
            return (!fUser || String(t.userId) === fUser) && (fDone || t.status !== 2);
        });
    }

    // ---------- لیست کشویی کاربر (با جستجو) ----------
    var usersList = [], qUser = '', actIdx = -1;

    // یکسان‌سازی حروف عربی/فارسی و ارقام؛ طول رشته را حفظ می‌کند تا هایلایت درست بیفتد
    function fold(s) {
        return String(s == null ? '' : s).toLowerCase()
            .replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/ۀ/g, 'ه')
            .replace(/[٠-٩]/g, function (c) { return String.fromCharCode(c.charCodeAt(0) - 1632 + 48); })
            .replace(/[۰-۹]/g, function (c) { return String.fromCharCode(c.charCodeAt(0) - 1776 + 48); })
            .replace(/‌/g, ' ');
    }
    function hl(name, qn) {
        if (!qn) return esc(name);
        var i = fold(name).indexOf(qn); if (i < 0) return esc(name);
        return esc(name.slice(0, i)) + '<mark>' + esc(name.slice(i, i + qn.length)) + '</mark>' + esc(name.slice(i + qn.length));
    }
    function optHtml(u, qn, all) {
        return '<div class="tk-cb-opt' + (u.id === fUser ? ' sel' : '') + '" role="option" data-id="' + u.id + '">' +
            '<span class="tk-av">' + (all ? '👥' : esc(u.name.trim().charAt(0) || '؟')) + '</span>' +
            '<span class="nm">' + hl(u.name, qn) + '</span>' +
            '<span class="tk-badge" title="کار باز">' + u.open + '</span></div>';
    }
    function setAct(i) {
        var list = q('#tk-cbList'), opts = list.querySelectorAll('.tk-cb-opt');
        actIdx = opts.length ? Math.max(-1, Math.min(i, opts.length - 1)) : -1;
        opts.forEach(function (o, k) { o.classList.toggle('act', k === actIdx); });
        if (actIdx > -1) {
            var o = opts[actIdx];
            if (o.offsetTop < list.scrollTop) list.scrollTop = o.offsetTop;
            else if (o.offsetTop + o.offsetHeight > list.scrollTop + list.clientHeight) list.scrollTop = o.offsetTop + o.offsetHeight - list.clientHeight;
        }
    }
    function renderCombo() {
        var qn = fold(qUser).trim();
        var cur = usersList.filter(function (u) { return u.id === fUser; })[0];
        var list = usersList.filter(function (u) { return !qn || fold(u.name).indexOf(qn) > -1; });
        var openAll = items.filter(function (t) { return t.status !== 2; }).length;
        var html = '';
        if (!qn) html += optHtml({ id: '', name: 'همه‌ی کاربران', open: openAll }, '', true);
        html += list.map(function (u) { return optHtml(u, qn, false); }).join('');
        if (!list.length) html += '<div class="tk-cb-empty">کاربری با این نام پیدا نشد</div>';
        q('#tk-cbList').innerHTML = html;
        q('#tk-cbLabel').textContent = cur ? cur.name : 'همه‌ی کاربران';
        q('#tk-cbAv').textContent = cur ? (cur.name.trim().charAt(0) || '؟') : '👥';
        q('#tk-combo').classList.toggle('has', !!cur);
        setAct(qn && list.length ? 0 : -1);
    }
    function buildUserSelect() {
        var seen = {};
        items.forEach(function (t) {
            if (!seen[t.userId]) seen[t.userId] = { id: String(t.userId), name: t.owner, open: 0 };
            if (t.status !== 2) seen[t.userId].open++;
        });
        usersList = Object.keys(seen).map(function (k) { return seen[k]; })
            .sort(function (a, b) { return a.name.localeCompare(b.name, 'fa'); });
        if (fUser && !seen[fUser]) fUser = '';
        renderCombo();
    }
    function openCombo() {
        q('#tk-combo').classList.add('open');
        qUser = ''; q('#tk-cbSearch').value = ''; renderCombo();
        var sel = q('#tk-cbList').querySelector('.sel');
        if (sel) q('#tk-cbList').scrollTop = Math.max(0, sel.offsetTop - 40);
        q('#tk-cbSearch').focus({ preventScroll: true });
    }
    function closeCombo() { q('#tk-combo').classList.remove('open'); }
    function pickUser(id) { fUser = id; closeCombo(); renderCombo(); render(); }

    // ---------- لیست ----------
    function dueChip(t) {
        if (t.status === 2) return '';
        if (t.daysLeft < 0) return '<span class="tk-chip late">' + (-t.daysLeft) + ' روز تأخیر</span>';
        if (t.daysLeft === 0) return '<span class="tk-chip late">امروز آخرین مهلت</span>';
        return '<span class="tk-chip">' + t.daysLeft + ' روز مانده</span>';
    }
    function render() {
        var list = visible(), box = q('#tk-tasks');
        var open = items.filter(function (t) { return t.status !== 2; }).length;
        q('#tk-count').textContent = list.length + ' کار نمایش داده می‌شود' + ' · ' + open + ' کار باز';
        q('#tk-doneCnt').textContent = items.filter(function (t) { return t.status === 2 && (!fUser || String(t.userId) === fUser); }).length;
        if (!list.length) { box.innerHTML = '<div class="tk-empty">موردی نیست</div>'; return; }
        box.innerHTML = list.map(function (t) {
            return '<div class="tk-task s' + t.status + '" draggable="true" data-id="' + t.id + '">' +
              '<div class="tk-top">' +
                '<div class="tk-line"><span class="tk-grip" title="بکش">⋮⋮</span>' +
                  '<span class="tk-rank' + (t.rank ? '' : ' done') + '" title="اولویت">' + (t.rank ? t.rank : '✓') + '</span>' +
                  '<div class="tk-ttl">' + esc(t.title) + '</div></div>' +
                '<div class="tk-flex" style="flex-wrap:nowrap">' +
                  '<button type="button" class="tk-ib" title="بالاتر" data-act="up" data-id="' + t.id + '">▲</button>' +
                  '<button type="button" class="tk-ib" title="پایین‌تر" data-act="down" data-id="' + t.id + '">▼</button>' +
                  '<button type="button" class="tk-ib" title="ویرایش" data-act="edit" data-id="' + t.id + '">✎</button>' +
                  '<button type="button" class="tk-ib danger" title="حذف" data-act="del" data-id="' + t.id + '">🗑</button>' +
                '</div></div>' +
              (t.description ? '<div class="tk-desc" data-act="more">' + esc(t.description) + '</div>' : '') +
              '<div class="tk-meta">' +
                '<span class="tk-chip owner">👤 ' + esc(t.owner) + '</span>' +
                '<span class="tk-chip s' + t.status + '">' + esc(t.statusName) + '</span>' +
                '<span class="tk-chip">مهلت ' + t.deadline + '</span>' + dueChip(t) +
                (t.estimate != null ? '<span class="tk-chip pink">تخمین ' + t.estimate + ' ساعت</span>' : '<span class="tk-chip">بدون تخمین</span>') +
                t.files.map(function (f) { return '<span class="tk-chip"><a href="' + URLS.dl + '/' + f.id + '" title="' + fmtSize(f.size) + '">📎 ' + esc(f.name) + '</a></span>'; }).join('') +
              '</div>' +
              (t.note ? '<div class="tk-note">💬 ' + esc(t.note) + '</div>' : '') +
            '</div>';
        }).join('');
        bindDrag();
    }
    async function load() {
        var box = q('#tk-tasks'), top = box.scrollTop;
        var r = await get(URLS.all); if (!r.ok) return toast(r.msg, true);
        items = r.data; buildUserSelect(); render(); box.scrollTop = top;
    }

    // ---------- درگ و دراپ ----------
    function afterEl(container, y) {
        return Array.prototype.slice.call(container.querySelectorAll('.tk-task:not(.dragging)')).reduce(function (best, el) {
            var b = el.getBoundingClientRect(), off = y - b.top - b.height / 2;
            return (off < 0 && off > best.off) ? { off: off, el: el } : best;
        }, { off: -Infinity }).el || null;
    }
    function bindDrag() {
        var box = q('#tk-tasks');
        box.querySelectorAll('.tk-task').forEach(function (el) {
            el.ondragstart = function (e) { el.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move'; try { e.dataTransfer.setData('text/plain', el.dataset.id); } catch (_) { } };
            el.ondragend = function () { el.classList.remove('dragging'); saveOrderFromDom(); };
        });
        box.ondragover = function (e) {
            e.preventDefault();
            var dr = box.querySelector('.dragging'); if (!dr) return;
            // اسکرول خودکار نزدیک لبه‌ی لیست
            var rc = box.getBoundingClientRect();
            if (e.clientY < rc.top + 40) box.scrollTop -= 14; else if (e.clientY > rc.bottom - 40) box.scrollTop += 14;
            var a = afterEl(box, e.clientY);
            if (a == null) box.appendChild(dr); else box.insertBefore(dr, a);
        };
    }
    // ترتیب کارهای «نمایش‌داده‌شده» را می‌فرستیم؛ سرور فقط جای همین‌ها را بین خودشان عوض می‌کند
    async function saveOrder(ids) {
        var r = await post(URLS.order, { ids: ids });
        toast(r.ok ? 'اولویت ذخیره شد ✓' : r.msg, !r.ok);
        load();
    }
    function saveOrderFromDom() {
        var ids = Array.prototype.map.call(q('#tk-tasks').querySelectorAll('.tk-task'), function (e) { return +e.dataset.id; });
        var cur = visible().map(function (t) { return t.id; });
        if (ids.length === cur.length && ids.every(function (id, i) { return cur[i] === id; })) return;
        saveOrder(ids);
    }
    function move(id, dir) {
        var ids = visible().map(function (t) { return t.id; });
        var i = ids.indexOf(id), j = i + dir;
        if (i < 0 || j < 0 || j >= ids.length) return;
        var tmp = ids[i]; ids[i] = ids[j]; ids[j] = tmp;
        saveOrder(ids);
    }

    // ---------- ویرایش ----------
    function openEdit(id) {
        var t = items.find(function (x) { return x.id === id; }); if (!t) return;
        q('#tk-mTitle').textContent = t.title; q('#tk-eId').value = id; q('#tk-eStatus').value = t.status;
        q('#tk-eEst').value = t.estimate == null ? '' : t.estimate; q('#tk-eNote').value = t.note || ''; q('#tk-eDeadline').value = '';
        openM('#tk-mEdit');
    }
    q('#tk-eSave').onclick = async function () {
        var r = await post(URLS.upd, { id: q('#tk-eId').value, status: q('#tk-eStatus').value, estimateHours: q('#tk-eEst').value, managerNote: q('#tk-eNote').value, deadline: q('#tk-eDeadline').value });
        if (!r.ok) return toast(r.msg, true);
        q('#tk-mEdit').classList.remove('open'); toast('ذخیره شد ✓'); load();
    };
    async function removeTask(id) {
        if (!confirm('این مسئله حذف شود؟')) return;
        var r = await post(URLS.del, { id: id }); if (!r.ok) return toast(r.msg, true);
        load();
    }

    // ---------- دسترسی‌ها ----------
    async function loadMgrs() {
        var r = await get(URLS.mList); if (!r.ok) return toast(r.msg, true);
        q('#tk-mgrs').innerHTML = r.data.map(function (m) {
            return '<div class="tk-user"><span>' + esc(m.name) + (m.self ? ' <span class="tk-chip pink">شما</span>' : '') + '</span>' +
                   (m.self ? '' : '<button type="button" class="tk-btn sm danger" data-act="revoke" data-id="' + m.id + '">لغو</button>') + '</div>';
        }).join('');
    }
    q('#tk-btnAccess').onclick = function () { loadMgrs(); openM('#tk-mAccess'); };
    q('#tk-gAdd').onclick = async function () {
        var r = await post(URLS.grant, { nationalCode: q('#tk-gNat').value });
        if (!r.ok) return toast(r.msg, true);
        q('#tk-gNat').value = ''; toast('دسترسی داده شد ✓'); loadMgrs();
    };
    q('#tk-mgrs').addEventListener('click', async function (e) {
        var el = e.target.closest('[data-act="revoke"]'); if (!el) return;
        if (!confirm('دسترسی این کاربر لغو شود؟')) return;
        var r = await post(URLS.revoke, { id: +el.dataset.id }); if (!r.ok) return toast(r.msg, true);
        loadMgrs();
    });

    // ---------- رویدادها ----------
    q('#tk-cbBtn').addEventListener('click', function (e) {
        if (e.target.closest('#tk-cbClear')) { pickUser(''); return; }        // ✕ : برگشت به «همه‌ی کاربران»
        if (q('#tk-combo').classList.contains('open')) closeCombo(); else openCombo();
    });
    q('#tk-cbSearch').addEventListener('input', function () { qUser = this.value; renderCombo(); });
    q('#tk-cbSearch').addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') { e.preventDefault(); setAct(actIdx + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setAct(actIdx - 1); }
        else if (e.key === 'Enter') {
            e.preventDefault();
            var o = q('#tk-cbList').querySelectorAll('.tk-cb-opt')[actIdx > -1 ? actIdx : 0];
            if (o) pickUser(o.dataset.id);
        }
        else if (e.key === 'Escape') { closeCombo(); q('#tk-cbBtn').focus(); }
    });
    q('#tk-cbList').addEventListener('click', function (e) { var o = e.target.closest('.tk-cb-opt'); if (o) pickUser(o.dataset.id); });
    document.addEventListener('mousedown', function (e) { if (!e.target.closest('#tk-combo')) closeCombo(); });
    q('#tk-fDone').onchange = function () { fDone = this.checked; render(); };
    q('#tk-root').addEventListener('click', function (e) {
        var el = e.target.closest('[data-act]'); if (!el) return;
        var id = +el.dataset.id;
        switch (el.dataset.act) {
            case 'up': move(id, -1); break;
            case 'down': move(id, 1); break;
            case 'edit': openEdit(id); break;
            case 'del': removeTask(id); break;
            case 'more': el.classList.toggle('x'); break;
        }
    });

    // ============ انتخاب‌گر تاریخ شمسی (بدون وابستگی به کتابخانه) ============
    var DP = (function () {
        var BR = [-61, 9, 38, 199, 426, 686, 756, 818, 1111, 1181, 1210, 1635, 2060, 2097, 2192, 2262, 2324, 2394, 2456, 3178];
        function div(a, b) { return ~~(a / b); } function mod(a, b) { return a - ~~(a / b) * b; }
        function jalCal(jy) {
            var bl = BR.length, gy = jy + 621, leapJ = -14, jp = BR[0], jm, jump = 0, leap, leapG, march, n, i;
            if (jy < jp || jy >= BR[bl - 1]) throw new Error('bad year');
            for (i = 1; i < bl; i++) { jm = BR[i]; jump = jm - jp; if (jy < jm) break; leapJ = leapJ + div(jump, 33) * 8 + div(mod(jump, 33), 4); jp = jm; }
            n = jy - jp; leapJ = leapJ + div(n, 33) * 8 + div(mod(n, 33) + 3, 4);
            if (mod(jump, 33) === 4 && jump - n === 4) leapJ += 1;
            leapG = div(gy, 4) - div((div(gy, 100) + 1) * 3, 4) - 150; march = 20 + leapJ - leapG;
            if (jump - n < 6) n = n - jump + div(jump + 4, 33) * 33;
            leap = mod(mod(n + 1, 33) - 1, 4); if (leap === -1) leap = 4;
            return { leap: leap, gy: gy, march: march };
        }
        function g2d(gy, gm, gd) { var d = div((gy + div(gm - 8, 6) + 100100) * 1461, 4) + div(153 * mod(gm + 9, 12) + 2, 5) + gd - 34840408; return d - div(div(gy + 100100 + div(gm - 8, 6), 100) * 3, 4) + 752; }
        function d2g(jdn) { var j = 4 * jdn + 139361631; j = j + div(div(4 * jdn + 183187720, 146097) * 3, 4) * 4 - 3908; var i = div(mod(j, 1461), 4) * 5 + 308; var gd = div(mod(i, 153), 5) + 1; var gm = mod(div(i, 153), 12) + 1; return { gy: div(j, 1461) - 100100 + div(8 - gm, 6), gm: gm, gd: gd }; }
        function j2d(jy, jm, jd) { var r = jalCal(jy); return g2d(r.gy, 3, r.march) + (jm - 1) * 31 - div(jm, 7) * (jm - 7) + jd - 1; }
        function d2j(jdn) {
            var gy = d2g(jdn).gy, jy = gy - 621, r = jalCal(jy), jdn1f = g2d(gy, 3, r.march), jd, jm, k = jdn - jdn1f;
            if (k >= 0) { if (k <= 185) { return { jy: jy, jm: 1 + div(k, 31), jd: mod(k, 31) + 1 }; } k -= 186; }
            else { jy -= 1; k += 179; if (r.leap === 1) k += 1; }
            jm = 7 + div(k, 30); jd = mod(k, 30) + 1; return { jy: jy, jm: jm, jd: jd };
        }
        function monthLen(jy, jm) { return jm <= 6 ? 31 : (jm <= 11 ? 30 : (jalCal(jy).leap === 0 ? 30 : 29)); }
        function weekday(jy, jm, jd) { var g = d2g(j2d(jy, jm, jd)); return (new Date(g.gy, g.gm - 1, g.gd).getDay() + 1) % 7; } // شنبه = 0

        var MN = ['فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور', 'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'];
        var WD = ['ش', 'ی', 'د', 'س', 'چ', 'پ', 'ج'];
        function fa(n) { return String(n).replace(/\d/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'.charAt(d); }); }
        function pad(n) { return (n < 10 ? '0' : '') + n; }
        function latin(s) { return String(s || '').replace(/[۰-۹]/g, function (c) { return c.charCodeAt(0) - 1776; }).replace(/[٠-٩]/g, function (c) { return c.charCodeAt(0) - 1632; }); }
        function parse(s) {
            var m = /^(\d{4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})$/.exec(latin(s).trim()); if (!m) return null;
            var y = +m[1], mo = +m[2], d = +m[3];
            try { if (mo < 1 || mo > 12 || d < 1 || d > monthLen(y, mo)) return null; } catch (e) { return null; }
            return { y: y, m: mo, d: d };
        }
        function today() { var n = new Date(), j = d2j(g2d(n.getFullYear(), n.getMonth() + 1, n.getDate())); return { y: j.jy, m: j.jm, d: j.jd }; }

        var el = null, cur = null, vy = 0, vm = 1, sel = null;

        function build() {
            el = document.createElement('div'); el.className = 'tk-scope tk-dp'; document.body.appendChild(el);
            el.addEventListener('mousedown', function (e) { if (e.target.tagName !== 'SELECT') e.preventDefault(); }); // فوکوس ورودی از بین نرود
            el.addEventListener('click', function (e) {
                var b = e.target.closest('button'); if (!b) return;
                if (b.hasAttribute('data-n')) { vm += +b.dataset.n; if (vm > 12) { vm = 1; vy++; } if (vm < 1) { vm = 12; vy--; } render(); }
                else if (b.hasAttribute('data-d')) { pick(vy, vm, +b.dataset.d); }
                else if (b.hasAttribute('data-today')) { var t = today(); pick(t.y, t.m, t.d); }
                else if (b.hasAttribute('data-clear')) { setVal(''); close(); }
            });
            el.addEventListener('change', function (e) {
                if (e.target.hasAttribute('data-m')) vm = +e.target.value;
                if (e.target.hasAttribute('data-y')) vy = +e.target.value;
                render();
            });
        }

        function render() {
            var t = today(), len = monthLen(vy, vm), first = weekday(vy, vm, 1), i, h = '';
            h += '<div class="tk-dp-head"><button type="button" class="tk-dp-nav" data-n="-1" title="ماه قبل">›</button>';
            h += '<select data-m>'; for (i = 1; i <= 12; i++) h += '<option value="' + i + '"' + (i === vm ? ' selected' : '') + '>' + MN[i - 1] + '</option>'; h += '</select>';
            h += '<select data-y>'; for (i = vy - 12; i <= vy + 12; i++) h += '<option value="' + i + '"' + (i === vy ? ' selected' : '') + '>' + fa(i) + '</option>'; h += '</select>';
            h += '<button type="button" class="tk-dp-nav" data-n="1" title="ماه بعد">‹</button></div>';
            h += '<div class="tk-dp-grid">';
            for (i = 0; i < 7; i++) h += '<div class="tk-dp-wd' + (i === 6 ? ' fri' : '') + '">' + WD[i] + '</div>';
            for (i = 0; i < first; i++) h += '<div></div>';
            for (i = 1; i <= len; i++) {
                var c = 'tk-dp-d' + ((first + i - 1) % 7 === 6 ? ' fri' : '');
                if (t.y === vy && t.m === vm && t.d === i) c += ' today';
                if (sel && sel.y === vy && sel.m === vm && sel.d === i) c += ' sel';
                h += '<button type="button" class="' + c + '" data-d="' + i + '">' + fa(i) + '</button>';
            }
            h += '</div><div class="tk-dp-foot"><button type="button" data-today>امروز</button><button type="button" class="clr" data-clear>پاک کردن</button></div>';
            el.innerHTML = h;
        }

        function place() {
            var r = cur.getBoundingClientRect(), w = el.offsetWidth, hh = el.offsetHeight;
            var left = Math.min(Math.max(8, r.right - w), window.innerWidth - w - 8);
            var top = r.bottom + 6; if (top + hh > window.innerHeight - 8) top = Math.max(8, r.top - hh - 6);
            el.style.left = left + 'px'; el.style.top = top + 'px';
        }

        function setVal(v) {
            cur.value = v;
            cur.dispatchEvent(new Event('input', { bubbles: true })); cur.dispatchEvent(new Event('change', { bubbles: true }));
        }
        function pick(y, m, d) { setVal(y + '/' + pad(m) + '/' + pad(d)); close(); }

        function open(input) {
            if (!el) build();
            cur = input; sel = parse(input.value); var base = sel || today(); vy = base.y; vm = base.m;
            render(); el.classList.add('open'); place();
        }
        function close() { if (el) el.classList.remove('open'); cur = null; }

        document.addEventListener('mousedown', function (e) { if (el && cur && !el.contains(e.target) && e.target !== cur) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' || e.key === 'Tab') close(); });
        window.addEventListener('resize', function () { if (el && cur) place(); });
        // با اسکرول صفحه/فرم، انتخاب‌گر دنبال ورودی می‌ماند؛ فقط اگر ورودی از دید خارج شد بسته می‌شود
        window.addEventListener('scroll', function (e) {
            if (!el || !cur || el.contains(e.target)) return;
            var r = cur.getBoundingClientRect();
            if (r.bottom < 0 || r.top > window.innerHeight) close(); else place();
        }, true);

        return {
            attach: function (input) {
                if (!input) return;
                input.setAttribute('autocomplete', 'off');
                // روی موبایل/لمسی کیبورد باز نشود؛ فقط انتخاب‌گر
                if (window.matchMedia && window.matchMedia('(pointer:coarse)').matches) input.readOnly = true;
                input.addEventListener('focus', function () { open(input); });
                input.addEventListener('click', function () { if (!el || !el.classList.contains('open') || cur !== input) open(input); });
                input.addEventListener('input', function () {
                    if (el && cur === input) { var p = parse(input.value); if (p) { sel = p; vy = p.y; vm = p.m; render(); } }
                });
            }
        };
    })();

    DP.attach(q('#tk-eDeadline'));

    load();
})();
</script>

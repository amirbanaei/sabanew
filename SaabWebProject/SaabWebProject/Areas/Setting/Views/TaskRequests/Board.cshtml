@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "برد عمومی مسائل";
    bool isManager = ViewBag.IsManager == true;
}

<style>
    /* ============ پایه (همه‌چیز با tk- اسکوپ شده تا با CSS لایه‌ی اصلی تداخل نکند) ============ */
    .tk-scope {
        --tk-off: 120px; /* ← ارتفاع هدر لایه‌ی خودت؛ اگر صفحه اسکرول کل‌صفحه گرفت این عدد را بیشتر کن */
        --cyan: #22d3ee;
        --pink: #f43f9e;
        --violet: #8b5cf6;
        --lime: #a3e635;
        --amber: #fbbf24;
        --red: #fb7185;
        --text: #e9edff;
        --muted: #9aa7d1;
        --line: rgba(255,255,255,.16);
        direction: rtl;
        text-align: right;
        font-family: inherit;
        font-size: 13px;
        line-height: 1.6;
        color: var(--text)
    }

        .tk-scope *, .tk-scope *::before, .tk-scope *::after {
            box-sizing: border-box
        }

        .tk-scope h1, .tk-scope h2, .tk-scope h3 {
            margin: 0;
            font-family: inherit;
            line-height: 1.4;
            color: inherit
        }

        .tk-scope a {
            text-decoration: none
        }

        .tk-scope button {
            font-family: inherit
        }

    .tk-root {
        position: relative;
        overflow: hidden;
        overflow: clip;
        isolation: isolate;
        border-radius: 20px;
        padding: 12px;
        height: calc(100vh - var(--tk-off));
        height: calc(100dvh - var(--tk-off));
        min-height: 440px;
        display: flex;
        flex-direction: column;
        background: radial-gradient(800px 420px at 85% -10%,rgba(99,60,255,.5),transparent 60%), radial-gradient(700px 420px at -5% 105%,rgba(244,63,158,.36),transparent 60%), linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px) 0 0/32px 32px, linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px) 0 0/32px 32px, linear-gradient(160deg,#060818,#0c1030);
        border: 1px solid rgba(255,255,255,.12);
        box-shadow: 0 14px 44px rgba(0,0,0,.5),0 0 0 1px rgba(34,211,238,.12),0 0 56px rgba(139,92,246,.2)
    }

        .tk-root > * {
            position: relative;
            z-index: 1
        }

        .tk-root::before, .tk-root::after {
            content: "";
            position: absolute;
            z-index: 0;
            border-radius: 50%;
            filter: blur(80px);
            opacity: .45;
            pointer-events: none
        }

        .tk-root::before {
            width: 300px;
            height: 300px;
            background: var(--cyan);
            top: -120px;
            left: -90px;
            animation: tkFloat 14s ease-in-out infinite
        }

        .tk-root::after {
            width: 340px;
            height: 340px;
            background: var(--pink);
            bottom: -140px;
            right: -100px;
            animation: tkFloat 18s ease-in-out infinite reverse
        }

    @@keyframes tkFloat {
        50% {
            transform: translate(50px,30px) scale(1.12)
        }
    }

    .tk-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        margin-bottom: 10px;
        flex: 0 0 auto
    }

    .tk-title {
        margin-left: auto !important;
        font-size: 16px !important;
        font-weight: 800;
        background: linear-gradient(90deg,var(--cyan),var(--pink));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent !important;
        filter: drop-shadow(0 0 12px rgba(34,211,238,.45))
    }

    .tk-link {
        display: inline-block;
        color: var(--text);
        padding: 5px 12px;
        border-radius: 9px;
        font-size: 12px;
        cursor: pointer;
        background: rgba(255,255,255,.07);
        border: 1px solid var(--line);
        backdrop-filter: blur(14px);
        transition: .25s
    }

        .tk-link:hover, .tk-link.on {
            color: #fff;
            border-color: var(--cyan);
            box-shadow: 0 0 16px rgba(34,211,238,.5),inset 0 0 10px rgba(34,211,238,.18)
        }

    .tk-glass {
        padding: 12px;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        min-height: 0;
        background: linear-gradient(145deg,rgba(255,255,255,.11),rgba(255,255,255,.03));
        border: 1px solid var(--line);
        backdrop-filter: blur(16px) saturate(150%);
        -webkit-backdrop-filter: blur(16px) saturate(150%);
        box-shadow: 0 8px 30px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.2)
    }

    .tk-main {
        flex: 1 1 auto;
        min-height: 0
    }

    .tk-h2 {
        font-size: 14px !important;
        color: var(--cyan) !important;
        text-shadow: 0 0 14px rgba(34,211,238,.65)
    }

    /* نوار ابزار: تغییر نما + نمایش انجام‌شده */
    .tk-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        flex: 0 0 auto
    }

        .tk-bar .tk-h2 {
            margin-left: auto
        }

    .tk-seg {
        display: inline-flex;
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden
    }

        .tk-seg button {
            border: 0;
            cursor: pointer;
            padding: 5px 14px;
            font-size: 12px;
            color: var(--text);
            background: rgba(255,255,255,.05);
            transition: .2s
        }

            .tk-seg button + button {
                border-right: 1px solid var(--line)
            }

            .tk-seg button.on {
                color: #fff;
                background: linear-gradient(90deg,var(--cyan),var(--violet));
                box-shadow: 0 0 14px rgba(34,211,238,.5)
            }

    /* --- سوئیچ «انجام‌شده‌ها» --- */
    .tk-scope label.tk-switch {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        padding: 4px 10px 4px 6px;
        border-radius: 99px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 400;
        color: var(--text);
        max-width: none;
        background: rgba(255,255,255,.06);
        border: 1px solid var(--line);
        transition: .2s;
        user-select: none
    }

        .tk-scope label.tk-switch:hover {
            border-color: var(--lime)
        }

    .tk-switch input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0
    }

    .tk-sw-track {
        direction: ltr;
        position: relative;
        flex: 0 0 36px;
        width: 36px;
        height: 20px;
        border-radius: 99px;
        background: rgba(255,255,255,.14);
        transition: .25s
    }

    .tk-sw-knob {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #cfd6ff;
        transition: .25s
    }

    .tk-switch input:checked ~ .tk-sw-track {
        background: linear-gradient(90deg,#65a30d,var(--lime));
        box-shadow: 0 0 14px rgba(163,230,53,.7)
    }

        .tk-switch input:checked ~ .tk-sw-track .tk-sw-knob {
            left: 19px;
            background: #fff
        }

    .tk-switch input:focus-visible ~ .tk-sw-track {
        outline: 2px solid var(--cyan);
        outline-offset: 2px
    }

    .tk-switch:has(input:checked) {
        border-color: var(--lime);
        box-shadow: 0 0 14px rgba(163,230,53,.3)
    }

    .tk-sw-cnt {
        min-width: 20px;
        text-align: center;
        padding: 0 6px;
        border-radius: 99px;
        font-size: 10px;
        font-weight: 800;
        line-height: 1.7;
        background: rgba(163,230,53,.2);
        color: var(--lime)
    }

    .tk-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        margin-top: 8px;
        padding-left: 2px;
        scrollbar-width: thin;
        scrollbar-color: rgba(34,211,238,.5) transparent
    }

        .tk-scroll::-webkit-scrollbar {
            width: 5px
        }

        .tk-scroll::-webkit-scrollbar-thumb {
            background: rgba(34,211,238,.5);
            border-radius: 9px
        }

    /* نمای «به ترتیب اولویت» */
    .tk-queue {
        max-width: 980px;
        margin: 0 auto
    }

    /* نمای «به تفکیک کاربر»: ستون‌ها کنار هم، هر ستون داخل خودش اسکرول می‌کند */
    .tk-cols {
        flex: 1 1 auto;
        min-height: 0;
        margin-top: 8px;
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(250px,300px);
        gap: 10px;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x proximity;
        scrollbar-width: thin;
        scrollbar-color: rgba(34,211,238,.5) transparent
    }

        .tk-cols > .tk-glass {
            scroll-snap-align: start;
            min-height: 0;
            box-shadow: none
        }

    .tk-col-h {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 14px !important;
        color: var(--pink) !important;
        text-shadow: 0 0 14px rgba(244,63,158,.7);
        flex: 0 0 auto
    }

    .tk-badge {
        font-size: 10px;
        padding: 1px 9px;
        border-radius: 99px;
        background: var(--cyan);
        color: #001;
        font-weight: 800;
        box-shadow: 0 0 10px rgba(34,211,238,.6)
    }

    .tk-task {
        --acc: var(--cyan);
        margin-bottom: 8px;
        padding: 8px 12px;
        border-radius: 12px;
        position: relative;
        background: linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.02));
        border: 1px solid rgba(255,255,255,.14);
        border-right: 3px solid var(--acc);
        box-shadow: inset -8px 0 18px -12px var(--acc);
        transition: .25s
    }

        .tk-task:hover {
            box-shadow: 0 0 20px -4px var(--acc),inset -8px 0 18px -12px var(--acc)
        }

        .tk-task.s1 {
            --acc: var(--amber)
        }

        .tk-task.s2 {
            --acc: var(--lime);
            opacity: .65
        }

        .tk-task.s3 {
            --acc: var(--red)
        }

    .tk-line {
        display: flex;
        align-items: center;
        gap: 10px
    }

    .tk-rank {
        flex: 0 0 28px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 12px;
        color: #fff;
        background: linear-gradient(135deg,var(--pink),var(--violet));
        box-shadow: 0 0 12px rgba(244,63,158,.7)
    }

        .tk-rank.done {
            background: linear-gradient(135deg,#65a30d,var(--lime));
            color: #102000;
            box-shadow: 0 0 12px rgba(163,230,53,.6)
        }
        /* سه نفر اول صف پررنگ‌ترند */
        .tk-rank.top1 {
            background: linear-gradient(135deg,#f59e0b,#fde047);
            color: #2a1800;
            box-shadow: 0 0 18px rgba(253,224,71,.8)
        }

        .tk-rank.top2 {
            background: linear-gradient(135deg,#94a3b8,#e2e8f0);
            color: #0f172a;
            box-shadow: 0 0 16px rgba(226,232,240,.6)
        }

        .tk-rank.top3 {
            background: linear-gradient(135deg,#c2410c,#fb923c);
            color: #fff;
            box-shadow: 0 0 16px rgba(251,146,60,.6)
        }

    .tk-ttl {
        font-weight: 700;
        font-size: 13px;
        min-width: 0;
        overflow-wrap: anywhere
    }

    .tk-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 6px
    }

    .tk-line .tk-meta {
        margin: 0;
        margin-right: auto;
        justify-content: flex-end
    }

    .tk-chip {
        display: inline-block;
        font-size: 11px;
        line-height: 1.5;
        padding: 1px 9px;
        border-radius: 99px;
        border: 1px solid rgba(255,255,255,.2);
        background: rgba(255,255,255,.06);
        white-space: nowrap
    }

        .tk-chip.owner {
            color: #fff;
            border-color: var(--violet);
            background: rgba(139,92,246,.25);
            box-shadow: 0 0 10px rgba(139,92,246,.45)
        }

        .tk-chip.s0 {
            color: var(--cyan);
            border-color: var(--cyan);
            box-shadow: 0 0 10px rgba(34,211,238,.4)
        }

        .tk-chip.s1 {
            color: var(--amber);
            border-color: var(--amber);
            box-shadow: 0 0 10px rgba(251,191,36,.4)
        }

        .tk-chip.s2 {
            color: var(--lime);
            border-color: var(--lime);
            box-shadow: 0 0 10px rgba(163,230,53,.4)
        }

        .tk-chip.s3 {
            color: var(--red);
            border-color: var(--red);
            box-shadow: 0 0 10px rgba(251,113,133,.4)
        }

        .tk-chip.late {
            color: var(--red);
            border-color: var(--red);
            animation: tkPulse 1.4s infinite
        }

        .tk-chip.pink {
            color: var(--pink);
            border-color: var(--pink);
            box-shadow: 0 0 10px rgba(244,63,158,.35)
        }

    @@keyframes tkPulse {
        50% {
            box-shadow: 0 0 14px var(--red)
        }
    }

    .tk-note {
        margin-top: 5px;
        font-size: 12px;
        color: var(--muted)
    }

    .tk-empty {
        text-align: center;
        color: var(--muted);
        padding: 30px 0
    }

    /* ============ موبایل / تبلت ============ */
    @@media(max-width:900px) {
        .tk-root {
            padding: 10px;
            border-radius: 16px
        }

        .tk-title {
            font-size: 14px !important
        }

        .tk-bar .tk-h2 {
            flex: 1 0 100%
        }

        .tk-cols {
            grid-auto-columns: 86%;
            scroll-snap-type: x mandatory
        }
        /* در موبایل چیپ‌ها زیر عنوان می‌روند */
        .tk-line {
            flex-wrap: wrap
        }

            .tk-line .tk-meta {
                flex: 1 0 100%;
                margin-right: 0;
                justify-content: flex-start
            }
    }
</style>

<div class="tk-scope tk-root" id="tk-root">
    <div class="tk-nav">
        <h1 class="tk-title">✦ برد عمومی</h1>
        <a class="tk-link" href="@Url.Action("Index")">ثبت مسئله</a>
        <a class="tk-link on" href="@Url.Action("Board")">برد عمومی</a>
        @if (isManager)
        {
            <a class="tk-link" href="@Url.Action("Manage")">مدیریت</a>
        }
    </div>

    <div class="tk-glass tk-main">
        <div class="tk-bar">
            <h2 class="tk-h2" id="tk-count">صف اولویت‌ها</h2>
            <div class="tk-seg" id="tk-seg">
                <button type="button" data-view="queue" class="on">به ترتیب اولویت</button>
                <button type="button" data-view="users">به تفکیک کاربر</button>
            </div>
            <label class="tk-switch" title="نمایش کارهای انجام‌شده">
                <input type="checkbox" id="tk-fDone" />
                <span class="tk-sw-track"><span class="tk-sw-knob"></span></span>
                <span>انجام‌شده‌ها</span>
                <span class="tk-sw-cnt" id="tk-doneCnt">0</span>
            </label>
        </div>
        <div id="tk-body" class="tk-scroll"></div>
    </div>
</div>

<script>
(function () {
    'use strict';
    var URL_DATA = '@Url.Action("BoardData")';
    var q = function (s) { return document.querySelector(s); };
    var data = [], view = 'queue', showDone = false;

    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }
    function dueChip(t) {
        if (t.status === 2) return '';
        if (t.daysLeft < 0) return '<span class="tk-chip late">' + (-t.daysLeft) + ' روز تأخیر</span>';
        if (t.daysLeft === 0) return '<span class="tk-chip late">امروز آخرین مهلت</span>';
        return '<span class="tk-chip">' + t.daysLeft + ' روز مانده</span>';
    }
    function rankCls(t) { return t.rank === 0 ? ' done' : (t.rank <= 3 ? ' top' + t.rank : ''); }
    function rankTxt(t) { return t.rank === 0 ? '✓' : t.rank; }

    // نمای صف: همه‌ی کارها به ترتیب اولویت سراسری، با نام بانی
    function queueHtml(list) {
        return '<div class="tk-queue">' + list.map(function (t) {
            return '<div class="tk-task s' + t.status + '">' +
              '<div class="tk-line">' +
                '<span class="tk-rank' + rankCls(t) + '">' + rankTxt(t) + '</span>' +
                '<div class="tk-ttl">' + esc(t.title) + '</div>' +
                '<div class="tk-meta">' +
                  '<span class="tk-chip owner">👤 ' + esc(t.owner) + '</span>' +
                  '<span class="tk-chip s' + t.status + '">' + esc(t.statusName) + '</span>' +
                  '<span class="tk-chip">مهلت ' + t.deadline + '</span>' + dueChip(t) +
                  (t.estimate != null ? '<span class="tk-chip pink">تخمین ' + t.estimate + ' ساعت</span>' : '') +
                '</div>' +
              '</div>' +
              (t.note ? '<div class="tk-note">💬 ' + esc(t.note) + '</div>' : '') +
            '</div>';
        }).join('') + '</div>';
    }

    // نمای کاربر: هر کاربر یک ستون؛ شماره‌ی روی کارت همان اولویت سراسری است
    function usersHtml(list) {
        var groups = {}, order = [];
        list.forEach(function (t) {
            if (!groups[t.userId]) { groups[t.userId] = { name: t.owner, tasks: [] }; order.push(t.userId); }
            groups[t.userId].tasks.push(t);
        });
        order.sort(function (a, b) { return groups[a].name.localeCompare(groups[b].name, 'fa'); });
        return order.map(function (id) {
            var g = groups[id];
            return '<div class="tk-glass">' +
              '<h3 class="tk-col-h"><span>' + esc(g.name) + '</span><span class="tk-badge">' + g.tasks.length + '</span></h3>' +
              '<div class="tk-scroll">' + g.tasks.map(function (t) {
                  return '<div class="tk-task s' + t.status + '">' +
                    '<div class="tk-line"><span class="tk-rank' + rankCls(t) + '">' + rankTxt(t) + '</span><div class="tk-ttl">' + esc(t.title) + '</div></div>' +
                    '<div class="tk-meta">' +
                      '<span class="tk-chip s' + t.status + '">' + esc(t.statusName) + '</span>' +
                      '<span class="tk-chip">مهلت ' + t.deadline + '</span>' + dueChip(t) +
                      (t.estimate != null ? '<span class="tk-chip pink">تخمین ' + t.estimate + ' ساعت</span>' : '') +
                    '</div>' +
                    (t.note ? '<div class="tk-note">💬 ' + esc(t.note) + '</div>' : '') +
                  '</div>';
              }).join('') + '</div></div>';
        }).join('');
    }

    function render() {
        var body = q('#tk-body');
        var list = data.filter(function (t) { return showDone || t.status !== 2; });
        var open = data.filter(function (t) { return t.status !== 2; }).length;
        q('#tk-count').textContent = open + ' کار باز';
        q('#tk-doneCnt').textContent = data.length - open;

        // اسکرول را هنگام رفرش خودکار حفظ می‌کنیم
        var pos = body.scrollTop;
        var colPos = Array.prototype.map.call(body.querySelectorAll('.tk-scroll'), function (e) { return e.scrollTop; });

        if (!list.length) { body.className = 'tk-scroll'; body.innerHTML = '<div class="tk-empty">موردی برای نمایش نیست</div>'; return; }
        if (view === 'queue') {
            body.className = 'tk-scroll'; body.innerHTML = queueHtml(list); body.scrollTop = pos;
        } else {
            body.className = 'tk-cols'; body.innerHTML = usersHtml(list);
            body.querySelectorAll('.tk-scroll').forEach(function (e, i) { if (colPos[i]) e.scrollTop = colPos[i]; });
        }
    }

    async function load() {
        try {
            var r = await (await fetch(URL_DATA, { credentials: 'same-origin' })).json();
            if (!r.ok) { q('#tk-body').innerHTML = '<div class="tk-empty">' + esc(r.msg) + '</div>'; return; }
            data = r.data; render();
        } catch (e) { }
    }

    q('#tk-seg').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-view]'); if (!b) return;
        view = b.dataset.view;
        q('#tk-seg').querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
        render();
    });
    q('#tk-fDone').onchange = function () { showDone = this.checked; render(); };

    load();
    setInterval(load, 30000); // به‌روزرسانی خودکار هر ۳۰ ثانیه
})();
</script>

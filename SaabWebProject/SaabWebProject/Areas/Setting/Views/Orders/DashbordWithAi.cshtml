                                'مقادیر؛ با کاما جدا شوند',
                                `data.series.${i}.valuesText`,
                                (s.values || []).join(', '),
                                'db-series-values'
                            )}

                ${check(
                                'استفاده از رنگ دستی',
                                `data.series.${i}.customColor`,
                                !!s.customColor
                            )}

                ${field(
                                'رنگ سری',
                                `data.series.${i}.color`,
                                s.color || '',
                                'color'
                            )}

            </div>
        `;
                    }

                });

                /*
                   Pie فقط یک سری نیاز دارد.
                   برای Line و Bar امکان افزودن سری داریم.
                */

                if (type !== 'pieChart' && type !== 'pie') {

                    html += `
                <button
                    type="button"
                    class="glass-btn-ag glass-btn-ag-primary db-full-btn"
                    data-chart-add-series>

                    <i class="bi bi-plus-lg"></i>
                    <p>افزودن سری</p>

                </button>
            `;
                }


                html += `
            </div>
        `;
                setTimeout(() => {
                    series.forEach((s, i) => {
                        const colorInput = body.querySelector(
                            `[data-setting="data.series.${i}.color"]`
                        );

                        if (colorInput) {
                            colorInput.disabled = !s.customColor;
                        }
                    });
                }, 0);

                return html;
            }
            function setPath(obj, path, value) {
                const parts = path.split('.');
                let current = obj;
                for (let i = 0; i < parts.length - 1; i++) {
                    if (!current[parts[i]] || typeof current[parts[i]] !== 'object') current[parts[i]] = {};
                    current = current[parts[i]];
                }
                current[parts[parts.length - 1]] = value;
            }

            function applySettingsToDraft() {

                const draft = state.settingsDraft;
                if (!draft) return;

                const body = $('#dbSettingsBody');
                if (!body) return;

                draft.config.data = draft.config.data || {};
                draft.config.visual = draft.config.visual || {};
                draft.config.core = draft.config.core || {};
                draft.config.data.series = draft.config.data.series || [];

                body.querySelectorAll('[data-setting]').forEach(el => {

                    const path = el.dataset.setting;

                    if (path === 'resizeMode')
                        return;

                    let value = el.type === 'checkbox'
                        ? el.checked
                        : el.value;


                    /* ============================================================
                       Numeric values
                       ============================================================ */

                    if (
                        path === 'visual.fontSize' ||
                        path === 'visual.lineWidth' ||
                        path === 'data.pageSize' ||
                        path === 'data.donutSize'
                    ) {
                        value = Number(value) || 0;
                    }


                    /* ============================================================
                       List
                       ============================================================ */

                    if (path === 'data.itemsText') {

                        draft.config.data.items =
                            String(value)
                                .split(/\r?\n/)
                                .map(x => x.trim())
                                .filter(Boolean);

                        return;
                    }


                    /* ============================================================
                       Data Widget
                       ============================================================ */

                    if (path === 'data.dataItemsText') {

                        draft.config.data.items =
                            String(value)
                                .split(/\r?\n/)
                                .filter(Boolean)
                                .map(line => {

                                    const parts = line.split('|');

                                    return {
                                        name: (parts[0] || '').trim(),
                                        value: (parts.slice(1).join('|') || '').trim()
                                    };

                                })
                                .filter(x => x.name || x.value);

                        return;
                    }


                    /* ============================================================
                       Table Columns
                       ============================================================ */

                    if (path === 'data.columnsText') {

                        draft.config.data.columns =
                            String(value)
                                .split(/\r?\n/)
                                .map(x => x.trim())
                                .filter(Boolean);

                        return;
                    }


                    /* ============================================================
                       Table Rows
                       ============================================================ */

                    if (path === 'data.rowsText') {

                        draft.config.data.rows =
                            String(value)
                                .split(/\r?\n/)
                                .filter(Boolean)
                                .map(r =>
                                    r.split('|').map(x => x.trim())
                                );

                        return;
                    }


                    /* ============================================================
                       Chart Labels
                       ============================================================ */

                    if (path === 'data.labelsText') {

                        draft.config.data.labels =
                            String(value)
                                .split(/\r?\n/)
                                .map(x => x.trim())
                                .filter(Boolean);

                        return;
                    }


                    /* ============================================================
                       Widget Size
                       ============================================================ */

                    if (path === 'size.w') {

                        draft.w = Number(value) || draft.w;
                        return;
                    }

                    if (path === 'size.h') {

                        draft.h = Number(value) || draft.h;
                        return;
                    }


                    /* ============================================================
                       Series Values
                       ============================================================ */

                    const valuesMatch =
                        path.match(/^data\.series\.(\d+)\.valuesText$/);

                    if (valuesMatch) {

                        const index = Number(valuesMatch[1]);

                        draft.config.data.series[index] =
                            draft.config.data.series[index] || {
                                name: 'سری ' + toFa(index + 1),
                                values: []
                            };

                        draft.config.data.series[index].values =
                            String(value)
                                .split(',')
                                .map(x => Number(String(x).trim()))
                                .filter(Number.isFinite);

                        return;
                    }
                    /* Pie Values */
                    const pieValueMatch =
                        path.match(/^data\.series\.(\d+)\.values\.(\d+)$/);

                    if (pieValueMatch) {

                        const seriesIndex = Number(pieValueMatch[1]);
                        const valueIndex = Number(pieValueMatch[2]);

                        draft.config.data.series[seriesIndex] =
                            draft.config.data.series[seriesIndex] || {
                                name: 'مقدار',
                                values: [],
                                colors: []
                            };

                        draft.config.data.series[seriesIndex].values =
                            draft.config.data.series[seriesIndex].values || [];

                        draft.config.data.series[seriesIndex].values[valueIndex] =
                            Number(value);

                        return;
                    }


                    /* Pie Custom Color */
                    const pieCustomColorMatch =
                        path.match(/^data\.series\.(\d+)\.colors\.(\d+)\.customColor$/);

                    if (pieCustomColorMatch) {

                        const seriesIndex = Number(pieCustomColorMatch[1]);
                        const colorIndex = Number(pieCustomColorMatch[2]);

                        draft.config.data.series[seriesIndex] =
                            draft.config.data.series[seriesIndex] || {
                                name: 'مقدار',
                                values: [],
                                colors: []
                            };

                        draft.config.data.series[seriesIndex].colors =
                            draft.config.data.series[seriesIndex].colors || [];

                        draft.config.data.series[seriesIndex].colors[colorIndex] =
                            draft.config.data.series[seriesIndex].colors[colorIndex] || {
                                customColor: false,
                                color: ''
                            };

                        draft.config.data.series[seriesIndex].colors[colorIndex].customColor =
                            !!value;

                        return;
                    }


                    /* Pie Color */
                    const pieColorMatch =
                        path.match(/^data\.series\.(\d+)\.colors\.(\d+)\.color$/);

                    if (pieColorMatch) {

                        const seriesIndex = Number(pieColorMatch[1]);
                        const colorIndex = Number(pieColorMatch[2]);

                        draft.config.data.series[seriesIndex] =
                            draft.config.data.series[seriesIndex] || {
                                name: 'مقدار',
                                values: [],
                                colors: []
                            };

                        draft.config.data.series[seriesIndex].colors =
                            draft.config.data.series[seriesIndex].colors || [];

                        draft.config.data.series[seriesIndex].colors[colorIndex] =
                            draft.config.data.series[seriesIndex].colors[colorIndex] || {
                                customColor: false,
                                color: ''
                            };

                        draft.config.data.series[seriesIndex].colors[colorIndex].color = value;

                        return;
                    }
                    /* ============================================================
                       Series Name
                       ============================================================ */

                    const nameMatch =
                        path.match(/^data\.series\.(\d+)\.name$/);

                    if (nameMatch) {

                        const index = Number(nameMatch[1]);

                        draft.config.data.series[index] =
                            draft.config.data.series[index] || {
                                name: 'سری ' + toFa(index + 1),
                                values: []
                            };

                        draft.config.data.series[index].name = value;

                        return;
                    }

                    // ============================================================
                    // Series Custom Color
                    // ============================================================

                    const customColorMatch =
                        path.match(/^data\.series\.(\d+)\.customColor$/);

                    if (customColorMatch) {

                        const index = Number(customColorMatch[1]);

                        draft.config.data.series[index] =
                            draft.config.data.series[index] || {
                                name: 'سری ' + toFa(index + 1),
                                values: [],
                                customColor: false,
                                color: ''
                            };

                        draft.config.data.series[index].customColor = !!value;

                        return;
                    }
                    // ============================================================
                    // Series Color
                    // ============================================================

                    const colorMatch =
                        path.match(/^data\.series\.(\d+)\.color$/);

                    if (colorMatch) {

                        const index = Number(colorMatch[1]);

                        draft.config.data.series[index] =
                            draft.config.data.series[index] || {
                                name: 'سری ' + toFa(index + 1),
                                values: [],
                                customColor: false,
                                color: ''
                            };

                        draft.config.data.series[index].color = value;

                        return;
                    }


                    /* ============================================================
                       Normal Settings
                       ============================================================ */

                    setPath(draft.config, path, value);
                });
            }

            function syncSettingsToWidget(options = {}) {
                const draft = state.settingsDraft;
                if (!draft) return false;

                applySettingsToDraft();

                const w = state.widgets.find(item => item.id === draft.id);
                if (!w) return false;

                const constraints = Registry[w.type].constraints;
                const nextW = clamp(Number(draft.w) || w.w, constraints.minW, Math.min(constraints.maxW, CFG.columns - w.x));
                const nextH = clamp(Number(draft.h) || w.h, constraints.minH, constraints.maxH);

                if (!valid(w, w.x, w.y, nextW, nextH)) {
                    if (options.notify !== false) toast('این ابعاد با ویجت‌های دیگر تداخل دارد.', 'error');
                    return false;
                }

                w.config = clone(draft.config);
                w.w = nextW;
                w.h = nextH;
                state.dirty = true;

                const el = $(`#dbCanvas .db-widget[data-id="${w.id}"]`);
                if (el) {
                    applyWidgetRect(el, w);
                    const title = el.querySelector('.glass-field-title');
                    const subtitle = el.querySelector('.glass-field-subtitle');
                    const body = el.querySelector('.db-widget-body');

                    if (title) title.textContent = w.config.core.title || Registry[w.type].title;
                    if (subtitle) subtitle.textContent = w.config.core.subtitle || Registry[w.type].title;

                    if (
                        body &&
                        !['lineChart', 'barChart', 'pieChart'].includes(w.type)
                    ) {
                        body.innerHTML = widgetInner(w);
                    } else if (
                        body &&
                        ['lineChart', 'barChart', 'pieChart'].includes(w.type)
                    ) {
                        let chart = body.querySelector('.db-chart');
                        if (!chart) {
                            body.innerHTML = widgetInner(w);
                            chart = body.querySelector('.db-chart');
                        }
                        renderChart(w, chart);
                    }

                    el.classList.toggle('is-selected', state.selectedId === w.id);
                    el.classList.toggle('is-resize-mode', state.selectedId === w.id && state.resizeMode);
                }

                updateCanvasContentHeight();
                return true;
            }

            function settingsSignature(w) {
                return JSON.stringify({ config: w.config, w: w.w, h: w.h });
            }

            function commitSettingsIfChanged() {
                const draft = state.settingsDraft;
                if (!draft) return false;

                const w = state.widgets.find(item => item.id === draft.id);
                if (!w) {
                    state.settingsDraft = null;
                    state.settingsBaseline = null;
                    return false;
                }

                const current = settingsSignature(w);
                const baseline = state.settingsBaseline;
                if (baseline && current !== baseline) {
                    commit('تغییر تنظیمات ویجت');
                    state.settingsBaseline = current;
                    return true;
                }
                return false;
            }

            function openSettings(w) {
                if (!w) return;

                if (state.settingsDraft && state.settingsDraft.id !== w.id) {
                    commitSettingsIfChanged();
                }

                state.selectedId = w.id;
                state.settingsDraft = { id: w.id, config: clone(w.config), w: w.w, h: w.h };
                state.settingsBaseline = settingsSignature(w);
                $('#dbSettings').classList.add('is-open');
                $('#dbSettings').setAttribute('aria-hidden', 'false');
                renderSettings(w);
            }

            function closeSettings(commitChanges = true) {
                if (commitChanges) commitSettingsIfChanged();
                state.settingsDraft = null;
                state.settingsBaseline = null;
                state.resizeMode = false;
                $('#dbSettings').classList.remove('is-open');
                $('#dbSettings').setAttribute('aria-hidden', 'true');
            }

            /* ================================================================
               13. Chart System
               ================================================================ */
            const CHART_DEFAULT_COLORS = [
                '#00BFFF',
                '#008CFF',
                '#00A8D6',
                '#00C8C8',
                '#00D9A5',
                '#00E676',
                '#39D353',
                '#7CFF4F'
            ];
            function renderChart(w, container) {
                if (!container) return;

                if (container.__dbChart) {
                    try { container.__dbChart.destroy(); } catch (ignore) { }
                    container.__dbChart = null;
                }

                if (!window.Highcharts) {
                    container.innerHTML = '<div class="db-chart-placeholder"><i class="bi bi-exclamation-triangle"></i><span>Highcharts بارگذاری نشده است.</span></div>';
                    return;
                }

                const d = w.config.data || {};
                const v = w.config.visual || {};

                let type = d.chartType || 'line';

                // نوع نمودار
                if (w.type === 'lineChart') {
                    type = d.chartType || 'line';
                }

                if (w.type === 'barChart') {
                    type = d.barDirection === 'horizontal' ? 'bar' : 'column';
                }

                if (w.type === 'pieChart') {
                    type = 'pie';
                }

                const font = state.fontFamily;
                const position = d.legendPosition || 'bottom';
                const horizontalLegend = position === 'top' || position === 'bottom';

                // پالت رنگ پیش‌فرض نمودارها
                //const defaultSeriesColors = [
                //    '#00BFFF', // Deep Sky Blue
                //    '#008CFF', // Blue
                //    '#00A8D6', // Cyan Blue
                //    '#00C8C8', // Cyan
                //    '#00D9A5', // Aqua Green
                //    '#00E676', // Green
                //    '#39D353', // Bright Green
                //    '#7CFF4F'  // Lime Green
                //];

                // تولید رنگ هر سری
                function getSeriesColor(series, index) {

                    // اگر کاربر رنگ دستی تعیین کرده باشد
                    if (series && series.customColor && series.color) {
                        return series.color;
                    }

                    // در غیر این صورت رنگ خودکار
                    return CHART_DEFAULT_COLORS[
                        index % CHART_DEFAULT_COLORS.length
                    ];
                }

                const series = (d.series || []).map((item, index) => ({
                    name: item.name || ('سری ' + toFa(index + 1)),
                    data: (item.values || []).map(Number),
                    colors: item.colors || [],
                    color: getSeriesColor(item, index),

                    marker: {
                        enabled: d.marker !== false
                    },

                    shadow: !!d.shadow
                }));

                const options = {
                    chart: {
                        type,
                        backgroundColor: 'transparent',
                        animation: false,
                        spacing: [8, 8, 8, 8],
                        style: {
                            fontFamily: font
                        }
                    },

                    title: {
                        text: null
                    },

                    credits: {
                        enabled: false
                    },

                    accessibility: {
                        enabled: false
                    },

                    legend: {
                        enabled: d.legend !== false,
                        align: position === 'left'
                            ? 'left'
                            : position === 'right'
                                ? 'right'
                                : 'center',

                        verticalAlign: position === 'top'
                            ? 'top'
                            : position === 'bottom'
                                ? 'bottom'
                                : 'middle',

                        layout: horizontalLegend
                            ? 'horizontal'
                            : 'vertical',

                        itemStyle: {
                            color: '#d5e8ee',
                            fontFamily: font,
                            fontSize: '10px',
                            fontWeight: 'normal'
                        }
                    },

                    xAxis: {
                        categories: d.labels || [],

                        title: {
                            text: d.xTitle || null,
                            style: {
                                color: '#a9c0cc',
                                fontFamily: font
                            }
                        },

                        labels: {
                            style: {
                                color: '#b2c5ce',
                                fontFamily: font,
                                fontSize: '9px'
                            }
                        },

                        gridLineWidth: d.grid === false ? 0 : 1,
                        gridLineColor: 'rgba(255,255,255,.07)',
                        lineColor: 'rgba(255,255,255,.12)'
                    },

                    yAxis: {
                        min: d.yMin === '' || d.yMin == null
                            ? undefined
                            : Number(d.yMin),

                        max: d.yMax === '' || d.yMax == null
                            ? undefined
                            : Number(d.yMax),

                        title: {
                            text: d.yTitle || null,
                            style: {
                                color: '#a9c0cc',
                                fontFamily: font
                            }
                        },

                        labels: {
                            style: {
                                color: '#b2c5ce',
                                fontFamily: font,
                                fontSize: '9px'
                            }
                        },

                        gridLineWidth: d.grid === false ? 0 : 1,
                        gridLineColor: 'rgba(255,255,255,.07)'
                    },

                    tooltip: {
                        enabled: d.tooltip !== false,
                        shared: type !== 'pie',
                        useHTML: true,
                        style: {
                            fontFamily: font,
                            fontSize: '11px'
                        }
                    },

                    plotOptions: {
                        series: {
                            animation: false,
                            lineWidth: Number(v.lineWidth) || 3,
                            shadow: !!d.shadow,

                            stacking: d.stacked
                                ? 'normal'
                                : undefined,

                            dataLabels: {
                                enabled: !!d.dataLabels,
                                style: {
                                    fontFamily: font,
                                    textOutline: 'none',
                                    color: '#fff'
                                }
                            }
                        },

                        pie: {
                            showInLegend: true,
                            borderWidth: 0,
                            borderColor: 'transparent',
                            innerSize: d.donut
                                ? '55%'
                                : '0%',

                            dataLabels: {
                                enabled: !!d.dataLabels,
                                style: {
                                    fontFamily: font,
                                    textOutline: 'none',
                                    color: '#fff'
                                }
                            }
                        },

                        column: {
                            borderWidth: 0
                        },

                        bar: {
                            borderWidth: 0
                        }
                    },

                    series: type === 'pie'
                        ? buildPieSeries(series, d.labels || [])
                        : series
                };

                try {
                    container.innerHTML = '';
                    container.__dbChart = Highcharts.chart(container, options);
                } catch (error) {
                    container.__dbChart = null;
                    container.innerHTML = '<div class="db-chart-placeholder">خطا در ساخت نمودار</div>';
                }
            }

            function buildPieSeries(series, labels) {

                const first = series[0] || {
                    name: 'مقدار',
                    data: [],
                    colors: []
                };

                return [{
                    type: 'pie',
                    name: first.name || 'مقدار',

                    data: labels.map((name, i) => {

                        const slice = first.colors?.[i];

                        return {
                            name: name,
                            y: Number(first.data[i]) || 0,

                            color:
                                slice?.customColor && slice?.color
                                    ? slice.color
                                    : CHART_DEFAULT_COLORS[
                                    i % CHART_DEFAULT_COLORS.length
                                    ]
                        };
                    })
                }];
            }

            /* ================================================================
               14. Data Table System
               ================================================================ */
            /* Table rendering is handled by renderTable(); widget data stays in config.data. */

            /* ================================================================
               15. Persistence
               ================================================================ */
            function snapshot() {
                return clone({
                    dashboardId: state.dashboardId,
                    dashboardName: state.dashboardName,
                    widgets: state.widgets
                });
            }

            function normalizeLoaded(w) {
                if (!w || !Registry[w.type]) return null;
                w.config = deepMerge(Registry[w.type].defaults, w.config || {});
                const c = Registry[w.type].constraints;
                w.x = Math.max(0, Number(w.x) || 0);
                w.y = Math.max(0, Number(w.y) || 0);
                w.w = clamp(Number(w.w) || Registry[w.type].defaultSize.w, c.minW, Math.min(c.maxW, CFG.columns));
                w.h = clamp(Number(w.h) || Registry[w.type].defaultSize.h, c.minH, c.maxH);
                return w;
            }

            function restore(s, options = {}) {
                const source = s || {};

                state.dashboardId = source.dashboardId || 'default';
                state.dashboardName = source.dashboardName || '';

                state.widgets = (source.widgets || [])
                    .map(normalizeLoaded)
                    .filter(Boolean);

                state.selectedId = null;
                state.settingsDraft = null;
                state.settingsBaseline = null;
                state.resizeMode = false;
                state.dirty = options.dirty ?? false;

                const nameInput = $('#dbDashboardName');

                if (nameInput) {
                    nameInput.value = state.dashboardName;
                }

                renderCanvas();
            }

            async function save() {
                commitSettingsIfChanged();

                const payload = snapshot();
                const dashboardName = document.getElementById('dbDashboardName')?.value.trim();

                if (!dashboardName) {
                    toast('لطفاً نام داشبورد را وارد کنید.', 'warning');
                    return;
                }

                try {
                    if (CFG.api.saveUrl) {

                        const response = await fetch(CFG.api.saveUrl, {
                            method: CFG.api.method,
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                dashboardName: dashboardName,
                                dashboardConfigJson: JSON.stringify(payload)
                            })
                        });

                        if (!response.ok) throw new Error('save');

                    } else {

                        localStorage.setItem(
                            CFG.storageKey,
                            JSON.stringify(payload)
                        );
                    }

                    state.dirty = false;
                    toast('داشبورد با موفقیت ذخیره شد.', 'success');

                } catch (error) {
                    toast('ذخیره داشبورد انجام نشد.', 'error');
                }
            }

            function load() {
                try {
                    if (CFG.api.loadUrl) return loadFromApi();
                    const raw = localStorage.getItem(CFG.storageKey);
                    if (raw) restore(JSON.parse(raw), { dirty: false });
                } catch (error) {
                    toast('خواندن داشبورد ذخیره‌شده ناموفق بود.', 'error');
                }
            }

            async function loadFromApi() {
                try {
                    const response = await fetch(CFG.api.loadUrl, {
                        method: 'GET'
                    });

                    const raw = await response.text();

                    console.log('Load status:', response.status);
                    console.log('Load raw:', raw);

                    if (!response.ok) {
                        throw new Error('Load HTTP Error');
                    }

                    if (!raw || raw === 'null') {
                        console.log('No dashboard found.');
                        return;
                    }

                    const result = JSON.parse(raw);

                    console.log('Load result:', result);

                    // JSON داشبورد
                    const payload = JSON.parse(result.config);

                    console.log('Load payload:', payload);

                    restore(payload, { dirty: false });

                    // نام واقعی داشبورد از دیتابیس
                    state.dashboardName = result.name || '';

                    const nameInput = document.getElementById('dbDashboardName');

                    if (nameInput) {
                        nameInput.value = state.dashboardName;
                    }

                    console.log('After restore - widgets:', state.widgets);
                    console.log('After restore - name:', state.dashboardName);

                } catch (error) {
                    console.error('Load Dashboard Error:', error);
                    toast('خواندن داشبورد از سرور ناموفق بود.', 'error');
                }
            }

            /* ================================================================
               18. Undo / Redo
               ================================================================ */
            function commit(label) {
                const next = snapshot();
                const previous = state.history[state.historyIndex]?.snapshot;
                if (previous && JSON.stringify(previous) === JSON.stringify(next)) return false;

                state.history = state.history.slice(0, state.historyIndex + 1);
                state.history.push({ label, snapshot: next });

                if (state.history.length > CFG.maxHistory) {
                    state.history.shift();
                }

                state.historyIndex = state.history.length - 1;
                state.dirty = true;
                return true;
            }

            function undo() {
                commitSettingsIfChanged();
                if (state.historyIndex <= 0) {
                    toast('عملی برای واگرد وجود ندارد.', 'error');
                    return;
                }
                state.historyIndex--;
                restore(state.history[state.historyIndex].snapshot, { dirty: true });
            }

            function redo() {
                commitSettingsIfChanged();
                if (state.historyIndex >= state.history.length - 1) {
                    toast('عملی برای بازانجام وجود ندارد.', 'error');
                    return;
                }
                state.historyIndex++;
                restore(state.history[state.historyIndex].snapshot, { dirty: true });
            }

            /* ================================================================
               19. Event Management
               ================================================================ */
            function duplicate(id) {
                commitSettingsIfChanged();

                const w = state.widgets.find(item => item.id === id);
                if (!w) return;

                const n = clone(w);
                n.id = uid(w.type);
                n.metadata = n.metadata || {};
                n.metadata.createdAt = new Date().toISOString();

                const p = nearestFree(n, w.x + 1, w.y);
                n.x = p.x;
                n.y = p.y;
                state.widgets.push(n);
                state.selectedId = n.id;

                commit('کپی ویجت');
                renderCanvas();
                openSettings(n);
            }

            function remove(id) {
                commitSettingsIfChanged();

                const index = state.widgets.findIndex(item => item.id === id);
                if (index < 0) return;

                state.widgets.splice(index, 1);
                if (state.selectedId === id) {
                    state.selectedId = null;
                    closeSettings(false);
                }

                commit('حذف ویجت');
                renderCanvas();
            }

            function clearAll() {
                commitSettingsIfChanged();
                if (!state.widgets.length) return;

                state.widgets = [];
                state.selectedId = null;
                closeSettings(false);
                commit('پاک کردن داشبورد');
                renderCanvas();
            }

            function setupSettings() {
                const body = $('#dbSettingsBody');
                if (!body) return;

                body.addEventListener('input', e => {
                    if (!e.target.dataset.setting) return;
                    syncSettingsToWidget({ notify: false });
                });

                body.addEventListener('change', e => {
                    const path = e.target.dataset.setting;
                    if (!path) return;

                    if (path === 'resizeMode') {
                        state.resizeMode = e.target.value === '1';
                        renderCanvas();

                        const w = state.widgets.find(item => item.id === state.selectedId);
                        if (w) renderSettings(w);

                        return;
                    }

                    // فعال / غیرفعال کردن رنگ دستی سری
                    // فعال / غیرفعال کردن رنگ دستی سری
                    const colorMatch = path.match(/^data\.series\.(\d+)\.customColor$/);

                    if (colorMatch) {

                        const index = Number(colorMatch[1]);

                        const colorInput = body.querySelector(
                            `[data-setting="data.series.${index}.color"]`
                        );

                        if (colorInput) {
                            colorInput.disabled = !e.target.checked;
                        }
                    }


                    // فعال / غیرفعال کردن رنگ دستی Pie
                    const pieColorMatch = path.match(
                        /^data\.series\.(\d+)\.colors\.(\d+)\.customColor$/
                    );

                    if (pieColorMatch) {

                        const seriesIndex = Number(pieColorMatch[1]);
                        const colorIndex = Number(pieColorMatch[2]);

                        const colorInput = body.querySelector(
                            `[data-setting="data.series.${seriesIndex}.colors.${colorIndex}.color"]`
                        );

                        if (colorInput) {
                            colorInput.disabled = !e.target.checked;
                        }
                    }

                    syncSettingsToWidget({ notify: true });
                });

                body.addEventListener('click', e => {
                    const addSeries = e.target.closest('[data-chart-add-series]');
                    if (addSeries) {
                        e.preventDefault();
                        e.stopPropagation();
                        const draft = state.settingsDraft;
                        if (!draft) return;

                        applySettingsToDraft();
                        const series = draft.config.data.series || (draft.config.data.series = []);
                        const labels = draft.config.data.labels || [];
                        const index = series.length;
                        series.push({
                            name: 'سری ' + toFa(index + 1),
                            values: labels.length ? labels.map((_, i) => (i + 1) * 10) : [10, 20, 30, 40]
                        });

                        syncSettingsToWidget({ notify: false });
                        const w = state.widgets.find(item => item.id === draft.id);
                        if (w) renderSettings(w);
                        return;
                    }

                    const removeSeries = e.target.closest('[data-series-remove]');

                    if (removeSeries) {
                        e.preventDefault();
                        e.stopPropagation();

                        const draft = state.settingsDraft;
                        if (!draft) return;

                        applySettingsToDraft();

                        const index = Number(removeSeries.dataset.seriesRemove);
                        const series = draft.config.data.series || [];

                        if (
                            Number.isInteger(index) &&
                            index >= 0 &&
                            index < series.length &&
                            series.length > 1
                        ) {
                            series.splice(index, 1);
                        }

                        draft.config.data.series = series;

                        const w = state.widgets.find(item => item.id === draft.id);

                        if (w) {
                            w.config = clone(draft.config);
                            state.dirty = true;

                            renderSettings(w);
                            renderCanvas();

                            const updated = state.widgets.find(item => item.id === draft.id);

                            if (updated) {
                                state.selectedId = updated.id;
                                state.settingsDraft = {
                                    id: updated.id,
                                    config: clone(updated.config),
                                    w: updated.w,
                                    h: updated.h
                                };
                            }
                        }

                        return;
                    }
                });
            }

            function setupGlobal() {
                root.addEventListener('click', e => {
                    const action = e.target.closest('[data-db-action]');
                    if (!action) return;

                    switch (action.dataset.dbAction) {
                        case 'undo': undo(); break;
                        case 'redo': redo(); break;
                        case 'save': save(); break;
                        case 'clear': clearAll(); break;
                        case 'close-settings': closeSettings(true); break;
                        case 'fit': {
                            const viewport = root.querySelector('.db-canvas-scroll');
                            if (viewport) viewport.scrollTo({ left: 0, top: 0, behavior: 'smooth' });
                            break;
                        }
                    }
                });

                const search = $('#dbWidgetSearch');
                if (search) search.addEventListener('input', renderLibrary);

                window.addEventListener('resize', () => {
                    state.fontFamily = pageFont();
                    root.style.setProperty('--db-page-font', state.fontFamily);
                    renderCanvas();
                });
            }

            /* ================================================================
               20. Utility Functions
               ================================================================ */
            function initHistory() { state.history = [{ label: 'شروع', snapshot: snapshot() }]; state.historyIndex = 0 }

            /* ================================================================
               21. Initialization
               ================================================================ */
            renderLibrary(); setupDrag(); setupResize(); setupSelection(); setupSettings(); setupGlobal(); load(); initHistory(); renderCanvas();

            window.DashboardBuilder = { state, Registry, config: CFG, addWidget, remove, duplicate, save, load, undo, redo, validate, render: renderCanvas };
        })(window, document);

    </script>
</body>
</html>

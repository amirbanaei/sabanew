                if (d === 'table') html += `<div class="db-setting-section"><div class="db-setting-title">جدول</div>${textarea('ستون‌ها؛ هر ستون در یک خط', 'data.columnsText', (c.data.columns || []).join('\n'))}${textarea('ردیف‌ها؛ هر ردیف در یک خط و سلول‌ها با | جدا شوند', 'data.rowsText', (c.data.rows || []).map(r => r.join(' | ')).join('\n'))}${check('فعال بودن فیلتر', 'data.filter', !!c.data.filter)}${check('فعال بودن صفحه‌بندی', 'data.pagination', !!c.data.pagination)}${field('تعداد ردیف هر صفحه', 'data.pageSize', c.data.pageSize, 'number')}</div>`;

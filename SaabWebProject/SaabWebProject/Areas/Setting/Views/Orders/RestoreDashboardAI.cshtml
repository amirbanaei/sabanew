        ================================================================ */

        #dashboardBuilder .db-series {
            border-top: 1px solid var(--db-border);
            margin-top: .55rem;
            padding-top: .55rem;
        }

            #dashboardBuilder .db-series:first-child {
                border-top: 0;
                margin-top: 0;
                padding-top: 0;
            }

        #dashboardBuilder .db-series-head {
            display: flex;
            align-items: center;
            gap: .35rem;
            margin-bottom: .35rem;
        }

            #dashboardBuilder .db-series-head strong {
                font-size: .65rem;
                flex: 1;
            }

        #dashboardBuilder .db-series-values {
            width: 100%;
            min-height: 2.2rem;
            resize: vertical;
        }

        #dashboardBuilder .db-labels-input {
            min-height: 4rem;
            resize: vertical;
        }


        /* ================================================================
           Settings Actions
        ================================================================ */

        #dashboardBuilder .db-settings-actions {
            position: sticky;
            bottom: -.7rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: .45rem;
            margin: 0 !important;
            padding: .65rem 0 .1rem;
            background: linear-gradient( transparent, rgba(7, 17, 27, .98) 25% );
            z-index: 5;
        }

            #dashboardBuilder .db-settings-actions button {
                margin: 0 !important;
                width: 100% !important;
            }

        #dashboardBuilder .db-full-btn {
            width: 100% !important;
            margin-top: .4rem !important;
        }


        /* ================================================================
           KPI / Progress
        ================================================================ */

        #dashboardBuilder .db-kpi-value,
        #restoreDashboardCanvas .db-kpi-value {
            font-weight: 700;
            letter-spacing: .3px;
        }

        #dashboardBuilder .db-kpi-label,
        #restoreDashboardCanvas .db-kpi-label {
            font-size: .65rem;
            color: var(--db-muted);
            margin-top: .4rem;
        }

        #dashboardBuilder .db-progress,
        #restoreDashboardCanvas .db-progress {
            height: 8px;
            border-radius: 99px;
            background: rgba(255, 255, 255, .08);
            overflow: hidden;
            margin-top: 1rem;
        }

            #dashboardBuilder .db-progress i,
            #restoreDashboardCanvas .db-progress i {
                display: block;
                height: 100%;
                border-radius: 99px;
            }


        /* ================================================================
           Chart
        ================================================================ */

        #dashboardBuilder .db-chart,
        #restoreDashboardCanvas .db-chart {
            width: 100%;
            height: 100%;
            min-height: 130px;
        }

        #dashboardBuilder .db-chart-placeholder,
        #restoreDashboardCanvas .db-chart-placeholder {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: .5rem;
            color: var(--db-muted);
            font-size: .7rem;
        }


        /* ================================================================
           Data Table
        ================================================================ */

        #dashboardBuilder .db-table-wrap,
        #restoreDashboardCanvas .db-table-wrap {
            width: 100%;
            height: 100%;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, .06);
            border-radius: .7rem;
            background: transparent;
        }

        #dashboardBuilder .db-table,
        #restoreDashboardCanvas .db-table {
            width: 100%;
            height: 100%;
            display: grid;
            grid-template-rows: auto minmax(0, 1fr);
            border-collapse: separate;
            border-spacing: 0;
            direction: rtl;
            color: #fff;
            font-size: .62rem;
            table-layout: fixed;
        }

            #dashboardBuilder .db-table thead,
            #restoreDashboardCanvas .db-table thead {
                display: table;
                width: 100%;
                table-layout: fixed;
            }

            #dashboardBuilder .db-table th,
            #restoreDashboardCanvas .db-table th {
                height: 2.5rem;
                padding: .75rem 1rem;
                text-align: center;
                vertical-align: middle;
                font-weight: 600;
                white-space: nowrap;
                color: #ecfbff;
                background: linear-gradient( 135deg, rgba(255, 255, 255, .10), rgba(255, 255, 255, .045) );
                border-top: 1px solid rgba(255, 255, 255, .18);
                border-bottom: 1px solid rgba(0, 255, 255, .20);
                border-left: 1px solid rgba(255, 255, 255, .08);
                backdrop-filter: blur(15px) saturate(150%);
                -webkit-backdrop-filter: blur(15px) saturate(150%);
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, .14);
            }

            #dashboardBuilder .db-table tbody,
            #restoreDashboardCanvas .db-table tbody {
                display: block;
                width: 100%;
                min-height: 0;
                height: 100%;
                overflow-y: auto;
                overflow-x: hidden;
                scrollbar-width: thin;
                scrollbar-color: rgba(255, 255, 255, .18) transparent;
            }

                #dashboardBuilder .db-table tbody tr,
                #restoreDashboardCanvas .db-table tbody tr {
                    display: table;
                    width: 100%;
                    table-layout: fixed;
                    transition: background .25s ease;
                }

            #dashboardBuilder .db-table td,
            #restoreDashboardCanvas .db-table td {
                height: 2.5rem;
                padding: .5rem .75rem;
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                background: transparent;
                color: rgba(255, 255, 255, .88);
                border: none;
                border-bottom: 1px solid rgba(255, 255, 255, .06);
                box-sizing: border-box;
                transition: background .25s ease, color .25s ease, border-color .25s ease;
            }

                #dashboardBuilder .db-table td:not(:last-child),
                #restoreDashboardCanvas .db-table td:not(:last-child) {
                    border-left: 1px solid rgba(255, 255, 255, .045);
                }

            #dashboardBuilder .db-table tbody tr:last-child td,
            #restoreDashboardCanvas .db-table tbody tr:last-child td {
                border-bottom: none;
            }

            #dashboardBuilder .db-table tbody tr:hover td,
            #restoreDashboardCanvas .db-table tbody tr:hover td {
                color: #f2fcff;
                border-bottom-color: rgba(0, 255, 255, .10);
            }

            #dashboardBuilder .db-table tbody::-webkit-scrollbar,
            #restoreDashboardCanvas .db-table tbody::-webkit-scrollbar {
                width: 5px;
            }

            #dashboardBuilder .db-table tbody::-webkit-scrollbar-track,
            #restoreDashboardCanvas .db-table tbody::-webkit-scrollbar-track {
                background: transparent;
            }

            #dashboardBuilder .db-table tbody::-webkit-scrollbar-thumb,
            #restoreDashboardCanvas .db-table tbody::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, .18);
                border-radius: 10px;
            }

                #dashboardBuilder .db-table tbody::-webkit-scrollbar-thumb:hover,
                #restoreDashboardCanvas .db-table tbody::-webkit-scrollbar-thumb:hover {
                    background: rgba(0, 255, 255, .32);
                }


        /* ================================================================
           Data Widget
        ================================================================ */

        #dashboardBuilder .db-data-widget,
        #restoreDashboardCanvas .db-data-widget {
            width: 100%;
            height: 100%;
            overflow-y: auto;
            overflow-x: hidden;
            padding: .15rem .2rem;
            direction: rtl;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.18) transparent;
        }

            #dashboardBuilder .db-data-widget::-webkit-scrollbar,
            #restoreDashboardCanvas .db-data-widget::-webkit-scrollbar {
                width: 4px;
            }

            #dashboardBuilder .db-data-widget::-webkit-scrollbar-track,
            #restoreDashboardCanvas .db-data-widget::-webkit-scrollbar-track {
                background: transparent;
            }

            #dashboardBuilder .db-data-widget::-webkit-scrollbar-thumb,
            #restoreDashboardCanvas .db-data-widget::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.18);
                border-radius: 10px;
            }

        #dashboardBuilder .db-data-row,
        #restoreDashboardCanvas .db-data-row {
            width: 100%;
            min-height: 2.45rem;
            display: flex !important;
            flex-direction: row !important;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: .45rem .65rem;
            border-bottom: 1px solid rgba(255,255,255,.065);
            transition: background .25s ease, border-color .25s ease;
        }

            #dashboardBuilder .db-data-row:last-child,
            #restoreDashboardCanvas .db-data-row:last-child {
                border-bottom: none;
            }

            #dashboardBuilder .db-data-row:hover,
            #restoreDashboardCanvas .db-data-row:hover {
                background: rgba(255,255,255,.035);
                border-bottom-color: rgba(0,255,255,.15);
            }

        #dashboardBuilder .db-data-name,
        #restoreDashboardCanvas .db-data-name {
            flex: 1 1 auto;
            min-width: 0;
            text-align: right;
            color: rgba(255,255,255,.78);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #dashboardBuilder .db-data-value,
        #restoreDashboardCanvas .db-data-value {
            flex: 0 0 auto;
            text-align: left;
            font-weight: 700;
            white-space: nowrap;
            direction: rtl;
            text-shadow: 0 0 10px rgba(0,255,255,.18);
        }


        /* ================================================================
           Text / List
        ================================================================ */

        #dashboardBuilder .db-text-content,
        #restoreDashboardCanvas .db-text-content {
            line-height: 1.9;
            white-space: normal;
        }

        #dashboardBuilder .db-list-content,
        #restoreDashboardCanvas .db-list-content {
            margin: 0;
            padding-right: 1.1rem;
            line-height: 2;
        }


        /* ================================================================
           Utility
        ================================================================ */

        #dashboardBuilder .scrollbar,
        #restoreDashboardCanvas .scrollbar {
            min-height: 0;
        }


        /* ================================================================
           Responsive
        ================================================================ */

        @@media (max-width: 1100px) {

            #dashboardBuilder .db-workspace {
                grid-template-columns: 220px minmax(0, 1fr);
            }
        }

        @@media (max-width: 850px) {

            #dashboardBuilder .db-workspace {
                grid-template-columns: 1fr;
            }

            #dashboardBuilder .db-library {
                max-height: 250px;
            }

            #dashboardBuilder .db-settings {
                width: min(390px, 95%);
            }
        }



        #restoreDashboardCanvas .highcharts-legend-item:hover text {
            fill: #00ffff !important;
            color: #00ffff !important;
        }
    </style>
    <style>
        #restoreDashboardCanvas {
            position: relative;
            width: 100%;
            min-height: 600px;
            margin-top: 15px;
            overflow: auto;
        }

            #restoreDashboardCanvas .db-widget {
                position: absolute;
                box-sizing: border-box;
            }

            #restoreDashboardCanvas .glass-field-ag {
                width: 100%;
                height: 100%;
            }

            #restoreDashboardCanvas .glass-field-body {
                min-height: 0;
            }

            #restoreDashboardCanvas .db-chart {
                width: 100%;
                height: 100%;
                min-height: 0;
            }
    </style>
</head>
<body>
    <div class="tab-content tab-AG" id="pills-tabContent">


        <div class="row row-input-AG">


            <div class="col-xl-3">
                <label class="glass-label-ag">نوع جلسه</label>
                <select style="margin-bottom:0px !important" class="glass-select-ag" id="restoreDashboardSelect">
                    <option value="0">انتخاب کنید...</option>
                </select>
            </div>
            <div class="col-xl-2">
                <button type="button"
                        id="btnRestoreDashboard"
                        class="glass-btn-ag glass-btn-ag-primary"
                        style="width:100%;">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <p>بازگردانی داشبورد</p>
                </button>
            </div>

        </div>
        <div id="restoreDashboardCanvas"
             class="restore-dashboard-canvas">
        </div>

    </div>
    <script src="~/Scripts/highcharts.js"></script>
    <script src="~/Scripts/highcharts-more.js"></script>
    <script src="~/Scripts/highcharts-3d.js"></script>

    <script>
        (function () {

            'use strict';

            const select = document.getElementById('restoreDashboardSelect');
            const restoreButton = document.getElementById('btnRestoreDashboard');
            const canvas = document.getElementById('restoreDashboardCanvas');

            if (!select || !restoreButton || !canvas) return;


            /* =========================================================
               Configuration
            ========================================================= */

            const CFG = {
                columns: 12,
                rowHeight: 34,
                gap: 10,
                canvasPadding: 12
            };

            const CHART_COLORS = [
                '#00BFFF',
                '#008CFF',
                '#00A8D6',
                '#00C8C8',
                '#00D9A5',
                '#00E676',
                '#39D353',
                '#7CFF4F'
            ];


            /* =========================================================
               Load Dashboard List
            ========================================================= */

            loadDashboardList();


            function loadDashboardList() {

                fetch('/Setting/Orders/GetDashboardAIList', {
                    method: 'GET',
                    cache: 'no-cache'
                })
                    .then(function (response) {
                        return response.json();
                    })
                    .then(function (result) {

                        if (!result.success) {
                            throw new Error(
                                result.message || 'خطا در دریافت لیست داشبوردها'
                            );
                        }

                        select.innerHTML =
                            '<option value="">یک داشبورد را انتخاب کنید</option>';

                        (result.data || []).forEach(function (dashboard) {

                            const option = document.createElement('option');

                            option.value = dashboard.ID;
                            option.textContent = dashboard.DashboardName;

                            select.appendChild(option);

                        });

                    })
                    .catch(function (error) {

                        console.error(error);

                        select.innerHTML =
                            '<option value="">خطا در دریافت داشبوردها</option>';

                    });

            }


            /* =========================================================
               Restore
            ========================================================= */

            restoreButton.addEventListener('click', function () {

                const id = select.value;

                if (!id) {
                    alert('لطفاً یک داشبورد را انتخاب کنید.');
                    return;
                }

                restoreButton.disabled = true;

                fetch(
                    '/Setting/Orders/GetDashboardAIById?id=' +
                    encodeURIComponent(id),
                    {
                        method: 'GET',
                        cache: 'no-cache'
                    }
                )
                    .then(function (response) {
                        return response.json();
                    })
                    .then(function (result) {

                        if (!result.success) {
                            throw new Error(
                                result.message || 'داشبورد پیدا نشد.'
                            );
                        }

                        const dashboard =
                            typeof result.config === 'string'
                                ? JSON.parse(result.config)
                                : result.config;

                        renderDashboard(dashboard);

                    })
                    .catch(function (error) {

                        console.error(error);

                        alert(
                            error.message ||
                            'خطا در بازگردانی داشبورد'
                        );

                    })
                    .finally(function () {

                        restoreButton.disabled = false;

                    });

            });


            /* =========================================================
               Render Dashboard
            ========================================================= */

            function renderDashboard(dashboard) {

                canvas.innerHTML = '';
                canvas.style.position = 'relative';
                if (
                    !dashboard ||
                    !Array.isArray(dashboard.widgets)
                ) {
                    return;
                }

                const metrics = gridMetrics();

                dashboard.widgets.forEach(function (widget) {

                    const element =
                        createWidget(widget, metrics);

                    if (element) {
                        canvas.appendChild(element);
                    }

                });

                updateCanvasHeight(
                    dashboard.widgets,
                    metrics
                );

            }


            /* =========================================================
               Grid
            ========================================================= */

            function gridMetrics() {

                const width =
                    Math.max(
                        canvas.clientWidth || 900,
                        900
                    ) -
                    CFG.canvasPadding * 2;

                return {
                    cw:
                        (
                            width -
                            CFG.gap * (CFG.columns - 1)
                        ) /
                        CFG.columns,

                    rh:
                        CFG.rowHeight
                };

            }


            function pxRect(w) {

                const m = gridMetrics();

                return {

                    left:
                        CFG.canvasPadding +
                        w.x * (m.cw + CFG.gap),

                    top:
                        CFG.canvasPadding +
                        w.y * (m.rh + CFG.gap),

                    width:
                        w.w * m.cw +
                        (w.w - 1) * CFG.gap,

                    height:
                        w.h * m.rh +
                        (w.h - 1) * CFG.gap

                };

            }


            function updateCanvasHeight(widgets, metrics) {

                let maxBottom = 0;

                widgets.forEach(function (w) {

                    const bottom =
                        Number(w.y || 0) +
                        Number(w.h || 1);

                    if (bottom > maxBottom) {
                        maxBottom = bottom;
                    }

                });

                const height =
                    CFG.canvasPadding * 2 +
                    maxBottom * metrics.rh +
                    Math.max(0, maxBottom - 1) * CFG.gap;

                canvas.style.height =
                    Math.max(height, 600) + 'px';

                canvas.style.minHeight =
                    Math.max(height, 600) + 'px';

            }


            /* =========================================================
               Create Widget
               همان ساختار Builder
            ========================================================= */

            function createWidget(widget, metrics) {

                if (!widget) return null;

                const element =
                    document.createElement('article');

                element.className =
                    'db-widget';
                element.style.position = 'absolute';
                element.dataset.id =
                    widget.id || '';

                element.dataset.type =
                    widget.type || '';


                const x =
                    Number(widget.x || 0);

                const y =
                    Number(widget.y || 0);

                const w =
                    Math.max(
                        Number(widget.w || 1),
                        1
                    );

                const h =
                    Math.max(
                        Number(widget.h || 1),
                        1
                    );


                element.style.left =
                    CFG.canvasPadding +
                    x * (metrics.cw + CFG.gap) +
                    'px';

                element.style.top =
                    CFG.canvasPadding +
                    y * (metrics.rh + CFG.gap) +
                    'px';

                element.style.width =
                    w * metrics.cw +
                    (w - 1) * CFG.gap +
                    'px';

                element.style.height =
                    h * metrics.rh +
                    (h - 1) * CFG.gap +
                    'px';


                const config =
                    widget.config || {};

                const core =
                    config.core || {};

                const registry =
                    getWidgetInfo(widget.type);


                const title =
                    core.title ||
                    registry.title;

                const subtitle =
                    core.subtitle ||
                    registry.description;


                /*
                 * دقیقاً همان ساختار renderCanvas Builder
                 */

                element.innerHTML = `

                <div class="glass-field-ag">

                    <div class="glass-field-header db-widget-head">

                        <div class="glass-field-icon">
                            <i class="bi ${registry.icon}"></i>
                        </div>

                        <div class="glass-field-heading">

                            <div class="glass-field-title">
                                ${escapeHtml(title)}
                            </div>

                            <div class="glass-field-subtitle">
                                ${escapeHtml(subtitle)}
                            </div>

                        </div>

                    </div>

                    <div class="glass-field-body db-widget-body">

                        ${widgetInner(widget)}

                    </div>

                </div>

            `;


                canvas.appendChild(element);


                /*
                 * نمودار بعد از قرار گرفتن داخل DOM ساخته می‌شود
                 */

                if (
                    [
                        'lineChart',
                        'barChart',
                        'pieChart'
                    ].includes(widget.type)
                ) {

                    const chart =
                        element.querySelector('.db-chart');

                    if (chart) {
                        renderChart(widget, chart);
                    }

                }


                return element;

            }


            /* =========================================================
               Widget Info
               معادل Registry برای Restore
            ========================================================= */

            function getWidgetInfo(type) {

                const registry = {

                    kpi: {
                        title: 'شاخص کلیدی',
                        description: 'نمایش یک مقدار مهم',
                        icon: 'bi-speedometer2'
                    },

                    progress: {
                        title: 'پیشرفت',
                        description: 'نمایش درصد پیشرفت',
                        icon: 'bi-bar-chart-line'
                    },

                    lineChart: {
                        title: 'نمودار خطی',
                        description: 'نمایش روند داده‌ها',
                        icon: 'bi-graph-up'
                    },

                    barChart: {
                        title: 'نمودار مقایسه‌ای',
                        description: 'مقایسه داده‌ها',
                        icon: 'bi-bar-chart'
                    },

                    pieChart: {
                        title: 'نمودار سهم',
                        description: 'توزیع داده‌ها',
                        icon: 'bi-pie-chart'
                    },

                    table: {
                        title: 'جدول',
                        description: 'نمایش داده‌های جدولی',
                        icon: 'bi-table'
                    },

                    data: {
                        title: 'داده',
                        description: 'نمایش چند مقدار',
                        icon: 'bi-list-columns'
                    },

                    text: {
                        title: 'متن',
                        description: 'نمایش متن آزاد',
                        icon: 'bi-fonts'
                    },

                    list: {
                        title: 'لیست',
                        description: 'نمایش فهرست اطلاعات',
                        icon: 'bi-list-ul'
                    }

                };

                return registry[type] || {
                    title: 'ویجت',
                    description: '',
                    icon: 'bi-grid'
                };

            }


            /* =========================================================
               Widget Inner
               تقریباً همان widgetInner Builder
            ========================================================= */

            function widgetInner(widget) {

                const c =
                    widget.config || {};

                const data =
                    c.data || {};

                const visual =
                    c.visual || {};


                /* ---------------- KPI ---------------- */

                if (widget.type === 'kpi') {

                    return `

                    <div class="db-kpi-value"
                         style="
                            font-size:${Number(visual.fontSize) || 28}px;
                            text-align:${visual.align || 'right'};
                            color:${escapeHtml(
                        visual.accent || '#00ffff'
                    )};
                         ">

                        ${escapeHtml(data.value || '')}

                    </div>

                    <div class="db-kpi-label"
                         style="
                            text-align:${visual.align || 'right'};
                         ">

                        ${escapeHtml(data.label || '')}

                    </div>

                `;

                }


                /* ---------------- Progress ---------------- */

                if (widget.type === 'progress') {

                    const value =
                        clamp(
                            Number(data.value) || 0,
                            0,
                            100
                        );

                    return `

                    <div class="db-kpi-value"
                         style="
                            font-size:${Number(visual.fontSize) || 22}px;
                            text-align:${visual.align || 'right'};
                         ">

                        ${escapeHtml(value)}%

                    </div>

                    <div class="db-progress">

                        <i style="
                            width:${value}%;
                            background:${escapeHtml(
                        visual.accent || '#00ffff'
                    )};
                        "></i>

                    </div>

                    <div class="db-kpi-label">

                        ${escapeHtml(data.label || '')}

                    </div>

                `;

                }


                /* ---------------- Charts ---------------- */

                if (
                    [
                        'lineChart',
                        'barChart',
                        'pieChart'
                    ].includes(widget.type)
                ) {

                    return `
                    <div
                        class="db-chart"
                        data-chart-id="${escapeHtml(widget.id || '')}">
                    </div>
                `;

                }


                /* ---------------- Data ---------------- */

                if (widget.type === 'data') {
                    return renderDataWidget(widget);
                }


                /* ---------------- Table ---------------- */

                if (widget.type === 'table') {
                    return renderTable(widget);
                }


                /* ---------------- Text ---------------- */

                if (widget.type === 'text') {

                    return `

                    <div class="db-text-content"
                         style="
                            font-size:${Number(visual.fontSize) || 13}px;
                            text-align:${visual.align || 'right'};
                         ">

                        ${escapeHtml(
                        data.text || ''
                    ).replace(/\n/g, '<br>')}

                    </div>

                `;

                }


                /* ---------------- List ---------------- */

                if (widget.type === 'list') {

                    return `

                    <ul class="db-list-content"
                        style="
                            font-size:${Number(visual.fontSize) || 11}px;
                        ">

                        ${(data.items || []).map(function (item) {

                        return `
                                <li>
                                    ${escapeHtml(
                            typeof item === 'string'
                                ? item
                                : (
                                    item.label ||
                                    item.title ||
                                    ''
                                )
                        )}
                                </li>
                            `;

                    }).join('')}

                    </ul>

                `;

                }


                return '';

            }


            /* =========================================================
               Table
               دقیقاً مطابق Builder
            ========================================================= */

            function renderTable(widget) {

                const data =
                    widget.config &&
                        widget.config.data
                        ? widget.config.data
                        : {};

                const cols =
                    Array.isArray(data.columns)
                        ? data.columns
                        : [];

                const rows =
                    Array.isArray(data.rows)
                        ? data.rows
                        : [];


                return `

                <div class="db-table-wrap">

                    <table class="db-table">

                        <thead>

                            <tr>

                                ${cols.map(function (column) {

                    return `
                                        <th>
                                            ${escapeHtml(column)}
                                        </th>
                                    `;

                }).join('')}

                            </tr>

                        </thead>

                        <tbody>

                            ${rows.map(function (row) {

                    return `

                                    <tr>

                                        ${cols.map(function (_, i) {

                        const value =
                            row[i] == null
                                ? ''
                                : row[i];

                        return `

                                                <td title="${escapeHtml(value)}">
                                                    ${escapeHtml(value)}
                                                </td>

                                            `;

                    }).join('')}

                                    </tr>

                                `;

                }).join('')}

                        </tbody>

                    </table>

                </div>

            `;

            }


            /* =========================================================
               Data Widget
               دقیقاً مطابق Builder
            ========================================================= */

            function renderDataWidget(widget) {

                const data =
                    widget.config &&
                        widget.config.data
                        ? widget.config.data
                        : {};

                const visual =
                    widget.config &&
                        widget.config.visual
                        ? widget.config.visual
                        : {};


                const items =
                    Array.isArray(data.items)
                        ? data.items
                        : [];


                const fontSize =
                    Number(visual.fontSize) || 11;

                const accent =
                    visual.accent || '#00ffff';


                return `

                <div class="db-data-widget"
                     style="font-size:${fontSize}px">

                    ${items.map(function (item) {

                    return `

                            <div class="db-data-row">

                                <div class="db-data-name"
                                     title="${escapeHtml(
                        item.name || ''
                    )}">

                                    ${escapeHtml(
                        item.name || ''
                    )}

                                </div>

                                <div class="db-data-value"
                                     style="color:${escapeHtml(accent)}"
                                     title="${escapeHtml(
                        item.value == null
                            ? ''
                            : item.value
                    )}">

                                    ${escapeHtml(
                        item.value == null
                            ? ''
                            : item.value
                    )}

                                </div>

                            </div>

                        `;

                }).join('')}

                </div>

            `;

            }


            /* =========================================================
               Highcharts
               تنظیمات ذخیره‌شده حفظ می‌شوند
            ========================================================= */

            function renderChart(widget, container) {

                if (!container) return;

                if (container.__dbChart) {
                    try {
                        container.__dbChart.destroy();
                    } catch (ignore) { }

                    container.__dbChart = null;
                }

                if (!window.Highcharts) {
                    container.innerHTML =
                        '<div class="db-chart-placeholder">' +
                        '<i class="bi bi-exclamation-triangle"></i>' +
                        '<span>Highcharts بارگذاری نشده است.</span>' +
                        '</div>';
                    return;
                }

                const config = widget.config || {};
                const d = config.data || {};
                const v = config.visual || {};

                /* ============================================================
                   نوع نمودار
                   ============================================================ */

                let type = d.chartType || 'line';

                if (widget.type === 'lineChart') {

                    type = d.chartType || 'line';

                }
                else if (widget.type === 'barChart') {

                    type =
                        d.barDirection === 'horizontal'
                            ? 'bar'
                            : 'column';

                }
                else if (widget.type === 'pieChart') {

                    type = 'pie';

                }


                /* ============================================================
                   رنگ سری‌ها
                   ============================================================ */

                function getSeriesColor(series, index) {

                    if (
                        series &&
                        series.customColor === true &&
                        series.color
                    ) {
                        return series.color;
                    }

                    return CHART_COLORS[
                        index % CHART_COLORS.length
                    ];
                }


                /* ============================================================
                   سری‌ها
                   ============================================================ */

                const sourceSeries =
                    Array.isArray(d.series)
                        ? d.series
                        : [];

                const series =
                    sourceSeries.map(function (item, index) {

                        return {
                            name:
                                item.name ||
                                ('سری ' + (index + 1)),

                            data:
                                Array.isArray(item.values)
                                    ? item.values.map(Number)
                                    : [],

                            colors:
                                Array.isArray(item.colors)
                                    ? item.colors
                                    : [],

                            color:
                                getSeriesColor(item, index),

                            marker: {
                                enabled:
                                    d.marker !== false
                            },

                            shadow:
                                !!d.shadow
                        };

                    });


                /* ============================================================
                   Legend
                   ============================================================ */

                const position =
                    d.legendPosition || 'bottom';

                const horizontalLegend =
                    position === 'top' ||
                    position === 'bottom';


                /* ============================================================
                   Options
                   ============================================================ */

                const options = {

                    chart: {

                        type: type,

                        backgroundColor:
                            'transparent',

                        animation: false,

                        spacing: [
                            8,
                            8,
                            8,
                            8
                        ],

                        style: {
                            fontFamily: 'inherit'
                        }
                    },


                    title: {
                        text: null
                    },


                    credits: {
                        enabled: false
                    },


                    accessibility: {
                        enabled: false
                    },


                    /* ========================================================
                       Legend
                       ======================================================== */

                    legend: {

                        enabled:
                            d.legend !== false,

                        align:
                            position === 'left'
                                ? 'left'
                                : position === 'right'
                                    ? 'right'
                                    : 'center',

                        verticalAlign:
                            position === 'top'
                                ? 'top'
                                : position === 'bottom'
                                    ? 'bottom'
                                    : 'middle',

                        layout:
                            horizontalLegend
                                ? 'horizontal'
                                : 'vertical',

                        itemStyle: {
                            color: '#d5e8ee',
                            fontFamily: 'inherit',
                            fontSize: '10px',
                            fontWeight: 'normal'
                        }
                    },


                    /* ========================================================
                       X Axis
                       ======================================================== */

                    xAxis: {

                        categories:
                            Array.isArray(d.labels)
                                ? d.labels
                                : [],

                        title: {

                            text:
                                d.xTitle || null,

                            style: {
                                color: '#a9c0cc',
                                fontFamily: 'inherit'
                            }
                        },

                        labels: {

                            style: {
                                color: '#b2c5ce',
                                fontFamily: 'inherit',
                                fontSize: '9px'
                            }
                        },

                        gridLineWidth:
                            d.grid === false
                                ? 0
                                : 1,

                        gridLineColor:
                            'rgba(255,255,255,.07)',

                        lineColor:
                            'rgba(255,255,255,.12)'
                    },


                    /* ========================================================
                       Y Axis
                       ======================================================== */

                    yAxis: {

                        min:
                            d.yMin === '' ||
                                d.yMin == null
                                ? undefined
                                : Number(d.yMin),

                        max:
                            d.yMax === '' ||
                                d.yMax == null
                                ? undefined
                                : Number(d.yMax),

                        title: {

                            text:
                                d.yTitle || null,

                            style: {
                                color: '#a9c0cc',
                                fontFamily: 'inherit'
                            }
                        },

                        labels: {

                            style: {
                                color: '#b2c5ce',
                                fontFamily: 'inherit',
                                fontSize: '9px'
                            }
                        },

                        gridLineWidth:
                            d.grid === false
                                ? 0
                                : 1,

                        gridLineColor:
                            'rgba(255,255,255,.07)'
                    },


                    /* ========================================================
   Tooltip
   ======================================================== */

                    tooltip: {

                        enabled:
                            d.tooltip !== false,

                        shared:
                            type !== 'pie',

                        useHTML: true,

                        backgroundColor:
                            'rgba(8, 20, 31, .96)',

                        borderColor:
                            'rgba(0, 255, 255, .45)',

                        borderWidth: 1,

                        borderRadius: 10,

                        style: {
                            color: '#edfaff',
                            fontFamily: 'inherit',
                            fontSize: '11px',
                            fontWeight: '400'
                        },

                        headerFormat:
                            '<span style="color:#91a9b7">{point.key}</span><br/>',

                        pointFormat:
                            '<div style="margin-top:3px;">' +
                            '<span style="color:#edfaff">{series.name}</span>: ' +
                            '<b style="color:#00ffff">{point.y}</b>' +
                            '</div>'
                    },


                    /* ========================================================
                       Plot Options
                       ======================================================== */

                    plotOptions: {

                        series: {

                            animation: false,

                            lineWidth:
                                Number(v.lineWidth) || 3,

                            shadow:
                                !!d.shadow,

                            stacking:
                                d.stacked
                                    ? 'normal'
                                    : undefined,

                            dataLabels: {

                                enabled:
                                    d.dataLabels === true,

                                style: {

                                    fontFamily: 'inherit',

                                    textOutline:
                                        'none',

                                    color:
                                        '#fff'
                                }
                            }
                        },


                        /* ----------------------------------------------------
                           Pie
                           ---------------------------------------------------- */

                        pie: {

                            showInLegend:
                                d.legend === true,

                            borderWidth: 0,

                            borderColor:
                                'transparent',

                            innerSize:
                                d.donut === true
                                    ? '55%'
                                    : '0%',

                            dataLabels: {

                                enabled:
                                    d.dataLabels === true,

                                style: {

                                    fontFamily:
                                        'inherit',

                                    textOutline:
                                        'none',

                                    color:
                                        '#fff'
                                }
                            }
                        },


                        /* ----------------------------------------------------
                           Column
                           ---------------------------------------------------- */

                        column: {

                            borderWidth: 0
                        },


                        /* ----------------------------------------------------
                           Horizontal Bar
                           ---------------------------------------------------- */

                        bar: {

                            borderWidth: 0
                        },


                        /* ----------------------------------------------------
                           Line
                           ---------------------------------------------------- */

                        line: {

                            marker: {

                                enabled:
                                    d.marker !== false
                            }
                        },


                        /* ----------------------------------------------------
                           Spline
                           ---------------------------------------------------- */

                        spline: {

                            marker: {

                                enabled:
                                    d.marker !== false
                            }
                        }
                    },


                    /* ========================================================
                       Series
                       ======================================================== */

                    series:
                        type === 'pie'

                            ? buildPieSeries(
                                series,
                                Array.isArray(d.labels)
                                    ? d.labels
                                    : []
                            )

                            : series
                };


                /* ============================================================
                   Pie Axis حذف شود
                   ============================================================ */

                if (type === 'pie') {

                    delete options.xAxis;
                    delete options.yAxis;
                }


                /* ============================================================
                   Render
                   ============================================================ */

                try {

                    container.innerHTML = '';

                    container.__dbChart =
                        Highcharts.chart(
                            container,
                            options
                        );

                }
                catch (error) {

                    console.error(
                        'Restore Highcharts Error:',
                        error
                    );

                    container.__dbChart = null;

                    container.innerHTML =
                        '<div class="db-chart-placeholder">' +
                        'خطا در ساخت نمودار' +
                        '</div>';
                }
            }
            function buildPieSeries(series, labels) {

                const first =
                    series[0] || {};

                const values =
                    Array.isArray(first.data)
                        ? first.data
                        : [];

                const sourceColors =
                    Array.isArray(
                        first.colors
                    )
                        ? first.colors
                        : [];

                return [{
                    name:
                        first.name || 'مقدار',

                    data:
                        labels.map(function (label, index) {

                            const colorInfo =
                                sourceColors[index] || {};

                            const color =
                                colorInfo.customColor === true &&
                                    colorInfo.color
                                    ? colorInfo.color
                                    : CHART_COLORS[
                                    index %
                                    CHART_COLORS.length
                                    ];

                            return {
                                name: label,

                                y:
                                    Number(
                                        values[index] || 0
                                    ),

                                color: color
                            };

                        })
                }];
            }

            /* =========================================================
               Build Chart Series
            ========================================================= */

            function buildSeries(
                sourceSeries,
                labels,
                chartType
            ) {

                if (chartType === 'pie') {

                    const first =
                        sourceSeries[0] || {};

                    const values =
                        Array.isArray(first.values)
                            ? first.values
                            : [];

                    const sliceColors =
                        Array.isArray(first.colors)
                            ? first.colors
                            : [];


                    return [{

                        name:
                            first.name ||
                            'مقدار',

                        data:
                            labels.map(function (label, index) {

                                const slice =
                                    sliceColors[index] || {};

                                const color =
                                    slice.customColor &&
                                        slice.color
                                        ? slice.color
                                        : CHART_COLORS[
                                        index %
                                        CHART_COLORS.length
                                        ];


                                return {

                                    name:
                                        label,

                                    y:
                                        Number(
                                            values[index] || 0
                                        ),

                                    color:
                                        color

                                };

                            })

                    }];

                }


                return sourceSeries.map(
                    function (item, index) {

                        const values =
                            Array.isArray(item.values)
                                ? item.values
                                : [];


                        const custom =
                            item.customColor === true &&
                            item.color;


                        return {

                            name:
                                item.name ||
                                ('سری ' + (index + 1)),

                            color:
                                custom
                                    ? item.color
                                    : CHART_COLORS[
                                    index %
                                    CHART_COLORS.length
                                    ],

                            data:
                                labels.map(
                                    function (_, i) {

                                        return Number(
                                            values[i] || 0
                                        );

                                    }
                                )

                        };

                    }
                );

            }


            /* =========================================================
               Helpers
            ========================================================= */

            function clamp(value, min, max) {

                return Math.max(
                    min,
                    Math.min(max, value)
                );

            }


            function escapeHtml(value) {

                return String(
                    value == null
                        ? ''
                        : value
                )
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');

            }

        })();
    </script>

</body>
</html>

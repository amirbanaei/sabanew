            #MyModalAG.edit-mode #Marahel .timeline-item:hover {
                background: rgba(255, 255, 255, .035);
            }
        /* ========================================================= */
        /* 04. TIMELINE                                              */
        /* ========================================================= */

        .meeting-timeline-wrapper {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }


        .meeting-timeline {
            flex: 1;
            min-height: 0;
            width: 100%;
            display: flex;
            flex-direction: column;
            direction: ltr;
            padding: 1rem .65rem .65rem .75rem;
            position: relative;
            box-sizing: border-box;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(0, 255, 255, .15) transparent;
        }


            .meeting-timeline::-webkit-scrollbar {
                width: 3px;
            }


            .meeting-timeline::-webkit-scrollbar-track {
                background: transparent;
            }


            .meeting-timeline::-webkit-scrollbar-thumb {
                background: rgba(0, 255, 255, .16);
                border-radius: 10px;
            }


                .meeting-timeline::-webkit-scrollbar-thumb:hover {
                    background: rgba(0, 255, 255, .3);
                }



        /* ========================================================= */
        /* TIMELINE ITEM                                             */
        /* ========================================================= */

        .timeline-item {
            min-height: 3.15rem;
            display: flex;
            align-items: flex-start;
            position: relative;
            isolation: isolate;
            box-sizing: border-box;
        }


        .timeline-icon {
            width: 2.05rem;
            height: 2.05rem;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 3;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 50%;
            background: linear-gradient( 145deg, rgba(255, 255, 255, .10), rgba(255, 255, 255, .025) );
            backdrop-filter: blur(1rem) saturate(160%);
            -webkit-backdrop-filter: blur(1rem) saturate(160%);
            color: rgba(255, 255, 255, .3);
            font-size: .64rem;
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, .15), inset 0 -1px 1px rgba(0, 0, 0, .15);
            transition: all .35s cubic-bezier(.22, .61, .36, 1);
        }


            .timeline-icon::before {
                content: "";
                position: absolute;
                inset: 3px;
                border: 1px solid rgba(255, 255, 255, .05);
                border-radius: inherit;
                pointer-events: none;
            }


            .timeline-icon i {
                position: relative;
                z-index: 2;
                font-size: .75rem;
            }



        /* ========================================================= */
        /* TIMELINE CONNECTOR                                        */
        /* ========================================================= */

        .timeline-item:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 2.05rem;
            left: .975rem;
            width: 1px;
            height: 1.1rem;
            z-index: 1;
            background: linear-gradient( 180deg, rgba(255, 255, 255, .18), rgba(255, 255, 255, .04) );
            box-shadow: 0 0 5px rgba(255, 255, 255, .04);
        }



        /* ========================================================= */
        /* TIMELINE CONTENT                                          */
        /* ========================================================= */

        .timeline-content {
            flex: 1;
            min-width: 0;
            padding-top: .03rem;
            padding-left: .75rem;
            padding-right: 0;
            position: relative;
            direction: rtl;
            text-align: left;
        }


        .timeline-title {
            font-size: .69rem;
            font-weight: 500;
            line-height: 1.55;
            color: rgba(255, 255, 255, .48);
            transition: all .3s ease;
        }


        .timeline-description {
            margin-top: .08rem;
            font-size: .59rem;
            line-height: 1.55;
            color: rgba(255, 255, 255, .25);
            transition: all .3s ease;
        }



        /* ========================================================= */
        /* TIMELINE - COMPLETED                                     */
        /* ========================================================= */

        .timeline-item.completed .timeline-icon {
            background: linear-gradient( 145deg, rgba(50, 213, 131, .16), rgba(50, 213, 131, .035) );
            border-color: rgba(50, 213, 131, .55);
            color: #32d583;
            box-shadow: 0 0 6px rgba(50, 213, 131, .25), 0 0 16px rgba(50, 213, 131, .12), inset 0 0 10px rgba(50, 213, 131, .08);
        }


            .timeline-item.completed .timeline-icon::after {
                content: "";
                position: absolute;
                inset: -4px;
                border: 1px solid rgba(50, 213, 131, .08);
                border-radius: 50%;
                box-shadow: 0 0 10px rgba(50, 213, 131, .12);
                pointer-events: none;
            }


        .timeline-item.completed .timeline-title {
            color: rgba(255, 255, 255, .72);
        }


        .timeline-item.completed .timeline-description {
            color: rgba(255, 255, 255, .38);
        }


        .timeline-item.completed:not(:last-child)::after {
            background: linear-gradient( 180deg, rgba(50, 213, 131, .5), rgba(50, 213, 131, .08) );
            box-shadow: 0 0 7px rgba(50, 213, 131, .15);
        }



        /* ========================================================= */
        /* TIMELINE - ACTIVE                                         */
        /* ========================================================= */

        .timeline-item.active .timeline-icon {
            background: linear-gradient( 145deg, rgba(0, 255, 255, .18), rgba(0, 255, 255, .035) );
            border-color: rgba(0, 255, 255, .7);
            color: #00ffff;
            box-shadow: 0 0 6px rgba(0, 255, 255, .35), 0 0 18px rgba(0, 255, 255, .18), 0 0 35px rgba(0, 255, 255, .08), inset 0 0 12px rgba(0, 255, 255, .1);
        }


            .timeline-item.active .timeline-icon::after {
                content: "";
                position: absolute;
                inset: -5px;
                border: 1px solid rgba(0, 255, 255, .15);
                border-radius: 50%;
                box-shadow: 0 0 12px rgba(0, 255, 255, .2), inset 0 0 8px rgba(0, 255, 255, .08);
                animation: timelinePulse 2.2s ease-in-out infinite;
                pointer-events: none;
            }


        .timeline-item.active .timeline-title {
            color: #00ffff;
            text-shadow: 0 0 8px rgba(0, 255, 255, .35);
        }


        .timeline-item.active .timeline-description {
            color: rgba(0, 255, 255, .55);
        }


        .timeline-item.active:not(:last-child)::after {
            background: linear-gradient( 180deg, rgba(0, 255, 255, .55), rgba(0, 255, 255, .08) );
            box-shadow: 0 0 7px rgba(0, 255, 255, .2);
        }



        /* ========================================================= */
        /* TIMELINE - PENDING                                        */
        /* ========================================================= */

        .timeline-item:not(.active):not(.completed) .timeline-icon {
            color: rgba(255, 255, 255, .24);
            background: linear-gradient( 145deg, rgba(255, 255, 255, .055), rgba(255, 255, 255, .015) );
        }



        /* ========================================================= */
        /* TIMELINE - HOVER                                          */
        /* ========================================================= */

        .timeline-item:hover .timeline-icon {
            transform: scale(1.06);
            border-color: rgba(0, 255, 255, .35);
            box-shadow: 0 0 10px rgba(0, 255, 255, .12), inset 0 0 10px rgba(0, 255, 255, .05);
        }


        .timeline-item:hover .timeline-title {
            color: rgba(255, 255, 255, .75);
        }




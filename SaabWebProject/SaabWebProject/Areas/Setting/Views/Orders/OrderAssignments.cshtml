    <!-- =====================================================
         TAB 3 - EXCEL COMPONENT IMPORT
         ===================================================== -->

    <div id="tabThree"
         class="main-tab-panel"
         style="display:none">

        <div class="glass-card">

            <div class="section-header">

                <div>

                    <h2>
                        ورود مؤلفه‌ها از Excel
                    </h2>

                    <p>
                        ابتدا نمونه فایل مؤلفه را دریافت کنید، مقادیر را در ستون اول قرار دهید و سپس همان فایل را بارگذاری نمایید.
                    </p>

                </div>

            </div>


            <div class="excel-component-grid">

                @foreach (var component in excelComponents)
                {
                    var activeBatch =
                        excelImportBatches
                        .Where(x =>
                            x.ComponentType == component.Key
                            &&
                            x.IsActive == true)
                        .OrderByDescending(x =>
                            x.ID)
                        .FirstOrDefault();


                    <form class="excel-component-card component-upload-form"
                          enctype="multipart/form-data"
                          data-component-type="@component.Key"
                          data-component-title="@component.Value">

                        @Html.AntiForgeryToken()


                        <div class="excel-component-head">

                            <h3 class="excel-component-title">
                                @component.Value
                            </h3>

                            <span class="excel-component-number">
                                @component.Key
                            </span>

                        </div>


                        <div class="excel-component-description">
                            فایل باید فقط یک ستون با عنوان دقیق «@component.Value» داشته باشد. ردیف‌های خالی و مقادیر تکراری نادیده گرفته می‌شوند.
                        </div>


                        <div class="excel-file-picker">

                            <input type="file"
                                   id="componentExcel_@component.Key"
                                   name="excelFile"
                                   class="component-excel-file"
                                   accept=".xlsx,.xls" />

                            <label class="excel-file-label"
                                   for="componentExcel_@component.Key">
                                انتخاب فایل
                            </label>

                            <span class="excel-selected-file">
                                فایلی انتخاب نشده است
                            </span>

                        </div>


                        <div class="excel-component-actions">

                            <a class="excel-action-link"
                               href="@Url.Action("DownloadOrderComponentTemplate", "Orders", new { area = "Setting", componentType = component.Key })">
                                دریافت نمونه Excel
                            </a>

                            <button type="submit"
                                    class="excel-upload-button">
                                بارگذاری و ذخیره
                            </button>

                            @if (activeBatch != null)
                            {
                                <button type="button"
                                        class="excel-disable-button disable-component-import"
                                        data-id="@activeBatch.ID">
                                    غیرفعال‌سازی فایل فعلی
                                </button>
                            }

                        </div>


                        @if (activeBatch != null)
                        {
                            <div class="excel-active-batch">
                                <strong>فایل فعال:</strong>
                                @(activeBatch.OriginalFileName ?? "-")
                                <br />
                                <strong>تعداد مقادیر:</strong>
                                @activeBatch.RowCount
                            </div>
                        }


                        <div class="excel-result"></div>

                    </form>
                }

            </div>

        </div>

    </div>
</div>


<!-- =========================================================
     jQuery

     اگر در _Layout.cshtml از قبل jQuery لود شده است،
     این خط را حذف کنید.
     ========================================================= -->

<script src="~/Scripts/jquery-3.3.1.js"
        type="text/javascript"></script>


<script>

$(document).ready(function () {


    /* =====================================================
       IMPORTANT

       برای Guide هیچ JavaScript اینجا وجود ندارد.
       Guide توسط <dialog> خود مرورگر کنترل می‌شود.
       ===================================================== */


    var DEFAULT_ASSIGNMENT_TITLE = "تعیین نقش";
    var DEFAULT_ASSIGNMENT_DESCRIPTION = "";


    /* =====================================================
       COMMON
       ===================================================== */

    function token(formSelector) {

        return $(
            formSelector +
            ' input[name="__RequestVerificationToken"]'
        ).val();

    }


    function message(text, type) {

        var box = $("#orderNotification");


        box
            .stop(true, true)
            .removeClass("success error")
            .addClass(type || "success")
            .text(text || "")
            .fadeIn(150);


        clearTimeout(
            window.orderMessageTimer
        );


        window.orderMessageTimer =
            setTimeout(
                function () {

                    box.fadeOut(200);

                },
                3500
            );

    }


    function loading(show) {

        $("#pageLoadingOverlay")
            .toggleClass(
                "show",
                !!show
            );

    }


    function htmlEncode(value) {

        return $("<div>")
            .text(
                value == null
                ?
                ""
                :
                value
            )
            .html();

    }


    /* =====================================================
       TABS
       ===================================================== */

    $(".main-tab-button").on(
        "click",
        function () {

            var target =
                $(this).data("tab");


            $(".main-tab-button")
                .removeClass("active");


            $(this)
                .addClass("active");


            $(".main-tab-panel")
                .hide();


            $("#" + target)
                .show();


            sessionStorage.setItem(
                "OrderAssignmentActiveTab",
                target
            );
        }
    );


    /* =====================================================
       RESTORE LAST TAB
       ===================================================== */

    var savedTab =
        sessionStorage.getItem(
            "OrderAssignmentActiveTab"
        );


    if (
        savedTab
        &&
        $("#" + savedTab).length
        &&
        $('.main-tab-button[data-tab="' + savedTab + '"]').length
    ) {

        $('.main-tab-button[data-tab="' + savedTab + '"]')
            .trigger("click");
    }

    /* =====================================================
       TAB 1 MASTER CHECKBOX
       ===================================================== */

    function updateAssignmentMasters() {

        $(".column-select-all")
            .each(
                function () {

                    var master =
                        $(this);


                    var activityId =
                        master.data(
                            "activity"
                        );


                    var items =
                        $(
                            '.user-activity-check[data-activity="' +
                            activityId +
                            '"]'
                        );


                    var checked =
                        items
                        .filter(":checked")
                        .length;


                    if (
                        items.length > 0
                        &&
                        checked === items.length
                    ) {

                        master
                            .prop(
                                "checked",
                                true
                            )
                            .prop(
                                "indeterminate",
                                false
                            );

                    }
                    else if (
                        checked > 0
                    ) {

                        master
                            .prop(
                                "checked",
                                false
                            )
                            .prop(
                                "indeterminate",
                                true
                            );

                    }
                    else {

                        master
                            .prop(
                                "checked",
                                false
                            )
                            .prop(
                                "indeterminate",
                                false
                            );

                    }

                }
            );
    }


    $(".column-select-all").on(
        "change",
        function () {

            var activity =
                $(this).data(
                    "activity"
                );


            var checked =
                $(this).is(
                    ":checked"
                );


            $(
                '.user-activity-check[data-activity="' +
                activity +
                '"]'
            )
            .prop(
                "checked",
                checked
            );


            updateAssignmentMasters();

        }
    );


    $(document).on(
        "change",
        ".user-activity-check",
        function () {

            updateAssignmentMasters();

        }
    );


    /* =====================================================
       TAB 1 USER SEARCH
       ===================================================== */

    $("#matrixUserSearch").on(
        "input",
        function () {

            var q =
                $.trim(
                    $(this).val()
                )
                .toLowerCase();


            $("#assignmentMatrix .user-activity-row")
                .each(
                    function () {

                        var text =
                            (
                                $(this)
                                .attr(
                                    "data-search"
                                )
                                ||
                                ""
                            )
                            .toLowerCase();


                        $(this).toggle(
                            !q
                            ||
                            text.indexOf(q) >= 0
                        );

                    }
                );

        }
    );


    /* =====================================================
       TAB 1 SUMMARY SEARCH
       ===================================================== */

    $(document).on(
        "input",
        ".summary-cell-search",
        function () {

            var cell =
                $(this)
                .closest(
                    ".summary-cell-box"
                );


            var query =
                $.trim(
                    $(this).val()
                )
                .toLowerCase();


            var visibleCount = 0;


            cell
                .find(
                    ".summary-person-item"
                )
                .each(
                    function () {

                        var item =
                            $(this);


                        var text =
                            (
                                item.attr(
                                    "data-search"
                                )
                                ||
                                ""
                            )
                            .toLowerCase();


                        var visible =
                            !query
                            ||
                            text.indexOf(
                                query
                            ) >= 0;


                        item.toggle(
                            visible
                        );


                        if (visible) {

                            visibleCount++;

                        }

                    }
                );


            var total =
                parseInt(
                    cell
                    .find(
                        ".summary-person-count"
                    )
                    .attr(
                        "data-total"
                    )
                    ||
                    "0"
                );


            cell
                .find(
                    ".summary-search-result-count"
                )
                .text(
                    query
                    ?
                    visibleCount +
                    " از " +
                    total
                    :
                    "همه"
                );


            cell
                .find(
                    ".summary-no-result"
                )
                .toggle(
                    !!query
                    &&
                    visibleCount === 0
                );


            cell
                .find(
                    ".summary-person-scroll"
                )
                .scrollTop(0);

        }
    );


    /* =====================================================
       TAB 1 URL
       ===================================================== */

    var assignmentUrls = {

        save:
            '@Url.Action("CreateOrderAssignment", "Orders", new { area = "Setting" })'

    };


    /* =====================================================
       TAB 1 SELECTED PAIRS
       ===================================================== */

    function selectedPairs() {

        var result = [];


        $(".user-activity-check:checked")
            .each(
                function () {

                    result.push(
                        $(this).data("user")
                        +
                        "_"
                        +
                        $(this).data("activity")
                    );

                }
            );


        return result;
    }


    /* =====================================================
       TAB 1 ALL MATRIX USERS

       همه کاربران ارسال می‌شوند؛ حتی کاربری که هیچ تیکی ندارد.
       به همین دلیل حالت کاملاً خالی نیز قابل ذخیره است.
       ===================================================== */

    function allMatrixUsers() {

        var map = {};


        $(".user-activity-check")
            .each(
                function () {

                    map[
                        $(this).data("user")
                    ] = true;

                }
            );


        return Object.keys(map);
    }


    var assignmentSaving = false;


    /* =====================================================
       TAB 1 SAVE / FAST UPSERT
       ===================================================== */

    $("#assignmentForm").on(
        "submit",
        function (e) {

            e.preventDefault();


            if (assignmentSaving) {

                return;

            }


            var allUserIds =
                allMatrixUsers();


            var pairs =
                selectedPairs();


            if (allUserIds.length === 0) {

                message(
                    "هیچ نیرویی برای ثبت وجود ندارد.",
                    "error"
                );

                return;

            }


            assignmentSaving = true;


            var $submitButton =
                $(this).find(":submit");


            $submitButton
                .prop(
                    "disabled",
                    true
                );


            loading(true);


            $.ajax({

                url:
                    assignmentUrls.save,

                type:
                    "POST",

                traditional:
                    true,

                data: {

                    __RequestVerificationToken:
                        token(
                            "#assignmentForm"
                        ),

                    Title:
                        DEFAULT_ASSIGNMENT_TITLE,

                    Description:
                        DEFAULT_ASSIGNMENT_DESCRIPTION,

                    UserIds:
                        allUserIds,

                    UserActivityPairs:
                        pairs
                },

                success:
                    function (r) {

                        if (
                            r
                            &&
                            r.success
                        ) {

                            message(
                                r.message,
                                "success"
                            );


                            sessionStorage.setItem(
                                "OrderAssignmentActiveTab",
                                "tabOne"
                            );


                            // بدون تأخیر اضافی، جدول خلاصه نیز تازه می‌شود.
                            window.location.reload();

                        }
                        else {

                            message(
                                r
                                &&
                                r.message
                                ?
                                r.message
                                :
                                "عملیات انجام نشد.",
                                "error"
                            );

                        }

                    },

                error:
                    function () {

                        message(
                            "خطا در ارتباط با سرور.",
                            "error"
                        );

                    },

                complete:
                    function () {

                        assignmentSaving = false;


                        $submitButton
                            .prop(
                                "disabled",
                                false
                            );


                        loading(false);

                    }

            });

        }
    );


    /* =====================================================
       TAB 1 CLEAR

    /* =====================================================
       TAB 2 URLS
       ===================================================== */

    var scopeUrls = {

        save:
            '@Url.Action("SaveAgentScope", "Orders", new { area = "Setting" })',

        get:
            '@Url.Action("GetAgentScope", "Orders", new { area = "Setting" })',

        details:
            '@Url.Action("GetAgentScopeDetails", "Orders", new { area = "Setting" })',

        remove:
            '@Url.Action("DeleteAgentScope", "Orders", new { area = "Setting" })'

    };


    /* =====================================================
       TAB 2 GET SELECTED VALUES
       ===================================================== */

    function scopeValues(
        selector
    ) {

        var result = [];


        $(
            selector +
            ":checked"
        )
        .each(
            function () {

                result.push(
                    parseInt(
                        $(this).val(),
                        10
                    )
                );

            }
        );


        return result;
    }


    /* =====================================================
       TAB 2 SAVE
       ===================================================== */

    $("#agentScopeForm").on(
        "submit",
        function (e) {

            e.preventDefault();


            var selectedUserIds =
                scopeValues(
                    ".scope-user-check"
                );


            var regions =
                scopeValues(
                    ".scope-region-check"
                );


            var days =
                scopeValues(
                    ".scope-workday-check"
                );


            if (
                selectedUserIds.length === 0
            ) {

                message(
                    "حداقل یک مامور انتخاب کنید.",
                    "error"
                );

                return;
            }


            if (
                regions.length === 0
            ) {

                message(
                    "حداقل یک منطقه انتخاب کنید.",
                    "error"
                );

                return;
            }


            if (
                days.length === 0
            ) {

                message(
                    "حداقل یک روزکار انتخاب کنید.",
                    "error"
                );

                return;
            }


            loading(true);


            $.ajax({

                url:
                    scopeUrls.save,

                type:
                    "POST",

                traditional:
                    true,

                data: {

                    __RequestVerificationToken:
                        token(
                            "#agentScopeForm"
                        ),

                    ID:
                        $("#ScopeID")
                        .val(),

                    UserIds:
                        selectedUserIds,

                    RegionIds:
                        regions,

                    WorkDays:
                        days
                },

                success:
                    function (r) {

                        if (
                            r
                            &&
                            r.success
                        ) {

                            message(
                                r.message,
                                "success"
                            );


                            sessionStorage.setItem(
                                "OrderAssignmentActiveTab",
                                "tabTwo"
                            );


                            setTimeout(
                                function () {

                                    location.reload();

                                },
                                450
                            );

                        }
                        else {

                            message(
                                r
                                &&
                                r.message
                                ?
                                r.message
                                :
                                "ثبت انجام نشد.",
                                "error"
                            );

                        }

                    },

                error:
                    function () {

                        message(
                            "خطا در ارتباط با سرور.",
                            "error"
                        );

                    },

                complete:
                    function () {

                        loading(false);

                    }

            });

        }
    );


    /* =====================================================
       TAB 2 EDIT
       ===================================================== */

    $(document).on(
        "click",
        ".edit-agent-scope",
        function () {

            var id =
                $(this).data("id");


            loading(true);


            $.ajax({

                url:
                    scopeUrls.get,

                type:
                    "GET",

                data:
                    {
                        id: id
                    },

                success:
                    function (r) {

                        if (
                            !r
                            ||
                            !r.success
                        ) {

                            message(
                                r
                                &&
                                r.message
                                ?
                                r.message
                                :
                                "اطلاعات دریافت نشد.",
                                "error"
                            );

                            return;
                        }


                        $("#ScopeID")
                            .val(
                                r.data.ID
                            );


                        $(".scope-user-check")
                            .prop(
                                "checked",
                                false
                            )
                            .prop(
                                "disabled",
                                true
                            );


                        $(
                            '.scope-user-check[value="' +
                            r.data.UserID +
                            '"]'
                        )
                        .prop(
                            "checked",
                            true
                        )
                        .prop(
                            "disabled",
                            false
                        );


                        $(".scope-region-check")
                            .prop(
                                "checked",
                                false
                            );


                        $.each(
                            r.data.Regions
                            ||
                            [],
                            function (
                                index,
                                value
                            ) {

                                $(
                                    '.scope-region-check[value="' +
                                    value +
                                    '"]'
                                )
                                .prop(
                                    "checked",
                                    true
                                );

                            }
                        );


                        $(".scope-workday-check")
                            .prop(
                                "checked",
                                false
                            );


                        $.each(
                            r.data.WorkDays
                            ||
                            [],
                            function (
                                index,
                                value
                            ) {

                                $(
                                    '.scope-workday-check[value="' +
                                    value +
                                    '"]'
                                )
                                .prop(
                                    "checked",
                                    true
                                );

                            }
                        );


                        $("#saveAgentScope")
                            .text(
                                "ذخیره تغییرات"
                            );


                        $("#cancelAgentScopeEdit")
                            .show();


                        $(".main-tab-button")
                            .removeClass(
                                "active"
                            );


                        $('.main-tab-button[data-tab="tabTwo"]')
                            .addClass(
                                "active"
                            );


                        $(".main-tab-panel")
                            .hide();


                        $("#tabTwo")
                            .show();


                        $("html,body")
                            .animate(
                                {
                                    scrollTop:
                                        $("#scopeFormCard")
                                        .offset()
                                        .top
                                        -
                                        30
                                },
                                250
                            );

                    },

                error:
                    function () {

                        message(
                            "خطا در دریافت اطلاعات.",
                            "error"
                        );

                    },

                complete:
                    function () {

                        loading(false);

                    }

            });

        }
    );


    /* =====================================================
       TAB 2 CANCEL EDIT
       ===================================================== */

    $("#cancelAgentScopeEdit").on(
        "click",
        function () {

            $("#ScopeID")
                .val("");


            $(".scope-user-check")
                .prop(
                    "disabled",
                    false
                )
                .prop(
                    "checked",
                    true
                );


            $(".scope-region-check")
                .prop(
                    "checked",
                    false
                );


            $(".scope-workday-check")
                .prop(
                    "checked",
                    false
                );


            $("#saveAgentScope")
                .text(
                    "ذخیره اطلاعات"
                );


            $(this)
                .hide();

        }
    );


    /* =====================================================
       TAB 2 CLEAR
       ===================================================== */

    $("#clearAgentScope").on(

    /* =====================================================
       TAB 2 DELETE
       ===================================================== */

    $(document).on(
        "click",
        ".delete-agent-scope",
        function () {

            var id =
                $(this).data("id");


            if (
                !confirm(
                    "آیا اطلاعات این مامور حذف شود؟"
                )
            ) {

                return;

            }


            loading(true);


            $.ajax({

                url:
                    scopeUrls.remove,

                type:
                    "POST",

                data: {

                    __RequestVerificationToken:
                        token(
                            "#agentScopeForm"
                        ),

                    id:
                        id
                },

                success:
                    function (r) {

                        if (
                            r
                            &&
                            r.success
                        ) {

                            message(
                                r.message,
                                "success"
                            );


                            sessionStorage.setItem(
                                "OrderAssignmentActiveTab",
                                "tabTwo"
                            );


                            setTimeout(
                                function () {

                                    location.reload();

                                },
                                400
                            );

                        }
                        else {

                            message(
                                r
                                &&
                                r.message
                                ?
                                r.message
                                :
                                "حذف انجام نشد.",
                                "error"
                            );

                        }

                    },

                error:
                    function () {

                        message(
                            "خطا در حذف اطلاعات.",
                            "error"
                        );

                    },

                complete:
                    function () {

                        loading(false);

                    }

            });

        }
    );


    /* =====================================================
       TAB 2 DETAILS
       ===================================================== */

    $(document).on(
        "click",
        ".details-agent-scope",
        function () {

            var id =
                $(this).data("id");


            loading(true);


            $.ajax({

                url:
                    scopeUrls.details,

                type:
                    "GET",

                data:
                    {
                        id: id
                    },

                success:
                    function (r) {

                        if (
                            !r
                            ||
                            !r.success
                        ) {

                            message(
                                r
                                &&
                                r.message
                                ?
                                r.message
                                :
                                "اطلاعات دریافت نشد.",
                                "error"
                            );

                            return;
                        }


                        var d =
                            r.data;


                        var regionsText =
                            (
                                d.Regions
                                ||
                                []
                            )
                            .join("، ");


                        var workDaysText =
                            (
                                d.WorkDays
                                ||
                                []
                            )
                            .join("، ");


                        var html = "";


                        html +=
                            "<div class='detail-row'>" +
                                "<div>نام مامور</div>" +
                                "<div>" +
                                    htmlEncode(
                                        d.FullName
                                    ) +
                                "</div>" +
                            "</div>";


                        html +=
                            "<div class='detail-row'>" +
                                "<div>کد ملی</div>" +
                                "<div>" +
                                    htmlEncode(
                                        d.NationalCode
                                    ) +
                                "</div>" +
                            "</div>";


                        html +=
                            "<div class='detail-row'>" +
                                "<div>مناطق</div>" +
                                "<div>" +
                                    htmlEncode(
                                        regionsText
                                    ) +
                                "</div>" +
                            "</div>";


                        html +=
                            "<div class='detail-row'>" +
                                "<div>روزکار</div>" +
                                "<div>" +
                                    htmlEncode(
                                        workDaysText
                                    ) +
                                "</div>" +
                            "</div>";


                        html +=
                            "<div class='detail-row'>" +
                                "<div>محدوده</div>" +
                                "<div>در حال بروزرسانی</div>" +
                            "</div>";


                        html +=
                            "<div class='detail-row'>" +
                                "<div>نوع تعرفه</div>" +
                                "<div>در حال بروزرسانی</div>" +
                            "</div>";


                        $("#scopeDetailsContent")
                            .html(
                                html
                            );


                        $("#scopeDetailsModal")
                            .addClass(
                                "show"
                            );

                    },

                error:
                    function () {

                        message(
                            "خطا در دریافت جزئیات.",
                            "error"
                        );

                    },

                complete:
                    function () {

                        loading(false);

                    }

            });

        }
    );


    /* =====================================================
       CLOSE DETAILS
       ===================================================== */

    $("#closeScopeDetails").on(
        "click",
        function () {

            $("#scopeDetailsModal")
                .removeClass(
                    "show"
                );

        }
    );


    $("#scopeDetailsModal").on(
        "click",
        function (e) {

            if (
                e.target === this
            ) {

                $(this)
                    .removeClass(
                        "show"
                    );

            }

        }
    );


    /* =====================================================
       TAB 2 SAVED TABLE SEARCH
       ===================================================== */

    $("#scopeSearch").on(
        "input",
        function () {

            var q =
                $.trim(
                    $(this).val()
                )
                .toLowerCase();


            $(".scope-data-row")
                .each(
                    function () {

                        var text =
                            (
                                $(this)
                                .attr(
                                    "data-name"
                                )
                                ||
                                ""
                            )
                            .toLowerCase();


                        $(this).toggle(
                            !q
                            ||
                            text.indexOf(q) >= 0
                        );

                    }
                );

        }
    );


    /* =====================================================
       TAB 3 URLS
       ===================================================== */

    var componentImportUrls = {

        upload:
            '@Url.Action("UploadOrderComponentExcel", "Orders", new { area = "Setting" })',

        disable:
            '@Url.Action("DisableOrderComponentImport", "Orders", new { area = "Setting" })'

    };


    /* =====================================================
       TAB 3 FILE NAME
       ===================================================== */

    $(document).on(
        "change",
        ".component-excel-file",
        function () {

            var fileName =
                this.files
                &&
                this.files.length
                ?
                this.files[0].name
                :
                "فایلی انتخاب نشده است";


            $(this)
                .closest(".excel-file-picker")
                .find(".excel-selected-file")
                .text(fileName);

        }
    );


    /* =====================================================
       TAB 3 UPLOAD
       ===================================================== */

    $(document).on(
        "submit",
        ".component-upload-form",
        function (e) {

            e.preventDefault();


            var form = this;
            var $form = $(form);
            var fileInput =
                $form.find(".component-excel-file")[0];
            var $result =
                $form.find(".excel-result");


            if (
                !fileInput
                ||
                !fileInput.files
                ||
                fileInput.files.length === 0
            ) {

                $result
                    .removeClass("success")
                    .addClass("error")
                    .text("ابتدا فایل Excel را انتخاب کنید.");

                return;
            }


            var formData =
                new FormData(form);


            formData.append(
                "componentType",
                $form.data("component-type")
            );


            var $button =
                $form.find(".excel-upload-button");


            $button.prop("disabled", true);
            loading(true);


            $.ajax({

                url:
                    componentImportUrls.upload,

                type:
                    "POST",

                data:
                    formData,

                processData:
                    false,

                contentType:
                    false,

                success:
                    function (r) {

                        if (r && r.success) {

                            $result
                                .removeClass("error")
                                .addClass("success")
                                .text(r.message);


                            message(
                                r.message,
                                "success"
                            );


                            sessionStorage.setItem(
                                "OrderAssignmentActiveTab",
                                "tabThree"
                            );


                            window.location.reload();
                        }
                        else {

                            var errorText =
                                r && r.message
                                ? r.message
                                : "بارگذاری فایل انجام نشد.";


                            if (
                                r
                                &&
                                r.errors
                                &&
                                r.errors.length
                            ) {

                                errorText +=
                                    " | "
                                    +
                                    r.errors.join(" | ");
                            }


                            $result
                                .removeClass("success")
                                .addClass("error")
                                .text(errorText);


                            message(
                                errorText,
                                "error"
                            );
                        }

                    },

                error:
                    function () {

                        var errorText =
                            "خطا در ارتباط با سرور هنگام بارگذاری فایل.";


                        $result
                            .removeClass("success")
                            .addClass("error")
                            .text(errorText);


                        message(
                            errorText,
                            "error"
                        );

                    },

                complete:
                    function () {

                        $button.prop("disabled", false);
                        loading(false);

                    }

            });

        }
    );


    /* =====================================================
       TAB 3 DISABLE ACTIVE FILE
       ===================================================== */

    $(document).on(
        "click",
        ".disable-component-import",
        function () {

            var $button =
                $(this);


            if (
                !confirm(
                    "آیا فایل فعال این مؤلفه غیرفعال شود؟"
                )
            ) {

                return;
            }


            $button.prop("disabled", true);
            loading(true);


            $.ajax({

                url:
                    componentImportUrls.disable,

                type:
                    "POST",

                data: {

                    __RequestVerificationToken:
                        $button
                        .closest(".component-upload-form")
                        .find('input[name="__RequestVerificationToken"]')
                        .val(),

                    id:
                        $button.data("id")
                },

                success:
                    function (r) {

                        if (r && r.success) {

                            message(
                                r.message,
                                "success"
                            );


                            sessionStorage.setItem(
                                "OrderAssignmentActiveTab",
                                "tabThree"
                            );


                            window.location.reload();
                        }
                        else {

                            message(
                                r && r.message
                                ? r.message
                                : "غیرفعال‌سازی انجام نشد.",
                                "error"
                            );

                            $button.prop("disabled", false);
                        }

                    },

                error:
                    function () {

                        message(
                            "خطا در ارتباط با سرور.",
                            "error"
                        );


                        $button.prop("disabled", false);

                    },

                complete:
                    function () {

                        loading(false);

                    }

            });

        }
    );

    /* =====================================================
       INITIAL
       ===================================================== */

    updateAssignmentMasters();


});

</script>
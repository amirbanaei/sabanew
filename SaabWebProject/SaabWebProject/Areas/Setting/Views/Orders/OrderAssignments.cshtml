                        پاک کردن

                    </button>


                    <button type="button"
                            id="cancelAgentScopeEdit"
                            class="order-btn btn-cancel"
                            style="display:none">

                        انصراف از ویرایش

                    </button>


                </div>


            </form>


        </div>


        <!-- =================================================
             TAB 2 SAVED
             ================================================= -->

        <div class="glass-card">


            <div class="section-header">


                <div>

                    <h2>

                        آخرین تنظیمات ذخیره‌شده ماموران

                    </h2>

                    <p>

                        ارجاعات بر اساس آخرین تنظیمات ذخیره‌شده انجام خواهد شد.

                    </p>

                </div>


                <div style="width:250px">

                    <input type="text"
                           id="scopeSearch"
                           class="order-input"
                           autocomplete="off"
                           placeholder="جستجوی مامور..." />

                </div>


            </div>


            <div class="matrix-wrapper">


                <table class="activity-matrix">


                    <thead>

                        <tr>

                            <th>
                                مامور
                            </th>

                            <th>
                                مناطق
                            </th>

                            <th>
                                روزکار
                            </th>

                            <th>

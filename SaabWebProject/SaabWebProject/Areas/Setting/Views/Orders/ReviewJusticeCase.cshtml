                <h3>📜 ثبت نتیجه رسیدگی</h3>
                <button type="button" class="jbp-modal-close" data-close-modal="verdictModal">×</button>
            </div>

            @if (verdictStatus == 2)
            {
                <div class="jbp-alert warn"><div class="grow">رای در مرحله امضای اعضاست؛ با ذخیره تغییرات، امضاهای قبلی بازنشانی و از اعضا خواسته می‌شود دوباره امضا کنند.</div></div>
            }

            <form id="verdictForm" enctype="multipart/form-data">
                <input type="hidden" name="caseId" value="@Model.CaseID" />

                <div class="jbp-field" style="margin-bottom:6px;">
                    <label>متن نتیجه رسیدگی *</label>
                    <textarea name="verdictText" class="jbp-control" rows="10">@(currentVerdict != null ? currentVerdict.VerdictText : "")</textarea>
                </div>

                @if (currentVerdictFiles.Any())

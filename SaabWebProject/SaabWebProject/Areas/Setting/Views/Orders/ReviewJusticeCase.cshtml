                    </div>
                </div>

                <div class="jbp-modal-foot">
                    <button type="button" class="jbp-btn" data-close-modal="meetingModal">انصراف</button>
                    <button type="submit" class="jbp-btn primary" id="btnMeeting">✓ ثبت و ارسال دعوت‌نامه</button>
                </div>
            </form>
        </div>
    </div>
}



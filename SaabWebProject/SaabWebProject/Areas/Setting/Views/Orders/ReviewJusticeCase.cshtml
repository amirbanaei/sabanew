@if (canManageMeeting)
{
    <div class="jbp-modal" id="meetingModal">
        <div class="jbp-modal-card" style="max-width:900px;">
            <div class="jbp-modal-head">
                <h3>📅 تنظیم جلسه رسیدگی</h3>
                <button type="button" class="jbp-modal-close" data-close-modal="meetingModal">×</button>
            </div>

            <form id="meetingForm">
                <input type="hidden" name="caseId" value="@Model.CaseID" />

                <div class="jbp-grid-3" style="grid-template-columns: 3fr 2fr;">
                    <div class="jbp-grid-2" style="align-content:start;">
                        <div class="jbp-field jbp-span-all">
                            <label>عنوان جلسه *</label>
                            <input type="text" name="title" class="jbp-control" maxlength="300"
                                   value="جلسه @(currentStage != null ? currentStage.Title : "رسیدگی") پرونده @Model.CaseNumber" />
                        </div>

                        <div class="jbp-field jbp-span-all">
                            <label>مفاد / دستور جلسه *</label>
                            <textarea name="agenda" class="jbp-control" rows="4" placeholder="موضوعات مورد بررسی، مستندات لازم، ..."></textarea>
                        </div>

                        <div class="jbp-field">
                            <label>نوع جلسه</label>
                            <select name="meetingType" id="meetingType" class="jbp-control">
                                <option value="1">حضوری</option>
                                <option value="2">ویدئوکال / آنلاین</option>
                                <option value="3">تلفنی</option>
                            </select>
                        </div>

                        <div class="jbp-field">
                            <label>تاریخ *</label>
                            <div><input type="text" name="meetingDatePersian" id="meetingDatePersian" class="jbp-control jbp-ltr" placeholder="انتخاب تاریخ" /></div>
                        </div>

                        <div class="jbp-field">
                            <label>ساعت *</label>
                            <input type="time" name="meetingTime" class="jbp-control" />
                        </div>

                        <div class="jbp-field" id="locationBox">
                            <label>محل جلسه</label>
                            <input type="text" name="location" class="jbp-control" />
                        </div>

                        <div class="jbp-field" id="onlineLinkBox" style="display:none;">
                            <label>لینک جلسه ویدئویی</label>
                            <input type="text" name="onlineLink" class="jbp-control jbp-ltr" placeholder="https://..." />
                        </div>

                        <div class="jbp-field">
                            <label>شماره تماس (برای جلسه / متقاضی تلفنی)</label>
                            <input type="text" name="contactPhone" class="jbp-control jbp-ltr" />
                        </div>

                        <div class="jbp-panel jbp-span-all" style="border-color:rgba(255,190,60,.25);">
                            <label class="jbp-check" style="margin-bottom:6px;">
                                <input type="checkbox" id="inviteApplicant" />
                                دعوت از خود متقاضی (@(applicant != null ? ((applicant.usr_Name ?? "") + " " + (applicant.usr_Family ?? "")).Trim() : "-"))
                            </label>
                            <div id="applicantModeBox" style="display:none;">
                                <select name="applicantAttendanceType" class="jbp-control">
                                    <option value="1">حضوری</option>
                                    <option value="2">ویدئوکال</option>
                                    <option value="3">تلفنی</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="jbp-panel" style="margin-bottom:5px;">
                            <label class="jbp-check">
                                <input type="checkbox" id="inviteMembers" checked />
                                دعوت از همه اعضای مرحله (@(instanceMembers.Count(x => !x.IsGuest && x.CanView)) نفر)
                            </label>
                        </div>

                        <div class="jbp-panel">
                            <div class="jbp-panel-title">➕ اعضای مهمان</div>
                            <input type="text" id="guestSearch" class="jbp-control" placeholder="جستجوی کاربر..." />
                            <div class="jbp-scroll-list" style="max-height:220px; margin-top:6px;">
                                @foreach (var u in users.Where(x => x.usr_ID != Model.FK_User && !instanceMembers.Any(m => m.FK_User == x.usr_ID && !m.IsGuest)))
                                {
                                    string fullName = ((u.usr_Name ?? "") + " " + (u.usr_Family ?? "")).Trim();
                                    string personnel = u.usr_Personal_ID.HasValue ? u.usr_Personal_ID.Value.ToString() : "";
                                    <label class="jbp-check guest-item" data-search="@(fullName + " " + personnel)">
                                        <input type="checkbox" name="guestUserIds" value="@u.usr_ID" />

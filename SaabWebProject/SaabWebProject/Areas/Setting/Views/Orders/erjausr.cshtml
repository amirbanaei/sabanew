    /* =====================================================
       TAB 1 LIFT RULE
       اگر «بالابری» انتخاب شد، «عادی» یا «دیماند» هم الزامی است
       ===================================================== */

    function isLiftRelatedActivity(activityId) {
        return !!liftActivityId
            && liftCompanionIds.length > 0
            && (activityId === liftActivityId || liftCompanionIds.indexOf(activityId) >= 0);
    }

    // آیا این ردیف «بالابری» دارد ولی «عادی» و «دیماند» ندارد؟
    function liftRowViolates($row) {

        if (!liftActivityId || !liftCompanionIds.length) { return false; }

        var hasLift = $row
            .find('.user-activity-check[data-activity="' + liftActivityId + '"]')
            .is(":checked");

        if (!hasLift) { return false; }

        var hasCompanion = false;

        $.each(liftCompanionIds, function (_, id) {
            if ($row.find('.user-activity-check[data-activity="' + id + '"]').is(":checked")) {
                hasCompanion = true;
                return false;
            }
        });

        return !hasCompanion;
    }

    function findLiftRuleViolations() {

        var bad = [];

        $("#assignmentMatrix .user-activity-row").each(function () {
            if (liftRowViolates($(this))) { bad.push($(this)); }
        });

        return bad;
    }

    // علامت خطا را برای همه ردیف‌ها به‌روز می‌کند و تعداد ردیف‌های دارای خطا را برمی‌گرداند
    function refreshLiftRowErrors() {

        var count = 0;

        $("#assignmentMatrix .user-activity-row").each(function () {

            var violates = liftRowViolates($(this));

            $(this).toggleClass("row-error", violates);

            if (violates) { count++; }
        });

        return count;
    }



                                                            </div>
                                                        }

                                                        <div class="summary-no-result">موردی پیدا نشد</div>

                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span style="color:#475569">-</span>
                                            }

                                        </div>
                                    </td>
                                }
                            </tr>
                        }

                        @if (row == 0)
                        {
                            <tr>
                                <td colspan="@(activityTypes.Count + 1)" style="padding:30px;color:#64748b">
                                    هنوز اطلاعاتی ثبت نشده است.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TAB 2  (هر منطقه ← روزکارهای مخصوص همان منطقه)
         پیش‌فرض: همه ماموران، مناطق، روزکارها و تعرفه‌ها تیک‌خورده
         ===================================================== -->

    <div id="tabTwo" class="main-tab-panel" style="display:none">

        <div class="glass-card" id="scopeFormCard">

            <div class="section-header">
                <div>
                    <h2 id="scopeFormTitle">تنظیمات ارجاع ماموران</h2>
                    <p>مامور را انتخاب کنید و برای هر @scopeRegionTitle، روزکارهای مخصوص همان @scopeRegionTitle را تعیین کنید. در حالت پیش‌فرض همه موارد تیک‌خورده است (بدون محدودیت).</p>
                </div>
            </div>

            <form id="agentScopeForm">

                @Html.AntiForgeryToken()

                <div class="scope-grid">

                    <!-- 1 USER -->
                    <div class="scope-card">
                        <div class="scope-card-title">نام مامور</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeUserSearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی نام یا کد ملی..." />
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllUsers" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            @foreach (var user in tab2Users)
                            {
                                var name = ((user.usr_Name ?? "") + " " + (user.usr_Family ?? "")).Trim();
                                var userAlreadySaved = savedScopeUserIds.Contains(user.usr_ID);

                                <label class="scope-item scope-user-option @(userAlreadySaved ? "scope-user-hidden scope-user-saved" : "")"
                                       data-search="@((name + " " + (user.usr_NationalCode ?? "")).ToLower())">
                                    <input type="checkbox" class="scope-user-check" value="@user.usr_ID" @(userAlreadySaved ? null : "checked") />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">@name</span>
                                </label>
                            }

                            <div id="scopeNoNewUsers" class="scope-empty-note">
                                همه ماموران قبلاً ثبت شده‌اند. برای تغییر، از دکمه «ویرایش» جدول پایین استفاده کنید.
                            </div>

                        </div>
                    </div>

                    <!-- 2 REGION -->
                    <div class="scope-card">
                        <div class="scope-card-title">کد @scopeRegionTitle</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeRegionSearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی @scopeRegionTitle..." />
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllRegions" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            @foreach (var region in allowedRegions)
                            {
                                <label class="scope-item scope-region-option" data-search="@region">
                                    <input type="checkbox" class="scope-region-check" value="@region" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">@scopeRegionTitle @region</span>
                                </label>
                            }

                        </div>
                    </div>

                    <!-- 3 WORK DAY -->
                    <div class="scope-card">
                        <div class="scope-card-title">روزکار</div>

                        <div class="scope-selector-search">
                            <input type="text" id="scopeWorkDaySearch" class="scope-selector-search-input"
                                   autocomplete="off" placeholder="جستجوی روزکار..." />
                        </div>

                        <div class="scope-selector-search workday-range-row">
                            <input type="number" id="workDayFrom" min="1" max="99"
                                   class="scope-selector-search-input" placeholder="از" />
                            <input type="number" id="workDayTo" min="1" max="99"
                                   class="scope-selector-search-input" placeholder="تا" />
                            <button type="button" id="applyWorkDayRange" class="scope-action">انتخاب بازه</button>
                        </div>

                        <div class="scope-card-body">

                            <label class="scope-item">
                                <input type="checkbox" id="scopeAllWorkDays" checked />
                                <span class="scope-check"></span>
                                <span class="scope-text">انتخاب همه</span>
                            </label>

                            <div class="workday-grid">

                                @for (int day = 1; day <= 99; day++)
                                {
                                    <label class="scope-item scope-workday-option" data-search="@day">
                                        <input type="checkbox" class="scope-workday-check" value="@day" checked />
                                        <span class="scope-check"></span>
                                        <span class="scope-text">@day</span>
                                    </label>
                                }

                            </div>

                        </div>
                    </div>

                    <!-- 4 + 5 : MAHDOODEH / TARIFF (کوچک، کنار هم) -->
                    <div class="scope-side-cards">

                        <div class="scope-card">
                            <div class="scope-card-title">@scopeAreaTitle (کد ناحیه)</div>

                            <div class="scope-card-body">

                                <label class="scope-item">
                                    <input type="checkbox" id="scopeAllAreas" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">انتخاب همه</span>
                                </label>

                                <div class="area-grid">

                                    @for (int area = AreaMin; area <= AreaMax; area++)
                                    {
                                        <label class="scope-item scope-area-option">
                                            <input type="checkbox" class="scope-area-check" value="@area" checked />
                                            <span class="scope-check"></span>
                                            <span class="scope-text">@area</span>
                                        </label>
                                    }

                                </div>

                            </div>
                        </div>

                        <div class="scope-card">
                            <div class="scope-card-title">نوع تعرفه</div>

                            <div class="scope-card-body">

                                <label class="scope-item">
                                    <input type="checkbox" id="scopeAllTariffs" checked />
                                    <span class="scope-check"></span>
                                    <span class="scope-text">انتخاب همه</span>
                                </label>

                                @foreach (var tariff in tariffTypes)
                                {
                                    <label class="scope-item scope-tariff-option">
                                        <input type="checkbox" class="scope-tariff-check" value="@tariff.ID" checked />
                                        <span class="scope-check"></span>
                                        <span class="scope-text">@tariff.Title</span>
                                    </label>
                                }

                            </div>
                        </div>

                    </div>

                </div>

                @* RULE BUILDER (فعلاً غیرفعال - برای فعال‌سازی مجدد این کامنت را بردارید)
                    <div class="rule-builder">
                        <button type="button" id="addScopeRule" class="order-btn btn-secondary">
                            + افزودن منطقه و روزکارهای انتخاب‌شده به لیست
                        </button>
                        <span class="rule-hint">
                            مثال: منطقه 16 و روزکار 22 تا 25 را انتخاب کنید ← افزودن ← سپس منطقه 17 و روزکار 27 تا 29 ← افزودن ← ذخیره.
                            اگر همه روزکارها تیک‌خورده باشند یعنی همه روزها.
                        </span>
                        <div id="scopeRuleList" class="rule-list"></div>
                    </div>
                *@

                <div class="form-actions">
                    <button type="submit" id="saveAgentScope" class="order-btn btn-main">ذخیره اطلاعات</button>
                    <button type="button" id="clearAgentScope" class="order-btn btn-secondary">پاک کردن</button>
                </div>

            </form>

        </div>


        <!-- TAB 2 SAVED -->

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>آخرین تنظیمات ذخیره‌شده ماموران</h2>
                    <p>ارجاعات بر اساس آخرین تنظیمات ذخیره‌شده انجام خواهد شد.</p>
                </div>

                <div style="width:250px">
                    <input type="text" id="scopeSearch" class="order-input"
                           autocomplete="off" placeholder="جستجوی مامور..." />
                </div>
            </div>

            <div class="matrix-wrapper">

                <table class="activity-matrix">

                    <thead>
                        <tr>
                            <th>مامور</th>
                            <th>@scopeRegionsTitle و روزکار</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var scope in agentScopes)
                        {
                            var person = tab2Users.FirstOrDefault(x => x.usr_ID == scope.UserID);

                            if (person == null) { continue; }

                            var name = ((person.usr_Name ?? "") + " " + (person.usr_Family ?? "")).Trim();

                            var scopeRegionList = agentScopeRegions
                                .Where(x => x.ScopeID == scope.ID)
                                .Select(x => x.RegionCode)
                                .Distinct()
                                .OrderBy(x => x)
                                .ToList();

                            var scopeDayRows = agentScopeWorkDays.Where(x => x.ScopeID == scope.ID).ToList();

                            var generalDays = scopeDayRows
                                .Where(x => !x.RegionCode.HasValue)
                                .Select(x => x.WorkDay)
                                .ToList();

                            var scopeTariffRows = agentScopeTariffs.Where(x => x.ScopeID == scope.ID).ToList();

                            var scopeAreaRows = agentScopeAreas.Where(x => x.ScopeID == scope.ID).ToList();

                            var generalAreas = scopeAreaRows
                                .Where(x => !x.RegionCode.HasValue)
                                .Select(x => x.AreaCode)
                                .Distinct()
                                .ToList();

                            // همه محدوده‌های مجاز یا خالی = بدون محدودیت
                            var generalAreasRestricted = generalAreas.Count > 0 && generalAreas.Count < AreaTotal;

                            // مناطق مجازی که هنوز برای این مامور ثبت نشده‌اند (برای دکمه «افزودن منطقه دیگر»)
                            var remainingRegions = allowedRegions.Except(scopeRegionList).ToList();

                            var generalTariffIds = scopeTariffRows
                                .Where(x => !x.RegionCode.HasValue)
                                .Select(x => x.TariffTypeID)
                                .Distinct()
                                .ToList();

                            var generalTariffTitles = tariffTypes
                                .Where(x => generalTariffIds.Contains(x.ID))
                                .Select(x => x.Title)
                                .ToList();

                            <tr class="scope-data-row"
                                data-name="@((name + " " + (person.usr_NationalCode ?? "")).ToLower())">

                                <td>
                                    <div class="person-info">
                                        <span class="person-avatar">
                                            @(string.IsNullOrWhiteSpace(name) ? "؟" : name.Substring(0, 1))
                                        </span>
                                        <div>
                                            <span class="person-name">@name</span>
                                            <span class="person-national">@(person.usr_NationalCode ?? "")</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="scope-rule-lines">

                                        @foreach (var r in scopeRegionList)
                                        {
                                            // هر منطقه چند «گروه» دارد؛ هر گروه روزکار + محدوده + تعرفه‌ی مستقل
                                            var regionGroupNos = scopeDayRows.Where(x => x.RegionCode == r).Select(x => x.GroupNo)
                                                .Concat(scopeTariffRows.Where(x => x.RegionCode == r).Select(x => x.GroupNo))
                                                .Concat(scopeAreaRows.Where(x => x.RegionCode == r).Select(x => x.GroupNo))
                                                .Distinct()
                                                .OrderBy(x => x)
                                                .ToList();

                                            var regionRestricted = regionGroupNos.Count > 0;

                                            if (regionGroupNos.Count == 0) { regionGroupNos.Add(1); }

                                            foreach (var g in regionGroupNos)
                                            {
                                                var rd = scopeDayRows
                                                    .Where(x => x.RegionCode == r && x.GroupNo == g)
                                                    .Select(x => x.WorkDay)
                                                    .Distinct()
                                                    .ToList();

                                                if (rd.Count == 0) { rd = generalDays; }

                                                var rt = scopeTariffRows
                                                    .Where(x => x.RegionCode == r && x.GroupNo == g)
                                                    .Select(x => x.TariffTypeID)
                                                    .Distinct()
                                                    .ToList();

                                                if (rt.Count == 0) { rt = generalTariffIds; }

                                                var rtTitles = tariffTypes
                                                    .Where(x => rt.Contains(x.ID))
                                                    .Select(x => x.Title)
                                                    .ToList();

                                                var ra = scopeAreaRows
                                                    .Where(x => x.RegionCode == r && x.GroupNo == g)
                                                    .Select(x => x.AreaCode)
                                                    .Distinct()
                                                    .ToList();

                                                if (ra.Count == 0) { ra = generalAreas; }

                                                var raRestricted = ra.Count > 0 && ra.Count < AreaTotal;

                                                var isLastGroup = g == regionGroupNos.Last();

                                                <div class="scope-rule-line">
                                                    <span class="scope-chip">@scopeRegionTitle @r</span>
                                                    @if (regionGroupNos.Count > 1)
                                                    {
                                                        <span class="scope-chip">گروه @g</span>
                                                    }
                                                    <span class="scope-rule-days">
                                                        @("روزکار: " + (rd.Count > 0 ? compressDays(rd) : allDaysText))
                                                        &nbsp;|&nbsp;
                                                        @("تعرفه: " + (rtTitles.Count > 0 ? string.Join("، ", rtTitles) : allTariffsText))
                                                        &nbsp;|&nbsp;
                                                        @(scopeAreaTitle + ": " + (raRestricted ? compressDays(ra) : allAreasText))
                                                    </span>
                                                    <button type="button" class="scope-action edit-scope-region"
                                                            data-user="@scope.UserID"
                                                            data-region="@r"
                                                            data-group="@g"
                                                            data-tariffs="@string.Join(",", rt)"
                                                            data-areas="@(raRestricted ? string.Join(",", ra.OrderBy(a => a)) : "")"
                                                            data-days="@string.Join(",", rd.OrderBy(d => d))">
                                                        ویرایش
                                                    </button>
                                                    @if (isLastGroup && regionRestricted)
                                                    {
                                                        <button type="button" class="scope-action add-scope-group"
                                                                data-user="@scope.UserID"
                                                                data-region="@r"
                                                                title="افزودن گروه جدید (روزکار و @scopeAreaTitle دیگر) برای @scopeRegionTitle @r">
                                                            + گروه
                                                        </button>
                                                    }
                                                    <button type="button" class="scope-action delete-scope-region"
                                                            data-id="@scope.ID"
                                                            data-region="@r"
                                                            data-group="@g">
                                                        حذف
                                                    </button>
                                                </div>
                                            }
                                        }

                                        @if (scopeRegionList.Count == 0 && (generalDays.Count > 0 || generalTariffIds.Count > 0 || generalAreasRestricted))
                                        {
                                            <div class="scope-rule-line">
                                                <span class="scope-chip">همه @scopeRegionsTitle</span>
                                                <span class="scope-rule-days">
                                                    @("روزکار: " + (generalDays.Count > 0 ? compressDays(generalDays) : allDaysText))
                                                    &nbsp;|&nbsp;
                                                    @("تعرفه: " + (generalTariffTitles.Count > 0 ? string.Join("، ", generalTariffTitles) : allTariffsText))
                                                    &nbsp;|&nbsp;
                                                    @(scopeAreaTitle + ": " + (generalAreasRestricted ? compressDays(generalAreas) : allAreasText))
                                                </span>
                                                <button type="button" class="scope-action edit-scope-region"
                                                        data-user="@scope.UserID"
                                                        data-region="0"
                                                        data-tariffs="@string.Join(",", generalTariffIds)"
                                                        data-areas="@(generalAreasRestricted ? string.Join(",", generalAreas.OrderBy(a => a)) : "")"
                                                        data-days="@string.Join(",", generalDays.OrderBy(d => d))">
                                                    ویرایش
                                                </button>
                                                <button type="button" class="scope-action delete-scope-region"
                                                        data-id="@scope.ID"
                                                        data-region="0"
                                                        data-group="0">
                                                    حذف
                                                </button>
                                            </div>
                                        }

                                        @* مامور بدون هیچ ردیف منطقه/قانون (داده قدیمی «بدون محدودیت»): ویرایش و حذف هم دارد *@
                                        @if (scopeRegionList.Count == 0 && generalDays.Count == 0 && generalTariffIds.Count == 0 && !generalAreasRestricted)
                                        {
                                            <div class="scope-rule-line">
                                                <span class="scope-chip">@scopeRegionTitle: @allRegionsText</span>
                                                <span class="scope-rule-days">
                                                    @("روزکار: " + allDaysText)
                                                    &nbsp;|&nbsp;
                                                    @("تعرفه: " + allTariffsText)
                                                    &nbsp;|&nbsp;
                                                    @(scopeAreaTitle + ": " + allAreasText)
                                                </span>
                                                <button type="button" class="scope-action edit-scope-region"
                                                        data-user="@scope.UserID"
                                                        data-region="0"
                                                        data-tariffs=""
                                                        data-areas=""
                                                        data-days="">
                                                    ویرایش
                                                </button>
                                                <button type="button" class="scope-action delete-scope-region"
                                                        data-id="@scope.ID"
                                                        data-region="0"
                                                        data-group="0">
                                                    حذف
                                                </button>
                                            </div>
                                        }

                                    </div>
                                </td>

                                <td>
                                    <div class="scope-actions">
                                        @if (scopeRegionList.Count > 0 && remainingRegions.Count > 0)
                                        {
                                            <button type="button" class="scope-action add-scope-region"
                                                    data-user="@scope.UserID"
                                                    data-registered="@string.Join(",", scopeRegionList)"
                                                    title="@scopeRegionsTitle ثبت‌نشده: @string.Join("، ", remainingRegions)">
                                                + افزودن @scopeRegionTitle دیگر
                                            </button>
                                        }
                                        <button type="button" class="scope-action details-agent-scope" data-id="@scope.ID">جزئیات</button>
                                        <button type="button" class="scope-action delete-agent-scope" data-id="@scope.ID">حذف کل مامور</button>
                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TAB 3 و TAB 4 - EXCEL COMPONENT IMPORT
         (بالابری = ListType 1 ، سخت وصول = ListType 2)
         ===================================================== -->

    @foreach (var list in excelLists)
    {
        <div id="@list.TabId" class="main-tab-panel" style="display:none">

            <div class="glass-card">

                <div class="section-header">
                    <div>
                        <h2>ورود مؤلفه‌ها از Excel - @list.Title</h2>
                        <p>ابتدا نمونه فایل مؤلفه را دریافت کنید، مقادیر را در ستون اول قرار دهید و سپس همان فایل را بارگذاری نمایید.</p>
                    </div>
                </div>

                <div class="excel-component-grid">

                    @foreach (var component in excelComponents)
                    {
                        /* مؤلفه در حال توسعه (روزکار / محدوده) */

                        if (developingExcelComponents.Contains(component.Key))
                        {
                            <div class="excel-component-card excel-card-disabled">

                                <div class="excel-component-head">
                                    <h3 class="excel-component-title">@component.Value</h3>
                                    <span class="excel-component-number">@component.Key</span>
                                </div>

                                <div class="excel-disabled-box">
                                    <div class="scope-disabled-badge">در حال توسعه</div>
                                    <div class="excel-disabled-text">
                                        بارگذاری فایل «@component.Value» به‌زودی فعال خواهد شد.
                                    </div>
                                </div>

                            </div>

                            continue;
                        }

                        /* مؤلفه فعال (شناسه قبض / پرونده) برای همین نوع لیست */

                        var activeBatch = excelImportBatches
                            .Where(x => x.ComponentType == component.Key
                                        && x.ListType == list.Type
                                        && x.IsActive == true)
                            .OrderByDescending(x => x.ID)
                            .FirstOrDefault();

                        <form class="excel-component-card component-upload-form"
                              enctype="multipart/form-data"
                              data-list-type="@list.Type"
                              data-component-type="@component.Key"
                              data-component-title="@component.Value">

                            @Html.AntiForgeryToken()

                            <div class="excel-component-head">
                                <h3 class="excel-component-title">@component.Value</h3>
                                <span class="excel-component-number">@component.Key</span>
                            </div>

                            <div class="excel-component-description">
                                فایل باید فقط یک ستون با عنوان دقیق «@component.Value» داشته باشد. ردیف‌های خالی و مقادیر تکراری نادیده گرفته می‌شوند.
                            </div>

                            <div class="excel-file-picker">
                                <input type="file" id="componentExcel_@(list.Type)_@component.Key" name="excelFile"
                                       class="component-excel-file" accept=".xlsx,.xls" />
                                <label class="excel-file-label" for="componentExcel_@(list.Type)_@component.Key">انتخاب فایل</label>
                                <span class="excel-selected-file">فایلی انتخاب نشده است</span>
                            </div>

                            <div class="excel-component-actions">

                                <a class="excel-action-link"
                                   href="@Url.Action("DownloadOrderComponentTemplate", "Orders", new { area = "Setting", componentType = component.Key })">
                                    دریافت نمونه Excel
                                </a>

                                <button type="submit" class="excel-upload-button">بارگذاری و ذخیره</button>

                                @if (activeBatch != null)
                                {
                                    <button type="button" class="excel-disable-button disable-component-import"
                                            data-id="@activeBatch.ID">
                                        غیرفعال‌سازی فایل فعلی
                                    </button>
                                }

                            </div>

                            @if (activeBatch != null)
                            {
                                <div class="excel-active-batch">
                                    <strong>فایل فعال:</strong>
                                    @(activeBatch.OriginalFileName ?? "-")
                                    <br />
                                    <strong>تعداد مقادیر:</strong>
                                    @activeBatch.RowCount
                                </div>
                            }

                            <div class="excel-result"></div>

                        </form>
                    }

                </div>

            </div>

        </div>
    }

</div>


<!-- اگر در _Layout.cshtml از قبل jQuery لود شده است، این خط را حذف کنید. -->
<script src="~/Scripts/jquery-3.3.1.js" type="text/javascript"></script>


<script>

$(document).ready(function () {

    var DEFAULT_ASSIGNMENT_TITLE = "تعیین نقش";
    var DEFAULT_ASSIGNMENT_DESCRIPTION = "";
    var scopeRegionLabel = "@scopeRegionTitle";
    var scopeRegionsLabel = "@scopeRegionsTitle";
    var scopeAreaLabel = "@scopeAreaTitle";
    var scopeAreasLabel = "@scopeAreasTitle";


    /* =====================================================
       COMMON
       ===================================================== */

    function token(formSelector) {
        return $(formSelector + ' input[name="__RequestVerificationToken"]').val();
    }


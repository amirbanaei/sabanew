        transform: translateY(-50%);
        z-index: 2;
        color: #22d3ee;
        pointer-events: none;
        font-size: 13px;
    }

    .user-column-search-input {
        width: 100%;
        height: 31px;
        padding: 5px 29px 5px 8px;
        color: #e0f2fe;
        outline: none;
        background: rgba(2,6,23,.82);
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 7px;
        font-size: 8px;
    }

        .user-column-search-input::placeholder {
            color: #64748b;
        }

        .user-column-search-input:focus {
            border-color: rgba(34,211,238,.70);
            box-shadow: 0 0 10px rgba(34,211,238,.08);
        }

    /* TAB 1 - خطای قانون بالابری */
    .user-activity-row.row-error td {
        background: rgba(244,63,94,.14) !important;
    }

    .user-activity-row.row-error .person-name {
        color: #fda4af;
    }

    /* PERSON */
    .person-cell {
        min-width: 240px;
        text-align: right !important;
    }

    .person-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .person-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        color: #7dd3fc;
        background: rgba(14,165,233,.15);
        border: 1px solid rgba(34,211,238,.15);
        border-radius: 8px;
    }

    .person-name {
        display: block;
        color: #e2e8f0;
        font-size: 10px;
        font-weight: 700;
    }

    .person-national {
        display: block;
        margin-top: 2px;
        color: #64748b;
        font-size: 8px;
    }

    /* CHECKBOX */
    .neon-check {
        position: relative;
        display: inline-flex;
        width: 22px;
        height: 22px;
        cursor: pointer;
    }

        .neon-check input {
            position: absolute;
            opacity: 0;
        }

        .neon-check span {
            position: absolute;
            inset: 0;
            background: rgba(2,6,23,.78);
            border: 1px solid rgba(148,163,184,.34);
            border-radius: 6px;
        }

        .neon-check input:checked + span {
            background: linear-gradient(135deg, #06b6d4, #4f46e5);
            border-color: #22d3ee;
            box-shadow: 0 0 10px rgba(34,211,238,.30);
        }

            .neon-check input:checked + span:after {
                content: "✓";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%,-53%);
                color: white;
                font-size: 13px;
                font-weight: 900;
            }

        .neon-check input:disabled + span {
            cursor: not-allowed;
            opacity: .28;
            filter: grayscale(1);
        }

    /* BUTTONS */
    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 14px;
    }

    .order-btn {
        padding: 8px 15px;
        color: #fff;
        cursor: pointer;
        border: 1px solid transparent;
        border-radius: 8px;
    }

    .btn-main {
        background: linear-gradient(135deg, #0891b2, #4f46e5);
    }

    .btn-secondary {
        background: rgba(71,85,105,.40);
        border-color: rgba(148,163,184,.14);
    }

    .btn-cancel {
        color: #fde68a;
        background: rgba(245,158,11,.09);
        border-color: rgba(245,158,11,.18);
    }

    .action-edit {
        padding: 6px 9px;
        color: #c4b5fd;
        cursor: pointer;
        background: rgba(2,6,23,.35);
        border: 1px solid rgba(139,92,246,.24);
        border-radius: 6px;
    }

    /* TAB 1 SUMMARY */
    .summary-cell-box {
        min-width: 155px;
        padding: 6px;
        background: rgba(2,6,23,.20);
        border: 1px solid rgba(148,163,184,.05);
        border-radius: 9px;
    }

    .summary-count-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
        margin-bottom: 5px;
    }

    .summary-person-count {
        padding: 3px 7px;
        color: #67e8f9;
        background: rgba(6,182,212,.08);
        border: 1px solid rgba(34,211,238,.14);
        border-radius: 20px;
        font-size: 8px;
    }

    .summary-search-result-count {
        color: #64748b;
        font-size: 7px;
    }

    .summary-search-box {
        position: relative;
        margin-bottom: 6px;
    }

    .summary-search-icon {
        position: absolute;
        top: 50%;
        right: 8px;
        transform: translateY(-50%);
        color: #22d3ee;
        pointer-events: none;
    }

    .summary-cell-search {
        width: 100%;
        height: 29px;
        padding: 5px 26px 5px 7px;
        color: #dbeafe;
        outline: none;
        background: rgba(2,6,23,.72);
        border: 1px solid rgba(34,211,238,.13);
        border-radius: 6px;
        font-size: 8px;
    }

        .summary-cell-search:focus {
            border-color: rgba(34,211,238,.55);
        }

    .summary-person-scroll {
        max-height: 92px;
        min-height: 30px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: rgba(34,211,238,.50) rgba(2,6,23,.20);
    }

    .summary-person-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .summary-person-item {
        padding: 5px 7px;
        text-align: right;
        color: #bae6fd;
        background: rgba(14,165,233,.07);
        border: 1px solid rgba(34,211,238,.08);
        border-radius: 6px;
        font-size: 8px;
    }

    .summary-no-result {
        display: none;
        padding: 14px 6px;
        text-align: center;
        color: #64748b;
        font-size: 8px;
    }

    /* TAB 2 GRID */
    .scope-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr)) 150px 170px;
        gap: 10px;
        align-items: stretch;
    }

    /* محدوده و نوع تعرفه: دو کارت کوچک در همان ردیف کارت‌های اصلی */
    .scope-side-cards {
        display: contents;
    }

        .scope-side-cards .scope-card {
            align-self: start;
            min-width: 0;
            min-height: 0;
        }

        .scope-side-cards .scope-card-title {
            padding: 8px 10px;
            font-size: 10px;
        }

        .scope-side-cards .scope-disabled-body {
            min-height: 0;
            padding: 8px;
        }

        .scope-side-cards .scope-disabled-box {
            padding: 10px 6px;
        }

        .scope-side-cards .scope-disabled-title {
            margin-top: 8px;
            font-size: 9px;
        }

    .scope-card {
        min-height: 340px;
        overflow: hidden;
        background: rgba(2,6,23,.66);
        border: 1px solid rgba(34,211,238,.17);
        border-radius: 12px;
    }

    .scope-card-title {
        padding: 11px 13px;
        color: #e0f2fe;
        border-bottom: 1px solid rgba(148,163,184,.08);
        font-size: 11px;
        font-weight: 800;
    }

    .scope-selector-search {
        padding: 8px 9px 0;
    }

    .scope-selector-search-input {
        width: 100%;
        height: 31px;
        padding: 6px 9px;
        color: #dbeafe;
        outline: none;
        background: rgba(2,6,23,.72);
        border: 1px solid rgba(34,211,238,.13);
        border-radius: 7px;
        font-size: 9px;
    }

        .scope-selector-search-input:focus {
            border-color: rgba(34,211,238,.55);
        }

    .scope-card-body {
        max-height: 270px;
        padding: 9px;
        overflow-y: auto;
    }

    .scope-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 34px;
        padding: 5px 8px;
        cursor: pointer;
    }

        .scope-item input {
            position: absolute;
            opacity: 0;
        }

    .scope-check {
        position: relative;
        width: 17px;
        height: 17px;
        flex-shrink: 0;
        background: rgba(2,6,23,.90);
        border: 1px solid rgba(148,163,184,.35);
        border-radius: 4px;
    }

    .scope-item input:checked + .scope-check {
        background: linear-gradient(135deg, #06b6d4, #2563eb);
        border-color: #22d3ee;
    }

        .scope-item input:checked + .scope-check:after {
            content: "✓";
            position: absolute;
            right: 3px;
            top: -1px;
            color: white;
        }

    /* حالت بینابین «انتخاب همه» (بعضی تیک‌خورده) */
    .scope-item input:indeterminate + .scope-check {
        background: rgba(34,211,238,.25);
        border-color: #22d3ee;
    }

        .scope-item input:indeterminate + .scope-check:after {
            content: "–";
            position: absolute;
            right: 4px;
            top: -2px;
            color: white;
        }

    .scope-item input:disabled + .scope-check {
        opacity: .35;
    }

    .scope-text {
        color: #cbd5e1;
        font-size: 10px;
    }

    .workday-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 2px;
    }

    /* محدوده (بازه مجاز قرارداد) */
    .area-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 2px;
    }

    /* ماموران ثبت‌شده در لیست بالا نمایش داده نمی‌شوند */
    .scope-user-hidden {
        display: none !important;
    }

    .scope-empty-note {
        display: none;
        padding: 10px 8px;
        color: #64748b;
        font-size: 9px;
        line-height: 1.9;
    }

    /* DISABLED CARDS */
    .scope-card-disabled {
        opacity: .70;
        pointer-events: none;
        border-style: dashed;
    }

    .scope-disabled-body {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 285px;
        padding: 15px;
    }

    .scope-disabled-box {
        width: 100%;
        padding: 18px 10px;
        text-align: center;
        background: rgba(2,6,23,.35);
        border: 1px dashed rgba(148,163,184,.15);
        border-radius: 10px;
    }

    .scope-disabled-badge {
        display: inline-block;
        padding: 6px 12px;
        color: #fbbf24;
        background: rgba(245,158,11,.08);
        border: 1px solid rgba(245,158,11,.16);
        border-radius: 20px;
        font-size: 9px;
    }

    .scope-disabled-title {
        margin-top: 12px;
        color: #cbd5e1;
        font-size: 10px;
    }

    /* TAB 2 - RULES (منطقه ← روزکار) */
    .workday-range-row {
        display: flex;
        gap: 6px;
        align-items: center;
    }

        .workday-range-row .scope-selector-search-input {
            width: 60px;
            flex: 1;
        }

    .rule-builder {
        margin-top: 14px;
    }

    .rule-hint {
        margin-right: 10px;
        color: #64748b;
        font-size: 10px;
    }

    .rule-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 10px;
    }

    .rule-row, .scope-rule-line {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 10px;
        background: rgba(14,165,233,.06);
        border: 1px solid rgba(34,211,238,.12);
        border-radius: 8px;
    }

    .rule-days, .scope-rule-days {
        flex: 1;
        color: #cbd5e1;
        font-size: 11px;
        text-align: right;
    }

    .rule-empty {
        color: #64748b;
        font-size: 10px;
        padding: 6px 2px;
    }

    .scope-rule-lines {
        display: flex;
        flex-direction: column;
        gap: 5px;
        max-height: 130px;
        overflow-y: auto;
    }

    /* TAB 2 - TARIFF */
    .scope-tariff-cell {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 4px;
    }

    .delete-scope-tariffs {
        color: #fda4af;
        border-color: rgba(244,63,94,.20);
    }

    /* TAB 2 TABLE */
    .scope-chip-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4px;
        max-height: 90px;
        overflow-y: auto;
    }

    .scope-chip {
        padding: 4px 7px;
        color: #bae6fd;
        background: rgba(14,165,233,.08);
        border-radius: 15px;
        font-size: 8px;
        white-space: nowrap;
    }

    .scope-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 4px;
    }

    .scope-action {
        padding: 6px 8px;
        color: #bae6fd;
        cursor: pointer;
        background: rgba(2,6,23,.40);
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 6px;
        font-size: 8px;
    }

    .delete-agent-scope, .delete-rule, .delete-scope-region {
        color: #fda4af;
        border-color: rgba(244,63,94,.20);
    }

    /* DETAILS MODAL */
    .scope-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999998;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(2,6,23,.80);
        backdrop-filter: blur(8px);
    }

        .scope-modal.show {
            display: flex;
        }

    .scope-modal-card {
        width: 600px;
        max-width: 95%;
        padding: 20px;
        color: #e2e8f0;
        background: #0f172a;
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 16px;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 110px 1fr;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid rgba(148,163,184,.07);
    }

    /* MESSAGE */
    #orderNotification {
        display: none;
        position: fixed;
        top: 18px;
        left: 50%;
        z-index: 999999999;
        transform: translateX(-50%);
        min-width: 330px;
        padding: 13px 20px;
        color: white;
        text-align: center;
        border-radius: 11px;
        box-shadow: 0 18px 50px rgba(0,0,0,.45);
    }

        #orderNotification.success {
            background: #047857;
        }

        #orderNotification.error {
            background: #b91c1c;
        }

    /* LOADING */
    #pageLoadingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999999998;
        align-items: center;
        justify-content: center;
        background: rgba(2,6,23,.76);
    }

        #pageLoadingOverlay.show {
            display: flex;
        }

    .loading-card {
        min-width: 260px;
        padding: 25px;
        color: white;
        text-align: center;
        background: #0f172a;
        border: 1px solid rgba(34,211,238,.18);
        border-radius: 15px;
    }

    /* TAB 3 - EXCEL IMPORT */
    .excel-component-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .excel-component-card {
        position: relative;
        padding: 20px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15,23,42,.94), rgba(2,6,23,.84));
        border: 1px solid rgba(34,211,238,.16);
        border-radius: 20px;
        box-shadow: 0 18px 46px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.04);
    }

        .excel-component-card::before {
            content: "";
            position: absolute;
            inset: 0 auto auto 0;
            width: 120px;
            height: 120px;
            pointer-events: none;
            background: radial-gradient(circle, rgba(34,211,238,.13), transparent 68%);
        }

    .excel-component-head {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
    }

    .excel-component-title {
        margin: 0;
        color: #f8fafc;
        font-size: 17px;
        font-weight: 900;
    }

    .excel-component-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        color: #67e8f9;
        font-weight: 900;
        background: rgba(8,145,178,.13);
        border: 1px solid rgba(34,211,238,.24);
        border-radius: 11px;
    }

    .excel-component-description {
        min-height: 42px;
        margin-bottom: 14px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.9;
    }

    .excel-file-picker {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 48px;
        padding: 8px 10px;
        margin-bottom: 12px;
        background: rgba(15,23,42,.72);
        border: 1px dashed rgba(148,163,184,.26);
        border-radius: 14px;
    }

        .excel-file-picker input[type="file"] {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

    .excel-file-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 6px 12px;
        cursor: pointer;
        color: #e0f2fe;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
        background: rgba(14,165,233,.15);
        border: 1px solid rgba(56,189,248,.24);
        border-radius: 10px;
    }

    .excel-selected-file {
        min-width: 0;
        overflow: hidden;
        color: #94a3b8;
        font-size: 12px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .excel-component-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .excel-action-link, .excel-upload-button, .excel-disable-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 8px 13px;
        cursor: pointer;
        text-decoration: none;
        font-family: inherit;
        font-size: 12px;
        font-weight: 900;
        border-radius: 11px;
        transition: .18s ease;
    }

    .excel-action-link {
        color: #bfdbfe;
        background: rgba(37,99,235,.14);
        border: 1px solid rgba(96,165,250,.24);
    }

    .excel-upload-button {
        color: #052e16;
        background: linear-gradient(135deg, #34d399, #22d3ee);
        border: 0;
    }

    .excel-disable-button {
        color: #fecdd3;
        background: rgba(225,29,72,.12);
        border: 1px solid rgba(251,113,133,.24);
    }

        .excel-upload-button:disabled, .excel-disable-button:disabled {
            cursor: not-allowed;
            opacity: .55;
        }

    .excel-active-batch {
        margin-top: 14px;
        padding: 12px;
        color: #cbd5e1;
        font-size: 12px;
        line-height: 1.9;
        background: rgba(16,185,129,.07);
        border: 1px solid rgba(52,211,153,.16);
        border-radius: 13px;
    }

        .excel-active-batch strong {
            color: #6ee7b7;
        }

    .excel-result {
        display: none;
        margin-top: 12px;
        padding: 10px 12px;
        font-size: 12px;
        line-height: 1.9;
        border-radius: 12px;
    }

        .excel-result.success {
            display: block;
            color: #a7f3d0;
            background: rgba(16,185,129,.09);
            border: 1px solid rgba(52,211,153,.18);
        }

        .excel-result.error {
            display: block;
            color: #fecdd3;
            background: rgba(225,29,72,.09);
            border: 1px solid rgba(251,113,133,.18);
        }

    /* TAB 3 - در حال توسعه */
    .excel-component-card.excel-card-disabled {
        opacity: .70;
        border-style: dashed;
        border-color: rgba(148,163,184,.22);
    }

        .excel-component-card.excel-card-disabled::before {
            background: radial-gradient(circle, rgba(245,158,11,.10), transparent 68%);
        }

        .excel-component-card.excel-card-disabled .excel-component-number {
            color: #fbbf24;
            background: rgba(245,158,11,.08);
            border-color: rgba(245,158,11,.20);
        }

    .excel-disabled-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 150px;
        padding: 18px 12px;
        text-align: center;
        background: rgba(2,6,23,.35);
        border: 1px dashed rgba(148,163,184,.15);
        border-radius: 14px;
    }

    .excel-disabled-text {
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.9;
    }

    /* RESPONSIVE */
    /* هر ۵ کارت تب ۲ تا عرض ۹۰۰ پیکسل در یک ردیف می‌مانند */
    @@media(max-width:900px) {
        .scope-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .order-stats {
            grid-template-columns: repeat(2,1fr);
        }

        .excel-component-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width:650px) {
        .order-page {
            padding: 10px;
        }

        .scope-grid, .order-stats {
            grid-template-columns: 1fr;
        }

        .order-tabs {
            flex-direction: column;
        }

        .order-tab {
            width: 100%;
        }

        .guide-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .guide-main-btn {
            width: 100%;
        }

        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .oa-native-guide {
            width: calc(100% - 16px);
        }

        .oa-native-guide-card {
            padding: 15px;
        }

        .oa-native-guide-title {
            font-size: 14px;
        }

        .oa-native-guide-item {
            padding: 11px;
        }

        .oa-native-guide-text {
            font-size: 10px;
        }
    }

    /* Scoped upload tab: glass surface and cyan accents. */
    #tabUpload .bu-glass {
        position: relative;
        overflow: hidden;
        padding: 26px;

        // SEARCH
        // =====================================================

        searchInput.addEventListener(
            "keyup",
            function () {

                var value =
                    this.value
                        .trim()
                        .toLowerCase();


                nodes.forEach(
                    function (node) {

                        node.classList.remove(
                            "search-found"
                        );

                    }
                );


                if (!value) {

                    clearBranchFocusImmediate();

                    return;
                }


                var found =
                    null;


                for (
                    var i = 0;
                    i < nodes.length;
                    i++
                ) {

                    var node =
                        nodes[i];


                    var searchText =
                        (
                            (
                                node.getAttribute(
                                    "data-name"
                                )
                                || ""
                            )
                            +
                            " "
                            +
                            (
                                node.getAttribute(
                                    "data-job"
                                )
                                || ""
                            )
                            +
                            " "
                            +
                            (
                                node.getAttribute(
                                    "data-unit"
                                )
                                || ""
                            )
                        )
                        .toLowerCase();


                    if (
                        searchText.indexOf(
                            value
                        ) !== -1
                    ) {

                        found =
                            node;

                        break;
                    }
                }


                if (found) {

                    found.classList.add(
                        "search-found"
                    );


                    activateBranch(
                        found
                    );


                    var nodeRect =
                        found.getBoundingClientRect();


                    var wrapperRect =
                        chartWrapper.getBoundingClientRect();


                    var desiredTop =
                        chartWrapper.scrollTop
                        +
                        (
                            nodeRect.top -
                            wrapperRect.top
                        )
                        -
                        (
                            chartWrapper.clientHeight /
                            2
                        )
                        +
                        (
                            nodeRect.height /
                            2
                        );


                    chartWrapper.scrollTo({

                        top:
                            Math.max(
                                0,
                                desiredTop
                            ),

                        behavior:
                            "smooth"

                    });
                }

            }
        );



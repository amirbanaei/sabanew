        function loadOrganizationFormData(callback) {

            var parentSelect =
                document.getElementById(
                    "OrganizationParentId"
                );


            var managerSelect =
                document.getElementById(
                    "OrganizationManagerId"
                );


            fetch(
                '@Url.Action("GetOrganizationFormData", "AG", new { area = "Mdr" })'
            )
            .then(function (response) {

                if (!response.ok) {

                    throw new Error(
                        "خطا در ارتباط با سرور"
                    );
                }

                return response.json();

            })
            .then(function (result) {

                if (!result.success) {

                    console.error(
                        "GetOrganizationFormData:",
                        result.message
                    );

                    return;
                }


                parentSelect.innerHTML =
                    '<option value="">بدون واحد بالادستی</option>';


                result.units.forEach(
                    function (unit) {

                        var option =
                            document.createElement(
                                "option"
                            );

                        option.value =
                            unit.id;

                        option.textContent =
                            unit.text;

                        parentSelect.appendChild(
                            option
                        );

                    }
                );


                managerSelect.innerHTML =
                    '<option value="">انتخاب نشده</option>';


                result.users.forEach(
                    function (user) {

                        var option =
                            document.createElement(
                                "option"
                            );

                        option.value =
                            user.id;

                        option.textContent =
                            user.text;

                        managerSelect.appendChild(
                            option
                        );

                    }
                );
                if (
                    typeof callback ===
                    "function"
                ) {
                    callback();
                }

            })
            .catch(function (error) {

                console.error(
                    "MDR Organization Form Error:",
                    error
                );

            });
        }



                        managerUserId
                    );
                }


                if (sortOrder) {

                    formData.append(
                        "sortOrder",
                        sortOrder
                    );
                }


                var saveUrl =
                    modalMode === "edit"
                        ? '@Url.Action("UpdateOrganizationUnit", "AG", new { area = "Mdr" })'
                        : '@Url.Action("SaveOrganizationUnit", "AG", new { area = "Mdr" })';


                fetch(
                    saveUrl,
                    {
                        method: "POST",
                        body: formData
                    }
                )
                .then(function (response) {

                    if (!response.ok) {

                        throw new Error(
                            "خطا در ارتباط با سرور"
                        );
                    }

                    return response.json();

                })
                .then(function (result) {

                    if (!result.success) {

                        showAlert(
                            "error",
                            "عملیات ناموفق",
                            result.message
                        );

                        return;
                    }


                    showAlert(
                        "success",
                        "عملیات موفق",
                        result.message
                    );


                    closeOrganizationUnitModal();


                    console.log(
                        modalMode === "edit"

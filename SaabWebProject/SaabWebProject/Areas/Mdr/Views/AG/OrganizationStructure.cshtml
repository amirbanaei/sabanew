                    var selfOption =
                        parentSelect.querySelector(
                            'option[value="' +
                            organizationUnitId +
                            '"]'
                        );

                    if (selfOption) {
                        selfOption.remove();
                    }

                }
            );


            organizationModal.style.display =
                "flex";


            closeDrawer();
        }
        // =====================================================
        // MDR 1.3.4
        // EDIT UNIT
        // =====================================================

        document
            .getElementById(
                "btnEditUnit"
            )
            .addEventListener(
                "click",
                function () {

                    if (!selectedNode) {
                        return;
                    }

                    openEditOrganizationUnitModal(
                        selectedNode
                    );

                }
            );

        // =====================================================
        // MDR 1.3.5.1
        // OPEN ADD CHILD UNIT MODAL
        // =====================================================

        function openAddChildOrganizationUnitModal(
            node
        ) {

            if (!node) {
                return;
            }


            var parentId =
                node.getAttribute(
                    "data-id"
                );

            var parentName =
                node.getAttribute(
                    "data-unit"
                ) || "-";


            // -----------------------------------------
            // Modal در حالت افزودن
            // -----------------------------------------

            organizationModal.dataset.mode =
                "add";

            delete organizationModal.dataset.id;


            document
                .getElementById(
                    "organizationModalTitle"
                )
                .textContent =
                "افزودن زیرمجموعه";


            document
                .getElementById(
                    "organizationModalSubtitle"
                )
                .textContent =
                "افزودن واحد جدید زیرمجموعه «" +
                parentName +
                "»";


            // -----------------------------------------
            // پاک کردن اطلاعات فرم
            // -----------------------------------------

            document
                .getElementById(
                    "OrganizationUnitName"
                )
                .value = "";


            document
                .getElementById(
                    "OrganizationUnitType"
                )
                .value = "";


            document
                .getElementById(
                    "OrganizationManagerId"
                )
                .value = "";


            document
                .getElementById(
                    "OrganizationSortOrder"
                )
                .value = "";


            // -----------------------------------------
            // بارگذاری Dropdownها
            // سپس انتخاب خودکار Parent
            // -----------------------------------------

            loadOrganizationFormData(
                function () {

                    document
                        .getElementById(
                            "OrganizationParentId"
                        )
                        .value =
                        parentId;

                }
            );


            organizationModal.style.display =
                "flex";


            closeDrawer();


            setTimeout(
                function () {

                    document
                        .getElementById(
                            "OrganizationUnitName"
                        )
                        .focus();

                },
                100
            );
        }
        // =====================================================
        // MDR 1.3.5
        // ADD CHILD
        // =====================================================

        document
            .getElementById(
                "btnAddChild"
            )
            .addEventListener(
                "click",
                function () {

                    if (!selectedNode) {
                        return;
                    }


                    openAddChildOrganizationUnitModal(
                        selectedNode
                    );

                }
            );


        // =====================================================
        // MDR 1.3.4.1
        // DELETE UNIT
        // =====================================================

        document
            .getElementById(
                "btnDeleteUnit"
            )
            .addEventListener(
                "click",
                function () {

                    if (!selectedNode) {
                        return;
                    }


                    var btnDelete =
                        this;

                    var unitId =
                        btnDelete.getAttribute(
                            "data-id"
                        );

                    var unitName =
                        document
                            .getElementById(
                                "drawerUnit"
                            )
                            .innerText
                            .trim();


                    // -----------------------------------------
                    // تأیید حذف با Alert اختصاصی (هم‌سبک DashbordJalasat)
                    // -----------------------------------------

                    showAlert(
                        "warning",
                        "حذف واحد",
                        "آیا از حذف واحد «" + unitName + "» مطمئن هستید؟ این عملیات قابل بازگشت نیست.",
                        0
                    );


                    var confirmActions =
                        document.createElement("div");

                    confirmActions.className =
                        "cancel-alert-actions unit-delete-actions";

                    confirmActions.innerHTML =
                        '<button type="button" ' +
                        'class="global-alert-confirm action-confirm" ' +
                        'id="ConfirmDeleteUnit" ' +
                        'title="تأیید حذف">' +
                        '<i class="bi bi-check-lg"></i>' +
                        '</button>';

                    confirmActions
                        .querySelector("#ConfirmDeleteUnit")
                        .setAttribute(
                            "data-id",
                            unitId
                        );


                    document
                        .getElementById(
                            "GlobalAlertWarning"
                        )
                        .appendChild(
                            confirmActions
                        );

                }
            );


        // =====================================================
        // MDR 1.3.4.1
        // CONFIRM DELETE UNIT
        // =====================================================

        document.addEventListener(
            "click",
            function (event) {

                var confirmButton =
                    event.target.closest(
                        "#ConfirmDeleteUnit"
                    );

                if (!confirmButton) {
                    return;
                }


                event.preventDefault();


                var unitId =
                    confirmButton.getAttribute(
                        "data-id"
                    );

                var btnDelete =
                    document.getElementById(
                        "btnDeleteUnit"
                    );


                // بستن هشدار و حذف دکمه تأیید

                var warningAlert =
                    document.getElementById(
                        "GlobalAlertWarning"
                    );

                warningAlert.classList.remove(
                    "show"
                );

                warningAlert
                    .querySelectorAll(".cancel-alert-actions")
                    .forEach(function (actions) {
                        actions.remove();
                    });


                    var formData =
                        new FormData();

                    formData.append(
                        "organizationUnitId",
                        unitId
                    );


                    btnDelete.disabled =
                        true;


                    fetch(
                        '@Url.Action("DeleteOrganizationUnit", "AG", new { area = "Mdr" })',
                        {
                            method: "POST",
                            body: formData
                        }
                    )
                    .then(function (response) {

                        if (!response.ok) {

                            throw new Error(
                                "خطا در ارتباط با سرور"
                            );
                        }

                        return response.json();

                    })
                    .then(function (result) {

                        showAlert(
                            result.success ? "success" : "error",
                            result.success ? "عملیات موفق" : "عملیات ناموفق",
                            result.message
                        );


                        if (!result.success) {
                            return;
                        }


                        console.log(
                            "MDR Organization Unit Deleted:",
                            result.id
                        );


                        closeDrawer();

                        loadOrganizationChart();

                    })
                    .catch(function (error) {

                        console.error(
                            "MDR Delete Organization Error:",
                            error
                        );


                        showAlert(
                            "error",
                            "عملیات ناموفق",
                            "در حذف واحد سازمانی خطایی رخ داد."
                        );

                    })
                    .finally(function () {

                        btnDelete.disabled =
                            false;

                    });

                }
            );


        // =====================================================
        // RESPONSIVE FIT
        // =====================================================

        var resizeTimer =
            null;


        window.addEventListener(
            "resize",
            function () {

                clearTimeout(
                    resizeTimer
                );


                resizeTimer =
                    setTimeout(
                        function () {

                            fitTreeToScreen();

                        },
                        120
                    );

            }
        );


        // =====================================================
        // MDR 1.3.2
        // INITIAL LOAD
        // مهم: بعد از تعریف تمام توابع اجرا می‌شود
        // =====================================================

        loadOrganizationChart();

    }
);

</script>




</body>
</html>
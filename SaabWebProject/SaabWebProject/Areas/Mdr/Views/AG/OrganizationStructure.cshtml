                // =====================================================

                var modalMode =
                    organizationModal.dataset.mode ||
                    "add";

                var organizationUnitId =
                    organizationModal.dataset.id ||
                    "";

                var formData =
                    new FormData();
                if (
                    modalMode === "edit"
                ) {

                    formData.append(
                        "organizationUnitId",
                        organizationUnitId
                    );

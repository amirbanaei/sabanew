<script data-cfasync="false">

        // =========================================================
        // MDR — اعلان‌های سراسری (هم‌سبک DashbordJalasat)
        // =========================================================

        let globalAlertTimer = null;

        function showAlert(type, title, message, duration = 4000) {

            let alertBox = null;

            switch (type) {

                case "success":
                    alertBox = document.getElementById("GlobalAlertSuccess");
                    break;

                case "warning":
                    alertBox = document.getElementById("GlobalAlertWarning");
                    break;

                case "error":
                    alertBox = document.getElementById("GlobalAlertError");
                    break;
            }

            if (!alertBox) {
                console.error("Alert پیدا نشد:", type);
                return;
            }

            const titleElement =
                alertBox.querySelector(".global-alert-title");

            const messageElement =
                alertBox.querySelector(".global-alert-message");

            if (titleElement) {
                titleElement.textContent = title;
            }

            if (messageElement) {
                messageElement.textContent = message;
            }

            // حذف دکمه‌های تأیید قبلی (مثل تأیید حذف)
            document
                .querySelectorAll(".global-alert .cancel-alert-actions")
                .forEach(function (actions) {
                    actions.remove();
                });

            // بستن اعلان‌های قبلی
            document
                .querySelectorAll(".global-alert")
                .forEach(function (alert) {
                    alert.classList.remove("show");
                });

            // نمایش اعلان
            requestAnimationFrame(function () {
                alertBox.classList.add("show");
            });

            // حذف تایمر قبلی
            if (globalAlertTimer) {
                clearTimeout(globalAlertTimer);
            }

            // بستن خودکار
            if (duration > 0) {

                globalAlertTimer = setTimeout(function () {

                    alertBox.classList.remove("show");

                }, duration);
            }
        }


        // =========================================================
        // بستن دستی اعلان
        // =========================================================

        // بدون jQuery؛ چون این اسکریپت قبل از بارگذاری jQuery در Layout اجرا می‌شود
        document.addEventListener(
            "click",
            function (event) {

                var closeButton =
                    event.target.closest(
                        ".global-alert-close"
                    );

                if (!closeButton) {
                    return;
                }

                var alertBox =
                    closeButton.closest(".global-alert");

                alertBox.classList.remove("show");

                alertBox
                    .querySelectorAll(".cancel-alert-actions")
                    .forEach(function (actions) {
                        actions.remove();
                    });

            }
        );

</script>


<script data-cfasync="false">

document.addEventListener(
    "DOMContentLoaded",
    function () {

        // =====================================================
        // MDR — جلوگیری از اجرای دوباره
        // Rocket Loader رویداد DOMContentLoaded را یک بار دیگر
        // به‌صورت مصنوعی صدا می‌زند؛ این Guard اجرای دوم را رد می‌کند
        // =====================================================

        if (window.__mdrOrgInit) {
            return;
        }

        window.__mdrOrgInit = true;


        // =====================================================
        // MDR
        // Phase 1   : زیرساخت مشترک
        // Step 1.3  : ساختار سازمانی و واحدها
        // Part 1.3.2: چارت سازمانی واقعی
        // =====================================================

        console.log("MDR SCRIPT LOADED");


        // =====================================================
        // ELEMENTS
        // =====================================================

        var orgTree =
            document.getElementById("orgTree");

        var treeScale =
            document.getElementById("orgTreeScale");

        var treeViewport =
            document.getElementById("orgTreeViewport");

        var chartWrapper =
            document.getElementById("orgChartWrapper");

        var drawer =
            document.getElementById("orgDrawer");

        var overlay =
            document.getElementById("orgDrawerOverlay");

        var zoomValue =
            document.getElementById("zoomValue");

        var searchInput =
            document.getElementById("txtOrgSearch");

        var btnAddOrganizationUnit =
            document.getElementById(
                "btnAddOrganizationUnit"
            );

        var organizationModal =
            document.getElementById(
                "MyModalAG"
            );

        var btnCloseOrganizationModal =
            document.getElementById(
                "btnCloseOrganizationModal"
            );

        var btnCancelOrganizationUnit =
            document.getElementById(
                "btnCancelOrganizationUnit"
            );

        var btnSaveOrganizationUnit =
            document.getElementById(
                "btnSaveOrganizationUnit"
            );


        // =====================================================
        // متغیرهای Dynamic Tree
        // =====================================================

        var nodes = [];

        var allTreeItems = [];

        var selectedNode = null;

        var currentZoom = 1;

        var minZoom = .35;

        var maxZoom = 1.40;

        var zoomStep = .10;

        var returnTimer = null;


        // =====================================================
        // MDR 1.3.8
        // انتقال Drawer به Body
        // =====================================================

        if (
            overlay &&
            overlay.parentElement !== document.body
        ) {

            document.body.appendChild(
                overlay
            );
        }


        if (
            drawer &&
            drawer.parentElement !== document.body
        ) {

            document.body.appendChild(
                drawer
            );
        }


        // =====================================================
        // MDR - 1.3.2.1 / 1.3.2.2
        // دریافت اطلاعات واقعی چارت
        // =====================================================

        function loadOrganizationChart() {

            fetch(
                '@Url.Action("GetOrganizationChartData", "AG", new { area = "Mdr" })'
            )
            .then(function (response) {

                if (!response.ok) {

                    throw new Error(
                        "خطا در ارتباط با سرور"
                    );
                }

                return response.json();

            })
            .then(function (result) {

                if (!result.success) {

                    console.error(
                        "GetOrganizationChartData:",
                        result.message
                    );

                    return;
                }


                var treeData =
                    buildOrganizationTree(
                        result.units
                    );


                console.log(
                    "MDR Organization Tree:",
                    treeData
                );


                // -----------------------------------------
                // ساخت HTML واقعی Tree
                // -----------------------------------------

                renderOrganizationTree(
                    treeData
                );


                // -----------------------------------------
                // MDR 1.3.2.4
                // اتصال مجدد رفتارها به Nodeهای جدید
                // -----------------------------------------

                refreshOrganizationTreeBindings();


                // =====================================================
                // MDR 1.3.2.5
                // INITIAL CHART ZOOM = 100%
                // CENTER CHART ON LOAD
                // =====================================================

                setTimeout(
                    function () {

                        // -----------------------------------------
                        // نمایش اولیه همیشه 100 درصد
                        // -----------------------------------------

                        currentZoom = 1;

                        applyZoom();


                        // -----------------------------------------
                        // شروع از بالای نمودار
                        // -----------------------------------------

                        chartWrapper.scrollTop = 0;


                        // -----------------------------------------
                        // قرار دادن مرکز نمودار
                        // در مرکز Wrapper
                        // -----------------------------------------

                        var maxScrollLeft =
                            chartWrapper.scrollWidth -
                            chartWrapper.clientWidth;


                        if (maxScrollLeft > 0) {

                            chartWrapper.scrollLeft =
                                maxScrollLeft / 2;

                        }
                        else {

                            chartWrapper.scrollLeft = 0;

                        }

                    },
                    50
                );

            })
            .catch(function (error) {

                console.error(
                    "MDR Organization Chart Error:",
                    error
                );

            });
        }


        // =====================================================
        // MDR - 1.3.2.2
        // تبدیل Flat List به Parent / Child Tree
        // =====================================================

        function buildOrganizationTree(
            units
        ) {

            var unitMap = {};

            var roots = [];


            units.forEach(
                function (unit) {

                    unitMap[unit.id] = {

                        id:
                            unit.id,

                        unitName:
                            unit.unitName || "",

                        unitType:
                            unit.unitType || "",

                        parentId:
                            unit.parentId,

                        managerUserId:
                            unit.managerUserId,

                        managerName:
                            unit.managerName || "",

                        managerJobTitle:
                            unit.managerJobTitle || "",

                        managerPicture:
                            unit.managerPicture || "",

                        sortOrder:
                            unit.sortOrder || 0,

                        children: []
                    };

                }
            );


            Object.keys(
                unitMap
            )
            .forEach(
                function (key) {

                    var node =
                        unitMap[key];


                    if (
                        node.parentId !== null &&
                        node.parentId !== undefined &&
                        unitMap[node.parentId]
                    ) {

                        unitMap[
                            node.parentId
                        ]
                        .children
                        .push(node);

                    }
                    else {

                        roots.push(node);

                    }

                }
            );
            // ==========================================================
            // MDR - 1.3.2.4.1
            // تعیین نام واحد بالادستی
            // ==========================================================

            Object.keys(
                unitMap
            )
                .forEach(
                    function (key) {

                        var node =
                            unitMap[key];

                        if (
                            node.parentId !== null &&
                            node.parentId !== undefined &&
                            unitMap[node.parentId]
                        ) {

                            node.parentName =
                                unitMap[
                                    node.parentId
                                ].unitName;

                        }
                        else {

                            node.parentName =
                                "-";
                        }

                    }
                );

            function sortNodes(
                list
            ) {

                list.sort(
                    function (a, b) {

                        if (
                            a.sortOrder !==
                            b.sortOrder
                        ) {

                            return (
                                a.sortOrder -
                                b.sortOrder
                            );
                        }


                        return (
                            a.unitName || ""
                        )
                        .localeCompare(
                            b.unitName || "",
                            "fa"
                        );

                    }
                );


                list.forEach(
                    function (node) {

                        if (
                            node.children &&
                            node.children.length > 0
                        ) {

                            sortNodes(
                                node.children
                            );
                        }

                    }
                );
            }


            sortNodes(
                roots
            );


            return roots;
        }


        // =====================================================
        // MDR - 1.3.2.3
        // Render Tree
        // =====================================================

        function renderOrganizationTree(
            treeData
        ) {

            if (!orgTree) {

                return;
            }


            orgTree.innerHTML = "";


            if (
                !treeData ||
                treeData.length === 0
            ) {

                orgTree.innerHTML =
                    '<div class="glass-alert glass-alert-warning">' +
                    'هنوز واحد سازمانی ثبت نشده است.' +
                    '</div>';

                return;
            }


            var rootUl =
                document.createElement(
                    "ul"
                );


            treeData.forEach(
                function (node) {

                    rootUl.appendChild(

                        createOrganizationTreeNode(
                            node,
                            1
                        )

                    );

                }
            );


            orgTree.appendChild(
                rootUl
            );
        }


        // =====================================================
        // MDR - 1.3.2.3
        // ساخت Recursive Node
        // =====================================================

        function createOrganizationTreeNode(
            node,
            level
        ) {

            var li =
                document.createElement(
                    "li"
                );


            var nodeElement =
                document.createElement(
                    "div"
                );


            nodeElement.className =
                "org-node" +
                (
                    level === 1
                        ? " org-node-root"
                        : ""
                );


            // -----------------------------------------
            // DATA
            // -----------------------------------------

            nodeElement.setAttribute(
                "data-id",
                node.id
            );

            nodeElement.setAttribute(
                "data-name",
                node.managerName || "-"
            );

            nodeElement.setAttribute(
                "data-job",
                node.managerJobTitle || "-"
            );

            nodeElement.setAttribute(
                "data-unit",
                node.unitName || "-"
            );

            nodeElement.setAttribute(
                "data-type",
                node.unitType || "-"
            );

            nodeElement.setAttribute(
                "data-parent-id",
                node.parentId == null
                    ? ""
                    : node.parentId
            );

            nodeElement.setAttribute(
                "data-parent",
                node.parentName || "-"
            );

            nodeElement.setAttribute(
                "data-manager-id",
                node.managerUserId == null
                    ? ""
                    : node.managerUserId
            );

            nodeElement.setAttribute(
                "data-sort-order",
                node.sortOrder || 0
            );

            nodeElement.setAttribute(
                "data-count",
                node.children
                    ? node.children.length
                    : 0
            );


            // -----------------------------------------
            // LEVEL
            // -----------------------------------------

            var levelElement =
                document.createElement(
                    "span"
                );

            levelElement.className =
                "org-node-level";

            levelElement.textContent =
                "سطح " + level;

            nodeElement.appendChild(
                levelElement
            );


            // -----------------------------------------
            // PHOTO
            // -----------------------------------------

            var photo =
                document.createElement(
                    "div"
                );

            photo.className =
                "org-node-photo";


            if (
                node.managerPicture
            ) {

                var img =
                    document.createElement(
                        "img"
                    );

                img.src =
                    node.managerPicture;

                img.alt =
                    node.managerName || "";

                photo.appendChild(
                    img
                );

            }
            else {

                var personIcon =
                    document.createElement(
                        "i"
                    );

                personIcon.className =
                    "bi bi-person-fill";

                photo.appendChild(
                    personIcon
                );
            }


            var status =
                document.createElement(
                    "span"
                );

            status.className =
                "org-node-status";

            photo.appendChild(
                status
            );

            nodeElement.appendChild(
                photo
            );


            // -----------------------------------------
            // INFO
            // -----------------------------------------

            var info =
                document.createElement(
                    "div"
                );

            info.className =
                "org-node-info";


            var name =
                document.createElement(
                    "div"
                );

            name.className =
                "org-node-name";

            name.textContent =
                node.managerName ||
                "بدون مسئول";

            info.appendChild(
                name
            );


            var job =
                document.createElement(
                    "div"
                );

            job.className =
                "org-node-job";

            job.textContent =
                node.managerJobTitle ||
                "سمت تعریف نشده";

            info.appendChild(
                job
            );


            var unit =
                document.createElement(
                    "div"
                );

            unit.className =
                "org-node-unit";


            var buildingIcon =
                document.createElement(
                    "i"
                );

            buildingIcon.className =
                "bi bi-building";

            unit.appendChild(
                buildingIcon
            );


            var unitName =
                document.createElement(
                    "span"
                );

            unitName.textContent =
                node.unitName || "-";

            unit.appendChild(
                unitName
            );


            info.appendChild(
                unit
            );

            nodeElement.appendChild(
                info
            );


            li.appendChild(
                nodeElement
            );


            // -----------------------------------------
            // CHILDREN
            // -----------------------------------------

            if (
                node.children &&
                node.children.length > 0
            ) {

                var childrenUl =
                    document.createElement(
                        "ul"
                    );


                node.children.forEach(
                    function (child) {

                        childrenUl.appendChild(

                            createOrganizationTreeNode(
                                child,
                                level + 1
                            )

                        );

                    }
                );


                li.appendChild(
                    childrenUl
                );
            }


            return li;
        }


        // =====================================================
        // MDR - 1.3.2.4
        // Refresh Dynamic Node References + Events
        // =====================================================

        function refreshOrganizationTreeBindings() {

            nodes =
                Array.prototype.slice.call(
                    orgTree.querySelectorAll(
                        ".org-node"
                    )
                );


            allTreeItems =
                Array.prototype.slice.call(
                    orgTree.querySelectorAll(
                        "li"
                    )
                );


            // -----------------------------------------
            // Hover
            // -----------------------------------------

            nodes.forEach(
                function (node) {

                    /*
                        جلوگیری از Bind چندباره
                        هنگام Refresh چارت
                    */

                    if (
                        node.dataset.mdrBound ===
                        "1"
                    ) {

                        return;
                    }


                    node.dataset.mdrBound =
                        "1";


                    node.addEventListener(
                        "mouseenter",
                        function () {

                            activateBranch(
                                this
                            );
                        }
                    );


                    node.addEventListener(
                        "mouseleave",
                        function () {

                            clearBranchFocusImmediate();
                        }
                    );


                    // ---------------------------------
                    // Drawer
                    // ---------------------------------

                    node.addEventListener(
                        "click",
                        function (event) {

                            event.stopPropagation();

                            openDrawer(
                                this
                            );
                        }
                    );

                }
            );
        }


        // =====================================================
        // MDR 1.3.2
        // APPLY ZOOM + SCROLL AREA
        // =====================================================

        function applyZoom() {

            if (
                !orgTree ||
                !treeScale ||
                !treeViewport ||
                !chartWrapper
            ) {
                return;
            }


            // -----------------------------------------
            // اعمال Zoom
            // -----------------------------------------

            treeScale.style.transform =
                "scale(" +
                currentZoom +
                ")";


            // -----------------------------------------
            // نمایش درصد Zoom
            // -----------------------------------------

            zoomValue.innerText =
                Math.round(
                    currentZoom * 100
                )
                +
                "%";


            // -----------------------------------------
            // ابعاد واقعی نمودار قبل از Scale
            // -----------------------------------------

            var treeWidth =
                orgTree.offsetWidth;

            var treeHeight =
                orgTree.offsetHeight;


            // -----------------------------------------
            // ابعاد واقعی نمودار بعد از Scale
            // -----------------------------------------

            var scaledWidth =
                treeWidth *
                currentZoom;

            var scaledHeight =
                treeHeight *
                currentZoom;


            


            // -----------------------------------------
            // تنظیم Viewport
            // -----------------------------------------

            treeViewport.style.minWidth =
                Math.max(
                    scaledWidth + 80,
                    chartWrapper.clientWidth
                )
                +
                "px";


            treeViewport.style.minHeight =
                Math.max(
                    scaledHeight + 140,
                    580
                )
                +
                "px";
        }   


        // =====================================================
        // MDR 1.3.2
        // FIT TO WIDTH
        // =====================================================

        function fitTreeToScreen() {

            if (
                !orgTree ||
                !treeScale ||
                !chartWrapper
            ) {

                return;
            }


            treeScale.style.transform =
                "scale(1)";


            var availableWidth =
                chartWrapper.clientWidth -
                40;


            var treeWidth =
                orgTree.offsetWidth;


            if (
                !treeWidth ||
                treeWidth <= 0
            ) {

                return;
            }


            if (
                treeWidth >
                availableWidth
            ) {

                currentZoom =
                    availableWidth /
                    treeWidth;

            }
            else {

                currentZoom = 1;
            }


            currentZoom =
                Math.max(
                    minZoom,
                    Math.min(
                        currentZoom,
                        1
                    )
                );


            applyZoom();
        }


        // =====================================================
        // MDR 1.3.2
        // CLEAR FOCUS
        // =====================================================

        function clearFocusClasses() {

            nodes.forEach(
                function (node) {

                    node.classList.remove(
                        "branch-active"
                    );

                    node.classList.remove(
                        "branch-hover-root"
                    );

                }
            );


            allTreeItems.forEach(
                function (li) {

                    li.classList.remove(
                        "branch-active-li"
                    );

                }
            );
        }


        // =====================================================
        // MDR 1.3.2
        // CLEAR FOCUS IMMEDIATELY
        // =====================================================

        function clearBranchFocusImmediate() {

            if (returnTimer) {

                clearTimeout(
                    returnTimer
                );

                returnTimer = null;
            }


            orgTree.classList.add(
                "instant-return"
            );


            orgTree.classList.remove(
                "branch-focus"
            );


            clearFocusClasses();


            requestAnimationFrame(
                function () {

                    requestAnimationFrame(
                        function () {

                            orgTree.classList.remove(
                                "instant-return"
                            );

                        }
                    );

                }
            );
        }


        // =====================================================
        // MDR 1.3.2
        // ACTIVATE BRANCH
        // =====================================================

        function activateBranch(
            node
        ) {

            if (returnTimer) {

                clearTimeout(
                    returnTimer
                );

                returnTimer = null;
            }


            clearFocusClasses();


            orgTree.classList.add(
                "branch-focus"
            );


            node.classList.add(
                "branch-active"
            );


            node.classList.add(
                "branch-hover-root"
            );


            var currentLi =
                node.closest(
                    "li"
                );


            if (!currentLi) {

                return;
            }


            currentLi.classList.add(
                "branch-active-li"
            );


            var descendants =
                currentLi.querySelectorAll(
                    ".org-node"
                );


            Array.prototype.forEach.call(
                descendants,
                function (childNode) {

                    childNode.classList.add(
                        "branch-active"
                    );

                }
            );


            var descendantLis =
                currentLi.querySelectorAll(
                    "li"
                );


            Array.prototype.forEach.call(
                descendantLis,
                function (childLi) {

                    childLi.classList.add(
                        "branch-active-li"
                    );

                }
            );
        }



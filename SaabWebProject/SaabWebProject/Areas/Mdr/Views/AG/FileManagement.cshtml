@* =========================================================
    MDR
    Phase 1    : زیرساخت مشترک
    Step 1.5   : مدیریت فایل و پیوست

    Part 1.5.5 : صفحه مدیریت فایل‌ها (برای مدیر سیستم)
    - کارت‌های آمار (کلیک = فیلتر)
    - حجم هر بخش
    - فیلترها (تاریخ، بخش، جدول، کاربر، نوع، وضعیت، تکراری، جستجو)
    - جدول گلس فایل‌ها
    - مودال جزئیات: نسخه‌ها، فایل‌های هم‌محتوا، بازگردانی / حذف
    ========================================================= *@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "مدیریت فایل‌ها";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>FileManagement</title>

    <style>

        /* =========================================================
            MDR 1.5.5
            PAGE
            ========================================================= */

        .fm-page {
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
            direction: rtl;
            color: rgba(255,255,255,.92);
        }


        /* =========================================================
            HEADER (هم‌سبک صفحه ساختار سازمانی)
            ========================================================= */

        .fm-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .fm-header-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            color: #00ffff;
            font-size: 22px;
            background: rgba(0,255,255,.08);
            border: 1px solid rgba(0,255,255,.25);
            box-shadow: 0 0 18px rgba(0,255,255,.08), inset 0 0 12px rgba(0,255,255,.03);
        }

        .fm-header-text h4 {
            margin: 0 0 4px 0;
            color: #fff;
            font-size: 18px;
            font-weight: 700;
        }

        .fm-header-text p {
            margin: 0;
            color: rgba(255,255,255,.52);
            font-size: 11px;
        }


        /* =========================================================
            STATS CARDS
            ========================================================= */

        .fm-stats {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: .6rem;
            margin-bottom: 1rem;
        }

        .fm-stat {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .7rem .8rem;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: .55rem;
            background: rgba(255,255,255,.035);
            backdrop-filter: blur(12px) saturate(150%);
            -webkit-backdrop-filter: blur(12px) saturate(150%);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
        }

        .fm-stat-icon {
            width: 2.2rem;
            height: 2.2rem;
            flex: 0 0 2.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: .6rem;
            font-size: 1rem;
            border: 1px solid currentColor;
            background: rgba(255,255,255,.03);
        }

        .fm-stat-value {
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
            line-height: 1.2;
        }

        .fm-stat-label {
            font-size: .62rem;
            color: rgba(255,255,255,.55);
        }

        .fm-stat-info .fm-stat-icon {
            color: #00ffff;
        }

        .fm-stat-success .fm-stat-icon {
            color: #32d583;
        }

        .fm-stat-warning .fm-stat-icon {
            color: #ffc857;
        }

        .fm-stat-danger .fm-stat-icon {
            color: #ff5a4f;
        }

        .fm-stat-users .fm-stat-icon {
            color: #b692f6;
        }


        /* =========================================================
            FILTERS
            ========================================================= */

        .fm-filters {
            margin-bottom: 1rem;
        }

            .fm-filters .glass-field-body {
                padding: .7rem;
            }

            .fm-filters .row > div {
                margin-bottom: .45rem;
            }

            .fm-filters .glass-input-ag,
            .fm-filters .glass-select-ag {
                width: 100%;
                margin-bottom: 0 !important;
            }

        .fm-filter-actions {
            display: flex;
            gap: .4rem;
            align-items: flex-end;
            height: 100%;
        }

            .fm-filter-actions button {
                flex: 1;
                margin: 0 !important;
            }


        /* =========================================================
            TABLE (glass-table-ag از Layout)
            عرض ستون‌ها باید در thead و tbody یکی باشد
            ========================================================= */

        .fm-table-wrap .glass-table-ag tbody {
            max-height: calc(100vh - 25rem);
            min-height: 8rem;
        }

        /* ستون‌ها: فایل، بخش، رکورد، نسخه، حجم، تاریخ، آپلودکننده، وضعیت، عملیات */
        .fm-table-wrap .glass-table-ag th:nth-child(1),
        .fm-table-wrap .glass-table-ag td:nth-child(1) { width: 25%; text-align: right; padding-right: .6rem; }

        .fm-table-wrap .glass-table-ag th:nth-child(2),
        .fm-table-wrap .glass-table-ag td:nth-child(2) { width: 11%; }

        .fm-table-wrap .glass-table-ag th:nth-child(3),
        .fm-table-wrap .glass-table-ag td:nth-child(3) { width: 14%; }

        .fm-table-wrap .glass-table-ag th:nth-child(4),
        .fm-table-wrap .glass-table-ag td:nth-child(4) { width: 6%; }

        .fm-table-wrap .glass-table-ag th:nth-child(5),
        .fm-table-wrap .glass-table-ag td:nth-child(5) { width: 8%; }

        .fm-table-wrap .glass-table-ag th:nth-child(6),
        .fm-table-wrap .glass-table-ag td:nth-child(6) { width: 9%; }

        .fm-table-wrap .glass-table-ag th:nth-child(7),
        .fm-table-wrap .glass-table-ag td:nth-child(7) { width: 11%; }

        .fm-table-wrap .glass-table-ag th:nth-child(8),
        .fm-table-wrap .glass-table-ag td:nth-child(8) { width: 8%; }

        .fm-table-wrap .glass-table-ag th:nth-child(9),
        .fm-table-wrap .glass-table-ag td:nth-child(9) { width: 8%; }

        .fm-table-wrap .glass-table-ag th:nth-child(1) { text-align: center; }

        .fm-table-wrap .glass-table-ag tbody tr {
            cursor: pointer;
        }

        .fm-date-cell {
            line-height: 1.35;
        }

            .fm-date-cell small {
                display: block;
                color: rgba(255,255,255,.45);
                font-size: .58rem;
            }

        .fm-muted {
            color: rgba(255,255,255,.45);
            font-size: .58rem;
        }

        .fm-table-wrap .glass-table-ag td.fm-empty,
        .fm-diff-wrap .glass-table-ag td.fm-empty,
        .fm-empty {
            width: 100% !important;
            text-align: center !important;
            padding: 2rem 0 !important;
            color: rgba(255,255,255,.45) !important;
            font-size: .7rem;
            white-space: normal !important;
        }

        .fm-source-badge {
            display: inline-block;
            margin-left: .25rem;
            padding: 0 .35rem;
            border-radius: .3rem;
            font-size: .52rem;
            color: #b692f6;
            border: 1px solid rgba(182,146,246,.45);
            background: rgba(182,146,246,.06);
        }

        .fm-source-badge-manual {
            color: #00ffff;
            border-color: rgba(0,255,255,.4);
            background: rgba(0,255,255,.05);
        }


        /* =========================================================
            PAGINATION
            ========================================================= */

        .fm-pagination {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .6rem;
            flex-wrap: wrap;
            margin-top: .75rem;
            font-size: .65rem;
            color: rgba(255,255,255,.6);
        }

        .fm-pages {
            display: flex;
            align-items: center;
            gap: .35rem;
        }

            .fm-pages .glass-btn-icon {
                width: 2rem;
                height: 2rem;
            }

        .fm-page-number {
            min-width: 5.5rem;
            text-align: center;
        }


        /* =========================================================
            MODAL (ModalAG از Layout)
            ========================================================= */

        /* مقادیر فقط‌خواندنی، هم‌شکل glass-input-ag */
        #FileModalAG .fm-readonly {
            min-height: 2.1rem;
            display: flex;
            align-items: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            cursor: default;
        }

            #FileModalAG .fm-readonly:hover,
            #FileModalAG .fm-readonly:focus {
                transform: none !important;
            }

            #FileModalAG .fm-readonly.fm-ltr {
                direction: ltr;
                justify-content: flex-end;
                font-size: 11px !important;
                color: rgba(255,255,255,.7) !important;
            }

            #FileModalAG .fm-readonly .meeting-status {
                height: 1.4rem;
                min-width: 3.5rem;
                padding: 0 .55rem;
                border-radius: .4rem;
                font-size: .65rem;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        .fm-diff-wrap {
            margin-top: .35rem;
        }

        .fm-diff-wrap .glass-table-ag tbody {
            max-height: 18rem;
        }

        .fm-diff-wrap .glass-table-ag th:nth-child(1),
        .fm-diff-wrap .glass-table-ag td:nth-child(1) {
            width: 24%;
        }

        .fm-diff-wrap .glass-table-ag th:nth-child(2),
        .fm-diff-wrap .glass-table-ag td:nth-child(2),
        .fm-diff-wrap .glass-table-ag th:nth-child(3),
        .fm-diff-wrap .glass-table-ag td:nth-child(3) {
            width: 38%;
        }

        .fm-diff-wrap .glass-table-ag td {
            white-space: normal !important;
            word-break: break-word;
            height: auto !important;
            padding: .45rem .5rem;
        }

        .fm-diff-changed td {
            background: rgba(255,200,87,.05) !important;
        }

            .fm-diff-changed td:first-child {
                color: #ffc857 !important;
                font-weight: 700;
            }

        .fm-diff-old {
            color: #ff8a80;
        }

        .fm-diff-new {
            color: #6ee7b7;
        }

        .fm-null {
            color: rgba(255,255,255,.3);
            font-style: italic;
        }



        /* =========================================================
            MDR 1.5.5 — اختصاصی مدیریت فایل‌ها
            ========================================================= */

        .fm-stat-click {
            cursor: pointer;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .fm-stat-click:hover {
                border-color: rgba(0,255,255,.35);
                box-shadow: 0 0 14px rgba(0,255,255,.10), inset 0 1px 0 rgba(255,255,255,.12);
            }

        /* حجم هر بخش */
        .fm-modules {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
            gap: .5rem;
            margin-bottom: 1rem;
        }

            .fm-modules:empty {
                display: none;
            }

        .fm-module {
            padding: .5rem .65rem;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: .55rem;
            background: rgba(255,255,255,.025);
            font-size: .65rem;
        }

        .fm-module-top {
            display: flex;
            justify-content: space-between;
            gap: .4rem;
            margin-bottom: .35rem;
        }

        .fm-module-bar {
            height: 4px;
            border-radius: 4px;
            background: rgba(255,255,255,.08);
            overflow: hidden;
        }

            .fm-module-bar span {
                display: block;
                height: 100%;
                background: #00ffff;
                box-shadow: 0 0 8px rgba(0,255,255,.5);
            }

        /* ستون فایل */
        /* flex روی div داخلی؛ خود td باید table-cell بماند تا عرضش با th یکی باشد */
        .fm-file-cell {
            display: flex;
            align-items: center;
            gap: .5rem;
            min-width: 0;
            width: 100%;
        }

        .fm-icon {
            font-size: 1.15rem;
            color: #00ffff;
        }

            .fm-icon.pdf { color: #ff6b6b; }
            .fm-icon.word { color: #4ea1ff; }
            .fm-icon.excel { color: #2ecc71; }
            .fm-icon.ppt { color: #ff9f43; }
            .fm-icon.image { color: #c08cff; }
            .fm-icon.zip { color: #f1c40f; }

        .fm-file-text {
            min-width: 0;
            line-height: 1.4;
        }

        .fm-file-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .fm-file-text .fm-muted {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                text-align: right;
            }

        .fm-dup-badge {
            display: inline-block;
            padding: 0 .3rem;
            border-radius: .3rem;
            font-size: .52rem;
            color: #ffc857;
            border: 1px solid rgba(255,200,87,.45);
            background: rgba(255,200,87,.06);
        }

        .fm-row-deleted td {
            opacity: .6;
        }

            .fm-row-deleted td:last-child,
            .fm-row-deleted td:nth-child(8) {
                opacity: 1;
            }

        .fm-current {
            color: #32d583;
            font-size: .58rem;
        }

        /* جدول نسخه‌ها در مودال */
        .fm-versions-wrap .glass-table-ag th,
        .fm-versions-wrap .glass-table-ag td {
            width: auto !important;
        }

        .fm-versions-wrap .glass-table-ag th:nth-child(1),
        .fm-versions-wrap .glass-table-ag td:nth-child(1) { width: 10% !important; }

        .fm-versions-wrap .glass-table-ag th:nth-child(2),
        .fm-versions-wrap .glass-table-ag td:nth-child(2) { width: 24% !important; }

        .fm-versions-wrap .glass-table-ag th:nth-child(3),
        .fm-versions-wrap .glass-table-ag td:nth-child(3) { width: 10% !important; }

        .fm-versions-wrap .glass-table-ag th:nth-child(4),
        .fm-versions-wrap .glass-table-ag td:nth-child(4) { width: 15% !important; }

        .fm-versions-wrap .glass-table-ag th:nth-child(5),
        .fm-versions-wrap .glass-table-ag td:nth-child(5) { width: 14% !important; }

        .fm-versions-wrap .glass-table-ag th:nth-child(6),
        .fm-versions-wrap .glass-table-ag td:nth-child(6) { width: 19% !important; }

        .fm-versions-wrap .glass-table-ag th:nth-child(7),
        .fm-versions-wrap .glass-table-ag td:nth-child(7) { width: 8% !important; }

        /* پیوست‌های هم‌محتوا */
        .fm-same {
            display: flex;
            flex-wrap: wrap;
            gap: .35rem;
            margin-top: .35rem;
        }

        .fm-same-item {
            padding: .3rem .55rem;
            border: 1px solid rgba(255,200,87,.35);
            border-radius: .45rem;
            background: rgba(255,200,87,.05);
            color: #ffc857;
            font-size: .62rem;
            cursor: pointer;
        }

            .fm-same-item:hover {
                background: rgba(255,200,87,.12);
            }

        #btnMdlDelete.fm-confirm {
            box-shadow: 0 0 12px rgba(255,90,79,.45);
        }


        /* =========================================================
            MOBILE
            ========================================================= */

        @@media (max-width: 992px) {

            .fm-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

        }
    </style>
</head>

<body>

    @* =============================================================
        GLOBAL ALERTS (استایل در Layout)
        ============================================================= *@

    <div class="global-alert-container">

        <div class="global-alert global-alert-success" id="GlobalAlertSuccess">
            <div class="global-alert-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div class="global-alert-content">
                <div class="global-alert-title">عملیات موفق</div>
                <div class="global-alert-message">-</div>
            </div>
            <button type="button" class="global-alert-close action-reject" aria-label="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="global-alert global-alert-error" id="GlobalAlertError">
            <div class="global-alert-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div class="global-alert-content">
                <div class="global-alert-title">عملیات ناموفق</div>
                <div class="global-alert-message">-</div>
            </div>
            <button type="button" class="global-alert-close action-reject" aria-label="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

    </div>


    <div class="tab-content tab-AG">


        @* =====================================================
            MDR 1.5.5 — HEADER
            ===================================================== *@

        <div class="fm-header">

            <div class="fm-header-icon">
                <i class="bi bi-folder2-open"></i>
            </div>

            <div class="fm-header-text">
                <h4>مدیریت فایل‌ها</h4>
                <p>همه پیوست‌های سامانه؛ حجم، نسخه‌ها، فایل‌های حذف‌شده و تکراری</p>
            </div>

        </div>


        @* =====================================================
            MDR 1.5.5 — STATS (کل سامانه — کلیک = فیلتر)
            ===================================================== *@

        <div class="fm-stats">

            <div class="fm-stat fm-stat-success fm-stat-click" data-filter="active" title="نمایش پیوست‌های فعال">
                <div class="fm-stat-icon"><i class="bi bi-file-earmark-check"></i></div>
                <div>
                    <div class="fm-stat-value" id="statActive">-</div>
                    <div class="fm-stat-label">پیوست فعال</div>
                </div>
            </div>

            <div class="fm-stat fm-stat-danger fm-stat-click" data-filter="deleted" title="نمایش پیوست‌های حذف‌شده">
                <div class="fm-stat-icon"><i class="bi bi-trash"></i></div>
                <div>
                    <div class="fm-stat-value" id="statDeleted">-</div>
                    <div class="fm-stat-label">حذف‌شده (قابل بازگردانی)</div>
                </div>
            </div>

            <div class="fm-stat fm-stat-info">
                <div class="fm-stat-icon"><i class="bi bi-hdd"></i></div>
                <div>
                    <div class="fm-stat-value" id="statSize">-</div>
                    <div class="fm-stat-label">حجم کل روی سرور</div>
                </div>
            </div>

            <div class="fm-stat fm-stat-users">
                <div class="fm-stat-icon"><i class="bi bi-layers"></i></div>
                <div>
                    <div class="fm-stat-value" id="statVersions">-</div>
                    <div class="fm-stat-label">تعداد کل نسخه‌ها</div>
                </div>
            </div>

            <div class="fm-stat fm-stat-warning fm-stat-click" data-filter="duplicate" title="نمایش فایل‌های تکراری">
                <div class="fm-stat-icon"><i class="bi bi-files"></i></div>
                <div>
                    <div class="fm-stat-value" id="statDuplicates">-</div>
                    <div class="fm-stat-label">محتوای تکراری</div>
                </div>
            </div>

        </div>


        @* MDR 1.5.5 — حجم هر بخش *@
        <div class="fm-modules" id="fmModules"></div>


        @* =====================================================
            MDR 1.5.5 — FILTERS
            ===================================================== *@

        <div class="glass-field-ag fm-filters">

            <div class="glass-field-header">

                <div class="glass-field-icon">
                    <i class="bi bi-funnel"></i>
                </div>

                <div class="glass-field-heading">
                    <div class="glass-field-title">فیلترها</div>
                    <div class="glass-field-subtitle">بازه زمانی، بخش، کاربر، نوع فایل و وضعیت</div>
                </div>

            </div>

            <div class="glass-field-body">

                <div class="row row-input-AG">

                    <div class="col-xl-2 col-md-4">
                        <label class="glass-label-ag">از تاریخ</label>
                        <input id="fltFromDate" class="glass-input-ag pdate" data-jdp jdp-btn-close autocomplete="off" />
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <label class="glass-label-ag">تا تاریخ</label>
                        <input id="fltToDate" class="glass-input-ag pdate" data-jdp jdp-btn-close autocomplete="off" />
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <label class="glass-label-ag">بخش</label>
                        <select id="fltModule" class="glass-select-search" data-search="true">
                            <option value="">همه بخش‌ها</option>
                        </select>
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <label class="glass-label-ag">جدول</label>
                        <select id="fltEntity" class="glass-select-search" data-search="true">
                            <option value="">همه جدول‌ها</option>
                        </select>
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <label class="glass-label-ag">آپلودکننده</label>
                        <select id="fltUser" class="glass-select-search" data-search="true">
                            <option value="">همه کاربران</option>
                        </select>
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <label class="glass-label-ag">نوع فایل</label>
                        <select id="fltExtension" class="glass-select-search" data-search="true">
                            <option value="">همه</option>
                        </select>
                    </div>

                </div>

                <div class="row row-input-AG">

                    <div class="col-xl-2 col-md-4">
                        <label class="glass-label-ag">وضعیت</label>
                        <select id="fltStatus" class="glass-select-search">
                            <option value="">همه</option>
                            <option value="active">فعال</option>
                            <option value="deleted">حذف‌شده</option>
                        </select>
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <label class="glass-label-ag">تکراری</label>
                        <select id="fltDuplicate" class="glass-select-search">
                            <option value="">همه</option>
                            <option value="true">فقط محتوای تکراری</option>
                        </select>
                    </div>

                    <div class="col-xl-4">
                        <label class="glass-label-ag">جستجو</label>
                        <input id="fltSearch"
                               class="glass-input-ag"
                               placeholder="عنوان، نام فایل، آپلودکننده یا شناسه رکورد..."
                               autocomplete="off" />
                    </div>

                    <div class="col-xl-2">
                        <button type="button" id="btnFmSearch" class="glass-btn-ag glass-btn-text-confirm">
                            <i class="bi bi-search"></i>
                            اعمال فیلتر
                        </button>
                    </div>


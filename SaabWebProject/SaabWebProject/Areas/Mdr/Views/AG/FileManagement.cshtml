    @* =============================================================
        MDR 1.5.5 — تقویم جلالی (همان قالب صفحه تاریخچه رویدادها)
        ============================================================= *@

    <link href="~/Assets/css/jalalidatepicker.min.css" rel="stylesheet" />
    <link href="~/MyStyles/jalalidatepicker.css" rel="stylesheet" />
    <script data-cfasync="false" src="~/Assets/js/jalalidatepicker.min.js"></script>

    <script data-cfasync="false">

        if (!window.__mdrFmJdpInit) {

            window.__mdrFmJdpInit = true;

            jalaliDatepicker.startWatch({
                time: false,
                days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
                persianDigits: true,
                autoClose: true,
                autocomplete: true,
                showEmptyBtn: false,
                showCloseBtn: true,
                zIndex: 100000
            });
        }

    </script>


    <script data-cfasync="false">

document.addEventListener(
    "DOMContentLoaded",
    function () {

        // =====================================================
        // MDR — جلوگیری از اجرای دوباره (Rocket Loader)
        // =====================================================

        if (window.__mdrFmInit) {
            return;
        }

        window.__mdrFmInit = true;


        // =====================================================
        // URLs
        // =====================================================

        var urls = {
            filters: '@Url.Action("GetFileManagementFilters", "AG", new { area = "Mdr" })',
            list: '@Url.Action("GetFileManagementList", "AG", new { area = "Mdr" })',
            detail: '@Url.Action("GetFileManagementDetail", "AG", new { area = "Mdr" })',
            download: '@Url.Action("DownloadFileAdmin", "AG", new { area = "Mdr" })',
            restore: '@Url.Action("RestoreFile", "AG", new { area = "Mdr" })',
            remove: '@Url.Action("DeleteFile", "AG", new { area = "Mdr" })'
        };

        var state = {
            page: 1,
            totalPages: 1,
            currentGuid: null
        };

        var $ = function (id) {
            return document.getElementById(id);
        };


        // =====================================================
        // Helpers
        // =====================================================

        function esc(value) {

            if (value === null || value === undefined) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function fa(value) {

            return String(value === null || value === undefined ? "" : value)
                .replace(/\d/g, function (d) { return "۰۱۲۳۴۵۶۷۸۹"[d]; });
        }

        function toLatinDigits(value) {

            return String(value || "")
                .replace(/[۰-۹]/g, function (d) { return "۰۱۲۳۴۵۶۷۸۹".indexOf(d); })
                .replace(/[٠-٩]/g, function (d) { return "٠١٢٣٤٥٦٧٨٩".indexOf(d); });
        }

        var alertTimer = null;

        function notify(type, message) {

            var box = $(type === "success" ? "GlobalAlertSuccess" : "GlobalAlertError");

            document.querySelectorAll(".global-alert").forEach(function (a) {
                a.classList.remove("show");
            });

            box.querySelector(".global-alert-message").textContent = message;
            box.classList.add("show");

            clearTimeout(alertTimer);
            alertTimer = setTimeout(function () {
                box.classList.remove("show");
            }, 4500);
        }

        document.addEventListener("click", function (e) {

            var closeButton = e.target.closest(".global-alert-close");

            if (closeButton) {
                closeButton.closest(".global-alert").classList.remove("show");
            }
        });


        // نام خوانای بخش (هم‌نام صفحه تاریخچه رویدادها)
        var moduleNames = {
            OrganizationStructure: "ساختار سازمانی",
            Users: "کاربران",
            Roles: "نقش‌ها",
            Meetings: "جلسات",
            Tasks: "وظایف",
            Requests: "درخواست‌ها"
        };

        function moduleName(module) {
            return moduleNames[module] || module || "-";
        }

        function iconOf(extension) {

            var ext = (extension || "").toLowerCase();

            if (ext === ".pdf") return { icon: "bi-file-earmark-pdf", css: "pdf" };
            if (ext === ".doc" || ext === ".docx") return { icon: "bi-file-earmark-word", css: "word" };
            if (ext === ".xls" || ext === ".xlsx" || ext === ".csv") return { icon: "bi-file-earmark-excel", css: "excel" };
            if (ext === ".ppt" || ext === ".pptx") return { icon: "bi-file-earmark-ppt", css: "ppt" };
            if ([".jpg", ".jpeg", ".png", ".gif", ".bmp"].indexOf(ext) >= 0) return { icon: "bi-file-earmark-image", css: "image" };
            if (ext === ".zip" || ext === ".rar") return { icon: "bi-file-earmark-zip", css: "zip" };

            return { icon: "bi-file-earmark-text", css: "" };
        }

        function downloadUrl(guid, versionNo) {

            return urls.download + "?id=" + encodeURIComponent(guid) +
                (versionNo ? "&version=" + versionNo : "");
        }

        function statusBadge(isDeleted) {

            return isDeleted
                ? '<span class="meeting-status glass-status-danger">حذف‌شده</span>'
                : '<span class="meeting-status glass-status-success">فعال</span>';
        }


        // =====================================================
        // MDR 1.5.5.2 — FILTER OPTIONS
        // =====================================================

        function fillSelect(id, items, valueOf, textOf) {

            var select = $(id);

            items.forEach(function (item) {

                var option = document.createElement("option");
                option.value = valueOf(item);
                option.textContent = textOf(item);
                select.appendChild(option);
            });
        }

        function loadFilters() {

            fetch(urls.filters)
                .then(function (r) { return r.json(); })
                .then(function (result) {

                    if (!result.success) {
                        return;
                    }

                    fillSelect("fltModule", result.modules,
                        function (x) { return x; },
                        function (x) { return moduleName(x); });

                    fillSelect("fltEntity", result.entities,
                        function (x) { return x; },
                        function (x) { return x; });

                    fillSelect("fltUser", result.users,
                        function (x) { return x.id; },
                        function (x) { return x.name || ("کاربر " + x.id); });

                    fillSelect("fltExtension", result.extensions,
                        function (x) { return x; },
                        function (x) { return x; });
                })
                .catch(function (error) {
                    console.error("MDR FileManagement Filters Error:", error);
                });
        }


        // =====================================================
        // MDR 1.5.5.3 — LOAD LIST
        // =====================================================

        function buildQuery() {

            var params = new URLSearchParams();

            params.append("page", state.page);
            params.append("pageSize", $("fmPageSize").value);

            var fields = {
                fromDate: toLatinDigits($("fltFromDate").value.trim()),
                toDate: toLatinDigits($("fltToDate").value.trim()),
                moduleName: $("fltModule").value,
                entityName: $("fltEntity").value,
                userId: $("fltUser").value,
                extension: $("fltExtension").value,
                status: $("fltStatus").value,
                duplicate: $("fltDuplicate").value,
                search: $("fltSearch").value.trim()
            };

            Object.keys(fields).forEach(function (key) {

                if (fields[key]) {
                    params.append(key, fields[key]);
                }
            });

            return params.toString();
        }


        function loadFiles() {

            var body = $("fmTableBody");

            body.innerHTML =
                '<tr><td colspan="9" class="fm-empty">در حال بارگذاری...</td></tr>';

            fetch(urls.list + "?" + buildQuery())
                .then(function (r) {

                    if (!r.ok) {
                        throw new Error("خطا در ارتباط با سرور");
                    }

                    return r.json();
                })
                .then(function (result) {

                    if (!result.success) {
                        notify("error", result.message);
                        body.innerHTML =
                            '<tr><td colspan="9" class="fm-empty">خطا در دریافت اطلاعات</td></tr>';
                        return;
                    }

                    renderStats(result.stats);
                    renderModules(result.moduleSizes);
                    renderRows(result.items);
                    renderPagination(result);
                })
                .catch(function (error) {

                    console.error("MDR FileManagement List Error:", error);
                    notify("error", "در دریافت فایل‌ها خطایی رخ داد.");

                    body.innerHTML =
                        '<tr><td colspan="9" class="fm-empty">خطا در دریافت اطلاعات</td></tr>';
                });
        }


        function renderStats(stats) {

            if (!stats) {
                return;
            }

            $("statActive").textContent = fa(stats.active);
            $("statDeleted").textContent = fa(stats.deleted);
            $("statSize").textContent = fa(stats.totalSizeText);
            $("statVersions").textContent = fa(stats.versions);
            $("statDuplicates").textContent = fa(stats.duplicates);
        }


        function renderModules(items) {

            var box = $("fmModules");

            if (!items || !items.length) {
                box.innerHTML = "";
                return;
            }

            box.innerHTML = items.map(function (x) {

                return '' +
                    '<div class="fm-module">' +
                        '<div class="fm-module-top">' +
                            '<span>' + esc(moduleName(x.module)) + '</span>' +
                            '<span class="fm-muted">' + fa(x.files) + ' فایل · ' + esc(fa(x.sizeText)) + '</span>' +
                        '</div>' +
                        '<div class="fm-module-bar"><span style="width:' + Math.max(x.percent, 2) + '%"></span></div>' +
                    '</div>';

            }).join("");
        }


        function renderRows(items) {

            var body = $("fmTableBody");

            if (!items || items.length === 0) {

                body.innerHTML =
                    '<tr><td colspan="9" class="fm-empty">' +
                    '<i class="bi bi-inbox"></i> فایلی با این فیلترها پیدا نشد' +
                    '</td></tr>';

                return;
            }

            body.innerHTML = items.map(function (x) {

                var icon = iconOf(x.extension);

                var actions =
                    '<a class="glass-btn-icon" href="' + downloadUrl(x.fileGuid) + '" title="دانلود">' +
                        '<i class="bi bi-download"></i></a>' +
                    (x.isDeleted
                        ? '<button type="button" class="glass-btn-icon glass-btn-icon-confirm" data-act="restore" ' +
                              'data-guid="' + esc(x.fileGuid) + '" title="بازگردانی">' +
                              '<i class="bi bi-arrow-counterclockwise"></i></button>'
                        : '');

                return '' +
                    '<tr data-guid="' + esc(x.fileGuid) + '" class="' + (x.isDeleted ? "fm-row-deleted" : "") + '">' +
                        '<td><div class="fm-file-cell">' +
                            '<i class="bi ' + icon.icon + ' fm-icon ' + icon.css + '"></i>' +
                            '<div class="fm-file-text">' +
                                '<div class="fm-file-title">' + esc(x.title) +
                                    (x.isDuplicate ? ' <span class="fm-dup-badge" title="این محتوا در پیوست دیگری هم هست">تکراری</span>' : '') +
                                '</div>' +
                                '<div class="fm-muted" dir="ltr">' + esc(x.fileName) + '</div>' +
                            '</div>' +
                        '</div></td>' +
                        '<td>' + esc(moduleName(x.module)) + '</td>' +
                        '<td>' + esc(x.entity) + '<div class="fm-muted">رکورد ' + esc(fa(x.entityId)) + '</div></td>' +
                        '<td>' + fa(x.versionNo) +
                            (x.versionsCount > 1 ? '<div class="fm-muted">از ' + fa(x.versionsCount) + '</div>' : '') +
                        '</td>' +
                        '<td>' + esc(fa(x.sizeText)) + '</td>' +
                        '<td>' + esc(fa(x.date || "-")) + '</td>' +
                        '<td>' + esc(x.createdBy || "نامشخص") + '</td>' +
                        '<td>' + statusBadge(x.isDeleted) + '</td>' +
                        '<td><div class="meeting-actions">' + actions + '</div></td>' +
                    '</tr>';

            }).join("");
        }


        function renderPagination(result) {

            state.page = result.page;
            state.totalPages = Math.max(result.totalPages, 1);

            $("fmTotalText").textContent =
                "مجموع: " + fa(result.total) + " فایل";

            $("fmPageText").textContent =
                "صفحه " + fa(state.page) + " از " + fa(state.totalPages);

            $("btnFmPrev").disabled = state.page <= 1;
            $("btnFmNext").disabled = state.page >= state.totalPages;
        }


        // =====================================================
        // MDR 1.5.5.4 — DETAIL MODAL
        // =====================================================

        function openDetail(guid) {

            fetch(urls.detail + "?fileGuid=" + encodeURIComponent(guid))
                .then(function (r) { return r.json(); })
                .then(function (result) {

                    if (!result.success) {
                        notify("error", result.message);
                        return;
                    }

                    var f = result.file;
                    state.currentGuid = f.fileGuid;

                    var current = (result.versions || []).filter(function (v) { return v.isCurrent; })[0];
                    var icon = iconOf(current ? current.fileName.substring(current.fileName.lastIndexOf(".")) : "");

                    $("mdlIcon").className = "bi " + icon.icon;
                    $("mdlTitle").textContent = f.title;
                    $("mdlSubtitle").textContent =
                        (current ? current.fileName : "") + " — نسخه فعلی " + fa(f.versionNo);

                    $("mdlModule").textContent = moduleName(f.module);
                    $("mdlEntity").textContent = f.entity + " — رکورد " + fa(f.entityId);
                    $("mdlStatus").innerHTML = statusBadge(f.isDeleted) +
                        (f.isDeleted && f.deletedBy
                            ? '<span class="fm-muted" style="margin-right:.4rem">توسط ' + esc(f.deletedBy) + '</span>'
                            : '');

                    $("mdlCreated").textContent = (f.createdBy || "نامشخص") + " — " + fa(f.date || "");
                    $("mdlUpdated").textContent = f.updatedBy || "-";
                    $("mdlCategory").textContent =
                        [f.category, f.description].filter(Boolean).join(" — ") || "-";

                    // نسخه‌ها
                    $("mdlVersionsBody").innerHTML = (result.versions || []).map(function (v) {

                        return '' +
                            '<tr>' +
                                '<td>' + fa(v.versionNo) +
                                    (v.isCurrent ? ' <span class="fm-current">فعلی</span>' : '') + '</td>' +
                                '<td dir="ltr" title="' + esc(v.fileName) + '">' + esc(v.fileName) + '</td>' +
                                '<td>' + esc(fa(v.sizeText)) + '</td>' +
                                '<td>' + esc(fa((v.date || "") + " " + (v.time || ""))) + '</td>' +
                                '<td>' + esc(v.uploadedBy || "نامشخص") + '</td>' +
                                '<td title="' + esc(v.changeNote) + '">' + esc(v.changeNote || "-") + '</td>' +
                                '<td><a class="glass-btn-icon" href="' + downloadUrl(f.fileGuid, v.versionNo) + '" title="دانلود این نسخه">' +
                                    '<i class="bi bi-download"></i></a></td>' +
                            '</tr>';

                    }).join("");

                    // هم‌محتوا
                    var same = result.sameContent || [];

                    $("mdlSameWrap").style.display = same.length ? "" : "none";

                    $("mdlSame").innerHTML = same.map(function (s) {

                        return '' +
                            '<button type="button" class="fm-same-item" data-open="' + esc(s.fileGuid) + '">' +
                                '<i class="bi bi-files"></i> ' + esc(s.title) +
                                '<span class="fm-muted"> — ' + esc(moduleName(s.module)) + ' / ' +
                                    esc(s.entity) + ' #' + esc(fa(s.entityId)) +
                                    (s.isDeleted ? ' (حذف‌شده)' : '') + '</span>' +
                            '</button>';

                    }).join("");

                    // دکمه‌ها
                    $("btnMdlRestore").parentNode.style.display = f.isDeleted ? "" : "none";
                    $("btnMdlDelete").parentNode.style.display = f.isDeleted ? "none" : "";
                    resetDeleteButton();

                    var modal = $("FileModalAG");
                    modal.classList.add("fade-in");
                    modal.style.display = "flex";
                })
                .catch(function (error) {
                    console.error("MDR FileManagement Detail Error:", error);
                    notify("error", "در دریافت جزئیات خطایی رخ داد.");
                });
        }


        function closeDetail() {

            var modal = $("FileModalAG");
            modal.style.display = "none";
            modal.classList.remove("fade-in");
            state.currentGuid = null;
        }


        // =====================================================
        // MDR 1.5.5.6 — RESTORE / DELETE
        // =====================================================

        function postAction(url, guid, done) {

            var formData = new FormData();
            formData.append("fileGuid", guid);

            fetch(url, { method: "POST", body: formData })
                .then(function (r) { return r.json(); })
                .then(function (result) {

                    if (!result.success) {
                        notify("error", result.message);
                        return;
                    }

                    notify("success", result.message);
                    done();
                })
                .catch(function () {
                    notify("error", "خطا در ارتباط با سرور");
                });
        }

        function restore(guid) {

            postAction(urls.restore, guid, function () {
                closeDetail();
                loadFiles();
            });
        }


        // حذف دومرحله‌ای: کلیک اول «مطمئنید؟»، کلیک دوم ظرف ۳ ثانیه حذف
        var deleteTimer = null;

        function resetDeleteButton() {

            clearTimeout(deleteTimer);

            var button = $("btnMdlDelete");
            button.classList.remove("fm-confirm");
            button.innerHTML = '<i class="bi bi-trash"></i> حذف';
        }

        $("btnMdlDelete").addEventListener("click", function () {

            var button = this;

            if (!button.classList.contains("fm-confirm")) {

                button.classList.add("fm-confirm");
                button.innerHTML = '<i class="bi bi-exclamation-triangle"></i> مطمئنید؟';
                deleteTimer = setTimeout(resetDeleteButton, 3000);
                return;
            }

            resetDeleteButton();

            postAction(urls.remove, state.currentGuid, function () {
                closeDetail();
                loadFiles();
            });
        });

        $("btnMdlRestore").addEventListener("click", function () {
            restore(state.currentGuid);
        });


        // =====================================================
        // EVENTS
        // =====================================================

        // جدول: دکمه بازگردانی، لینک دانلود، یا کلیک روی ردیف = جزئیات
        $("fmTableBody").addEventListener("click", function (e) {

            if (e.target.closest("a")) {
                return;
            }

            var button = e.target.closest("[data-act='restore']");

            if (button) {
                restore(button.getAttribute("data-guid"));
                return;
            }

            var row = e.target.closest("tr[data-guid]");

            if (row) {
                openDetail(row.getAttribute("data-guid"));
            }
        });

        // پیوست هم‌محتوا → باز کردن جزئیات همان پیوست
        $("mdlSame").addEventListener("click", function (e) {

            var item = e.target.closest("[data-open]");

            if (item) {
                openDetail(item.getAttribute("data-open"));
            }
        });

        // بستن مودال
        $("btnCloseFileModal").addEventListener("click", closeDetail);
        $("btnCloseFileModal2").addEventListener("click", closeDetail);

        $("FileModalAG").addEventListener("click", function (e) {

            if (e.target === this) {
                closeDetail();
            }
        });

        document.addEventListener("keydown", function (e) {

            if (e.key === "Escape") {
                closeDetail();
            }
        });

        // کارت‌های آمار = فیلتر سریع
        document.querySelectorAll(".fm-stat-click").forEach(function (card) {

            card.addEventListener("click", function () {

                var filter = card.getAttribute("data-filter");

                if (filter === "duplicate") {
                    $("fltDuplicate").value = "true";
                    $("fltStatus").value = "";
                }
                else {
                    $("fltStatus").value = filter;
                    $("fltDuplicate").value = "";
                }

                ["fltStatus", "fltDuplicate"].forEach(function (id) {
                    $(id).dispatchEvent(new Event("change"));
                });
            });
        });

        // فیلترها
        $("btnFmSearch").addEventListener("click", function () {
            state.page = 1;
            loadFiles();
        });

        $("fltSearch").addEventListener("keydown", function (e) {

            if (e.key === "Enter") {
                state.page = 1;
                loadFiles();
            }
        });

        ["fltFromDate", "fltToDate"].forEach(function (id) {

            $(id).addEventListener("jdp:change", function () {
                state.page = 1;
                loadFiles();
            });
        });

        var reloadTimer = null;

        ["fltModule", "fltEntity", "fltUser", "fltExtension", "fltStatus", "fltDuplicate", "fmPageSize"]
            .forEach(function (id) {

                $(id).addEventListener("change", function () {

                    // چند change پشت‌سرهم (مثل کلیک روی کارت آمار) = یک بار بارگذاری
                    clearTimeout(reloadTimer);
                    reloadTimer = setTimeout(function () {
                        state.page = 1;
                        loadFiles();
                    }, 50);
                });
            });

        $("btnFmReset").addEventListener("click", function () {

            ["fltFromDate", "fltToDate", "fltSearch"].forEach(function (id) {
                $(id).value = "";
            });

            ["fltModule", "fltEntity", "fltUser", "fltExtension", "fltStatus", "fltDuplicate"].forEach(function (id) {
                $(id).value = "";
            });

            state.page = 1;
            loadFiles();
        });

        // صفحه‌بندی
        $("btnFmPrev").addEventListener("click", function () {

            if (state.page > 1) {
                state.page--;
                loadFiles();
            }
        });

        $("btnFmNext").addEventListener("click", function () {

            if (state.page < state.totalPages) {
                state.page++;
                loadFiles();
            }
        });


        // =====================================================
        // INITIAL LOAD
        // =====================================================

        loadFilters();
        loadFiles();

    }
);

    </script>

</body>
</html>

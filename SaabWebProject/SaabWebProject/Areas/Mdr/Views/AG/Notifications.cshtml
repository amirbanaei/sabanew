        </div>

    </div>


    @* MDR 1.6.5.4 — تقویم جلالی (همان قالب صفحه تاریخچه رویدادها) *@
    <link href="~/Assets/css/jalalidatepicker.min.css" rel="stylesheet" />
    <link href="~/MyStyles/jalalidatepicker.css" rel="stylesheet" />
    <script data-cfasync="false" src="~/Assets/js/jalalidatepicker.min.js"></script>

    <script data-cfasync="false">

        if (!window.__mdrNtJdpInit) {

            window.__mdrNtJdpInit = true;

            jalaliDatepicker.startWatch({
                time: false,
                days: ["شنبه", "1شنبه", "2شنبه", "3شنبه", "4شنبه", "5شنبه", "جمعه"],
                persianDigits: true,
                autoClose: true,
                autocomplete: true,
                showEmptyBtn: false,
                showCloseBtn: true,
                zIndex: 100000
            });
        }

    </script>


    <script data-cfasync="false">

document.addEventListener(
    "DOMContentLoaded",
    function () {

        // =====================================================
        // MDR — جلوگیری از اجرای دوباره (Rocket Loader)
        // =====================================================

        if (window.__mdrNtInit) {
            return;
        }

        window.__mdrNtInit = true;


        // =====================================================
        // URLs
        // =====================================================

        var urls = {
            list: '@Url.Action("GetMyNotifications", "AG", new { area = "Mdr" })',
            open: '@Url.Action("OpenNotification", "AG", new { area = "Mdr" })',
            read: '@Url.Action("MarkNotificationRead", "AG", new { area = "Mdr" })',
            readAll: '@Url.Action("MarkAllNotificationsRead", "AG", new { area = "Mdr" })',
            ack: '@Url.Action("AcknowledgeNotification", "AG", new { area = "Mdr" })',
            snooze: '@Url.Action("SnoozeNotification", "AG", new { area = "Mdr" })',
            snoozeAt: '@Url.Action("SnoozeNotificationAt", "AG", new { area = "Mdr" })',
            cancelSnooze: '@Url.Action("CancelSnoozeNotification", "AG", new { area = "Mdr" })',
            archive: '@Url.Action("ArchiveNotification", "AG", new { area = "Mdr" })'
        };

        var state = {
            page: 1,
            totalPages: 1,
            moduleName: "",
            snoozeId: null
        };

        var $ = function (id) { return document.getElementById(id); };

        // منوی Snooze به body منتقل شود (position:fixed مستقل از والد)
        document.body.appendChild($("ntSnoozeMenu"));
        document.body.appendChild($("NtSnoozeModalAG"));


        // =====================================================
        // Helpers
        // =====================================================

        function esc(value) {

            if (value === null || value === undefined) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function fa(value) {
            return String(value === null || value === undefined ? "" : value)
                .replace(/\d/g, function (d) { return "۰۱۲۳۴۵۶۷۸۹"[d]; });
        }

        var alertTimer = null;

        function notify(type, message) {

            if (!message) {
                return;
            }

            var box = $(type === "success" ? "GlobalAlertSuccess" : "GlobalAlertError");

            document.querySelectorAll(".global-alert").forEach(function (a) {
                a.classList.remove("show");
            });

            box.querySelector(".global-alert-message").textContent = message;
            box.classList.add("show");

            clearTimeout(alertTimer);
            alertTimer = setTimeout(function () {
                box.classList.remove("show");
            }, 4000);
        }

        document.addEventListener("click", function (e) {

            var closeButton = e.target.closest(".global-alert-close");

            if (closeButton) {
                closeButton.closest(".global-alert").classList.remove("show");
            }
        });

        function post(url, data) {

            var form = new FormData();

            Object.keys(data || {}).forEach(function (k) {
                form.append(k, data[k]);
            });

            return fetch(url, { method: "POST", body: form, credentials: "same-origin" })
                .then(function (r) { return r.json(); });
        }

        // اجرای عملیات روی یک اعلان + مدیریت تغییر همزمان (طبق سند: Concurrent update)
        // اگر سرور success=false داد (اعلان در تب/دستگاه دیگر تغییر کرده)،
        // پیام نمایش داده می‌شود و لیست از سرور به‌روز می‌شود
        function runAction(button, url, data, showSuccess) {

            if (button) {
                button.disabled = true;
            }

            return post(url, data)
                .then(function (result) {

                    if (!result || !result.success) {
                        notify("error", (result && result.message) || "عملیات انجام نشد.");
                    }
                    else if (showSuccess) {
                        notify("success", result.message);
                    }

                    reloadAll();
                })
                .catch(function () {

                    notify("error", "خطا در ارتباط با سرور");

                    if (button) {
                        button.disabled = false;
                    }
                });
        }


        // بعد از هر تغییر: لیست صفحه + زنگوله هدر
        function reloadAll() {

            loadList();

            if (window.MdrBell && typeof window.MdrBell.refresh === "function") {
                window.MdrBell.refresh();
            }
        }


        var sevIcons = {
            Info: "bi-info-circle",
            Success: "bi-check-circle",
            Warning: "bi-exclamation-triangle",
            Danger: "bi-exclamation-octagon"
        };

        // نام خوانای منبع (هم‌نام صفحه تاریخچه رویدادها)
        var moduleNames = {
            System: "سیستم",
            OrganizationStructure: "ساختار سازمانی",
            Users: "کاربران",
            Roles: "نقش‌ها",
            Meetings: "جلسات",
            Tasks: "وظایف",
            Requests: "درخواست‌ها"
        };

        var moduleIcons = {
            System: "bi-cpu",
            OrganizationStructure: "bi-diagram-3",
            Meetings: "bi-people",
            Tasks: "bi-list-check",
            Requests: "bi-inbox"
        };

        function moduleName(module) {
            return moduleNames[module || "System"] || module;
        }


        // =====================================================
        // MDR 1.6.5.1 — LOAD
        // =====================================================

        function buildQuery() {

            var params = new URLSearchParams();

            params.append("page", state.page);
            params.append("pageSize", $("ntPageSize").value);

            var fields = {
                status: $("fltStatus").value,
                severity: $("fltSeverity").value,
                moduleName: state.moduleName,
                search: $("fltSearch").value.trim()
            };

            Object.keys(fields).forEach(function (key) {

                if (fields[key]) {
                    params.append(key, fields[key]);
                }
            });

            return params.toString();
        }


        function loadList() {

            fetch(urls.list + "?" + buildQuery(), { credentials: "same-origin" })
                .then(function (r) { return r.json(); })
                .then(function (result) {

                    if (!result.success) {
                        notify("error", result.message);
                        $("ntList").innerHTML = '<div class="nt-empty">' + esc(result.message) + '</div>';
                        return;
                    }

                    renderStats(result.stats);
                    renderSources(result.sources || []);
                    renderList(result.items || []);
                    renderPagination(result);
                    afterRender();
                })
                .catch(function (error) {

                    console.error("MDR Notifications Error:", error);
                    $("ntList").innerHTML = '<div class="nt-empty">خطا در دریافت اعلان‌ها</div>';
                });
        }


        function renderStats(stats) {

            if (!stats) {
                return;
            }

            $("statUnread").textContent = fa(stats.unread);
            $("statPending").textContent = fa(stats.pending);
            $("statSnoozed").textContent = fa(stats.snoozed);
            $("statToday").textContent = fa(stats.today);

            var status = $("fltStatus").value;

            document.querySelectorAll(".nt-stat").forEach(function (card) {
                card.classList.toggle("active",
                    !!status && card.getAttribute("data-status") === status);
            });
        }


        function renderSources(sources) {

            var totalAll = 0;
            var unreadAll = 0;

            sources.forEach(function (s) {
                totalAll += s.total;
                unreadAll += s.unread;
            });

            function item(module, title, icon, total, unread) {

                return '' +
                    '<button type="button" class="nt-source' + (state.moduleName === module ? ' active' : '') + '" data-module="' + esc(module) + '">' +
                        '<span><i class="bi ' + icon + '"></i>' + esc(title) + '</span>' +
                        '<span class="nt-source-count">' +
                            (unread > 0 ? '<span class="nt-unread-pill">' + fa(unread) + '</span>' : '') +
                            fa(total) +
                        '</span>' +
                    '</button>';
            }

            $("ntSources").innerHTML =
                item("", "همه منابع", "bi-collection", totalAll, unreadAll) +
                sources.map(function (s) {
                    return item(s.module, moduleName(s.module), moduleIcons[s.module] || "bi-app", s.total, s.unread);
                }).join("");
        }


        function renderList(items) {

            var list = $("ntList");

            if (!items.length) {

                list.innerHTML =
                    '<div class="nt-empty"><i class="bi bi-bell-slash"></i>اعلانی با این فیلترها وجود ندارد</div>';

                return;
            }

            var html = "";

            items.forEach(function (x) {

                var pending = x.important && !x.isAcknowledged;

                // اعلان در حال تعویق «جدید» حساب نمی‌شود (بعد از پایان تعویق دوباره جدید می‌شود)
                var isNew = !x.isRead && !x.isSnoozed;

                // نشان‌ها
                var badges = "";

                if (pending) {
                    badges += '<span class="nt-badge danger">مهم — نیازمند تأیید</span>';
                }
                else if (x.important) {
                    badges += '<span class="nt-badge success">مهم — تأییدشده</span>';
                }

                if (x.isSnoozed) {
                    badges += '<span class="nt-badge warning"><i class="bi bi-alarm"></i> تعویق تا ' + esc(fa(x.snoozedUntil)) + '</span>';
                }

                // عملیات
                var actions = "";

                if (pending) {
                    actions += '<button type="button" class="glass-btn-text glass-btn-text-confirm" data-act="ack" data-id="' + x.id + '">' +
                               '<i class="bi bi-check2-circle"></i><p>مطالعه کردم</p></button>';
                }

                if (x.hasLink) {
                    actions += '<a class="glass-btn-icon glass-btn-icon-suggest" href="' + urls.open + '?id=' + x.id + '" title="رفتن به منبع">' +
                               '<i class="bi bi-box-arrow-up-left"></i></a>';
                }

                if (isNew) {
                    actions += '<button type="button" class="glass-btn-icon glass-btn-icon-confirm" data-act="read" data-id="' + x.id + '" title="خوانده شد">' +
                               '<i class="bi bi-check2"></i></button>';
                }

                if (!pending) {

                    actions += x.isSnoozed
                        ? '<button type="button" class="glass-btn-icon glass-btn-icon-suggest" data-act="unsnooze" data-id="' + x.id + '" title="لغو تعویق">' +
                          '<i class="bi bi-alarm-fill"></i></button>'
                        : '<button type="button" class="glass-btn-icon glass-btn-icon-suggest" data-act="snooze" data-id="' + x.id + '" data-title="' + esc(x.title) + '" title="یادآوری بعداً (Snooze)">' +
                          '<i class="bi bi-alarm"></i></button>';

                    actions += '<button type="button" class="glass-btn-icon glass-btn-icon-reject" data-act="archive" data-id="' + x.id + '" title="حذف از لیست">' +
                               '<i class="bi bi-x-lg"></i></button>';
                }

                html += '' +
                    '<div class="nt-item' + (isNew ? ' unread' : '') + (pending ? ' pending' : '') + '">' +
                        '<div class="nt-sev ' + esc(x.severity) + '"><i class="bi ' + (sevIcons[x.severity] || sevIcons.Info) + '"></i></div>' +
                        '<div class="nt-text">' +
                            '<div class="nt-title">' + esc(x.title) +
                                (isNew ? '<span class="nt-new-badge">جدید</span>' : '') +
                            '</div>' +
                            (x.message ? '<div class="nt-msg">' + esc(x.message) + '</div>' : '') +
                            '<div class="nt-meta">' +
                                '<span><i class="bi bi-clock"></i> ' + esc(fa((x.date || "") + " " + (x.time || ""))) + '</span>' +
                                '<span><i class="bi ' + (moduleIcons[x.module || "System"] || "bi-app") + '"></i> ' + esc(moduleName(x.module)) + '</span>' +
                                (x.sender ? '<span><i class="bi bi-person"></i> ' + esc(x.sender) + '</span>' : '') +
                                badges +
                            '</div>' +
                        '</div>' +
                        '<div class="nt-actions">' + actions + '</div>' +
                    '</div>';
            });

            list.innerHTML = html;
        }


        function renderPagination(result) {

            state.page = result.page;
            state.totalPages = Math.max(result.totalPages, 1);

            $("ntTotalText").textContent = "مجموع: " + fa(result.total) + " اعلان";
            $("ntListSubtitle").textContent = fa(result.total) + " اعلان — جدیدترین‌ها در بالا";
            $("ntPageText").textContent = "صفحه " + fa(state.page) + " از " + fa(state.totalPages);

            $("btnNtPrev").disabled = state.page <= 1;
            $("btnNtNext").disabled = state.page >= state.totalPages;
        }


        // =====================================================
        // MDR 1.6.5.6 — ReturnContext (طبق سند)
        // فیلتر، منبع، صفحه، تعداد ردیف و اسکرول لیست در آدرس صفحه
        // ذخیره می‌شود؛ بعد از «رفتن به منبع» و برگشت (Back مرورگر)
        // صفحه دقیقاً به همان حالت قبل برمی‌گردد.
        // =====================================================

        var pendingScroll = null;

        function saveContext() {

            try {

                var params = new URLSearchParams();

                var values = {
                    status: $("fltStatus").value,
                    severity: $("fltSeverity").value,
                    q: $("fltSearch").value.trim(),
                    source: state.moduleName,
                    page: state.page > 1 ? state.page : "",
                    size: $("ntPageSize").value !== "20" ? $("ntPageSize").value : "",
                    scroll: $("ntList").scrollTop > 0 ? Math.round($("ntList").scrollTop) : ""
                };

                Object.keys(values).forEach(function (key) {

                    if (values[key] !== "" && values[key] !== null && values[key] !== undefined) {
                        params.append(key, values[key]);
                    }
                });

                var query = params.toString();

                history.replaceState(
                    history.state,
                    "",
                    window.location.pathname + (query ? "?" + query : ""));
            }
            catch (e) {
            }
        }

        function restoreContext() {

            try {

                var params = new URLSearchParams(window.location.search);

                if (params.get("status") !== null) $("fltStatus").value = params.get("status");
                if (params.get("severity") !== null) $("fltSeverity").value = params.get("severity");
                if (params.get("q") !== null) $("fltSearch").value = params.get("q");
                if (params.get("size") !== null) $("ntPageSize").value = params.get("size");

                state.moduleName = params.get("source") || "";
                state.page = parseInt(params.get("page"), 10) || 1;

                var scroll = parseInt(params.get("scroll"), 10);
                pendingScroll = scroll > 0 ? scroll : null;
            }
            catch (e) {
            }
        }

        // بعد از هر بارگذاری لیست
        function afterRender() {

            if (pendingScroll !== null) {
                $("ntList").scrollTop = pendingScroll;
                pendingScroll = null;
            }

            saveContext();
        }

        var scrollSaveTimer = null;

        $("ntList").addEventListener("scroll", function () {

            clearTimeout(scrollSaveTimer);
            scrollSaveTimer = setTimeout(saveContext, 200);
        });


        // =====================================================
        // MDR 1.6.5.2 — ACTIONS
        // =====================================================

        function placeMenu(menu, anchor) {

            var rect = anchor.getBoundingClientRect();

            menu.classList.add("open");

            var left = Math.max(10, Math.min(rect.left, window.innerWidth - menu.offsetWidth - 10));
            var top = rect.bottom + 6;

            if (top + menu.offsetHeight > window.innerHeight - 10) {
                top = rect.top - menu.offsetHeight - 6;
            }

            menu.style.left = left + "px";
            menu.style.top = top + "px";
        }

        function closeSnooze() {
            $("ntSnoozeMenu").classList.remove("open");
            state.snoozeId = null;
        }


        $("ntList").addEventListener("click", function (e) {

            // رفتن به منبع: اول وضعیت فعلی ذخیره شود (برای برگشت)
            if (e.target.closest("a")) {
                saveContext();
                return;
            }

            var button = e.target.closest("[data-act]");

            if (!button) {
                return;
            }

            var id = button.getAttribute("data-id");
            var act = button.getAttribute("data-act");

            if (act === "read") {
                runAction(button, urls.read, { id: id }, false);
            }
            else if (act === "ack") {
                runAction(button, urls.ack, { id: id }, true);
            }
            else if (act === "unsnooze") {
                runAction(button, urls.cancelSnooze, { id: id }, true);
            }
            else if (act === "archive") {

                // طبق سند: عملیات حذفی نیازمند تأیید
                // کلیک اول: «حذف شود؟» — کلیک دوم ظرف ۳ ثانیه: حذف
                if (!button.classList.contains("nt-confirm-delete")) {

                    button.classList.add("nt-confirm-delete");
                    button.className = "glass-btn-text glass-btn-text-reject nt-confirm-delete";
                    button.innerHTML = '<i class="bi bi-exclamation-triangle"></i><p>حذف شود؟</p>';

                    button._ntTimer = setTimeout(function () {
                        button.className = "glass-btn-icon glass-btn-icon-reject";
                        button.innerHTML = '<i class="bi bi-x-lg"></i>';
                    }, 3000);

                    return;
                }

                clearTimeout(button._ntTimer);
                runAction(button, urls.archive, { id: id }, true);
            }
            else if (act === "snooze") {

                e.stopPropagation();
                state.snoozeId = id;
                state.snoozeTitle = button.getAttribute("data-title") || "";
                placeMenu($("ntSnoozeMenu"), button);
            }
        });


        $("ntSnoozeMenu").addEventListener("click", function (e) {

            var button = e.target.closest("button[data-min]");

            if (!button || !state.snoozeId) {
                return;
            }

            var value = button.getAttribute("data-min");
            var minutes;

            if (value === "custom") {
                openSnoozeModal(state.snoozeId, state.snoozeTitle);
                closeSnooze();
                return;
            }

            if (value === "tomorrow") {

                var tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                tomorrow.setHours(8, 0, 0, 0);

                minutes = Math.max(15, Math.round((tomorrow - new Date()) / 60000));
            }
            else {
                minutes = parseInt(value, 10);
            }

            var id = state.snoozeId;
            closeSnooze();

            runAction(null, urls.snooze, { id: id, minutes: minutes }, true);
        });


        // =====================================================
        // MDR 1.6.5.4 — مودال تنظیم یادآوری (زمان دلخواه)
        // =====================================================

        var snoozeModalId = null;

        function pad2(n) {
            return (n < 10 ? "0" : "") + n;
        }

        function todayPersian(date) {

            try {
                return date.toLocaleDateString("fa-IR-u-nu-latn", {
                    year: "numeric", month: "2-digit", day: "2-digit"
                });
            }
            catch (e) {
                return "";
            }
        }

        function toLatin(value) {

            return String(value || "")
                .replace(/[۰-۹]/g, function (d) { return "۰۱۲۳۴۵۶۷۸۹".indexOf(d); })
                .replace(/[٠-٩]/g, function (d) { return "٠١٢٣٤٥٦٧٨٩".indexOf(d); });
        }

        function openSnoozeModal(id, title) {

            snoozeModalId = id;

            // پیش‌فرض: یک ساعت بعد
            var next = new Date(Date.now() + 60 * 60000);

            $("ntSnoozeSubtitle").textContent = title || "-";
            $("ntSnoozeDate").value = fa(todayPersian(next));
            $("ntSnoozeTime").value = pad2(next.getHours()) + ":" + pad2(next.getMinutes());
            $("btnNtSnoozeSave").disabled = false;

            var modal = $("NtSnoozeModalAG");
            modal.classList.add("fade-in");
            modal.style.display = "flex";
        }

        function closeSnoozeModal() {

            var modal = $("NtSnoozeModalAG");
            modal.style.display = "none";
            modal.classList.remove("fade-in");
            snoozeModalId = null;
        }

        $("btnCloseSnoozeModal").addEventListener("click", closeSnoozeModal);
        $("btnNtSnoozeCancel").addEventListener("click", closeSnoozeModal);

        $("NtSnoozeModalAG").addEventListener("click", function (e) {

            if (e.target === this) {
                closeSnoozeModal();
            }
        });

        document.addEventListener("keydown", function (e) {

            if (e.key === "Escape" && snoozeModalId) {
                closeSnoozeModal();
            }
        });

        $("btnNtSnoozeSave").addEventListener("click", function () {

            var date = toLatin($("ntSnoozeDate").value.trim());
            var time = $("ntSnoozeTime").value.trim();

            if (!date || !time) {
                notify("error", "تاریخ و ساعت یادآوری را وارد کنید.");
                return;
            }

            var id = snoozeModalId;
            var button = this;

            button.disabled = true;

            post(urls.snoozeAt, { id: id, date: date, time: time })
                .then(function (result) {

                    if (!result || !result.success) {
                        notify("error", (result && result.message) || "عملیات انجام نشد.");
                        button.disabled = false;
                        return;
                    }

                    notify("success", result.message);
                    closeSnoozeModal();
                    reloadAll();
                })
                .catch(function () {
                    notify("error", "خطا در ارتباط با سرور");
                    button.disabled = false;
                });
        });

        document.addEventListener("click", function (e) {

            if (!e.target.closest("#ntSnoozeMenu") && !e.target.closest("[data-act='snooze']")) {
                closeSnooze();
            }
        });

        window.addEventListener("scroll", closeSnooze, true);


        // همه خوانده شد (اعلان‌های در حال تعویق دست نمی‌خورند)
        $("btnNtReadAll").addEventListener("click", function () {

            var button = this;
            button.disabled = true;

            post(urls.readAll, {})
                .then(function (result) {
                    notify(result.success ? "success" : "error", result.message);
                    reloadAll();
                })
                .catch(function () {
                    notify("error", "خطا در ارتباط با سرور");
                })
                .then(function () {
                    button.disabled = false;
                });
        });


        // =====================================================
        // MDR 1.6.5.3 — FILTERS
        // =====================================================

        // منبع
        $("ntSources").addEventListener("click", function (e) {

            var item = e.target.closest("[data-module]");

            if (item) {
                state.moduleName = item.getAttribute("data-module");
                state.page = 1;
                loadList();
            }
        });

        // کارت‌های آمار = فیلتر وضعیت
        document.querySelectorAll(".nt-stat").forEach(function (card) {

            card.addEventListener("click", function () {

                $("fltStatus").value = card.getAttribute("data-status");
                $("fltStatus").dispatchEvent(new Event("change"));
            });
        });

        var reloadTimer = null;

        ["fltStatus", "fltSeverity", "ntPageSize"].forEach(function (id) {

            $(id).addEventListener("change", function () {

                clearTimeout(reloadTimer);
                reloadTimer = setTimeout(function () {
                    state.page = 1;
                    loadList();
                }, 50);
            });
        });

        // جستجو هنگام تایپ (با تأخیر کوتاه)
        var searchTimer = null;

        $("fltSearch").addEventListener("input", function () {

            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () {
                state.page = 1;
                loadList();
            }, 400);
        });

        $("btnNtReset").addEventListener("click", function () {

            $("fltStatus").value = "";
            $("fltSeverity").value = "";
            $("fltSearch").value = "";
            state.moduleName = "";
            state.page = 1;
            loadList();
        });

        // صفحه‌بندی
        $("btnNtPrev").addEventListener("click", function () {

            if (state.page > 1) {
                state.page--;
                loadList();
            }
        });

        $("btnNtNext").addEventListener("click", function () {

            if (state.page < state.totalPages) {
                state.page++;
                loadList();
            }
        });


        // =====================================================
        // INITIAL LOAD + به‌روزرسانی هر ۶۰ ثانیه
        // =====================================================

        restoreContext();
        loadList();

        setInterval(function () {

            if (!document.hidden &&
                !$("ntSnoozeMenu").classList.contains("open") &&
                !snoozeModalId) {
                loadList();
            }
        }, 60000);

    }
);

    </script>

</body>
</html>

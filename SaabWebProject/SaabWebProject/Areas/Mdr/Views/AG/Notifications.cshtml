﻿@* =========================================================
    MDR
    Phase 1    : زیرساخت مشترک
    Step 1.6   : اعلان‌ها و Notification

    Part 1.6.5 : صفحه مرکز اعلان (طبق سند جامع، بخش ۳)
    - کارت‌های آمار (کلیک = فیلتر)
    - گروه‌بندی بر اساس منبع (ستون کناری)
    - فیلتر وضعیت / سطح / جستجو
    - لیست گروه‌بندی‌شده بر اساس تاریخ
    - عملیات: رفتن به منبع، خوانده شد، تأیید، Snooze، حذف از لیست
    هر کاربر فقط اعلان‌های خودش را می‌بیند.
    ========================================================= *@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "مرکز اعلان‌ها";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Notifications</title>

    <style>

        /* =========================================================
            MDR 1.6.5 — HEADER / STATS (هم‌سبک صفحات MDR)
            ========================================================= */

        .nt-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .nt-header-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            color: #00ffff;
            font-size: 22px;
            background: rgba(0,255,255,.08);
            border: 1px solid rgba(0,255,255,.25);
            box-shadow: 0 0 18px rgba(0,255,255,.08), inset 0 0 12px rgba(0,255,255,.03);
        }

        .nt-header-text h4 {
            margin: 0 0 4px 0;
            color: #fff;
            font-size: 18px;
            font-weight: 700;
        }

        .nt-header-text p {
            margin: 0;
            color: rgba(255,255,255,.52);
            font-size: 11px;
        }

        /* دکمه «همه خوانده شد» در هدر باکس اعلان‌ها */
        .nt-list-box .glass-field-header {
            display: flex;
            align-items: center;
        }

        .nt-list-actions {
            margin-right: auto;
        }

            .nt-list-actions .glass-btn-text {
                width: auto;
                white-space: nowrap;
            }

        .nt-stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .6rem;
            margin-bottom: 1rem;
        }

        .nt-stat {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .7rem .8rem;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: .55rem;
            background: rgba(255,255,255,.035);
            backdrop-filter: blur(12px) saturate(150%);
            -webkit-backdrop-filter: blur(12px) saturate(150%);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
            cursor: pointer;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .nt-stat:hover,
            .nt-stat.active {
                border-color: rgba(0,255,255,.4);
                box-shadow: 0 0 14px rgba(0,255,255,.10), inset 0 1px 0 rgba(255,255,255,.12);
            }

        .nt-stat-icon {
            width: 2.2rem;
            height: 2.2rem;
            flex: 0 0 2.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: .6rem;
            font-size: 1rem;
            border: 1px solid currentColor;
            background: rgba(255,255,255,.03);
        }

        .nt-stat-value {
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
            line-height: 1.2;
        }

        .nt-stat-label {
            font-size: .62rem;
            color: rgba(255,255,255,.55);
        }

        .nt-c-info { color: #00ffff; }
        .nt-c-danger { color: #ff5a4f; }
        .nt-c-warning { color: #ffc857; }
        .nt-c-users { color: #b692f6; }


        /* =========================================================
            MDR 1.6.5 — LAYOUT: منابع + لیست
            ========================================================= */

        .nt-body {
            display: grid;
            grid-template-columns: 15rem minmax(0, 1fr);
            gap: 1rem;
            align-items: start;
        }

        .nt-sources .glass-field-body {
            padding: .5rem;
        }

        .nt-source {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .4rem;
            width: 100%;
            padding: .5rem .6rem;
            margin-bottom: .2rem;
            border: 1px solid transparent;
            border-radius: .5rem;
            background: transparent;
            color: rgba(255,255,255,.8);
            font-size: .68rem;
            text-align: right;
            cursor: pointer;
            transition: background .15s ease, border-color .15s ease;
        }

            .nt-source:hover {
                background: rgba(0,255,255,.05);
            }

            .nt-source.active {
                border-color: rgba(0,255,255,.35);
                background: rgba(0,255,255,.08);
                color: #00ffff;
            }

            .nt-source i {
                margin-left: .35rem;
            }

        .nt-source-count {
            display: flex;
            gap: .25rem;
            align-items: center;
            font-size: .58rem;
            color: rgba(255,255,255,.45);
        }

        .nt-unread-pill {
            min-width: 1.2rem;
            padding: 0 .3rem;
            border-radius: 1rem;
            background: rgba(0,255,255,.15);
            color: #00ffff;
            text-align: center;
        }


        /* فیلترها (داخل باکس گلس مثل بقیه صفحات MDR) */
        .nt-filters {
            margin-bottom: .8rem;
        }

            .nt-filters .glass-field-body {
                padding: .7rem;
            }

            .nt-filters .row > div {
                margin-bottom: .45rem;
            }

            .nt-filters .glass-input-ag,
            .nt-filters .glass-select-ag {
                width: 100%;
                margin-bottom: 0 !important;
            }


        /* =========================================================
            MDR 1.6.5 — LIST
            ========================================================= */

        .nt-list-box .glass-field-body {
            padding: .4rem .2rem .7rem;
        }

        .nt-list {
            max-height: calc(100vh - 27rem);
            min-height: 10rem;
            overflow-y: auto;
        }

        .nt-list-box .nt-pagination {
            padding: 0 .6rem;
        }

        /* هر اعلان = یک کارت ساده هم‌سبک کارت‌های گلس صفحه
           (همان بردر و پس‌زمینه کارت‌های آمار)
           خوانده‌نشده: فقط برچسب «جدید» + عنوان پررنگ
           مهمِ تأییدنشده: بردر قرمز ملایم */
        .nt-item {
            position: relative;
            display: flex;
            gap: .7rem;
            margin: .5rem .6rem;
            padding: .75rem .9rem;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: .55rem;
            background: rgba(255,255,255,.035);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .nt-item:hover {
                border-color: rgba(0,255,255,.4);
                box-shadow: 0 0 14px rgba(0,255,255,.10), inset 0 1px 0 rgba(255,255,255,.12);
            }

            /* خوانده‌شده: متن ملایم‌تر */
            .nt-item .nt-title,
            .nt-item .nt-msg {
                opacity: .72;
            }

            .nt-item.unread .nt-title,
            .nt-item.unread .nt-msg,
            .nt-item.pending .nt-title,
            .nt-item.pending .nt-msg {
                opacity: 1;
            }

            /* مهمِ تأییدنشده */
            .nt-item.pending {
                border-color: rgba(255,90,79,.45);
            }

                .nt-item.pending:hover {
                    border-color: rgba(255,90,79,.75);
                    box-shadow: 0 0 14px rgba(255,90,79,.10), inset 0 1px 0 rgba(255,255,255,.12);
                }

        .nt-new-badge {
            display: inline-block;
            margin-right: .35rem;
            padding: 0 .4rem;
            border-radius: .3rem;
            font-size: .55rem;
            font-weight: 700;
            color: #07111b;
            background: #00ffff;
            box-shadow: 0 0 8px rgba(0,255,255,.5);
            vertical-align: middle;
        }

        .nt-sev {
            flex: 0 0 auto;
            width: 36px;
            height: 36px;
            border-radius: .6rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            border: 1px solid currentColor;
            background: rgba(255,255,255,.03);
        }

            .nt-sev.Info { color: #00ffff; }
            .nt-sev.Success { color: #32d583; }
            .nt-sev.Warning { color: #ffc857; }
            .nt-sev.Danger { color: #ff5a4f; }

        .nt-text {
            flex: 1 1 auto;
            min-width: 0;
        }

        .nt-title {
            font-size: .78rem;
            color: #fff;
        }

        .nt-item.unread .nt-title {
            font-weight: 700;
        }

        .nt-msg {
            margin-top: .2rem;
            font-size: .68rem;
            line-height: 1.8;
            color: rgba(255,255,255,.62);
            white-space: pre-line;
        }

        .nt-meta {
            margin-top: .3rem;
            display: flex;
            flex-wrap: wrap;
            gap: .35rem .6rem;
            align-items: center;
            font-size: .58rem;
            color: rgba(255,255,255,.42);
        }

        .nt-badge {
            display: inline-block;
            padding: 0 .35rem;
            border-radius: .3rem;
            font-size: .55rem;
            border: 1px solid currentColor;
        }

            .nt-badge.danger { color: #ff5a4f; }
            .nt-badge.success { color: #32d583; }
            .nt-badge.warning { color: #ffc857; }

        .nt-actions {
            flex: 0 0 auto;
            display: flex;
            gap: .3rem;
            align-items: flex-start;
        }

            .nt-actions .glass-btn-icon {
                width: 1.9rem;
                height: 1.9rem;
            }

        .nt-actions .glass-btn-text {
            width: auto;
            height: 1.9rem;
            white-space: nowrap;
        }

        .nt-empty {
            padding: 3rem 1rem;
            text-align: center;
            color: rgba(255,255,255,.45);
            font-size: .72rem;
        }

            .nt-empty i {
                display: block;
                font-size: 1.8rem;
                color: rgba(0,255,255,.4);
                margin-bottom: .4rem;
            }


        /* منوی Snooze */
        .nt-snooze-menu {
            position: fixed;
            z-index: 100600;
            display: none;
            min-width: 9rem;
            padding: .3rem;
            direction: rtl;
            border: 1px solid rgba(0,255,255,.25);
            border-radius: .55rem;
            background: rgba(7,17,27,.98);
            box-shadow: 0 10px 25px rgba(0,0,0,.45);
        }

            .nt-snooze-menu.open {
                display: block;
            }

            .nt-snooze-menu button {
                display: block;
                width: 100%;
                padding: .35rem .5rem;
                border: 0;
                border-radius: .35rem;
                background: transparent;
                color: #edfaff;
                font-size: .64rem;
                text-align: right;
                cursor: pointer;
            }

                .nt-snooze-menu button:hover {
                    background: rgba(0,255,255,.08);
                    color: #00ffff;
                }


        /* صفحه‌بندی */
        .nt-pagination {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .6rem;
            flex-wrap: wrap;
            margin-top: .75rem;
            font-size: .65rem;
            color: rgba(255,255,255,.6);
        }

        .nt-pages {
            display: flex;
            align-items: center;
            gap: .35rem;
        }

            .nt-pages .glass-btn-icon {
                width: 2rem;
                height: 2rem;
            }

        .nt-page-number {
            min-width: 5.5rem;
            text-align: center;
        }


        /* MDR 1.6.5.4 — مودال تنظیم یادآوری */
        .nt-snooze-modal {
            max-width: 34rem;
        }

        .nt-time-input {
            direction: ltr;
            text-align: center;
        }

        .nt-snooze-hint {
            margin: .2rem 0 .6rem;
            font-size: .62rem;
            line-height: 1.8;
            color: rgba(255,255,255,.5);
        }

        /* MDR 1.6.5.5 — تأیید دومرحله‌ای حذف از لیست */
        .nt-actions .nt-confirm-delete {
            width: auto;
            height: 1.9rem;
            white-space: nowrap;
        }

        @@media (max-width: 992px) {

            .nt-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .nt-body {
                grid-template-columns: 1fr;
            }
        }

    </style>
</head>

<body>

    @* =============================================================
        GLOBAL ALERTS (استایل در Layout)
        ============================================================= *@

    <div class="global-alert-container">

        <div class="global-alert global-alert-success" id="GlobalAlertSuccess">
            <div class="global-alert-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div class="global-alert-content">
                <div class="global-alert-title">عملیات موفق</div>
                <div class="global-alert-message">-</div>
            </div>
            <button type="button" class="global-alert-close action-reject" aria-label="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="global-alert global-alert-error" id="GlobalAlertError">
            <div class="global-alert-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div class="global-alert-content">
                <div class="global-alert-title">عملیات ناموفق</div>
                <div class="global-alert-message">-</div>
            </div>
            <button type="button" class="global-alert-close action-reject" aria-label="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

    </div>


    <div class="tab-content tab-AG">


        @* =====================================================
            MDR 1.6.5 — HEADER
            ===================================================== *@

        <div class="nt-header">

            <div class="nt-header-icon">
                <i class="bi bi-bell"></i>
            </div>

            <div class="nt-header-text">
                <h4>مرکز اعلان‌ها</h4>
                <p>همه اعلان‌های شما از همه بخش‌های سامانه؛ خواندن، تأیید، تعویق و رفتن به منبع</p>
            </div>

        </div>


        @* =====================================================
            MDR 1.6.5 — STATS (کلیک = فیلتر وضعیت)
            ===================================================== *@

        <div class="nt-stats">

            <div class="nt-stat" data-status="unread" title="نمایش خوانده‌نشده‌ها">
                <div class="nt-stat-icon nt-c-info"><i class="bi bi-envelope"></i></div>
                <div>
                    <div class="nt-stat-value" id="statUnread">-</div>
                    <div class="nt-stat-label">خوانده‌نشده</div>
                </div>
            </div>

            <div class="nt-stat" data-status="pending" title="نمایش اعلان‌های مهمِ تأییدنشده">
                <div class="nt-stat-icon nt-c-danger"><i class="bi bi-exclamation-octagon"></i></div>
                <div>
                    <div class="nt-stat-value" id="statPending">-</div>
                    <div class="nt-stat-label">مهم و تأییدنشده</div>
                </div>
            </div>

            <div class="nt-stat" data-status="snoozed" title="نمایش اعلان‌های به تعویق افتاده">
                <div class="nt-stat-icon nt-c-warning"><i class="bi bi-alarm"></i></div>
                <div>
                    <div class="nt-stat-value" id="statSnoozed">-</div>
                    <div class="nt-stat-label">به تعویق افتاده</div>
                </div>
            </div>

            <div class="nt-stat" data-status="" title="نمایش همه">
                <div class="nt-stat-icon nt-c-users"><i class="bi bi-calendar-day"></i></div>
                <div>
                    <div class="nt-stat-value" id="statToday">-</div>
                    <div class="nt-stat-label">اعلان‌های امروز</div>
                </div>
            </div>

        </div>


        <div class="nt-body">


            @* =====================================================
                MDR 1.6.5 — SOURCES (گروه‌بندی بر اساس منبع)
                ===================================================== *@

            <div class="glass-field-ag nt-sources">

                <div class="glass-field-header">
                    <div class="glass-field-icon">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <div class="glass-field-heading">
                        <div class="glass-field-title">منبع اعلان</div>
                        <div class="glass-field-subtitle">بخش فرستنده</div>
                    </div>
                </div>

                <div class="glass-field-body" id="ntSources">
                    <div class="nt-empty">در حال بارگذاری...</div>
                </div>

            </div>


            @* =====================================================
                MDR 1.6.5 — FILTERS + LIST
                ===================================================== *@

            <div>

                @* =====================================================
                    MDR 1.6.5 — FILTERS (هم‌سبک صفحات MDR)
                    ===================================================== *@

                <div class="glass-field-ag nt-filters">

                    <div class="glass-field-header">

                        <div class="glass-field-icon">
                            <i class="bi bi-funnel"></i>
                        </div>

                        <div class="glass-field-heading">
                            <div class="glass-field-title">فیلترها</div>
                            <div class="glass-field-subtitle">وضعیت، سطح و جستجو در متن اعلان</div>
                        </div>

                    </div>

                    <div class="glass-field-body">

                        <div class="row row-input-AG">

                            <div class="col-xl-3 col-md-6">
                                <label class="glass-label-ag">وضعیت</label>
                                <select id="fltStatus" class="glass-select-search">
                                    <option value="">همه</option>
                                    <option value="unread">خوانده‌نشده</option>
                                    <option value="read">خوانده‌شده</option>
                                    <option value="pending">مهم و تأییدنشده</option>
                                    <option value="snoozed">به تعویق افتاده</option>
                                </select>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <label class="glass-label-ag">سطح</label>
                                <select id="fltSeverity" class="glass-select-search">
                                    <option value="">همه</option>
                                    <option value="Info">اطلاع</option>
                                    <option value="Success">موفق</option>
                                    <option value="Warning">هشدار</option>
                                    <option value="Danger">خطر</option>
                                </select>
                            </div>

                            <div class="col-xl-4 col-md-8">
                                <label class="glass-label-ag">جستجو</label>
                                <input id="fltSearch"
                                       class="glass-input-ag"
                                       placeholder="عنوان یا متن اعلان..."
                                       autocomplete="off" />
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <button type="button" id="btnNtReset" class="glass-btn-ag glass-btn-text-reject">
                                    <i class="bi bi-trash"></i>
                                    پاک کردن
                                </button>
                            </div>

                        </div>

                    </div>

                </div>


                @* =====================================================
                    MDR 1.6.5 — LIST (داخل باکس گلس مثل بقیه صفحات MDR)
                    ===================================================== *@

                <div class="glass-field-ag nt-list-box">

                    <div class="glass-field-header">

                        <div class="glass-field-icon">
                            <i class="bi bi-bell"></i>
                        </div>

                        <div class="glass-field-heading">
                            <div class="glass-field-title">اعلان‌ها</div>
                            <div class="glass-field-subtitle" id="ntListSubtitle">جدیدترین‌ها در بالا</div>
                        </div>

                        @* همه خوانده شد — سمت چپ هدر *@
                        <div class="nt-list-actions">
                            <button type="button" id="btnNtReadAll" class="glass-btn-text glass-btn-text-suggest">
                                <i class="bi bi-check2-all"></i>
                                <p>همه خوانده شوند</p>
                            </button>
                        </div>

                    </div>

                    <div class="glass-field-body">

                        <div class="nt-list scrollbar" id="ntList">
                            <div class="nt-empty">در حال بارگذاری...</div>
                        </div>


                        <div class="nt-pagination">

                            <div id="ntTotalText">-</div>

                            <div class="nt-pages">

                                <button type="button" id="btnNtPrev" class="glass-btn-icon" title="صفحه قبل">
                                    <i class="bi bi-chevron-right"></i>
                                </button>

                                <span class="nt-page-number" id="ntPageText">-</span>

                                <button type="button" id="btnNtNext" class="glass-btn-icon" title="صفحه بعد">
                                    <i class="bi bi-chevron-left"></i>
                                </button>

                                <select id="ntPageSize"
                                        data-search="false"
                                        class="glass-select-search"
                                        style="width:5.5rem !important; margin-bottom:0 !important;">
                                    <option value="20">۲۰ ردیف</option>
                                    <option value="50">۵۰ ردیف</option>
                                    <option value="100">۱۰۰ ردیف</option>
                                </select>

                            </div>

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </div>


    @* MDR 1.6.5 — منوی Snooze *@
    <div class="nt-snooze-menu" id="ntSnoozeMenu">
        <button type="button" data-min="60"><i class="bi bi-clock"></i> ۱ ساعت بعد</button>
        <button type="button" data-min="180"><i class="bi bi-clock"></i> ۳ ساعت بعد</button>
        <button type="button" data-min="tomorrow"><i class="bi bi-sunrise"></i> فردا ساعت ۸ صبح</button>
        <button type="button" data-min="10080"><i class="bi bi-calendar-week"></i> هفته بعد</button>
        <button type="button" data-min="custom"><i class="bi bi-calendar-event"></i> زمان دلخواه...</button>
    </div>


    @* =============================================================
        MDR 1.6.5.4 — مودال «تنظیم یادآوری» (طبق سند: Modal تنظیم یادآوری)
        ============================================================= *@

    <div id="NtSnoozeModalAG" class="ModalAG">

        <div class="ContentModalAG nt-snooze-modal">

            <div class="BtnCloseAG action-reject" id="btnCloseSnoozeModal">
                <i class="bi bi-x"></i>
            </div>

            <div class="tab-content scrollbar">

                <div class="glass-field-ag">

                    <div class="glass-field-header">

                        <div class="glass-field-icon">
                            <i class="bi bi-alarm"></i>
                        </div>

                        <div class="glass-field-heading">
                            <div class="glass-field-title">تنظیم یادآوری</div>
                            <div class="glass-field-subtitle" id="ntSnoozeSubtitle">-</div>
                        </div>

                    </div>

                    <div class="glass-field-body">

                        <div class="row row-input-AG">

                            <div class="col-xl-6">
                                <label class="glass-label-ag">تاریخ یادآوری</label>
